<script lang="ts">
import { computed, signal } from "@meekojs/meeko";
import * as Child from "./Child.meeko";

const count = signal(1);
const visible = signal(true);
const items = signal(["a", "b", "c"]);
const doubled = computed(() => count.value * 2);

function bump(): void {
  count.value += 1;
}

function reset(): void {
  count.value = 0;
}

async function load(): Promise<void> {
  count.value = await Promise.resolve(5);
}
</script>

<template>
  <section>
    <p>{doubled.value}</p>
    <div if:when="visible.value && count.value > 0"><span>on</span></div>
    <ul><li each:of="items.value.slice(0, count.value)" each:as="item" each:key="item">{item}</li></ul>
    <component is="Child" bind:label="String(count.value)"></component>
    <button on:click="bump">Bump</button>
    <button on:click="() => count.value++">Inc</button>
    <button on:click="reset">Reset</button>
    <button on:click="load">Load</button>
  </section>
</template>
