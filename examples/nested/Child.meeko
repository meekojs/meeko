<script lang="ts">
import { signal } from "@meekojs/meeko";
import * as Grandchild from "./Grandchild.meeko";

const props = defineProps<{ label: string }>();
const count = signal(0);
</script>

<template>
  <button on:click="() => count.value++">{props.label}: {count.value}</button>
  <component is="Grandchild" bind:label="props.label"></component>
</template>
