{
    "name": "meeko-monorepo",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@12.14.0",
    "description": "Workspace of @meekojs/meeko, its editor and DevTools extensions and the documentation site.",
    "license": "MIT",
    "scripts": {
        "dev": "pnpm run site:dev",
        "build": "pnpm -r --filter @meekojs/meeko --filter @meekojs/ui --filter @meekojs/i18n --filter @meekojs/prettier-plugin --filter @meekojs/eslint-plugin run build",
        "check": "pnpm -r --filter @meekojs/meeko --filter @meekojs/ui --filter @meekojs/i18n --filter @meekojs/prettier-plugin --filter @meekojs/eslint-plugin run check",
        "test": "pnpm -F @meekojs/meeko run test",
        "test:packages": "node --test --test-concurrency=1 packages/ui/tests/*.test.mjs packages/i18n/tests/*.test.mjs packages/eslint-plugin/tests/*.test.mjs packages/prettier-plugin/tests/*.test.mjs",
        "check:apps": "pnpm -F meeko-site run check && pnpm -F meeko-ui-site run check",
        "verify": "pnpm run test:build && pnpm -F @meekojs/meeko run verify && pnpm -F meeko-devtools-extension run check",
        "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
        "lint:fix": "eslint . --fix --cache --cache-location node_modules/.cache/eslint/",
        "e2e": "pnpm -F @meekojs/meeko run e2e",
        "conformance": "pnpm -F @meekojs/meeko run conformance",
        "conformance:node": "pnpm -F @meekojs/meeko run conformance:node",
        "conformance:bun": "pnpm -F @meekojs/meeko run conformance:bun",
        "conformance:deno": "pnpm -F @meekojs/meeko run conformance:deno",
        "conformance:workerd": "pnpm -F @meekojs/meeko run conformance:workerd",
        "pilot:e2e": "pnpm -F @meekojs/meeko run pilot:e2e",
        "package:smoke": "pnpm -F @meekojs/meeko run package:smoke",
        "example:bundle": "pnpm -F @meekojs/meeko run example:bundle",
        "example:serve": "pnpm -F @meekojs/meeko run example:serve",
        "vite:dev": "pnpm -F @meekojs/meeko run vite:dev",
        "benchmark": "pnpm -F @meekojs/meeko run benchmark",
        "benchmark:scenarios": "pnpm -F @meekojs/meeko run benchmark:scenarios",
        "devtools:check": "pnpm -F meeko-devtools-extension run check",
        "devtools:types": "pnpm -F meeko-devtools-extension run types",
        "vscode:check": "pnpm -F meeko-language run check",
        "vscode:test": "pnpm -F meeko-language run test",
        "vscode:package": "pnpm -F meeko-language run package:vsix",
        "vscode:install": "pnpm -F meeko-language run install:local",
        "site:dev": "pnpm -F meeko-site run dev",
        "ui:dev": "pnpm -F meeko-ui-site run dev",
        "ui:build": "pnpm -F @meekojs/meeko run build && pnpm -F @meekojs/ui run build && pnpm -F meeko-ui-site run build",
        "site:build": "pnpm -F @meekojs/meeko run build && pnpm -F meeko-site run build",
        "site:docs:sync": "pnpm -F meeko-site run docs:sync",
        "tooling:build": "pnpm -F @meekojs/meeko run build && pnpm -F @meekojs/eslint-plugin run build && pnpm -F @meekojs/prettier-plugin run build",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "test:build": "node --test scripts/build-package.test.mjs",
        "package:workspace-smoke": "pwsh -NoProfile -File scripts/package-workspace-smoke.ps1"
    },
    "engines": {
        "node": ">=24"
    },
    "devDependencies": {
        "eslint": "10.13.0",
        "globals": "17.13.0",
        "jiti": "2.7.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "@meekojs/eslint-plugin": "workspace:*",
        "@meekojs/prettier-plugin": "workspace:*",
        "esbuild": "0.28.2",
        "prettier": "3.9.10",
        "prettier-plugin-css-order": "2.2.0",
        "prettier-plugin-packagejson": "3.0.3"
    }
}
