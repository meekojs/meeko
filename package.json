{
	"name": "meeko-monorepo",
	"private": true,
	"description": "Workspace of @meekojs/meeko, its editor and DevTools extensions and the documentation site.",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"agents:check": "node scripts/sync-agents.mjs --check",
		"agents:sync": "node scripts/sync-agents.mjs",
		"benchmark": "pnpm -F @meekojs/meeko run benchmark",
		"benchmark:scenarios": "pnpm -F @meekojs/meeko run benchmark:scenarios",
		"build": "turbo run build",
		"build:apps": "turbo run build --filter=./apps/*",
		"build:packages": "turbo run build --filter=./packages/*",
		"check": "turbo run check --filter=@meekojs/meeko --filter=@meekojs/ui --filter=@meekojs/i18n --filter=@meekojs/icon --filter=@meekojs/prettier-plugin --filter=@meekojs/eslint-plugin",
		"check:apps": "pnpm -F meeko-site run check && pnpm -F meeko-ui-site run check && pnpm -F meeko-i18n-site run check",
		"ci:local": "node scripts/ci-local.mjs",
		"conformance": "pnpm -F @meekojs/meeko run conformance",
		"conformance:bun": "pnpm -F @meekojs/meeko run conformance:bun",
		"conformance:deno": "pnpm -F @meekojs/meeko run conformance:deno",
		"conformance:node": "pnpm -F @meekojs/meeko run conformance:node",
		"conformance:workerd": "pnpm -F @meekojs/meeko run conformance:workerd",
		"design:check": "node scripts/design-tokens-check.mjs",
		"dev": "turbo watch dev",
		"dev:apps": "turbo watch dev --filter=./apps/*",
		"dev:dashboard": "turbo watch dev --filter=meeko-dashboard",
		"dev:i18n": "turbo watch dev --filter=meeko-i18n-site",
		"dev:site": "turbo watch dev --filter=meeko-site",
		"dev:ui": "turbo watch dev --filter=meeko-ui-site",
		"devtools:check": "pnpm -F meeko-devtools-extension run check",
		"devtools:types": "pnpm -F meeko-devtools-extension run types",
		"e2e": "pnpm -F @meekojs/meeko run e2e",
		"example:bundle": "pnpm -F @meekojs/meeko run example:bundle",
		"example:serve": "pnpm -F @meekojs/meeko run example:serve",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
		"lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
		"package:smoke": "pnpm -F @meekojs/meeko run package:smoke",
		"package:workspace-smoke": "pwsh -NoProfile -File scripts/package-workspace-smoke.ps1",
		"pilot:e2e": "pnpm -F @meekojs/meeko run pilot:e2e",
		"site:docs:sync": "pnpm -F meeko-site run docs:sync",
		"test": "pnpm -F @meekojs/meeko run test",
		"test:build": "node --test scripts/build-package.test.mjs",
		"test:packages": "node --test --test-concurrency=1 packages/ui/tests/*.test.mjs packages/i18n/tests/*.test.mjs packages/icon/tests/*.test.mjs packages/eslint-plugin/tests/*.test.mjs packages/prettier-plugin/tests/*.test.mjs",
		"test:scripts": "node --test scripts/build-package.test.mjs scripts/ci-local.test.mjs scripts/ci-workflow.test.mjs scripts/deploy-dockerfile.test.mjs scripts/design-tokens-check.test.mjs scripts/generated-sources.test.mjs scripts/git-guard.test.mjs scripts/publish-packages.test.mjs scripts/sync-agents.test.mjs scripts/release-assets.test.ts scripts/test-support/test-support.test.ts",
		"tooling:build": "turbo run build --filter=@meekojs/eslint-plugin --filter=@meekojs/prettier-plugin",
		"verify": "pnpm run build:packages && pnpm run verify:prepared",
		"verify:prepared": "pnpm run test:scripts && pnpm run design:check && pnpm -F @meekojs/meeko run verify:prepared && pnpm -F meeko-devtools-extension run check",
		"vite:dev": "pnpm -F @meekojs/meeko run vite:dev",
		"vscode:check": "pnpm -F meeko-language run check",
		"vscode:install": "pnpm -F meeko-language run install:local",
		"vscode:package": "pnpm -F meeko-language run package:vsix",
		"vscode:test": "pnpm -F meeko-language run test"
	},
	"devDependencies": {
		"@meekojs/eslint-plugin": "workspace:*",
		"@meekojs/prettier-plugin": "workspace:*",
		"esbuild": "catalog:",
		"eslint": "catalog:",
		"eslint-config-turbo": "catalog:",
		"globals": "catalog:",
		"jiti": "catalog:",
		"prettier": "catalog:",
		"prettier-plugin-css-order": "catalog:",
		"prettier-plugin-packagejson": "catalog:",
		"tsdown": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:typescript6"
	},
	"packageManager": "pnpm@12.14.0",
	"engines": {
		"node": ">=24"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.14.0"
		}
	}
}
