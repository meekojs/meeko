{
  "name": "meeko-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "description": "Workspace of @meekojs/meeko, its editor and DevTools extensions and the documentation site.",
  "license": "MIT",
  "scripts": {
    "build": "pnpm -F @meekojs/meeko run build",
    "check": "pnpm -F @meekojs/meeko run check",
    "test": "pnpm -F @meekojs/meeko run test",
    "verify": "pnpm -F @meekojs/meeko run verify && pnpm -F meeko-devtools-extension run check",
    "e2e": "pnpm -F @meekojs/meeko run e2e",
    "conformance": "pnpm -F @meekojs/meeko run conformance",
    "conformance:node": "pnpm -F @meekojs/meeko run conformance:node",
    "conformance:bun": "pnpm -F @meekojs/meeko run conformance:bun",
    "conformance:deno": "pnpm -F @meekojs/meeko run conformance:deno",
    "conformance:workerd": "pnpm -F @meekojs/meeko run conformance:workerd",
    "pilot:e2e": "pnpm -F @meekojs/meeko run pilot:e2e",
    "package:smoke": "pnpm -F @meekojs/meeko run package:smoke",
    "example:bundle": "pnpm -F @meekojs/meeko run example:bundle",
    "example:serve": "pnpm -F @meekojs/meeko run example:serve",
    "vite:dev": "pnpm -F @meekojs/meeko run vite:dev",
    "benchmark": "pnpm -F @meekojs/meeko run benchmark",
    "benchmark:scenarios": "pnpm -F @meekojs/meeko run benchmark:scenarios",
    "devtools:check": "pnpm -F meeko-devtools-extension run check",
    "devtools:types": "pnpm -F meeko-devtools-extension run types",
    "vscode:check": "pnpm -F meeko-language run check",
    "vscode:test": "pnpm -F meeko-language run test",
    "vscode:package": "pnpm -F meeko-language run package:vsix",
    "site:dev": "pnpm -F meeko-site run dev",
    "site:build": "pnpm -F @meekojs/meeko run build && pnpm -F meeko-site run build",
    "site:build:static": "pnpm -F @meekojs/meeko run build && pnpm -F meeko-site run build:static"
  },
  "engines": {
    "node": ">=24"
  }
}
