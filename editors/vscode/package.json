{
  "name": "meeko-language",
  "publisher": "meekojs",
  "displayName": "Meeko Language",
  "description": "Syntax, diagnostics and TypeScript editing for .meeko components",
  "version": "0.0.1",
  "private": true,
  "repository": { "type": "git", "url": "https://github.com/meekojs/meeko" },
  "type": "module",
  "main": "./dist/extension.js",
  "engines": { "vscode": "^1.140.0" },
  "activationEvents": ["onLanguage:meeko"],
  "categories": ["Programming Languages"],
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:host": "node tests/run-host.mjs",
    "test:host:isolated": "pwsh -NoProfile -File tests/prepare-host.ps1",
    "package:vsix": "pwsh -NoProfile -File package-vsix.ps1"
  },
  "dependencies": {
    "@typescript/typescript6": "6.0.2",
    "typescript": "7.0.2"
  },
  "contributes": {
    "languages": [{
      "id": "meeko",
      "aliases": ["Meeko"],
      "extensions": [".meeko"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "meeko",
      "scopeName": "source.meeko",
      "path": "./syntaxes/meeko.tmLanguage.json",
      "embeddedLanguages": {
        "meta.embedded.block.typescript": "typescript",
        "meta.embedded.block.html": "html",
        "meta.embedded.block.css": "css"
      }
    }]
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/vscode": "1.140.0",
    "@vscode/test-electron": "3.1.0",
    "esbuild": "0.28.2",
    "tsx": "^4.20.0"
  }
}
