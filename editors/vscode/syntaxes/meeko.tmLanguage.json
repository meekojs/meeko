{
  "scopeName": "source.meeko",
  "patterns": [
    { "include": "#script" },
    { "include": "#template" },
    { "include": "#style" }
  ],
  "repository": {
    "script": {
      "begin": "(<)(script)(?=\\s|>)",
      "end": "(</)(script)(>)",
      "name": "meta.embedded.block.typescript",
      "patterns": [{ "include": "source.ts" }]
    },
    "template": {
      "begin": "(<)(template)(>)",
      "end": "(</)(template)(>)",
      "name": "meta.embedded.block.html",
      "patterns": [{ "include": "text.html.basic" }]
    },
    "style": {
      "begin": "(<)(style)(?=\\s|>)",
      "end": "(</)(style)(>)",
      "name": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    }
  }
}
