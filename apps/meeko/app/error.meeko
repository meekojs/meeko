<script lang="ts">
	export interface Props {
		status: number
		message: string
	}

	const props = defineProps<Props>()

	const { localePath, t } = useI18n()

	// An error under /en/… is shown in English, with its links to the English pages.
	const home = localePath(href('/'))
	const guide = localePath(href('/docs/[slug]', { params: { slug: 'framework' } }))
	const reference = localePath(href('/docs/reference'))
</script>

<template>
	<UIContainer
		size="2xl"
		class="site-error"
	>
		<section class="error">
			<div class="copy">
				<UIPageHeader
					layout="landing"
					bind:title="props.status === 404 ? t('error.notFoundTitle') : t('error.failedTitle')"
					bind:description="props.status === 404 ? t('error.notFoundDetail') : t('error.failedDetail', { message: props.message })"
				/>
				<UIProse>
					<p>
						<I18nT key="error.hint">
							<snippet
								name="kbd"
								params="text"
							>
								<kbd>{text}</kbd>
							</snippet>
						</I18nT>
					</p>
				</UIProse>
				<p class="actions">
					<UILink bind:href="home">{t('error.home')}</UILink>
					<UILink
						variant="outline"
						bind:href="guide"
					>
						{t('error.guide')}
					</UILink>
					<UILink
						variant="outline"
						bind:href="reference"
					>
						{t('error.reference')}
					</UILink>
				</p>
			</div>
			<div class="figure">
				<CatFigure
					bind:label="'FIG. ' + props.status"
					bind:caption="props.status === 404 ? t('error.notFoundCaption') : t('error.failedCaption')"
				/>
			</div>
		</section>
	</UIContainer>
</template>

