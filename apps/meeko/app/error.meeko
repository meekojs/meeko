<script lang="ts">
	export interface Props {
		status: number
		message: string
	}

	const props = defineProps<Props>()

	const { localePath, t } = useI18n()

	// An error under /en/… is shown in English, with its links to the English pages.
	const home = localePath(href('/'))
	const guide = localePath(href('/docs/[slug]', { params: { slug: 'framework' } }))
	const reference = localePath(href('/docs/reference'))
</script>

<template>
	<section class="error">
		<div class="copy">
			<h1 if:when="props.status === 404">
				{t('error.notFoundTitle')}
				<span class="tone-soft">{t('error.notFoundDetail')}</span>
			</h1>
			<h1 if:when="props.status !== 404">
				{t('error.failedTitle')}
				<span class="tone-soft">{t('error.failedDetail', { message: props.message })}</span>
			</h1>
			<p class="hint">
				<I18nT key="error.hint">
					<snippet
						name="kbd"
						params="text"
					>
						<kbd>{text}</kbd>
					</snippet>
				</I18nT>
			</p>
			<p class="actions">
				<UILink bind:href="home">{t('error.home')}</UILink>
				<UILink
					variant="outline"
					bind:href="guide"
				>
					{t('error.guide')}
				</UILink>
				<UILink
					variant="outline"
					bind:href="reference"
				>
					{t('error.reference')}
				</UILink>
			</p>
		</div>
		<div class="figure">
			<CatFigure
				bind:label="'FIG. ' + props.status"
				bind:caption="props.status === 404 ? t('error.notFoundCaption') : t('error.failedCaption')"
			/>
		</div>
	</section>
</template>

<style scoped>
	.error {
		display: grid;
		grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
		align-items: center;
		gap: 4rem;
		margin: 0 auto;
		padding: clamp(4rem, 12vh, 8rem) var(--gutter) clamp(4rem, 10vh, 7rem);
		max-width: var(--container);
	}
	h1 {
		margin: 0;
		max-width: 40rem;
		font-weight: var(--weight-display);
		font-size: clamp(2rem, 4.2vw, 3.25rem);
		line-height: 1.1;
		letter-spacing: -0.03em;
		text-wrap: balance;
	}
	.hint {
		margin: 1.5rem 0 0;
		color: var(--muted);
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 2rem 0 0;
	}
	@media (max-width: 860px) {
		.error {
			grid-template-columns: minmax(0, 1fr);
			gap: 3rem;
			padding-right: 1rem;
			padding-left: 1rem;
		}
		.figure {
			order: -1;
			max-width: 18rem;
		}
	}
</style>
