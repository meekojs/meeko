<script lang="ts">
	import type { ReferencePage } from '../../shared/types/reference'

	interface Props {
		/** A written page of the reference, merged with its generated types (packages/docs-content/src/content/reference.ts). */
		page: ReferencePage
		/** `title:` meta of Pagefind, for the search result. */
		searchTitle: string
	}

	const props = defineProps<Props>()

	const { localePath, t } = useI18n()
</script>

<template>
	<UIProse
		as="article"
		data-pagefind-body
		bind:data-pagefind-meta="props.searchTitle"
	>
		<div data-pagefind-ignore>
			<UIBreadcrumb
				bind:label="t('docs.reference.breadcrumb')"
				bind:items="[
					{ label: t('docs.reference.title'), href: localePath('/docs/reference') },
					{ label: props.page.group.title, href: props.page.group.href, current: false },
				]"
			/>
		</div>
		<h1 class="title">
			<code>{props.page.title}</code>
		</h1>
		<p>{props.page.description}</p>
		<div
			class="meta"
			data-pagefind-ignore
		>
			<UIBadge tone="accent">{props.page.kindLabel}</UIBadge>
			<UIBadge if:when="props.page.since">{t('docs.reference.since', { version: props.page.since ?? '' })}</UIBadge>
			<UIBadge if:when="props.page.autoImport">{t('docs.reference.noImport')}</UIBadge>
			<code if:when="props.page.specifier">{props.page.specifier}</code>
			<UILink
				if:when="props.page.sourceUrl"
				variant="ghost"
				size="sm"
				rel="noopener"
				bind:href="props.page.sourceUrl!"
			>
				<svg
					class="meeko-ui-icon"
					viewBox="0 0 16 16"
					aria-hidden="true"
				>
					<path d="m5.5 5-3 3 3 3M10.5 5l3 3-3 3M9 3.5l-2 9" />
				</svg>
				{t('docs.reference.source')}
			</UILink>
		</div>
		<p
			if:when="props.page.autoImport"
			html="props.page.autoImport"
		/>
		<div
			if:when="props.page.importCode"
			html="props.page.importCode"
		/>
		<div
			class="body"
			html="props.page.body"
		/>
	</UIProse>
</template>

