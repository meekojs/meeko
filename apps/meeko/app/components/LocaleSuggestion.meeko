<script lang="ts">
	import { signal } from '@meekojs/meeko'

	// The reader's language (the locale cookie, then navigator.languages) when this page exists in
	// it and is not the one shown. The site never redirects by language: it only offers the other
	// version here, once mounted, so the server HTML and the hydration never differ. It floats over
	// the page instead of pushing it down. It is written in the language it offers, from the
	// multilingual namespace `suggestion`; "stay" in the current one. "Stay" stores the current
	// language, so it does not come back on the next pages; following the link stores the new one.
	const i18n = useI18n()
	const suggestion = signal<string | undefined>(undefined)

	onMounted(() => {
		const code = i18n.suggestedLocale()
		if (code && i18n.pageLocales().includes(code)) suggestion.value = code
	})

	function stay(): void {
		i18n.rememberLocale(i18n.locale)
		suggestion.value = undefined
	}
</script>

<template>
	<aside
		if:when="suggestion.value"
		class="locale-suggestion"
		data-pagefind-ignore
		bind:lang="suggestion.value"
		bind:aria-label="i18n.t('locale.suggestion.label', {}, { locale: suggestion.value! })"
	>
		<svg
			class="icon"
			viewBox="0 0 16 16"
			aria-hidden="true"
		>
			<path d="M8 14.25A6.25 6.25 0 1 0 8 1.75a6.25 6.25 0 0 0 0 12.5ZM1.75 8h12.5M8 1.75c1.6 1.7 2.4 3.8 2.4 6.25S9.6 12.55 8 14.25C6.4 12.55 5.6 10.45 5.6 8S6.4 3.45 8 1.75Z" />
		</svg>
		<p role="status">{i18n.t('locale.suggestion.message', {}, { locale: suggestion.value! })}</p>
		<div class="actions">
			<a
				class="go"
				bind:href="i18n.switchLocalePath(suggestion.value!)"
				bind:hreflang="suggestion.value"
			>
				{i18n.t('locale.suggestion.go', {}, { locale: suggestion.value! })}
			</a>
			<button
				type="button"
				class="stay"
				bind:lang="i18n.locale"
				on:click="stay"
			>
				{i18n.t('locale.suggestion.stay')}
			</button>
		</div>
	</aside>
</template>

<style scoped>
	/* Floats over the page (the only shadow of the site is for what floats), so its arrival after
	   hydration moves nothing. */
	.locale-suggestion {
		display: grid;
		position: fixed;
		right: 1.25rem;
		bottom: 1.25rem;
		grid-template-columns: auto minmax(0, 1fr);
		align-items: start;
		gap: 0.35rem 0.7rem;
		z-index: 30;
		animation: arrive 0.5s var(--ease-out) both;
		box-shadow: var(--shadow-lg);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-l);
		background: var(--surface-2);
		padding: 0.95rem 1rem 1rem 0.95rem;
		width: min(23rem, calc(100vw - 2rem));
		color: var(--ink);
		font-size: 0.9rem;
		line-height: 1.45;
	}
	.icon {
		fill: none;
		stroke: var(--accent-ink);
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.3;
		margin-top: 0.12rem;
		width: 16px;
		height: 16px;
	}
	p {
		margin: 0;
		text-wrap: pretty;
	}
	.actions {
		display: flex;
		grid-column: 2;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.45rem;
	}
	.go,
	.stay {
		display: inline-flex;
		align-items: center;
		transition:
			background-color 0.15s,
			color 0.15s,
			border-color 0.15s;
		cursor: pointer;
		border-radius: 999px;
		padding: 0 0.9rem;
		height: 32px;
		font: inherit;
		font-weight: 520;
		font-size: 0.84rem;
		text-decoration: none;
	}
	.go {
		border: 1px solid transparent;
		background: var(--pill);
		color: var(--on-pill);
	}
	.go:hover {
		background: var(--pill-hover);
	}
	.stay {
		border: 1px solid var(--line-strong);
		background: transparent;
		color: var(--ink);
	}
	.stay:hover {
		background: var(--surface-3);
	}
	@keyframes arrive {
		from {
			transform: translateY(0.75rem);
			opacity: 0;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.locale-suggestion {
			animation: none;
		}
	}
	@media (max-width: 520px) {
		.locale-suggestion {
			right: 1rem;
			bottom: 1rem;
			left: 1rem;
			width: auto;
		}
	}
</style>
