<script lang="ts">
	import { computed, signal } from '@meekojs/meeko'

	import type { DemoSource } from '../../shared/types/demo'

	interface Props {
		/** The counter example of the package, highlighted on the server line by line. */
		source: DemoSource
	}

	/** A write to `count`, as the DevTools timeline lists it. */
	interface SignalEvent {
		readonly id: number
		readonly from: number
		readonly to: number
	}

	const props = defineProps<Props>()

	const { t } = useI18n()

	// The same state as examples/counter/Counter.meeko, rendered on the server and hydrated here.
	const count = signal(0)
	const doubled = computed(() => count.value * 2)
	const events = signal<readonly SignalEvent[]>([])
	const fileName = computed(() => props.source.file.split('/').pop() ?? props.source.file)
	/** Alternates on every change so the CSS flash restarts; absent until the first change. */
	const pulse = computed(() => {
		const latest = events.value[0]
		return latest === undefined ? undefined : latest.id % 2 ? 'a' : 'b'
	})
	const announcement = computed(() => (events.value.length ? t('home.demo.announcement', { count: count.value, doubled: doubled.value }) : ''))

	function increment(): void {
		const from = count.value
		count.value++
		const id = (events.value[0]?.id ?? 0) + 1
		events.value = [{ id, from, to: count.value }, ...events.value].slice(0, 4)
	}

	function reset(): void {
		count.value = 0
		events.value = []
	}
</script>

<template>
	<figure
		class="demo"
		aria-labelledby="demo-caption"
	>
		<div class="window">
			<div class="titlebar">
				<p class="path">
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path d="M4 1.5h5.5L13 5v9.5H4z M9.5 1.5V5H13" />
					</svg>
					<span class="dir">examples / counter /</span>
					<b>{fileName.value}</b>
				</p>
				<UIButton
					variant="outline"
					size="sm"
					bind:disabled="events.value.length === 0"
					on:click="reset"
				>
					{t('home.demo.reset')}
				</UIButton>
			</div>
			<div class="panes">
				<section
					class="pane code"
					bind:aria-label="t('home.demo.code')"
				>
					<header class="pane-head">
						<span>{t('home.demo.editor')}</span>
						<a
							rel="noopener"
							bind:href="props.source.url"
						>
							{t('home.demo.github')}
						</a>
					</header>
					<pre
						class="shiki source"
						tabindex="0"
						aria-label="Counter.meeko"
						bind:data-pulse="pulse.value"
					><code><span
							each:of="props.source.lines"
							each:as="line"
							each:index="index"
							class="line"
							bind:data-mark="line.mark"
						><span
								class="ln"
								aria-hidden="true"
							>{index + 1}</span><span
								class="text"
								html="line.html"
							/></span></code></pre>
				</section>
				<section
					class="pane result"
					bind:aria-label="t('home.demo.result')"
				>
					<header class="pane-head">
						<span>{t('home.demo.resultTitle')}</span>
						<span class="note">{t('home.demo.resultNote')}</span>
					</header>
					<div class="stage">
						<UIButton
							variant="outline"
							size="lg"
							on:click="increment"
						>
							{t('home.demo.counter', { count: count.value, doubled: doubled.value })}
						</UIButton>
						<p class="hint">{t('home.demo.hint')}</p>
					</div>
				</section>
				<section
					class="pane devtools"
					bind:aria-label="t('home.demo.devtools')"
				>
					<header class="pane-head">
						<span>DevTools</span>
						<UIBadge>{t('home.demo.devtoolsTag')}</UIBadge>
					</header>
					<div class="tree">
						<span class="node">&lt;Counter&gt;</span>
						<span class="instance">#1</span>
					</div>
					<p class="group-title">Props</p>
					<dl class="rows">
						<div class="row">
							<dt>initial</dt>
							<dd class="value muted">undefined</dd>
							<dd class="site" />
						</div>
					</dl>
					<p class="group-title">{t('home.demo.signals')}</p>
					<dl class="rows">
						<div
							class="row signal"
							bind:data-flash="pulse.value"
						>
							<dt>count</dt>
							<dd class="value">{count.value}</dd>
							<dd class="site">{fileName.value}:{props.source.countLine}</dd>
						</div>
						<div
							class="row derived"
							bind:data-flash="pulse.value"
						>
							<dt>
								doubled
								<span class="kind">computed</span>
							</dt>
							<dd class="value">{doubled.value}</dd>
							<dd class="site">{fileName.value}:{props.source.doubledLine}</dd>
						</div>
					</dl>
					<p class="group-title">{t('home.demo.timeline')}</p>
					<ol class="timeline">
						<li
							each:of="events.value"
							each:as="event"
							each:key="event.id"
						>
							<span class="seq">{event.id}</span>
							<span class="name">count</span>
							<span class="change">{event.from} → {event.to}</span>
						</li>
					</ol>
					<p
						if:when="events.value.length === 0"
						class="empty"
					>
						{t('home.demo.empty')}
					</p>
					<p class="disclaimer">{t('home.demo.disclaimer')}</p>
				</section>
			</div>
		</div>
		<figcaption
			id="demo-caption"
			class="fig-label"
		>
			<b>FIG. 01</b>
			<span>{t('home.demo.caption')}</span>
		</figcaption>
		<p
			class="meeko-ui-sr-only"
			aria-live="polite"
		>
			{announcement.value}
		</p>
	</figure>
</template>

<style scoped>
	.demo {
