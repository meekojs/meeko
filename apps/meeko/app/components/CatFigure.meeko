<style scoped>
	.cat-figure {
		display: grid;
		gap: 1.25rem;
		margin: 0;
	}
	svg {
		margin-inline: auto;
		max-width: 26rem;
	}
	/* About 11px at full size, like the labels of the other figures. */
	.cat-figure svg {
		--fig-text: 6.6px;
	}
	/* The mask and muzzle sit between the figure line and its soft tint, readable in both themes. */
	.iso .l.mid {
		stroke: color-mix(in oklab, var(--figure) 58%, transparent);
	}
	/* The eyes carry the one blue; the nose stays a neutral line (The Nose Rule). */
	.pupil {
		fill: var(--accent);
	}
	.glint {
		fill: var(--fig-ground, var(--bg));
	}
</style>
