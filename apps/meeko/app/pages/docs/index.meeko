<script server lang="ts">
	import { definePage } from '@meekojs/meeko/framework'

	import type { NavLink, RenderedDoc } from '../../../shared/types/docs'

	import { readPage } from '../../../server/content/db'

	export const route = definePage({ render: 'ssr' })

	type DocCard = Pick<NavLink, 'featured' | 'href'> & Pick<RenderedDoc, 'title' | 'description'> & { readonly section: string }
	type IndexPage = { readonly sections: readonly { readonly title: string; readonly docs: readonly DocCard[] }[] }
	const { locale } = await usePageI18n()
	const snapshot = await readPage<IndexPage>('/docs', locale)
	if (!snapshot) notFound()
	export const sections = snapshot.sections
</script>

<script lang="ts">
	import { splitLocalePath } from 'meeko-docs-content/locale'

	export interface Props {
		params: Record<string, string>
		search: Record<string, string | string[]>
	}

	const { t } = useI18n()
	// The snapshot of each language has `/docs/<slug>` or `/en/docs/<slug>`, and every guide of the
	// catalog has that form; `to` localizes the route again, so the link keeps the reader's language.
	const slugOf = (href: string): string => splitLocalePath(href).path.slice('/docs/'.length)
	useHead({ title: t('docs.index.headTitle'), meta: [{ name: 'description', content: t('docs.index.description') }] })
</script>

<template>
	<section
		class="index"
		data-pagefind-ignore
	>
		<h1>{t('docs.index.title')}</h1>
		<p class="lead">
			<I18nT key="docs.index.lead">
				<snippet
					name="code"
					params="text"
				>
					<code>{text}</code>
				</snippet>
			</I18nT>
		</p>
		<section
			each:of="sections"
			each:as="section"
			each:key="section.title"
		>
			<h2>{section.title}</h2>
			<ul>
				<li
					each:of="section.docs"
					each:as="doc"
					each:key="doc.href"
				>
					<UILinkCard
						to="/docs/[slug]"
						bind:params="{ slug: slugOf(doc.href) }"
						bind:title="doc.title"
						bind:description="doc.description"
					>
						<UIBadge
							if:when="doc.featured"
							tone="accent"
							class="featured"
						>
							{t('docs.layout.featured')}
						</UIBadge>
					</UILinkCard>
				</li>
			</ul>
		</section>
	</section>
</template>

<style scoped>
	.index {
		margin: 0 auto;
		padding: clamp(3rem, 8vh, 5rem) var(--gutter) 5rem;
		max-width: var(--container);
	}
	h1 {
		margin: 0;
		font-weight: var(--weight-display);
		font-size: clamp(2.2rem, 4.5vw, 3.25rem);
		line-height: 1.08;
		letter-spacing: var(--tracking-display);
	}
	.lead {
		margin: 1rem 0 3rem;
		max-width: 38rem;
		color: var(--muted);
		font-size: 1.1rem;
		line-height: 1.55;
	}
	.lead code {
		color: var(--ink-soft);
		font-size: 0.9em;
	}
	section + section {
		margin-top: 2.75rem;
	}
	h2 {
		margin: 0 0 1rem;
		border-bottom: 1px solid var(--line);
		padding-bottom: 0.75rem;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	/* Under the description of a card the dashboard features. */
	ul :global(.featured) {
		align-self: flex-start;
		margin-top: 0.6rem;
		font-size: 0.72rem;
	}
	@media (max-width: 640px) {
		.index {
			padding: 2.5rem var(--gutter) 3.5rem;
		}
	}
</style>
