<script server lang="ts">
	import { definePage } from '@meekojs/meeko/framework'

	import type { NavLink, RenderedDoc } from '../../../shared/types/docs'

	import { readPage } from '../../../server/content/db'

	export const route = definePage({ render: 'ssr' })

	type DocCard = Pick<NavLink, 'featured' | 'href'> & Pick<RenderedDoc, 'title' | 'description'> & { readonly section: string }
	type IndexPage = { readonly sections: readonly { readonly title: string; readonly docs: readonly DocCard[] }[] }
	const snapshot = await readPage<IndexPage>('/docs')
	if (!snapshot) notFound()
	export const sections = snapshot.sections

	export const head = {
		title: 'Documentación · Meeko',
		description: 'Toda la documentación de Meeko: guía del framework, API de componentes, editores, DevTools, estabilidad, arquitectura, migración y cambios.',
	}
</script>

<script lang="ts">
	export interface Props {
		params: Record<string, string>
		search: Record<string, string | string[]>
	}
</script>

<template>
	<section
		class="index"
		data-pagefind-ignore
	>
		<h1>Documentación</h1>
		<p class="lead">
			Todo lo que necesitas para escribir componentes
			<code>.meeko</code>
			y aplicaciones full-stack con Meeko.
		</p>
		<section
			each:of="sections"
			each:as="section"
			each:key="section.title"
		>
			<h2>{section.title}</h2>
			<ul>
				<li
					each:of="section.docs"
					each:as="doc"
					each:key="doc.href"
				>
					<UILinkCard
						bind:href="doc.href"
						bind:title="doc.title"
						bind:description="doc.description"
					>
						<UIBadge
							if:when="doc.featured"
							tone="accent"
							class="featured"
						>
							Destacado
						</UIBadge>
					</UILinkCard>
				</li>
			</ul>
		</section>
	</section>
</template>

