<script server lang="ts">
	import type { PageLocale } from 'meeko-docs-content/locale'

	import { definePage } from '@meekojs/meeko/framework'

	import type { ApiPage } from '../../../../shared/types/api'
	import type { NavSection, Pager, TocEntry } from '../../../../shared/types/docs'
	import type { ReferencePage } from '../../../../shared/types/reference'

	import { readPage } from '../../../../server/content/db'

	export const route = definePage({ render: 'ssr' })

	const { params } = usePage()
	const { locale } = await usePageI18n()
	type SymbolPage = {
		readonly written: ReferencePage | null
		readonly page: ApiPage | null
		readonly nav: readonly NavSection[]
		readonly current: string
		readonly pages: Pager
		readonly toc: readonly TocEntry[]
		readonly editUrl: string
		readonly editPath: string
		readonly index: string
		readonly searchTitle: string
		readonly head: { readonly title: string; readonly description: string }
		readonly i18n?: PageLocale
	}
	const snapshot = await readPage<SymbolPage>(`/docs/reference/${params.symbol}`, locale)
	if (!snapshot) notFound()
	export const { written, page, nav, current, pages, toc, editUrl, editPath, index, searchTitle, head } = snapshot
	// Without it in the payload (a snapshot older than the languages), the page is the original.
	export const i18n = snapshot.i18n ?? null
</script>

<script lang="ts">
	export interface Props {
		params: { symbol: string }
		search: Record<string, string | string[]>
	}

	const { t } = useI18n()
	const copyCode = useCodeCopy()
</script>

<template>
	<DocsLayout
		bind:nav="nav"
		bind:current="current"
		bind:toc="toc"
		bind:pager="pages"
		bind:editUrl="editUrl"
		bind:source="editPath"
		bind:i18n="i18n"
	>
		<ReferenceArticle
			if:when="written"
			bind:page="written"
			bind:searchTitle="searchTitle"
		/>
		<article
			if:when="page"
			class="prose symbol"
			data-pagefind-body
			bind:data-pagefind-meta="searchTitle"
			on:click="copyCode"
		>
			<nav
				class="crumbs"
				data-pagefind-ignore
				bind:aria-label="t('docs.reference.breadcrumb')"
			>
				<a bind:href="index">{t('docs.reference.title')}</a>
				<span aria-hidden="true">/</span>
				<a bind:href="page.group.href">{page.group.title}</a>
			</nav>
			<h1 class="title">
				<code>{page.name}</code>
			</h1>
			<p class="badges">
				<UIBadge tone="accent">{page.kindLabel}</UIBadge>
				<UIBadge if:when="page.since">{t('docs.reference.since', { version: page.since ?? '' })}</UIBadge>
				<UIBadge
					if:when="page.deprecated !== null"
					tone="neutral"
				>
					{t('docs.reference.deprecated')}
				</UIBadge>
				<UIBadge if:when="page.autoImport">{t('docs.reference.noImport')}</UIBadge>
			</p>
			<div
				if:when="page.deprecated !== null"
				class="note deprecation"
				role="note"
			>
				<strong>{t('docs.reference.deprecatedNote')}</strong>
				<div html="page.deprecated" />
			</div>
			<div
				class="description"
				html="page.description"
			/>
			<p
				if:when="page.autoImport"
				class="autoimport"
				html="page.autoImport"
			/>
			<div
				if:when="page.importCode"
				class="import"
				html="page.importCode"
			/>
			<p
				if:when="page.sourceUrl"
				class="source"
				data-pagefind-ignore
			>
				<a
					rel="noopener"
					bind:href="page.sourceUrl"
				>
					<svg
						viewBox="0 0 24 24"
						aria-hidden="true"
					>
						<path d="m8 8-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14" />
					</svg>
					{t('docs.reference.source')}
					<span class="path">{page.sourceLabel}</span>
				</a>
			</p>

			<section if:when="page.signatures.length > 0">
				<h2 id="firma">
					{page.signatureTitle}
					<a
						class="heading-anchor"
						href="#firma"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<div
					each:of="page.signatures"
					each:as="signature"
					class="signature"
				>
					<div
						if:when="signature.description"
						class="signature-description"
						html="signature.description"
					/>
					<div html="signature.code" />
				</div>
			</section>

			<section if:when="page.typeParameters.length > 0">
				<h2 id="parametros-de-tipo">
					{t('docs.reference.typeParameters')}
					<a
						class="heading-anchor"
						href="#parametros-de-tipo"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<dl class="parameters">
					<div
						each:of="page.typeParameters"
						each:as="parameter"
						each:key="parameter.name"
					>
						<dt>
							<code class="parameter-name">{parameter.name}</code>
							<code
								if:when="parameter.type"
								class="parameter-type"
								html="parameter.type"
							/>
						</dt>
						<dd html="parameter.description" />
					</div>
				</dl>
			</section>

			<section if:when="page.parameters.length > 0">
				<h2 id="parametros">
					{t('docs.reference.parameters')}
					<a
						class="heading-anchor"
						href="#parametros"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<dl class="parameters">
					<div
						each:of="page.parameters"
						each:as="parameter"
						each:key="parameter.name"
					>
						<dt>
							<code class="parameter-name">{parameter.name}</code>
							<span
								class="parameter-type"
								html="parameter.type"
							/>
							<span
								if:when="parameter.optional"
								class="optional"
							>
								{t('docs.reference.optional')}
							</span>
						</dt>
						<dd html="parameter.description" />
					</div>
				</dl>
			</section>

			<section if:when="page.returns">
				<h2 id="devuelve">
					{t('docs.reference.returns')}
					<a
						class="heading-anchor"
						href="#devuelve"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<dl class="parameters">
					<div>
						<dt>
							<span
								class="parameter-type"
								html="page.returns?.type ?? ''"
							/>
						</dt>
						<dd html="page.returns?.description ?? ''" />
					</div>
				</dl>
			</section>

			<section if:when="page.throws.length > 0">
				<h2 id="lanza">
					{t('docs.reference.throws')}
					<a
						class="heading-anchor"
						href="#lanza"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<dl class="parameters">
					<div
						each:of="page.throws"
						each:as="thrown"
					>
						<dt>
							<span
								class="parameter-type"
								html="thrown.type || '<code>Error</code>'"
							/>
						</dt>
						<dd html="thrown.description" />
					</div>
				</dl>
			</section>

			<section if:when="page.examples.length > 0">
				<h2 id="ejemplos">
					{t('docs.reference.examples', { count: page.examples.length })}
					<a
						class="heading-anchor"
						href="#ejemplos"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<div
					each:of="page.examples"
					each:as="example"
					class="example"
					html="example"
				/>
			</section>

			<section if:when="page.members.length > 0">
				<h2 id="miembros">
					{page.membersTitle}
					<a
						class="heading-anchor"
						href="#miembros"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<div
					each:of="page.members"
					each:as="member"
					each:key="member.id"
					class="member"
				>
					<h3 bind:id="member.id">
						<code>{member.name}</code>
						<a
							class="heading-anchor"
							data-pagefind-ignore
							bind:aria-label="t('docs.reference.anchor')"
							bind:href="'#' + member.id"
						>
							#
						</a>
					</h3>
					<p
						if:when="member.kind"
						class="member-meta"
						data-pagefind-ignore
					>
						<span>{member.kind}</span>
						<span
							each:of="member.flags"
							each:as="flag"
						>
							{flag}
						</span>
						<span
							if:when="member.since"
							class="since"
						>
							{t('docs.reference.sinceLower', { version: member.since ?? '' })}
						</span>
						<span
							if:when="member.deprecated !== null"
							class="obsolete"
						>
							{t('docs.reference.deprecatedLower')}
						</span>
					</p>
					<div
						class="member-signature"
						html="member.signature"
					/>
					<div
						if:when="member.deprecated"
						class="member-deprecation"
						html="member.deprecated ?? ''"
					/>
					<div
						class="member-description"
						html="member.description"
					/>
				</div>
			</section>

			<section if:when="page.see.length > 0 || page.related.length > 0">
				<h2 id="vease-tambien">
					{t('docs.reference.seeAlso')}
					<a
						class="heading-anchor"
						href="#vease-tambien"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<ul
					if:when="page.see.length > 0"
					class="see"
				>
					<li
						each:of="page.see"
						each:as="entry"
						html="entry"
					/>
				</ul>
				<ul
					if:when="page.related.length > 0"
					class="related"
					bind:aria-label="t('docs.reference.related')"
				>
					<li
						each:of="page.related"
						each:as="link"
						each:key="link.href"
					>
						<a bind:href="link.href">
							<code>{link.name}</code>
						</a>
					</li>
				</ul>
			</section>
		</article>
	</DocsLayout>
</template>

<style scoped>
	.symbol {
		max-width: 50rem;
	}
	.crumbs {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.4rem;
		margin: 0 0 0.9rem;
		color: var(--muted);
		font-size: 0.88rem;
	}
	.crumbs a {
		color: var(--ink-soft);
		text-decoration: none;
	}
	.crumbs a:hover {
		color: var(--accent-ink);
		text-decoration: underline;
	}
	.title {
		margin-bottom: 0.7rem;
		overflow-wrap: anywhere;
	}
	.title code {
		border: 0;
		background: none;
		padding: 0;
		font-weight: 600;
		font-size: 0.86em;
		letter-spacing: -0.01em;
	}
	.badges {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin: 0 0 1.4rem;
	}
	.note {
		margin: 0 0 1.4rem;
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: var(--surface);
		padding: 0.75rem 1rem;
	}
	.note :global(p) {
		display: inline;
		margin: 0;
	}
	.note div {
		display: inline;
	}
	.description :global(p:last-child) {
		margin-bottom: 1.1rem;
	}
	.autoimport {
		color: var(--ink-soft);
		font-size: 0.95rem;
	}
	.import :global(.code-block) {
		margin-bottom: 0.6rem;
	}
	.source {
		margin: 0;
		font-size: 0.88rem;
	}
	.source a {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem;
		color: var(--muted);
		text-decoration: none;
	}
	.source a:hover {
		color: var(--accent-ink);
	}
	.source .path {
		font: 0.8rem var(--font-mono);
	}
	svg {
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.8;
		width: 16px;
		height: 16px;
	}
	.signature + .signature {
		margin-top: 1.2rem;
	}
	.signature-description :global(p) {
		margin-bottom: 0.5rem;
		color: var(--ink-soft);
	}
	.parameters {
		margin: 0 0 1.2rem;
		border-top: 1px solid var(--line);
	}
	.parameters > div {
		border-bottom: 1px solid var(--line);
		padding: 0.7rem 0;
	}
	.parameters dt {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.35rem 0.6rem;
	}
	.parameters dd {
		margin: 0.3rem 0 0;
		color: var(--ink-soft);
	}
	.parameters dd :global(p) {
		margin: 0;
	}
	.parameters dd:empty {
		display: none;
	}
	.parameter-name {
		font-weight: 600;
	}
	.parameter-type :global(code),
	code.parameter-type {
		border-color: transparent;
		background: transparent;
		padding: 0;
		color: var(--ink-soft);
		font-size: 0.84rem;
	}
	.optional {
		border: 1px solid var(--line);
		border-radius: 999px;
		padding: 0 0.45rem;
		color: var(--muted);
		font: 500 0.72rem/1.5 var(--font-ui);
	}
	:global(.api-type-link) {
		color: var(--accent-ink);
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, var(--accent) 45%, transparent);
		text-underline-offset: 0.18em;
	}
	:global(.api-type-link:hover) {
		text-decoration-color: currentColor;
	}
	.example + .example {
		margin-top: 0.4rem;
	}
	.member {
		border-top: 1px solid var(--line);
		padding-top: 0.2rem;
	}
	.member h3 {
		margin: 1.1rem 0 0.2rem;
	}
	.member h3 code {
		border: 0;
		background: none;
		padding: 0;
		font-size: 0.92em;
	}
	.member-meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin: 0 0 0.6rem;
		color: var(--muted);
		font-size: 0.8rem;
	}
	.member-meta span + span::before {
		margin-right: 0.35rem;
		content: '·';
	}
	.member-meta .obsolete {
		color: var(--ink);
		font-weight: 560;
	}
	.member-signature :global(.shiki) {
		margin: 0 0 0.7rem;
		border: 1px solid var(--code-line);
		border-radius: var(--radius);
		background: var(--code-bg) !important;
		padding: 0.6rem 0.85rem;
		font-size: 0.82rem;
	}
	.member-deprecation {
		margin: 0 0 0.6rem;
		border: 1px solid var(--line);
		border-radius: var(--radius-s);
		background: var(--surface);
		padding: 0.45rem 0.75rem;
		color: var(--ink-soft);
		font-size: 0.92rem;
	}
	.member-deprecation :global(p) {
		margin: 0;
	}
	.member-description :global(p:last-child) {
		margin-bottom: 0.9rem;
	}
	.see {
		margin-bottom: 1rem;
	}
	.see :global(.api-see-source) {
		color: var(--muted);
		font-size: 0.85rem;
	}
	.see :global(.api-see-source)::before {
		margin-right: 0.3rem;
		content: '·';
	}
	.related {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.related li {
		margin: 0;
	}
	.related a {
		display: inline-block;
		transition: border-color 0.15s;
		border: 1px solid var(--line);
		border-radius: var(--radius-s);
		background: var(--surface);
		padding: 0.2rem 0.55rem;
		text-decoration: none;
	}
	.related a:hover {
		border-color: var(--accent);
	}
	.related code {
		border: 0;
		background: none;
		padding: 0;
		color: var(--accent-ink);
		font-size: 0.85rem;
	}
</style>
