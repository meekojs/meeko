<script server lang="ts">
	import type { PageLocale } from 'meeko-docs-content/locale'

	import { definePage } from '@meekojs/meeko/framework'

	import type { ApiIndexGroup, ApiKind } from '../../../../shared/types/api'
	import type { NavSection, Pager, TocEntry } from '../../../../shared/types/docs'

	import { readPage } from '../../../../server/content/db'

	export const route = definePage({
		render: 'ssr',
		layout: 'docs',
	})

	type ExportsPage = {
		readonly groups: readonly ApiIndexGroup[]
		readonly total: number
		readonly kinds: readonly { readonly kind: ApiKind; readonly label: string; readonly count: number }[]
		readonly nav: readonly NavSection[]
		readonly current: string
		readonly toc: readonly TocEntry[]
		readonly pages: Pager
		readonly index: string
		readonly source: string
		readonly editUrl: string
		readonly head: { readonly title: string; readonly description: string }
		readonly i18n?: PageLocale
	}
	const { locale } = await usePageI18n()
	const snapshot = await readPage<ExportsPage>('/docs/reference/exports', locale)
	if (!snapshot) notFound()
	export const { groups, total, kinds, index, head } = snapshot
	// Without it in the payload (a snapshot older than the languages), the page is the original.
	export const layoutProps = { nav: snapshot.nav, current: snapshot.current, toc: snapshot.toc, pager: snapshot.pages, editUrl: snapshot.editUrl, source: snapshot.source, i18n: snapshot.i18n ?? null }
</script>

<script lang="ts">
	export interface Props {
		params: Record<string, string>
		search: Record<string, string | string[]>
	}

	const { t } = useI18n()
	const query = signal('')
	const kind = signal('all')

	/** The groups with the symbols whose name contains the query and whose kind is chosen. */
	const visible = computed(() => {
		const text = query.value.trim().toLowerCase()
		const chosen = kind.value
		return groups
			.map((group) => ({
				...group,
				sections: group.sections
					.filter((section) => chosen === 'all' || section.kind === chosen)
					.map((section) => ({ ...section, items: section.items.filter((item) => !text || item.name.toLowerCase().includes(text)) }))
					.filter((section) => section.items.length > 0),
			}))
			.filter((group) => group.sections.length > 0)
	})
	const count = computed(() => visible.value.reduce((sum, group) => sum + group.sections.reduce((inner, section) => inner + section.items.length, 0), 0))

	function choose(value: string): void {
		kind.value = kind.value === value ? 'all' : value
	}
</script>

<template>
	<UIProse as="article">
		<h1>{t('docs.reference.allExports')}</h1>
		<p>{t('docs.exports.lead', { total })}</p>
		<p>
			<I18nT key="docs.exports.index">
				<snippet
					name="a"
					params="text"
				>
					<a bind:href="index">{text}</a>
				</snippet>
			</I18nT>
		</p>
		<div
			class="filters"
			role="search"
			data-pagefind-ignore
		>
			<UIField
				id="api-filter"
				bind:label="t('docs.exports.filter')"
			>
				<snippet
					name="default"
					params="id, describedBy"
				>
					<UIInput
						type="search"
						autocomplete="off"
						model="query"
						bind:spellcheck="false"
						bind:id="id"
						bind:describedBy="describedBy"
						bind:placeholder="t('docs.exports.placeholder')"
					/>
				</snippet>
			</UIField>
			<div
				class="kinds"
				role="group"
				bind:aria-label="t('docs.exports.kinds')"
			>
				<UIButton
					size="sm"
					bind:variant="kind.value === 'all' ? 'secondary' : 'outline'"
					bind:aria-pressed="String(kind.value === 'all')"
					on:click="() => choose('all')"
				>
					{t('docs.exports.all')}
				</UIButton>
				<UIButton
					each:of="kinds"
					each:as="entry"
					each:key="entry.kind"
					size="sm"
					bind:variant="kind.value === entry.kind ? 'secondary' : 'outline'"
					bind:aria-pressed="String(kind.value === entry.kind)"
					on:click="() => choose(entry.kind)"
				>
					{entry.label}
					<UIBadge>{entry.count}</UIBadge>
				</UIButton>
			</div>
			<p
				class="count"
				aria-live="polite"
			>
				{count.value === total ? t('docs.exports.total', { total }) : t('docs.exports.partial', { count: count.value, total })}
			</p>
		</div>
		<UIEmpty if:when="count.value === 0">
			<snippet name="title">
				<I18nT
					key="docs.exports.empty"
					bind:values="{ query: query.value.trim() }"
				>
					<snippet
						name="kbd"
						params="text"
					>
						<kbd>{text}</kbd>
					</snippet>
				</I18nT>
			</snippet>
		</UIEmpty>
		<section
			each:of="visible.value"
			each:as="group"
			each:key="group.id"
		>
			<h2 bind:id="group.id">
				<code if:when="group.specifier">{group.specifier}</code>
				<span if:when="!group.specifier">{group.title}</span>
			</h2>
			<p html="group.description" />
			<div
				each:of="group.sections"
				each:as="section"
				each:key="section.kind"
			>
				<h3>{section.title}</h3>
				<ul class="entries">
					<li
						each:of="section.items"
						each:as="item"
						each:key="item.href"
					>
						<a bind:href="item.href">
							<code>{item.name}</code>
						</a>
						<UIBadge if:when="item.deprecated">{t('docs.reference.deprecatedLower')}</UIBadge>
						<span
							class="summary"
							html="item.summary"
						/>
					</li>
				</ul>
			</div>
		</section>
	</UIProse>
</template>

<style scoped>
	.filters {
		display: grid;
		gap: var(--ui-space-3);
		margin-block: var(--ui-space-6) var(--ui-space-2);
		max-width: var(--ui-prose-measure);
	}
	.kinds {
		display: flex;
		flex-wrap: wrap;
		gap: var(--ui-space-1-5);
	}
	.count {
		margin: 0;
		font-size: var(--ui-font-size-md);
		font-variant-numeric: tabular-nums;
	}
	.entries {
		margin: 0;
		border-block-start: var(--ui-border-width) solid var(--ui-color-border);
		padding: 0;
		list-style: none;
	}
	.entries li {
		display: grid;
		grid-template-columns: minmax(11rem, 17rem) minmax(0, 1fr);
		align-items: baseline;
		gap: var(--ui-space-1) var(--ui-space-5);
		margin: 0;
		border-block-end: var(--ui-border-width) solid var(--ui-color-border);
		padding: var(--ui-space-2) 0;
	}
	.entries a {
		overflow-wrap: anywhere;
	}
	.summary {
		grid-row: 1;
		grid-column: 2;
		font-size: var(--ui-font-size-md);
	}
	@media (max-width: 40rem) {
		.entries li {
			grid-template-columns: minmax(0, 1fr);
		}
		.summary {
			grid-row: auto;
			grid-column: 1;
		}
	}
</style>
