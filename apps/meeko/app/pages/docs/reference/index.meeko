<script server lang="ts">
	import type { PageLocale } from 'meeko-docs-content/locale'

	import { definePage } from '@meekojs/meeko/framework'

	import type { NavSection, Pager, TocEntry } from '../../../../shared/types/docs'
	import type { ReferenceIndexGroup } from '../../../../shared/types/reference'

	import { readPage } from '../../../../server/content/db'

	export const route = definePage({ render: 'ssr' })

	type ReferenceIndexPage = {
		readonly groups: readonly ReferenceIndexGroup[]
		readonly total: number
		readonly modules: readonly { readonly id: string; readonly label: string; readonly href: string; readonly code: boolean }[]
		readonly exportsIcon: string
		/** `null` when the dashboard hides `/docs/reference/exports`: its card and its section leave. */
		readonly exportsLink: string | null
		readonly nav: readonly NavSection[]
		readonly current: string
		readonly toc: readonly TocEntry[]
		readonly pages: Pager
		readonly source: string
		readonly editUrl: string
		readonly head: { readonly title: string; readonly description: string }
		readonly i18n?: PageLocale
	}
	const { locale } = await usePageI18n()
	const snapshot = await readPage<ReferenceIndexPage>('/docs/reference', locale)
	if (!snapshot) notFound()
	export const { groups, total, modules, exportsIcon, exportsLink, nav, current, toc, pages, source, editUrl, head } = snapshot
	// Without it in the payload (a snapshot older than the languages), the page is the original.
	export const i18n = snapshot.i18n ?? null
</script>

<script lang="ts">
	export interface Props {
		params: Record<string, string>
		search: Record<string, string | string[]>
	}

	const { t } = useI18n()
</script>

<template>
	<DocsLayout
		bind:nav="nav"
		bind:current="current"
		bind:toc="toc"
		bind:pager="pages"
		bind:editUrl="editUrl"
		bind:source="source"
		bind:i18n="i18n"
	>
		<article class="prose reference-index">
			<h1>{t('docs.reference.title')}</h1>
			<p class="lead">{t('docs.reference.lead', { total })}</p>
			<ul
				class="cards"
				bind:aria-label="t('docs.reference.groups')"
			>
				<li
					each:of="groups"
					each:as="group"
					each:key="group.anchor"
				>
					<a
						class="card"
						bind:href="'#' + group.anchor"
					>
						<span class="card-head">
							<svg
								viewBox="0 0 16 16"
								aria-hidden="true"
							>
								<path bind:d="group.icon" />
							</svg>
							<span class="card-title">{group.title}</span>
							<span class="tally">{group.entries.length}</span>
						</span>
						<span
							class="card-text"
							html="group.description"
						/>
					</a>
				</li>
				<li if:when="exportsLink">
					<a
						class="card"
						bind:href="exportsLink"
					>
						<span class="card-head">
							<svg
								viewBox="0 0 16 16"
								aria-hidden="true"
							>
								<path bind:d="exportsIcon" />
							</svg>
							<span class="card-title">{t('docs.reference.allExports')}</span>
						</span>
						<span class="card-text">{t('docs.reference.allExportsCard')}</span>
					</a>
				</li>
			</ul>

			<section
				each:of="groups"
				each:as="group"
				each:key="group.anchor"
				class="group"
			>
				<h2 bind:id="group.anchor">
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path bind:d="group.icon" />
					</svg>
					{group.title}
					<a
						class="heading-anchor"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
						bind:href="'#' + group.anchor"
					>
						#
					</a>
				</h2>
				<p
					class="group-description"
					html="group.description"
				/>
				<ul class="entries">
					<li
						each:of="group.entries"
						each:as="entry"
						each:key="entry.name"
					>
						<a
							class="name"
							bind:href="entry.href"
						>
							<code>{entry.name}</code>
							<UIBadge
								if:when="entry.featured"
								tone="accent"
								class="featured"
							>
								{t('docs.layout.featured')}
							</UIBadge>
						</a>
						<span
							class="summary"
							html="entry.description"
						/>
					</li>
				</ul>
			</section>

			<section
				if:when="exportsLink && modules.length"
				class="group"
			>
				<h2 id="todos-los-exports">
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path bind:d="exportsIcon" />
					</svg>
					{t('docs.reference.allExports')}
					<a
						class="heading-anchor"
						href="#todos-los-exports"
						data-pagefind-ignore
						bind:aria-label="t('docs.reference.anchor')"
					>
						#
					</a>
				</h2>
				<p class="group-description">
					<I18nT key="docs.reference.modules">
						<snippet
							name="a"
							params="text"
						>
							<a bind:href="exportsLink">{text}</a>
						</snippet>
					</I18nT>
				</p>
				<ul class="modules">
					<li
						each:of="modules"
						each:as="module"
						each:key="module.id"
						bind:id="module.id"
					>
						<a bind:href="module.href">
							<code if:when="module.code">{module.label}</code>
							<span if:when="!module.code">{module.label}</span>
						</a>
					</li>
				</ul>
			</section>
		</article>
	</DocsLayout>
</template>

<style scoped>
	.reference-index {
		max-width: 60rem;
	}
	.lead {
		max-width: 46rem;
		color: var(--ink-soft);
		font-size: 1.05rem;
	}
	svg {
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
		width: 16px;
		height: 16px;
	}
	.cards {
		display: grid;
		max-width: none;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
		margin: 2rem 0 1rem;
		padding: 0;
		list-style: none;
	}
	.cards li {
		display: flex;
		margin: 0;
		padding: 0;
	}
	.card {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: 0.4rem;
		transition:
			border-color 0.15s,
			background-color 0.15s;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		background: var(--surface);
		padding: 0.85rem 0.95rem 0.95rem;
		color: var(--ink);
		text-decoration: none;
	}
	.card:hover {
		border-color: var(--line-strong);
		background: var(--surface-2);
	}
	.card-head {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		color: var(--ink-soft);
	}
	.card-title {
		flex: 1;
		color: var(--ink);
		font-weight: 560;
		font-size: 0.95rem;
	}
	.tally {
		color: var(--muted);
		font: 500 0.75rem var(--font-mono);
		font-variant-numeric: tabular-nums;
	}
	.card-text {
		color: var(--muted);
		font-size: 0.86rem;
		line-height: 1.5;
	}
	.card-text :global(code) {
		font-size: 0.86em;
	}
	.group h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.group h2 svg {
		width: 20px;
		height: 20px;
		color: var(--ink-soft);
	}
	.group-description {
		max-width: 46rem;
		color: var(--ink-soft);
	}
	.entries {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2rem;
		margin: 0;
		border-top: 1px solid var(--line);
		padding: 0;
		list-style: none;
	}
	.entries li {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin: 0;
		border-bottom: 1px solid var(--line);
		padding: 0.6rem 0;
	}
	.name {
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.name code {
		border: 0;
		background: none;
		padding: 0;
		color: var(--accent-ink);
		font-weight: 500;
		font-size: 0.88rem;
	}
	.name :global(.featured) {
		margin-left: 0.5rem;
		padding: 0 0.5rem;
		font-size: 0.7rem;
	}
	.name:hover code {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
	.summary {
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}
	.summary :global(code) {
		font-size: 0.84em;
	}
	.modules {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
		list-style: none;
		scroll-margin-top: calc(var(--header-height) + 1.25rem);
	}
	.modules li {
		margin: 0;
		padding: 0;
		scroll-margin-top: calc(var(--header-height) + 1.25rem);
	}
	.modules a {
		display: inline-block;
		transition: border-color 0.15s;
		border: 1px solid var(--line);
		border-radius: var(--radius-s);
		background: var(--surface);
		padding: 0.25rem 0.6rem;
		color: var(--ink-soft);
		font-size: 0.86rem;
		text-decoration: none;
	}
	.modules a:hover {
		border-color: var(--accent-line);
	}
	.modules code {
		background: none;
		padding: 0;
		color: var(--accent-ink);
	}
	.modules li:target a {
		border-color: var(--accent);
		background: var(--accent-soft);
	}
	@media (max-width: 1080px) {
		.cards {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 760px) {
		.entries {
			grid-template-columns: minmax(0, 1fr);
		}
	}
	@media (max-width: 520px) {
		.cards {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
