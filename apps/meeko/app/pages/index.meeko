							</snippet>
						</I18nT>
					</span>
					<span class="line tone-soft">{t('home.hero.titleLine2')}</span>
				</h1>
				<p class="lead">{t('home.hero.lead')}</p>
				<div class="actions">
					<UILink href="#inicio-rápido">{t('home.hero.start')}</UILink>
					<UIButton
						variant="outline"
						on:click="copyCommand"
					>
						<span
							class="prompt"
							aria-hidden="true"
						>
							$
						</span>
						<code>{command}</code>
						<UIBadge bind:tone="copied.value === 'done' ? 'success' : copied.value === 'error' ? 'danger' : 'neutral'">{copied.value === 'done' ? t('actions.copied') : copied.value === 'error' ? t('actions.copyFailed') : t('actions.copy')}</UIBadge>
					</UIButton>
				</div>
				<p class="meta">
					<span>v{version}</span>
					<span>{t('footer.license')}</span>
					<span>
						{t('home.hero.requires')}
						<code>pnpm add @meekojs/meeko</code>
					</span>
				</p>
			</div>
			<div class="hero-demo">
				<LiveDemo bind:source="demo" />
			</div>
		</UIContainer>
	</section>

