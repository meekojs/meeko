<script server lang="ts">
	import type { TrustedHtml } from '@meekojs/meeko'

	import { definePage } from '@meekojs/meeko/framework'

	import type { DemoSource } from '../../shared/types/demo'

	import { readPage } from '../../server/content/db'

	export const route = definePage({ render: 'ssr' })

	type HomePayload = {
		readonly demo: DemoSource
		readonly editorLines: { html: TrustedHtml; number: number; count: boolean }[]
		readonly command: string
		readonly quickStart: TrustedHtml
		readonly version: string
		readonly head: { title: string; description: string }
	}
	// `/en` is the English home page of the snapshot: its demo, quick start and head in English.
	const { locale } = await usePageI18n()
	const snapshot = await readPage<HomePayload>('/', locale)
	if (!snapshot) notFound()
	export const { demo, editorLines, command, quickStart, version, head } = snapshot
</script>

<script lang="ts">
	import { signal } from '@meekojs/meeko'
	import { copyText } from '@meekojs/ui/runtime'

	export interface Props {
		params: Record<string, string>
		search: Record<string, string | string[]>
	}

	const { localePath, t } = useI18n()

	// The guides in the language of the page (/en/docs/… in English); a section of a guide has its
	// own anchor in each language, so the catalog names it.
	const doc = (slug: string, anchor?: string): string => localePath(href('/docs/[slug]', { params: { slug } }) + (anchor ? `#${anchor}` : ''))
	const api = doc('api')
	const framework = doc('framework')
	const editors = doc('editors')
	const devtools = doc('devtools')
	const stability = doc('stability')
	const quickStartPage = doc('inicio-rapido')
	const reactivity = doc('api', t('home.flow.signalsAnchor'))
	const renderModes = doc('framework', t('home.flow.ssrAnchor'))
	const copied = signal<'idle' | 'done' | 'error'>('idle')
	let reset: ReturnType<typeof setTimeout> | undefined

	function copyCommand(): void {
		copyText(command).then(
			() => (copied.value = 'done'),
			() => (copied.value = 'error'),
		)
		if (reset !== undefined) clearTimeout(reset)
		reset = setTimeout(() => (copied.value = 'idle'), 1800)
	}
</script>

<template>
	<section
		class="hero"
		aria-labelledby="hero-title"
	>
		<UIContainer size="2xl">
