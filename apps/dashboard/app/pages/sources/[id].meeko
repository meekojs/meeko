<script
	server
	lang="ts"
>
	import { definePage } from '@meekojs/meeko/framework'
	import * as v from 'valibot'

	import { attempt } from '../../utils/errors'

	export const route = definePage({ params: v.object({ id: v.pipe(v.string(), v.regex(/^[1-9]\d{0,15}$/)) }), render: 'ssr' })

	const { params } = usePage()
	export const detail = await attempt(() => rpc.sources.get({ id: Number(params.id) }))
	if (!detail.ok && detail.failure.code === 'SOURCE_NOT_FOUND') notFound()
</script>

<script lang="ts">
	import type { Comparison, Conflict, RevisionRow } from '../../../shared/schemas/dashboard'
	import type { Failure } from '../../utils/errors'

	import { downloadText } from '../../utils/download'
	import { describeError } from '../../utils/errors'
	import { shortHash } from '../../utils/format'
	import { siteLabels } from '../../utils/labels'

	export interface Props {
		params: { id: string }
		search: Record<string, string | string[]>
	}

	const props = defineProps<Props>()

	const i18n = useI18n()
	const { t, localePath } = i18n
	const format = useFormat()
	const formatDate = format.date

	// The page remounts for another id: its initial value is enough.
	const sourceId = untrack(() => Number(props.params.id))

	const data = signal(detail.ok ? detail.data : null)
	const notice = signal('')
	const noticeLink = signal<{ href: string; label: string } | null>(null)
	const actionFailure = signal<Failure | null>(null)

	async function reload() {
		try {
			data.value = await rpc.sources.get({ id: sourceId })
		} catch (error) {
			actionFailure.value = describeError(error)
		}
	}

	function announce(text: string, link: { href: string; label: string } | null = null) {
		notice.value = text
		noticeLink.value = link
	}

	const revisionStatus = (status: RevisionRow['status']) => t(`source.status.${status}`)
	const pending = computed(() => data.value?.revisions.filter((revision) => revision.pending) ?? [])
	// A published revision after the snapshot, or the snapshot's one archived since (back to Git).
	const pendingPublished = computed(() => pending.value.filter((revision) => revision.status === 'published'))
	const pendingTitle = computed(() => {
		const published = pendingPublished.value
		if (published.length === 1) return t('source.pending.one', { id: published[0]?.id ?? 0 })
		if (published.length > 1) return t('source.pending.many', { count: published.length })
		return t('source.pending.archived', { id: pending.value[0]?.id ?? 0 })
	})
	const pendingText = computed(() => (pendingPublished.value.length ? t('source.pending.notIncluded') : t('source.pending.stillShown')))
	const editLabel = computed(() => (data.value?.source.publishedRevisionId ? t('source.newDraft') : t('source.edit')))
	const isTranslation = computed(() => data.value?.source.locale === 'en')
	const canTranslate = computed(() => data.value?.source.site === 'site' && data.value.source.file !== null && data.value.source.kind !== 'page')

	// Publish and archive: both ask first, because the next snapshot changes what the site shows.
	type Action = 'publish' | 'archive'
	const action = signal<{ kind: Action; revision: RevisionRow } | null>(null)
	const confirming = signal(false)
	const acting = signal(false)
	const confirmFailure = signal<Failure | null>(null)

	function ask(kind: Action, revision: RevisionRow) {
		action.value = { kind, revision }
		confirmFailure.value = null
		confirming.value = true
	}

	async function confirm() {
		const current = action.value
		if (!current) return
		acting.value = true
		confirmFailure.value = null
		try {
			if (current.kind === 'publish') {
				const revision = await rpc.revisions.publish({ id: current.revision.id })
				announce(t('source.notice.published', { id: revision.id }), { href: localePath('/snapshots'), label: t('source.publishDocs') })
			} else {
				const revision = await rpc.revisions.archive({ id: current.revision.id })
				announce(current.revision.status === 'published' ? t('source.notice.archivedPublished', { id: revision.id }) : t('source.notice.archived', { id: revision.id }), current.revision.status === 'published' ? { href: localePath('/snapshots'), label: t('source.publishDocs') } : null)
			}
			confirming.value = false
			await reload()
		} catch (error) {
			confirmFailure.value = describeError(error)
		} finally {
			acting.value = false
		}
	}

	async function exportMarkdown(revision: RevisionRow) {
		actionFailure.value = null
		try {
			const file = await rpc.revisions.export({ id: revision.id })
			downloadText(file.filename, file.markdown)
			announce(t('source.notice.exported', { filename: file.filename, id: file.revisionId, file: file.file }))
		} catch (error) {
			actionFailure.value = describeError(error)
		}
	}

	// Comparison of two sides: Git now or any revision.
	const sideOptions = computed(() => ['git', ...(data.value?.revisions.map((revision) => `r${revision.id}`) ?? [])])
	const sideLabel = (value: string) => (value === 'git' ? t('source.gitNow') : t('source.sideRevision', { id: value.slice(1), status: revisionStatus(data.value?.revisions.find((revision) => `r${revision.id}` === value)?.status ?? 'draft').toLocaleLowerCase(i18n.locale) }))
	const compared = signal<{ from: string; to: string } | null>(null)
	const fromSide = signal<string | null>('git')
	const toSide = signal<string | null>(data.value?.revisions[0] ? `r${data.value.revisions[0].id}` : null)
	const comparison = signal<Comparison | null>(null)
	const comparing = signal(false)
	const compareFailure = signal<Failure | null>(null)
	const side = (value: string) => (value === 'git' ? ({ kind: 'git' } as const) : ({ kind: 'revision', id: Number(value.slice(1)) } as const))

	async function compareSides() {
		if (!fromSide.value || !toSide.value) return
		comparing.value = true
		try {
			comparison.value = await rpc.revisions.compare({ sourceId, from: side(fromSide.value), to: side(toSide.value) })
			compared.value = { from: sideLabel(fromSide.value), to: sideLabel(toSide.value) }
			compareFailure.value = null
		} catch (error) {
			compareFailure.value = describeError(error)
		} finally {
			comparing.value = false
		}
	}

	// Conflict with Git: the three sides and, when trivial, a new draft with both changes.
	const conflict = signal<Conflict | null>(null)
	const conflictFailure = signal<Failure | null>(null)
	const loadingConflict = signal<number | null>(null)
	const merging = signal(false)
	const baseOrigin = (origin: 'commit' | 'import' | 'working-tree') => t(`source.origin.${origin === 'working-tree' ? 'workingTree' : origin}`)
	const conflictLead = computed(() => {
		const current = conflict.value
		if (!current) return ''
		if (current.state === 'missing') return t('source.conflict.missing')
		if (current.baseOrigin) return t('source.conflict.lead', { base: shortHash(current.baseHash), origin: baseOrigin(current.baseOrigin) + (current.baseCommit ? ' ' + current.baseCommit.slice(0, 10) : ''), git: shortHash(current.gitHash) })
		return t('source.conflict.noBase', { base: shortHash(current.baseHash) })
	})

	async function openConflict(revision: RevisionRow) {
		loadingConflict.value = revision.id
		try {
			conflict.value = await rpc.revisions.conflict({ id: revision.id })
			conflictFailure.value = null
		} catch (error) {
			conflictFailure.value = describeError(error)
		} finally {
			loadingConflict.value = null
		}
	}

	async function merge() {
		const current = conflict.value
		if (!current) return
		merging.value = true
		try {
			const draft = await rpc.revisions.merge({ id: current.revisionId, note: t('source.mergeNote', { id: current.revisionId }) })
			conflict.value = null
			announce(t('source.notice.merged', { id: draft.id, revision: current.revisionId }), { href: localePath(`/sources/${sourceId}/edit?revision=${draft.id}`), label: t('source.openDraft', { id: draft.id }) })
			await reload()
		} catch (error) {
			conflictFailure.value = describeError(error)
		} finally {
			merging.value = false
		}
	}

	const busyRow = computed(() => acting.value || merging.value)
</script>

<template>
	<DashPage
		bind:title="data.value ? data.value.source.title : t('source.fallbackTitle', { id: props.params.id })"
		bind:description="data.value ? siteLabels[data.value.source.site] + ' · ' + t(`locale.${data.value.source.locale}`) + ' · ' + t(`labels.kind.${data.value.source.kind}`) + ' · ' + data.value.source.path : t('source.fallbackDescription')"
	>
		<snippet name="actions">
			<UILink
				variant="ghost"
				bind:href="localePath('/sources')"
			>
				{t('source.allSources')}
			</UILink>
			<UILink
				if:when="canTranslate.value"
				variant="outline"
				bind:href="localePath('/translations/' + props.params.id)"
			>
				{isTranslation.value ? t('source.compareOriginal') : t('source.seeTranslation')}
			</UILink>
			<UILink
				if:when="data.value?.editable"
				bind:href="localePath('/sources/' + props.params.id + '/edit')"
			>
				{editLabel.value}
			</UILink>
		</snippet>
		<DashFailure
			if:when="!detail.ok"
			bind:failure="detail.failure"
		/>
		<div
			if:when="data.value"
			class="dash-stack"
		>
			<section
				class="dash-panel"
				aria-labelledby="source-heading"
			>
				<div class="dash-panel-head">
					<h2 id="source-heading">{t('source.heading')}</h2>
					<DashStateBadge
						bind:state="data.value?.source.state ?? null"
						bind:importStale="data.value?.source.importStale ?? false"
						bind:removed="data.value?.source.removedAt !== null"
					/>
				</div>
				<p
					if:when="data.value?.source.state"
					class="dash-section-lead"
				>
					{data.value?.source.state ? t(`labels.stateHelp.${data.value.source.state}`) : ''}
				</p>
				<dl class="dash-facts">
					<div>
						<dt>{t('source.facts.path')}</dt>
						<dd>
							<code>{data.value?.source.locale === 'en' ? '/en' + (data.value?.source.path === '/' ? '' : data.value?.source.path) : data.value?.source.path}</code>
						</dd>
					</div>
					<div>
						<dt>{t('source.facts.locale')}</dt>
						<dd>{data.value ? t(`locale.${data.value.source.locale}`) : ''}</dd>
					</div>
					<div>
						<dt>{t('source.facts.file')}</dt>
						<dd>
							<code if:when="data.value?.source.file">{data.value?.source.file}</code>
							<span
								if:when="!data.value?.source.file"
								class="dash-muted"
							>
								{t('source.facts.meekoFile')}
							</span>
						</dd>
					</div>
					<div>
						<dt>{t('source.facts.baseHash')}</dt>
						<dd>
							<code bind:title="data.value?.source.baseHash ?? undefined">{shortHash(data.value?.source.baseHash)}</code>
						</dd>
					</div>
					<div>
						<dt>{t('source.facts.gitHash')}</dt>
						<dd>
							<code bind:title="data.value?.gitHash ?? undefined">{shortHash(data.value?.gitHash)}</code>
						</dd>
					</div>
					<div>
						<dt>{t('source.facts.imported')}</dt>
						<dd>{formatDate(data.value?.source.importedAt)}</dd>
					</div>
					<div if:when="data.value?.source.removedAt">
						<dt>{t('source.facts.removed')}</dt>
						<dd>{formatDate(data.value?.source.removedAt)}</dd>
					</div>
					<div>
						<dt>{t('source.facts.published')}</dt>
						<dd>{data.value?.source.publishedRevisionId ? '#' + data.value.source.publishedRevisionId : t('source.facts.noPublished')}</dd>
					</div>
				</dl>
			</section>

			<div
				if:when="pending.value.length"
				class="dash-callout"
				role="note"
			>
				<p>
					<strong>{pendingTitle.value}</strong>
					{pendingText.value}
				</p>
				<UILink
					size="sm"
					variant="outline"
					bind:href="localePath('/snapshots')"
				>
					{t('source.publishDocs')}
				</UILink>
			</div>

			<p
				class="dash-notice"
				role="status"
				aria-live="polite"
			>
				{notice.value}
				<a
					if:when="notice.value && noticeLink.value"
					bind:href="noticeLink.value?.href"
				>
					{noticeLink.value?.label}
				</a>
			</p>
			<DashFailure
				if:when="actionFailure.value"
				bind:title="t('source.actionFailed')"
				bind:failure="actionFailure.value"
			/>

			<section
				id="revisiones"
				class="dash-panel"
				aria-labelledby="revisions-heading"
			>
				<div class="dash-panel-head">
					<h2 id="revisions-heading">{t('source.revisions')}</h2>
					<span class="dash-muted">{t('source.revisionCount', { count: data.value?.revisions.length ?? 0 })}</span>
				</div>
				<p
					if:when="!data.value?.revisions.length"
					class="dash-empty"
				>
					{data.value?.editable ? t('source.noRevisions.editable') : data.value?.source.file ? t('source.noRevisions.gone') : t('source.noRevisions.meeko')}
				</p>
				<div
					if:when="data.value?.revisions.length"
					class="dash-table-scroll"
				>
					<table class="dash-table dash-revisions">
						<caption class="dash-visually-hidden">{t('source.revisionsCaption')}</caption>
						<thead>
							<tr>
								<th scope="col">{t('source.columns.revision')}</th>
								<th scope="col">{t('source.columns.status')}</th>
								<th scope="col">{t('source.columns.author')}</th>
								<th scope="col">{t('source.columns.created')}</th>
								<th scope="col">{t('source.columns.published')}</th>
								<th scope="col">{t('source.columns.note')}</th>
								<th scope="col">
									<span class="dash-visually-hidden">{t('source.columns.actions')}</span>
								</th>
							</tr>
						</thead>
						<tbody>
							<tr
								each:of="data.value?.revisions ?? []"
								each:as="revision"
								each:key="revision.id"
							>
								<th scope="row">
									#{String(revision.id)}
									<code
										class="dash-revision-hash"
										bind:title="revision.baseHash ? t('source.writtenOn', { hash: revision.baseHash }) : undefined"
									>
										{shortHash(revision.baseHash)}
									</code>
								</th>
								<td>
									<span class="dash-badges">
										<UIBadge bind:tone="revision.status === 'published' ? 'accent' : 'neutral'">{revisionStatus(revision.status)}</UIBadge>
										<span
											if:when="revision.pending"
											bind:title="revision.status === 'archived' ? t('source.badges.archivedAfter') : t('source.badges.publishedAfter')"
										>
											<UIBadge tone="accent">{t('source.badges.noSnapshot')}</UIBadge>
										</span>
										<span
											if:when="revision.conflict"
											bind:title="t('source.badges.conflictHelp')"
										>
											<UIBadge tone="danger">{t('source.badges.conflict')}</UIBadge>
										</span>
									</span>
								</td>
								<td>{revision.author}</td>
								<td class="dash-nowrap">{formatDate(revision.createdAt)}</td>
								<td class="dash-nowrap">{formatDate(revision.publishedAt)}</td>
								<td>{revision.note ?? '—'}</td>
								<td>
									<span class="dash-row-actions">
										<UILink
											if:when="data.value?.editable"
											size="sm"
											variant="ghost"
											bind:href="localePath('/sources/' + props.params.id + '/edit?revision=' + revision.id)"
											bind:ariaLabel="revision.status === 'draft' ? t('source.row.editDraft', { id: revision.id }) : t('source.row.fromRevision', { id: revision.id })"
										>
											{revision.status === 'draft' ? t('source.edit') : t('source.row.startHere')}
										</UILink>
										<UIButton
											if:when="revision.status !== 'published'"
											size="sm"
											variant="outline"
											bind:disabled="busyRow.value"
											on:click="() => ask('publish', revision)"
										>
											{t('source.row.publish')}
											<span class="dash-visually-hidden">{t('source.row.theRevision', { id: revision.id })}</span>
										</UIButton>
										<UIButton
											if:when="revision.status !== 'archived'"
											size="sm"
											variant="ghost"
											bind:disabled="busyRow.value"
											on:click="() => ask('archive', revision)"
										>
											{t('source.row.archive')}
											<span class="dash-visually-hidden">{t('source.row.theRevision', { id: revision.id })}</span>
										</UIButton>
										<UIButton
											size="sm"
											variant="ghost"
											on:click="() => exportMarkdown(revision)"
										>
											<span class="dash-visually-hidden">{t('source.row.export', { id: revision.id })}</span>
											.md
										</UIButton>
										<UIButton
											if:when="revision.conflict"
											size="sm"
											variant="outline"
											bind:disabled="loadingConflict.value !== null"
											on:click="() => openConflict(revision)"
										>
											{loadingConflict.value === revision.id ? t('source.row.loading') : t('source.row.seeConflict')}
											<span class="dash-visually-hidden">{t('source.row.ofRevision', { id: revision.id })}</span>
										</UIButton>
									</span>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>

			<section
				if:when="conflict.value || conflictFailure.value"
				class="dash-panel"
				aria-labelledby="conflict-heading"
			>
				<div class="dash-panel-head">
					<h2 id="conflict-heading">{conflict.value ? t('source.conflict.title', { id: conflict.value.revisionId }) : t('source.badges.conflict')}</h2>
					<UIButton
						size="sm"
						variant="ghost"
						on:click="
							() => {
								conflict.value = null
								conflictFailure.value = null
							}
						"
					>
						{t('actions.close')}
					</UIButton>
				</div>
				<DashFailure
					if:when="conflictFailure.value"
					bind:title="t('source.conflict.failed')"
					bind:failure="conflictFailure.value"
				/>
				<div
					if:when="conflict.value"
					class="dash-stack"
				>
					<p class="dash-section-lead">
						{conflictLead.value}
					</p>
					<div
						if:when="conflict.value?.merge"
						class="dash-callout"
						bind:data-tone="conflict.value?.merge?.clean ? undefined : 'danger'"
					>
						<p if:when="conflict.value?.merge?.clean">
							<strong>{t('source.conflict.trivial')}</strong>
							{t('source.conflict.trivialText')}
						</p>
						<p if:when="!conflict.value?.merge?.clean">
							<strong>{t('source.conflict.zones', { count: conflict.value?.merge?.conflicts ?? 0 })}</strong>
							{t('source.conflict.manual')}
						</p>
						<form
							if:when="conflict.value?.merge?.clean"
							class="dash-inline-form"
							on:submit="
								(event) => {
									event.preventDefault()
									void merge()
								}
							"
						>
							<UIButton
								type="submit"
								bind:disabled="merging.value"
							>
								{merging.value ? t('source.conflict.creating') : t('source.conflict.merge')}
							</UIButton>
						</form>
					</div>
					<div class="dash-three-way">
						<section aria-labelledby="base-git-heading">
							<h3 id="base-git-heading">{t('source.conflict.baseGit')}</h3>
							<p class="dash-hint">{t('source.conflict.baseGitHint')}</p>
							<DashDiff
								bind:label="t('source.conflict.baseGitLabel')"
								bind:diff="conflict.value?.diffs.baseToGit ?? ''"
								bind:empty="conflict.value?.baseOrigin ? t('source.conflict.noChanges') : t('source.conflict.noBaseDiff')"
							/>
						</section>
						<section aria-labelledby="base-revision-heading">
							<h3 id="base-revision-heading">{t('source.conflict.baseRevision')}</h3>
							<p class="dash-hint">{t('source.conflict.baseRevisionHint')}</p>
							<DashDiff
								bind:label="t('source.conflict.baseRevisionLabel')"
								bind:diff="conflict.value?.diffs.baseToRevision ?? ''"
								bind:empty="conflict.value?.baseOrigin ? t('source.conflict.noChanges') : t('source.conflict.noBaseDiff')"
							/>
						</section>
						<section aria-labelledby="git-revision-heading">
							<h3 id="git-revision-heading">{t('source.conflict.gitRevision')}</h3>
							<p class="dash-hint">{t('source.conflict.gitRevisionHint')}</p>
							<DashDiff
								bind:label="t('source.conflict.gitRevisionLabel')"
								bind:diff="conflict.value?.diffs.gitToRevision ?? ''"
							/>
						</section>
					</div>
				</div>
			</section>

			<section
				if:when="data.value?.source.file && data.value?.revisions.length"
				class="dash-panel"
				aria-labelledby="compare-heading"
			>
				<div class="dash-panel-head">
					<h2 id="compare-heading">{t('source.compare.title')}</h2>
					<span
						if:when="comparison.value && !comparison.value.tooLarge"
						class="dash-diff-stat"
					>
						<span class="dash-add">+{String(comparison.value?.added ?? 0)}</span>
						<span class="dash-remove">−{String(comparison.value?.removed ?? 0)}</span>
					</span>
				</div>
				<form
					class="dash-filters"
					bind:aria-label="t('source.compare.label')"
					on:submit="
						(event) => {
							event.preventDefault()
							void compareSides()
						}
					"
				>
					<div class="dash-field">
						<label for="compare-from">{t('source.compare.from')}</label>
						<UISelect
							id="compare-from"
							model="fromSide"
							bind:options="sideOptions.value"
							bind:labelBy="sideLabel"
						/>
					</div>
					<div class="dash-field">
						<label for="compare-to">{t('source.compare.to')}</label>
						<UISelect
							id="compare-to"
							model="toSide"
							bind:options="sideOptions.value"
							bind:labelBy="sideLabel"
						/>
					</div>
					<UIButton
						type="submit"
						variant="secondary"
						bind:disabled="comparing.value || !fromSide.value || !toSide.value"
					>
						{comparing.value ? t('source.compare.running') : t('source.compare.submit')}
					</UIButton>
				</form>
				<DashFailure
					if:when="compareFailure.value"
					bind:title="t('source.compare.failed')"
					bind:failure="compareFailure.value"
				/>
				<p
					if:when="comparison.value?.tooLarge"
					class="dash-empty"
				>
					{t('source.compare.tooLarge')}
				</p>
				<DashDiff
					if:when="comparison.value && !comparison.value.tooLarge"
					bind:empty="t('source.compare.same')"
					bind:diff="comparison.value?.diff ?? ''"
					bind:label="t('source.compare.diffLabel', { from: compared.value?.from ?? '', to: compared.value?.to ?? '' })"
				/>
			</section>

			<section
				if:when="data.value?.source.file"
				class="dash-panel"
				aria-labelledby="diff-heading"
			>
				<div class="dash-panel-head">
					<h2 id="diff-heading">{t('source.gitDiff.title')}</h2>
					<span
						if:when="data.value?.diff"
						class="dash-diff-stat"
					>
						<span class="dash-add">+{String(data.value?.source.added ?? 0)}</span>
						<span class="dash-remove">−{String(data.value?.source.removed ?? 0)}</span>
					</span>
				</div>
				<DashDiff
					bind:label="t('source.gitDiff.label')"
					bind:diff="data.value?.diff ?? ''"
					bind:empty="data.value?.source.publishedRevisionId ? t('source.gitDiff.same') : t('source.gitDiff.none')"
				/>
			</section>
		</div>

		<UIModal
			model="confirming"
			bind:title="action.value ? (action.value.kind === 'publish' ? t('source.confirm.publishTitle', { id: action.value.revision.id }) : t('source.confirm.archiveTitle', { id: action.value.revision.id })) : ''"
			bind:description="action.value?.kind === 'publish' ? t('source.confirm.publishText') : action.value?.revision.status === 'published' ? t('source.confirm.archivePublishedText') : t('source.confirm.archiveText')"
		>
			<dl
				if:when="action.value"
				class="dash-facts"
			>
				<div>
					<dt>{t('source.columns.author')}</dt>
					<dd>{action.value?.revision.author}</dd>
				</div>
				<div>
					<dt>{t('source.columns.status')}</dt>
					<dd>{action.value ? revisionStatus(action.value.revision.status) : ''}</dd>
				</div>
				<div if:when="action.value?.kind === 'publish' && data.value?.source.publishedRevisionId">
					<dt>{t('source.confirm.replaces')}</dt>
					<dd>#{String(data.value?.source.publishedRevisionId)}</dd>
				</div>
				<div if:when="action.value?.revision.note">
					<dt>{t('source.columns.note')}</dt>
					<dd>{action.value?.revision.note}</dd>
				</div>
			</dl>
			<p
				if:when="action.value?.kind === 'publish' && action.value?.revision.conflict"
				class="dash-hint dash-editor-warning"
			>
				{t('source.confirm.conflictWarning')}
			</p>
			<DashFailure
				if:when="confirmFailure.value"
				bind:title="action.value?.kind === 'publish' ? t('source.confirm.notPublished') : t('source.confirm.notArchived')"
				bind:failure="confirmFailure.value"
			/>
			<snippet name="footer">
				<UIButton
					variant="ghost"
					on:click="() => (confirming.value = false)"
				>
					{t('actions.cancel')}
				</UIButton>
				<UIButton
					bind:disabled="acting.value"
					on:click="confirm"
				>
					{acting.value ? t('source.confirm.working') : action.value?.kind === 'publish' ? t('source.confirm.publish') : t('source.confirm.archive')}
				</UIButton>
			</snippet>
		</UIModal>
	</DashPage>
</template>
