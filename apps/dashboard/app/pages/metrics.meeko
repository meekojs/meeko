<script
	server
	lang="ts"
>
	import { definePage } from '@meekojs/meeko/framework'
	import * as v from 'valibot'

	import { attempt, failed } from '../utils/errors'
	import { defaultRange, rangeFailure } from '../utils/metrics'

	export const route = definePage({
		search: v.object({ site: v.optional(v.picklist(['site', 'ui', 'i18n'])), from: v.optional(v.string()), to: v.optional(v.string()) }),
		render: 'ssr',
	})

	const { search } = usePage()
	const range = defaultRange(search.from, search.to)
	const site = search.site ?? 'site'
	// A range of the URL that no reading accepts (`2026-99-99`, reversed) is an error state at once.
	const invalidRange = rangeFailure(site, range)
	export const initialSummary = invalidRange ? failed(invalidRange) : await attempt(() => rpc.metrics.get({ site, ...range }))
	export const initialComments = invalidRange ? failed(invalidRange) : await attempt(() => rpc.metrics.feedback.list({ site, ...range, status: 'pending' }))
</script>

<script lang="ts">
	import type { FeedbackCommentRow } from '../../shared/schemas/metrics'
	import type { Failure } from '../utils/errors'

	import { describeError } from '../utils/errors'
	import { formatDate, formatNumber, plural } from '../utils/format'
	import { siteLabels, sites } from '../utils/labels'
	import { defaultRange, formatRange, metricsHref, pageWithin, percent, presets, rangeFailure, todayUtc } from '../utils/metrics'

	export interface Props {
		params: Record<string, string>
		search: { site?: 'site' | 'ui' | 'i18n' | undefined; from?: string | undefined; to?: string | undefined }
	}

	const props = defineProps<Props>()

	// The page remounts for another web or range (links and the GET form): its initial values are enough.
	const site = untrack(() => props.search.site ?? 'site')
	const range = untrack(() => defaultRange(props.search.from, props.search.to))
	const invalidRange = rangeFailure(site, range)
	const navigation = useNavigation()
	const summary = initialSummary.ok ? initialSummary.data : null
	const summaryFailure: Failure | null = initialSummary.ok ? null : initialSummary.failure
	const notice = signal('')

	const tabs = sites.map((name) => ({ name, href: metricsHref(name, range), label: siteLabels[name] }))
	const presetLinks = presets.map((preset) => ({ ...preset, href: metricsHref(site, preset.range()), current: preset.matches(range) }))
	const answers = summary ? summary.totals.helpful + summary.totals.unhelpful : 0
	const hasViews = summary ? summary.totals.views > 0 : false

	// Comments ---------------------------------------------------------------------------------------

	const comments = signal(initialComments.ok ? initialComments.data : null)
	const commentsFailure = signal<Failure | null>(initialComments.ok ? null : initialComments.failure)
	const status = signal<'all' | 'pending' | 'reviewed'>('pending')
	const answer = signal<'all' | 'helpful' | 'unhelpful'>('all')
	const pathFilter = signal('')
	const page = signal(1)
	const loadingComments = signal(false)
	const actionFailure = signal<Failure | null>(null)
	let request = 0
	let timer: ReturnType<typeof setTimeout> | undefined

	const pages = computed(() => (comments.value ? Math.max(1, Math.ceil(comments.value.total / comments.value.pageSize)) : 1))
	const statusOptions = [
		{ value: 'pending', label: 'Pendientes' },
		{ value: 'reviewed', label: 'Revisados' },
		{ value: 'all', label: 'Todos' },
	] as const
	const answerOptions = [
		{ value: 'all', label: 'Todas' },
		{ value: 'unhelpful', label: 'No' },
		{ value: 'helpful', label: 'Sí' },
	] as const
	const commentsEmpty = computed(() => {
		if (pathFilter.value.trim() || answer.value !== 'all') return 'Ningún comentario coincide con los filtros.'
		if (status.value === 'pending') return 'No hay comentarios pendientes en este rango: todos están revisados.'
		if (status.value === 'reviewed') return 'Aún no has revisado ningún comentario de este rango.'
		return 'Nadie dejó un comentario en este rango.'
	})

	async function loadComments() {
		if (invalidRange) {
			commentsFailure.value = invalidRange
			return
		}
		const id = ++request
		loadingComments.value = true
		try {
			const list = await rpc.metrics.feedback.list({ site, ...range, status: status.value, answer: answer.value, path: pathFilter.value.trim(), page: page.value })
			if (id !== request) return
			// After any mutation (reviewing, reopening or deleting a row that leaves the list) the page
			// may start past the new total: show the last page that exists instead of an empty one.
			const within = pageWithin(list.page, list.total, list.pageSize)
			if (within !== list.page && list.items.length === 0) {
				page.value = within
				return await loadComments()
			}
			comments.value = list
			commentsFailure.value = null
		} catch (error) {
			if (id === request) commentsFailure.value = describeError(error)
		} finally {
			if (id === request) loadingComments.value = false
		}
	}

	function filter(change: () => void) {
		change()
		page.value = 1
		void loadComments()
	}

	/** The path filter waits until the typing stops. */
	function onPathInput(event: Event) {
		pathFilter.value = (event.currentTarget as HTMLInputElement).value
		if (timer !== undefined) clearTimeout(timer)
		timer = setTimeout(() => filter(() => {}), 300)
	}

	function goTo(next: number) {
		page.value = Math.min(pages.value, Math.max(1, next))
		void loadComments()
		document.getElementById('comments-heading')?.focus()
	}

	async function toggleReviewed(item: FeedbackCommentRow) {
		actionFailure.value = null
		try {
			const updated = await rpc.metrics.feedback.review({ id: item.id, reviewed: item.reviewedAt === null })
			await loadComments()
			notice.value = updated.reviewedAt ? `Comentario sobre ${updated.path} marcado como revisado.` : `Comentario sobre ${updated.path} de nuevo pendiente.`
		} catch (error) {
			actionFailure.value = describeError(error)
		}
	}

	// Deletion asks first: it cannot be undone.
	const deleting = signal<FeedbackCommentRow | null>(null)
	const confirming = signal(false)
	const answering = signal(false)
	const deleteFailure = signal<Failure | null>(null)

	function askDelete(item: FeedbackCommentRow) {
		deleting.value = item
		deleteFailure.value = null
		confirming.value = true
	}

	async function confirmDelete() {
		const item = deleting.value
		if (!item) return
		answering.value = true
		try {
			await rpc.metrics.feedback.delete({ id: item.id })
			await loadComments()
			notice.value = `Comentario sobre ${item.path} borrado.`
			// The native dialog gives the focus back to its trigger, which left with the row.
			const dialog = document.querySelector('dialog[open]')
			if (dialog) dialog.addEventListener('close', () => requestAnimationFrame(() => document.getElementById('comments-heading')?.focus()), { once: true })
			confirming.value = false
		} catch (error) {
			deleteFailure.value = describeError(error)
		} finally {
			answering.value = false
		}
	}

	onMounted(() => () => {
		if (timer !== undefined) clearTimeout(timer)
	})
</script>

<template>
	<DashPage
		title="Métricas"
		description="Vistas, búsquedas y respuestas a «¿Te sirvió?» de cada web, por día UTC. Sin cookies ni datos de los lectores."
	>
		<nav
			class="dash-tabs"
			aria-label="Web"
		>
			<a
				each:of="tabs"
				each:as="tab"
				each:key="tab.name"
				bind:href="tab.href"
				bind:aria-current="tab.name === site ? 'page' : undefined"
			>
				{tab.label}
			</a>
		</nav>

		<div class="metrics-filters">
			<nav
				class="metrics-presets"
				aria-label="Rango de fechas"
			>
				<a
					each:of="presetLinks"
					each:as="preset"
					each:key="preset.label"
					bind:href="preset.href"
					bind:aria-current="preset.current ? 'true' : undefined"
				>
					{preset.label}
				</a>
			</nav>
			<form
				class="metrics-range"
				method="get"
				action="/metrics"
			>
				<input
					type="hidden"
					name="site"
					bind:value="site"
				/>
				<div class="dash-field">
					<label for="metrics-from">Desde</label>
					<input
						id="metrics-from"
						class="meeko-ui-input"
						type="date"
						name="from"
						required
						bind:value="range.from"
						bind:max="todayUtc()"
					/>
				</div>
				<div class="dash-field">
					<label for="metrics-to">Hasta</label>
					<input
						id="metrics-to"
						class="meeko-ui-input"
						type="date"
						name="to"
						required
						bind:value="range.to"
						bind:max="todayUtc()"
					/>
				</div>
				<UIButton
					type="submit"
					variant="outline"
				>
					Aplicar
				</UIButton>
			</form>
		</div>

		<p
			class="dash-notice"
			role="status"
			aria-live="polite"
		>
			{notice.value}
		</p>

		<DashFailure
			if:when="summaryFailure"
			title="No se pudieron cargar las métricas"
			bind:failure="summaryFailure!"
		/>

		<div
			if:when="summary"
			class="dash-stack metrics-body"
			bind:aria-busy="navigation.pending.value ? 'true' : undefined"
		>
			<section
				class="dash-strip"
				aria-label="Totales del rango"
			>
				<div class="dash-strip-item">
					<h2>Vistas</h2>
					<p class="metrics-total">{formatNumber(summary?.totals.views ?? 0)}</p>
					<p class="dash-muted">{formatRange(range)}</p>
				</div>
				<div class="dash-strip-item">
					<h2>Búsquedas</h2>
					<p class="metrics-total">{formatNumber(summary?.totals.searches ?? 0)}</p>
					<p class="dash-muted">{summary?.totals.emptySearches ? plural(summary.totals.emptySearches, 'sin resultados', 'sin resultados') : 'Todas con resultados'}</p>
				</div>
				<div class="dash-strip-item">
					<h2>¿Te sirvió?</h2>
					<p class="metrics-total">{answers ? percent((summary?.totals.helpful ?? 0) / answers) + ' sí' : '—'}</p>
					<p class="dash-muted">{answers ? plural(answers, 'respuesta', 'respuestas') + ': ' + formatNumber(summary?.totals.helpful ?? 0) + ' sí, ' + formatNumber(summary?.totals.unhelpful ?? 0) + ' no' : 'Sin respuestas'}</p>
				</div>
			</section>

			<section
				class="dash-panel"
				aria-labelledby="views-heading"
			>
				<div class="dash-panel-head">
					<h2 id="views-heading">Vistas por día</h2>
					<span class="dash-muted">{siteLabels[site]} · {formatRange(range)}</span>
				</div>
				<p
					if:when="!hasViews"
					class="dash-empty"
				>
					Ninguna vista en este rango. Las webs cuentan una vista por página mostrada cuando tienen DATABASE_URL y DOCS_METRICS no está en off.
				</p>
				<DashViewsChart
					if:when="hasViews"
					bind:days="summary?.daily ?? []"
					bind:label="'Vistas por día de ' + siteLabels[site] + ', ' + formatRange(range)"
				/>
			</section>

			<div class="metrics-grid">
				<section
					class="dash-panel"
					aria-labelledby="pages-heading"
				>
					<div class="dash-panel-head">
						<h2 id="pages-heading">Páginas más vistas</h2>
						<span class="dash-muted">Las 20 primeras</span>
					</div>
					<p
						if:when="!summary?.topPages.length"
						class="dash-empty"
					>
						Ninguna página vista en este rango.
					</p>
					<ol
						if:when="summary?.topPages.length"
						class="metrics-ranking"
					>
						<li
							each:of="summary?.topPages ?? []"
							each:as="row"
							each:key="row.path"
						>
							<code>{row.path}</code>
							<span
								class="metrics-meter"
								aria-hidden="true"
							>
								<span bind:style="'width: ' + (row.views / (summary?.topPages[0]?.views || 1)) * 100 + '%'" />
							</span>
							<span class="dash-num">{formatNumber(row.views)}</span>
						</li>
					</ol>
				</section>

				<section
					class="dash-panel"
					aria-labelledby="searches-heading"
				>
					<div class="dash-panel-head">
						<h2 id="searches-heading">Búsquedas más frecuentes</h2>
						<span class="dash-muted">Consultas normalizadas</span>
					</div>
					<p
						if:when="!summary?.topSearches.length"
						class="dash-empty"
					>
						Nadie buscó en este rango.
					</p>
					<div
						if:when="summary?.topSearches.length"
						class="dash-table-scroll"
					>
						<table class="metrics-table">
							<caption class="dash-visually-hidden">Búsquedas más frecuentes de {siteLabels[site]}</caption>
							<thead>
								<tr>
									<th scope="col">Consulta</th>
									<th
										scope="col"
										class="dash-num"
									>
										Veces
									</th>
									<th
										scope="col"
										class="dash-num"
									>
										Resultados
									</th>
								</tr>
							</thead>
							<tbody>
								<tr
									each:of="summary?.topSearches ?? []"
									each:as="row"
									each:key="row.query"
								>
									<th scope="row">{row.query}</th>
									<td class="dash-num">{formatNumber(row.count)}</td>
									<td class="dash-num">
										<span
											if:when="row.results === 0"
											class="metrics-zero"
										>
											Ninguno
										</span>
										<span if:when="row.results > 0">{formatNumber(row.results)}</span>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				<section
					class="dash-panel"
					aria-labelledby="empty-heading"
				>
					<div class="dash-panel-head">
						<h2 id="empty-heading">Búsquedas sin resultados</h2>
						<span class="dash-muted">Lo que falta en la documentación</span>
					</div>
					<p
						if:when="!summary?.emptySearches.length"
						class="dash-empty"
					>
						Todas las búsquedas de este rango encontraron algo.
					</p>
					<ol
						if:when="summary?.emptySearches.length"
						class="metrics-ranking"
					>
						<li
							each:of="summary?.emptySearches ?? []"
							each:as="row"
							each:key="row.query"
						>
							<span class="metrics-query">{row.query}</span>
							<span
								class="metrics-meter"
								aria-hidden="true"
							>
								<span bind:style="'width: ' + (row.count / (summary?.emptySearches[0]?.count || 1)) * 100 + '%'" />
							</span>
							<span class="dash-num">{plural(row.count, 'vez', 'veces')}</span>
						</li>
					</ol>
				</section>

				<section
					class="dash-panel"
					aria-labelledby="helpful-heading"
				>
					<div class="dash-panel-head">
						<h2 id="helpful-heading">¿Te sirvió? por página</h2>
						<span class="dash-muted">Primero las más respondidas</span>
					</div>
					<p
						if:when="!summary?.feedback.length"
						class="dash-empty"
					>
						Ninguna respuesta en este rango.
					</p>
					<div
						if:when="summary?.feedback.length"
						class="dash-table-scroll"
					>
						<table class="metrics-table">
							<caption class="dash-visually-hidden">Respuestas a «¿Te sirvió?» por página de {siteLabels[site]}</caption>
							<thead>
								<tr>
									<th scope="col">Página</th>
									<th scope="col">Sí</th>
									<th
										scope="col"
										class="dash-num"
									>
										Respuestas
									</th>
									<th
										scope="col"
										class="dash-num"
									>
										Comentarios
									</th>
								</tr>
							</thead>
							<tbody>
								<tr
									each:of="summary?.feedback ?? []"
									each:as="row"
									each:key="row.path"
								>
									<th scope="row">
										<code>{row.path}</code>
									</th>
									<td>
										<span class="metrics-ratio">
											<span
												class="metrics-ratio-bar"
												aria-hidden="true"
											>
												<span bind:style="'width: ' + row.ratio * 100 + '%'" />
											</span>
											<span class="dash-num">{percent(row.ratio)}</span>
										</span>
									</td>
									<td class="dash-num">{formatNumber(row.helpful)} sí · {formatNumber(row.unhelpful)} no</td>
									<td class="dash-num">{formatNumber(row.comments)}</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>
			</div>
		</div>

		<section
			class="dash-panel metrics-comments"
			aria-labelledby="comments-heading"
		>
			<div class="dash-panel-head">
				<h2
					id="comments-heading"
					tabindex="-1"
				>
					Comentarios
				</h2>
				<span class="dash-muted">{comments.value ? plural(comments.value.total, 'comentario', 'comentarios') : ''} · {formatRange(range)}</span>
			</div>
			<div class="dash-filters metrics-comment-filters">
				<fieldset class="dash-segmented">
					<legend>Estado</legend>
					<label
						each:of="statusOptions"
						each:as="option"
						each:key="option.value"
					>
						<input
							type="radio"
							name="comment-status"
							bind:value="option.value"
							bind:checked="status.value === option.value"
							on:change="() => filter(() => (status.value = option.value))"
						/>
						{option.label}
					</label>
				</fieldset>
				<fieldset class="dash-segmented">
					<legend>¿Te sirvió?</legend>
					<label
						each:of="answerOptions"
						each:as="option"
						each:key="option.value"
					>
						<input
							type="radio"
							name="comment-answer"
							bind:value="option.value"
							bind:checked="answer.value === option.value"
							on:change="() => filter(() => (answer.value = option.value))"
						/>
						{option.value === 'all' ? 'Sí y no' : 'Respondió ' + option.label.toLowerCase()}
					</label>
				</fieldset>
				<div class="dash-field dash-field-grow">
					<label for="comment-path">Página</label>
					<input
						id="comment-path"
						class="meeko-ui-input"
						type="search"
						placeholder="Filtra por ruta: /docs/signal…"
						bind:value="pathFilter.value"
						on:input="onPathInput"
					/>
				</div>
			</div>
			<DashFailure
				if:when="commentsFailure.value"
				title="No se pudieron cargar los comentarios"
				bind:failure="commentsFailure.value!"
			/>
			<DashFailure
				if:when="actionFailure.value"
				title="No se hizo el cambio"
				bind:failure="actionFailure.value!"
			/>
			<div
				class="metrics-comment-list"
				bind:aria-busy="loadingComments.value ? 'true' : undefined"
			>
				<p
					if:when="comments.value && !comments.value.items.length"
					class="dash-empty"
				>
					{commentsEmpty.value}
				</p>
				<ul
					if:when="comments.value?.items.length"
					class="metrics-comment-items"
				>
					<li
						each:of="comments.value?.items ?? []"
						each:as="item"
						each:key="item.id"
						bind:data-reviewed="item.reviewedAt ? 'true' : undefined"
					>
						<div class="metrics-comment-meta">
							<code>{item.path}</code>
							<UIBadge bind:tone="item.helpful ? 'neutral' : 'danger'">{item.helpful ? 'Le sirvió' : 'No le sirvió'}</UIBadge>
							<span class="dash-muted">{formatDate(item.createdAt)}</span>
							<span
								if:when="item.reviewedAt"
								class="dash-muted"
							>
								· Revisado {formatDate(item.reviewedAt)}{item.reviewedBy ? ' por ' + item.reviewedBy : ''}
							</span>
						</div>
						<p class="metrics-comment-text">{item.comment}</p>
						<div class="dash-row-actions">
							<UIButton
								size="sm"
								variant="outline"
								on:click="() => void toggleReviewed(item)"
							>
								{item.reviewedAt ? 'Volver a pendiente' : 'Marcar como revisado'}
								<span class="dash-visually-hidden">el comentario sobre {item.path} del {formatDate(item.createdAt)}</span>
							</UIButton>
							<UIButton
								size="sm"
								variant="ghost"
								on:click="() => askDelete(item)"
							>
								Borrar
								<span class="dash-visually-hidden">el comentario sobre {item.path} del {formatDate(item.createdAt)}</span>
							</UIButton>
						</div>
					</li>
				</ul>
				<nav
					if:when="pages.value > 1"
					class="metrics-pager"
					aria-label="Páginas de comentarios"
				>
					<UIButton
						size="sm"
						variant="outline"
						bind:disabled="page.value <= 1 || loadingComments.value"
						on:click="() => goTo(page.value - 1)"
					>
						Más recientes
					</UIButton>
					<span class="dash-muted">Página {page.value} de {pages.value}</span>
					<UIButton
						size="sm"
						variant="outline"
						bind:disabled="page.value >= pages.value || loadingComments.value"
						on:click="() => goTo(page.value + 1)"
					>
						Más antiguos
					</UIButton>
				</nav>
			</div>
		</section>

		<UIModal
			title="¿Borrar este comentario?"
			model="confirming"
			bind:description="deleting.value ? 'El comentario sobre ' + deleting.value.path + ' y su respuesta desaparecen de las métricas. No se puede deshacer; para conservarlo, márcalo como revisado.' : ''"
		>
			<blockquote
				if:when="deleting.value"
				class="metrics-quote"
			>
				{deleting.value?.comment}
			</blockquote>
			<DashFailure
				if:when="deleteFailure.value"
				title="No se borró"
				bind:failure="deleteFailure.value!"
			/>
			<snippet name="footer">
				<UIButton
					variant="ghost"
					on:click="() => (confirming.value = false)"
				>
					Cancelar
				</UIButton>
				<UIButton
					bind:disabled="answering.value"
					on:click="confirmDelete"
				>
					{answering.value ? 'Borrando…' : 'Borrar el comentario'}
				</UIButton>
			</snippet>
		</UIModal>
	</DashPage>
</template>

<style scoped>
	.metrics-filters {
