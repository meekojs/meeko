<script
	server
	lang="ts"
>
	import { definePage } from '@meekojs/meeko/framework'
	import * as v from 'valibot'

	import { attempt, failed } from '../utils/errors'
	import { defaultRange, metricsLocale, rangeFailure } from '../utils/metrics'

	export const route = definePage({
		search: v.object({ site: v.optional(v.picklist(['site', 'ui', 'i18n'])), lang: v.optional(v.string()), from: v.optional(v.string()), to: v.optional(v.string()) }),
		render: 'ssr',
	})

	const { search } = usePage()
	const range = defaultRange(search.from, search.to)
	const site = search.site ?? 'site'
	// ?lang=es|en limits every reading to that language of the web; without it, both together.
	const locale = metricsLocale(search.lang)
	const filter = locale ? { locale } : {}
	// A range of the URL that no reading accepts (`2026-99-99`, reversed) is an error state at once.
	const invalidRange = rangeFailure(site, range)
	export const initialSummary = invalidRange ? failed(invalidRange) : await attempt(() => rpc.metrics.get({ site, ...range, ...filter }))
	export const initialComments = invalidRange ? failed(invalidRange) : await attempt(() => rpc.metrics.feedback.list({ site, ...range, ...filter, status: 'pending' }))
</script>

<script lang="ts">
	import type { DocsLocale } from '../../shared/schemas/dashboard'
	import type { FeedbackCommentRow } from '../../shared/schemas/metrics'
	import type { Failure } from '../utils/errors'

	import { describeError } from '../utils/errors'
	import { siteLabels, sites } from '../utils/labels'
	import { defaultRange, formatRange, localePagePath, metricsHref, metricsLocale, pageWithin, presets, rangeFailure, todayUtc } from '../utils/metrics'

	export interface Props {
		params: Record<string, string>
		search: { site?: 'site' | 'ui' | 'i18n' | undefined; lang?: string | undefined; from?: string | undefined; to?: string | undefined }
	}

	const props = defineProps<Props>()

	const i18n = useI18n()
	const { t, localePath } = i18n
	const format = useFormat()
	const formatDate = format.date
	const formatNumber = format.number
	const percent = format.percent
	const rangeText = (value: { from: string; to: string }) => formatRange(value, i18n.locale, t('metrics.invalidRange'))

	// The page remounts for another web or range (links and the GET form): its initial values are enough.
	const site = untrack(() => props.search.site ?? 'site')
	const range = untrack(() => defaultRange(props.search.from, props.search.to))
	const locale = untrack(() => metricsLocale(props.search.lang))
	const invalidRange = rangeFailure(site, range)
	const navigation = useNavigation()
	const summary = initialSummary.ok ? initialSummary.data : null
	const summaryFailure: Failure | null = initialSummary.ok ? null : initialSummary.failure
	const notice = signal('')

	const tabs = sites.map((name) => ({ name, href: localePath(metricsHref(name, range, locale)), label: siteLabels[name] }))
	const presetLinks = presets.map((preset) => ({ ...preset, label: t('metrics.days', { days: preset.days }), href: localePath(metricsHref(site, preset.range(), locale)), current: preset.matches(range) }))
	const localeChoices: readonly (DocsLocale | null)[] = [null, 'es', 'en']
	const localeLinks = localeChoices.map((choice) => ({ key: choice ?? 'all', label: choice ? t(`locale.${choice}`) : t('metrics.allLanguages'), href: localePath(metricsHref(site, range, choice)), current: choice === locale }))
	const localeText = locale ? t(`locale.${locale}`) : t('metrics.allLanguages')
	const pagePath = (path: string, of: DocsLocale) => localePagePath(path, of)
	const answers = summary ? summary.totals.helpful + summary.totals.unhelpful : 0
	const hasViews = summary ? summary.totals.views > 0 : false

	// Comments ---------------------------------------------------------------------------------------

	const comments = signal(initialComments.ok ? initialComments.data : null)
	const commentsFailure = signal<Failure | null>(initialComments.ok ? null : initialComments.failure)
	const status = signal<'all' | 'pending' | 'reviewed'>('pending')
	const answer = signal<'all' | 'helpful' | 'unhelpful'>('all')
	const pathFilter = signal('')
	const page = signal(1)
	const loadingComments = signal(false)
	const actionFailure = signal<Failure | null>(null)
	let request = 0
	let timer: ReturnType<typeof setTimeout> | undefined

	const pages = computed(() => (comments.value ? Math.max(1, Math.ceil(comments.value.total / comments.value.pageSize)) : 1))
	const statusOptions = [
		{ value: 'pending', label: t('metrics.comments.pending') },
		{ value: 'reviewed', label: t('metrics.comments.reviewed') },
		{ value: 'all', label: t('filters.allMasculine') },
	] as const
	const answerOptions = [
		{ value: 'all', label: t('metrics.comments.bothAnswers') },
		{ value: 'unhelpful', label: t('metrics.comments.answeredNo') },
		{ value: 'helpful', label: t('metrics.comments.answeredYes') },
	] as const
	const commentsEmpty = computed(() => {
		if (pathFilter.value.trim() || answer.value !== 'all') return t('metrics.comments.emptyFiltered')
		if (status.value === 'pending') return t('metrics.comments.emptyPending')
		if (status.value === 'reviewed') return t('metrics.comments.emptyReviewed')
		return t('metrics.comments.empty')
	})

	async function loadComments() {
		if (invalidRange) {
			commentsFailure.value = invalidRange
			return
		}
		const id = ++request
		loadingComments.value = true
		try {
			const list = await rpc.metrics.feedback.list({ site, ...range, ...(locale ? { locale } : {}), status: status.value, answer: answer.value, path: pathFilter.value.trim(), page: page.value })
			if (id !== request) return
			// After any mutation (reviewing, reopening or deleting a row that leaves the list) the page
			// may start past the new total: show the last page that exists instead of an empty one.
			const within = pageWithin(list.page, list.total, list.pageSize)
			if (within !== list.page && list.items.length === 0) {
				page.value = within
				return await loadComments()
			}
			comments.value = list
			commentsFailure.value = null
		} catch (error) {
			if (id === request) commentsFailure.value = describeError(error)
		} finally {
			if (id === request) loadingComments.value = false
		}
	}

	function filter(change: () => void) {
		change()
		page.value = 1
		void loadComments()
	}

	/** The path filter waits until the typing stops. */
	function onPathInput(event: Event) {
		pathFilter.value = (event.currentTarget as HTMLInputElement).value
		if (timer !== undefined) clearTimeout(timer)
		timer = setTimeout(() => filter(() => {}), 300)
	}

	function goTo(next: number) {
		page.value = Math.min(pages.value, Math.max(1, next))
		void loadComments()
		document.getElementById('comments-heading')?.focus()
	}

	async function toggleReviewed(item: FeedbackCommentRow) {
		actionFailure.value = null
		try {
			const updated = await rpc.metrics.feedback.review({ id: item.id, reviewed: item.reviewedAt === null })
			await loadComments()
			notice.value = updated.reviewedAt ? t('metrics.comments.markedReviewed', { path: pagePath(updated.path, updated.locale) }) : t('metrics.comments.markedPending', { path: pagePath(updated.path, updated.locale) })
		} catch (error) {
			actionFailure.value = describeError(error)
		}
	}

	// Deletion asks first: it cannot be undone.
	const deleting = signal<FeedbackCommentRow | null>(null)
	const confirming = signal(false)
	const answering = signal(false)
	const deleteFailure = signal<Failure | null>(null)

	function askDelete(item: FeedbackCommentRow) {
		deleting.value = item
		deleteFailure.value = null
		confirming.value = true
	}

	async function confirmDelete() {
		const item = deleting.value
		if (!item) return
		answering.value = true
		try {
			await rpc.metrics.feedback.delete({ id: item.id })
			await loadComments()
			notice.value = t('metrics.comments.deleted', { path: pagePath(item.path, item.locale) })
			// The native dialog gives the focus back to its trigger, which left with the row.
			const dialog = document.querySelector('dialog[open]')
			if (dialog) dialog.addEventListener('close', () => requestAnimationFrame(() => document.getElementById('comments-heading')?.focus()), { once: true })
			confirming.value = false
		} catch (error) {
			deleteFailure.value = describeError(error)
		} finally {
			answering.value = false
		}
	}

	onMounted(() => () => {
		if (timer !== undefined) clearTimeout(timer)
	})
</script>

<template>
	<DashPage
		bind:title="t('metrics.title')"
		bind:description="t('metrics.description')"
	>
		<nav
			class="dash-tabs"
			bind:aria-label="t('metrics.site')"
		>
			<a
				each:of="tabs"
				each:as="tab"
				each:key="tab.name"
				bind:href="tab.href"
				bind:aria-current="tab.name === site ? 'page' : undefined"
			>
				{tab.label}
			</a>
		</nav>

		<div class="metrics-filters">
			<nav
				class="metrics-locales"
				bind:aria-label="t('metrics.locale')"
			>
				<a
					each:of="localeLinks"
					each:as="link"
					each:key="link.key"
					bind:href="link.href"
					bind:aria-current="link.current ? 'true' : undefined"
				>
					{link.label}
				</a>
			</nav>
			<nav
				class="metrics-presets"
				bind:aria-label="t('metrics.range')"
			>
				<a
					each:of="presetLinks"
					each:as="preset"
					each:key="preset.label"
					bind:href="preset.href"
					bind:aria-current="preset.current ? 'true' : undefined"
				>
					{preset.label}
				</a>
			</nav>
			<form
				class="metrics-range"
				method="get"
				bind:action="localePath('/metrics')"
			>
				<input
					type="hidden"
					name="site"
					bind:value="site"
				/>
				<input
					if:when="locale"
					type="hidden"
					name="lang"
					bind:value="locale"
				/>
				<div class="dash-field">
					<label for="metrics-from">{t('metrics.from')}</label>
					<input
						id="metrics-from"
						class="meeko-ui-input"
						type="date"
						name="from"
						required
						bind:value="range.from"
						bind:max="todayUtc()"
					/>
				</div>
				<div class="dash-field">
					<label for="metrics-to">{t('metrics.to')}</label>
					<input
						id="metrics-to"
						class="meeko-ui-input"
						type="date"
						name="to"
						required
						bind:value="range.to"
						bind:max="todayUtc()"
					/>
				</div>
				<UIButton
					type="submit"
					variant="outline"
				>
					{t('metrics.apply')}
				</UIButton>
			</form>
		</div>

		<p
			class="dash-notice"
			role="status"
			aria-live="polite"
		>
			{notice.value}
		</p>

		<DashFailure
			if:when="summaryFailure"
			bind:title="t('metrics.failed')"
			bind:failure="summaryFailure!"
		/>

		<div
			if:when="summary"
			class="dash-stack metrics-body"
			bind:aria-busy="navigation.pending.value ? 'true' : undefined"
		>
			<section
				class="dash-strip"
				bind:aria-label="t('metrics.totals')"
			>
				<div class="dash-strip-item">
					<h2>{t('metrics.views')}</h2>
					<p class="metrics-total">{formatNumber(summary?.totals.views ?? 0)}</p>
					<p class="dash-muted">{rangeText(range)} · {localeText}</p>
				</div>
				<div class="dash-strip-item">
					<h2>{t('metrics.searches')}</h2>
					<p class="metrics-total">{formatNumber(summary?.totals.searches ?? 0)}</p>
					<p class="dash-muted">{summary?.totals.emptySearches ? t('metrics.emptySearchCount', { count: summary.totals.emptySearches, total: formatNumber(summary.totals.emptySearches) }) : t('metrics.allFound')}</p>
				</div>
				<div class="dash-strip-item">
					<h2>{t('metrics.helpful')}</h2>
					<p class="metrics-total">{answers ? t('metrics.yesShare', { share: percent((summary?.totals.helpful ?? 0) / answers) }) : '—'}</p>
					<p class="dash-muted">{answers ? t('metrics.answers', { count: answers, total: formatNumber(answers), yes: formatNumber(summary?.totals.helpful ?? 0), no: formatNumber(summary?.totals.unhelpful ?? 0) }) : t('metrics.noAnswers')}</p>
				</div>
			</section>

			<section
				class="dash-panel"
				aria-labelledby="views-heading"
			>
				<div class="dash-panel-head">
					<h2 id="views-heading">{t('metrics.viewsByDay')}</h2>
					<span class="dash-muted">{siteLabels[site]} · {localeText} · {rangeText(range)}</span>
				</div>
				<p
					if:when="!hasViews"
					class="dash-empty"
				>
					{t('metrics.noViews')}
				</p>
				<DashViewsChart
					if:when="hasViews"
					bind:days="summary?.daily ?? []"
					bind:label="t('metrics.chartLabel', { site: siteLabels[site], range: rangeText(range) })"
				/>
			</section>

			<div class="metrics-grid">
				<section
					class="dash-panel"
					aria-labelledby="pages-heading"
				>
					<div class="dash-panel-head">
						<h2 id="pages-heading">{t('metrics.topPages')}</h2>
						<span class="dash-muted">{t('metrics.topPagesHint')}</span>
					</div>
					<p
						if:when="!summary?.topPages.length"
						class="dash-empty"
					>
						{t('metrics.noPages')}
					</p>
					<ol
						if:when="summary?.topPages.length"
						class="metrics-ranking"
					>
						<li
							each:of="summary?.topPages ?? []"
							each:as="row"
							each:key="row.locale + row.path"
						>
							<code>{pagePath(row.path, row.locale)}</code>
							<span
								class="metrics-meter"
								aria-hidden="true"
							>
								<span bind:style="'width: ' + (row.views / (summary?.topPages[0]?.views || 1)) * 100 + '%'" />
							</span>
							<span class="dash-num">{formatNumber(row.views)}</span>
						</li>
					</ol>
				</section>

				<section
					class="dash-panel"
					aria-labelledby="searches-heading"
				>
					<div class="dash-panel-head">
						<h2 id="searches-heading">{t('metrics.topSearches')}</h2>
						<span class="dash-muted">{t('metrics.normalized')}</span>
					</div>
					<p
						if:when="!summary?.topSearches.length"
						class="dash-empty"
					>
						{t('metrics.noSearches')}
					</p>
					<div
						if:when="summary?.topSearches.length"
						class="dash-table-scroll"
					>
						<table class="metrics-table">
							<caption class="dash-visually-hidden">{t('metrics.topSearchesCaption', { site: siteLabels[site] })}</caption>
							<thead>
								<tr>
									<th scope="col">{t('metrics.query')}</th>
									<th
										scope="col"
										class="dash-num"
									>
										{t('metrics.times')}
									</th>
									<th
										scope="col"
										class="dash-num"
									>
										{t('metrics.results')}
									</th>
								</tr>
							</thead>
							<tbody>
								<tr
									each:of="summary?.topSearches ?? []"
									each:as="row"
									each:key="row.query"
								>
									<th scope="row">{row.query}</th>
									<td class="dash-num">{formatNumber(row.count)}</td>
									<td class="dash-num">
										<span
											if:when="row.results === 0"
											class="metrics-zero"
										>
											{t('metrics.none')}
										</span>
										<span if:when="row.results > 0">{formatNumber(row.results)}</span>
									</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>

				<section
					class="dash-panel"
					aria-labelledby="empty-heading"
				>
					<div class="dash-panel-head">
						<h2 id="empty-heading">{t('metrics.emptySearches')}</h2>
						<span class="dash-muted">{t('metrics.emptySearchesHint')}</span>
					</div>
					<p
						if:when="!summary?.emptySearches.length"
						class="dash-empty"
					>
						{t('metrics.allFoundRange')}
					</p>
					<ol
						if:when="summary?.emptySearches.length"
						class="metrics-ranking"
					>
						<li
							each:of="summary?.emptySearches ?? []"
							each:as="row"
							each:key="row.query"
						>
							<span class="metrics-query">{row.query}</span>
							<span
								class="metrics-meter"
								aria-hidden="true"
							>
								<span bind:style="'width: ' + (row.count / (summary?.emptySearches[0]?.count || 1)) * 100 + '%'" />
							</span>
							<span class="dash-num">{t('metrics.timesCount', { count: row.count, total: formatNumber(row.count) })}</span>
						</li>
					</ol>
				</section>

				<section
					class="dash-panel"
					aria-labelledby="helpful-heading"
				>
					<div class="dash-panel-head">
						<h2 id="helpful-heading">{t('metrics.helpfulByPage')}</h2>
						<span class="dash-muted">{t('metrics.helpfulHint')}</span>
					</div>
					<p
						if:when="!summary?.feedback.length"
						class="dash-empty"
					>
						{t('metrics.noAnswersRange')}
					</p>
					<div
						if:when="summary?.feedback.length"
						class="dash-table-scroll"
					>
						<table class="metrics-table">
							<caption class="dash-visually-hidden">{t('metrics.helpfulCaption', { site: siteLabels[site] })}</caption>
							<thead>
								<tr>
									<th scope="col">{t('metrics.page')}</th>
									<th scope="col">{t('metrics.yes')}</th>
									<th
										scope="col"
										class="dash-num"
									>
										{t('metrics.answersColumn')}
									</th>
									<th
										scope="col"
										class="dash-num"
									>
										{t('metrics.commentsColumn')}
									</th>
								</tr>
							</thead>
							<tbody>
								<tr
									each:of="summary?.feedback ?? []"
									each:as="row"
									each:key="row.locale + row.path"
								>
									<th scope="row">
										<code>{pagePath(row.path, row.locale)}</code>
									</th>
									<td>
										<span class="metrics-ratio">
											<span
												class="metrics-ratio-bar"
												aria-hidden="true"
											>
												<span bind:style="'width: ' + row.ratio * 100 + '%'" />
											</span>
											<span class="dash-num">{percent(row.ratio)}</span>
										</span>
									</td>
									<td class="dash-num">{t('metrics.yesNo', { yes: formatNumber(row.helpful), no: formatNumber(row.unhelpful) })}</td>
									<td class="dash-num">{formatNumber(row.comments)}</td>
								</tr>
							</tbody>
						</table>
					</div>
				</section>
			</div>
		</div>

		<section
			class="dash-panel metrics-comments"
			aria-labelledby="comments-heading"
		>
			<div class="dash-panel-head">
				<h2
					id="comments-heading"
					tabindex="-1"
				>
					{t('metrics.commentsColumn')}
				</h2>
				<span class="dash-muted">{comments.value ? t('metrics.comments.count', { count: comments.value.total, total: formatNumber(comments.value.total) }) : ''} · {localeText} · {rangeText(range)}</span>
			</div>
			<div class="dash-filters metrics-comment-filters">
				<fieldset class="dash-segmented">
					<legend>{t('metrics.comments.status')}</legend>
					<label
						each:of="statusOptions"
						each:as="option"
						each:key="option.value"
					>
						<input
							type="radio"
							name="comment-status"
							bind:value="option.value"
							bind:checked="status.value === option.value"
							on:change="() => filter(() => (status.value = option.value))"
						/>
						{option.label}
					</label>
				</fieldset>
				<fieldset class="dash-segmented">
					<legend>{t('metrics.helpful')}</legend>
					<label
						each:of="answerOptions"
						each:as="option"
						each:key="option.value"
					>
						<input
							type="radio"
							name="comment-answer"
							bind:value="option.value"
							bind:checked="answer.value === option.value"
							on:change="() => filter(() => (answer.value = option.value))"
						/>
						{option.label}
					</label>
				</fieldset>
				<div class="dash-field dash-field-grow">
					<label for="comment-path">{t('metrics.page')}</label>
					<input
						id="comment-path"
						class="meeko-ui-input"
						type="search"
						bind:placeholder="t('metrics.comments.pathPlaceholder')"
						bind:value="pathFilter.value"
						on:input="onPathInput"
					/>
				</div>
			</div>
			<DashFailure
				if:when="commentsFailure.value"
				bind:title="t('metrics.comments.failed')"
				bind:failure="commentsFailure.value!"
			/>
			<DashFailure
				if:when="actionFailure.value"
				bind:title="t('metrics.comments.notChanged')"
				bind:failure="actionFailure.value!"
			/>
			<div
				class="metrics-comment-list"
				bind:aria-busy="loadingComments.value ? 'true' : undefined"
			>
				<p
					if:when="comments.value && !comments.value.items.length"
					class="dash-empty"
				>
					{commentsEmpty.value}
				</p>
				<ul
					if:when="comments.value?.items.length"
					class="metrics-comment-items"
				>
					<li
						each:of="comments.value?.items ?? []"
						each:as="item"
						each:key="item.id"
						bind:data-reviewed="item.reviewedAt ? 'true' : undefined"
					>
						<div class="metrics-comment-meta">
							<code>{pagePath(item.path, item.locale)}</code>
							<UIBadge bind:tone="item.helpful ? 'neutral' : 'danger'">{item.helpful ? t('metrics.comments.helped') : t('metrics.comments.notHelped')}</UIBadge>
							<span class="dash-muted">{formatDate(item.createdAt)}</span>
							<span
								if:when="item.reviewedAt"
								class="dash-muted"
							>
								· {item.reviewedBy ? t('metrics.comments.reviewedBy', { date: formatDate(item.reviewedAt), user: item.reviewedBy }) : t('metrics.comments.reviewedOn', { date: formatDate(item.reviewedAt) })}
							</span>
						</div>
						<p
							class="metrics-comment-text"
							bind:lang="item.locale"
						>
							{item.comment}
						</p>
						<div class="dash-row-actions">
							<UIButton
								size="sm"
								variant="outline"
								on:click="() => void toggleReviewed(item)"
							>
								{item.reviewedAt ? t('metrics.comments.reopen') : t('metrics.comments.review')}
								<span class="dash-visually-hidden">{t('metrics.comments.about', { path: pagePath(item.path, item.locale), date: formatDate(item.createdAt) })}</span>
							</UIButton>
							<UIButton
								size="sm"
								variant="ghost"
								on:click="() => askDelete(item)"
							>
								{t('metrics.comments.delete')}
								<span class="dash-visually-hidden">{t('metrics.comments.about', { path: pagePath(item.path, item.locale), date: formatDate(item.createdAt) })}</span>
							</UIButton>
						</div>
					</li>
				</ul>
				<nav
					if:when="pages.value > 1"
					class="metrics-pager"
					bind:aria-label="t('metrics.comments.pages')"
				>
					<UIButton
						size="sm"
						variant="outline"
						bind:disabled="page.value <= 1 || loadingComments.value"
						on:click="() => goTo(page.value - 1)"
					>
						{t('metrics.comments.newer')}
					</UIButton>
					<span class="dash-muted">{t('metrics.comments.pageOf', { page: page.value, pages: pages.value })}</span>
					<UIButton
						size="sm"
						variant="outline"
						bind:disabled="page.value >= pages.value || loadingComments.value"
						on:click="() => goTo(page.value + 1)"
					>
						{t('metrics.comments.older')}
					</UIButton>
				</nav>
			</div>
		</section>

		<UIModal
			model="confirming"
			bind:title="t('metrics.comments.deleteTitle')"
			bind:description="deleting.value ? t('metrics.comments.deleteText', { path: pagePath(deleting.value.path, deleting.value.locale) }) : ''"
		>
			<blockquote
				if:when="deleting.value"
				class="metrics-quote"
			>
				{deleting.value?.comment}
			</blockquote>
			<DashFailure
				if:when="deleteFailure.value"
				bind:title="t('metrics.comments.notDeleted')"
				bind:failure="deleteFailure.value!"
			/>
			<snippet name="footer">
				<UIButton
					variant="ghost"
					on:click="() => (confirming.value = false)"
				>
					{t('actions.cancel')}
				</UIButton>
				<UIButton
					bind:disabled="answering.value"
					on:click="confirmDelete"
				>
					{answering.value ? t('metrics.comments.deleting') : t('metrics.comments.deleteConfirm')}
				</UIButton>
			</snippet>
		</UIModal>
	</DashPage>
</template>

