<script
	server
	lang="ts"
>
	import { attempt } from '../utils/errors'

	export const overview = await attempt(() => rpc.overview.get({}))
</script>

<script lang="ts">
	import type { DivergenceState, SiteSummary, TranslationStatus } from '../../shared/schemas/dashboard'

	import { siteLabels, states } from '../utils/labels'

	const { t, localePath } = useI18n()
	const format = useFormat()

	const markdown = (summary: SiteSummary) => summary.kinds.guide + summary.kinds.reference
	const stateHref = (summary: SiteSummary, state: DivergenceState) => localePath(`/sources?site=${summary.site}&state=${state}`)
	const staleHref = (summary: SiteSummary) => localePath(`/sources?site=${summary.site}&state=importStale`)
	const attention = (summary: SiteSummary) => summary.states.edited + summary.states.conflict + summary.states.missing + summary.importStale
	const translationStates: readonly TranslationStatus[] = ['translated', 'outdated', 'missing']
	const translated = computed(() => (overview.ok && overview.data.translations.total ? overview.data.translations.translated / overview.data.translations.total : 0))
</script>

<template>
	<DashPage
		bind:title="t('overview.title')"
		bind:description="t('overview.description')"
	>
		<DashFailure
			if:when="!overview.ok"
			bind:failure="overview.failure"
		/>
		<div
			if:when="overview.ok"
			class="dash-stack"
		>
			<section
				class="dash-strip"
				bind:aria-label="t('overview.publication')"
			>
				<div class="dash-strip-item">
					<h2>{t('overview.activeSnapshot')}</h2>
					<p if:when="overview.data.activeSnapshot">
						<a
							class="dash-strong-link"
							bind:href="localePath('/snapshots')"
						>
							#{String(overview.data.activeSnapshot.id)}
						</a>
						· {t('overview.pages', { count: overview.data.activeSnapshot.pages, pages: format.number(overview.data.activeSnapshot.pages) })} · {format.date(overview.data.activeSnapshot.publishedAt)}
						<span class="dash-muted">{t('overview.by', { user: overview.data.activeSnapshot.publishedBy ?? t('overview.unknownUser') })}</span>
					</p>
					<p
						if:when="overview.data.activeSnapshot"
						class="dash-muted"
					>
						{t('overview.byLocale', { es: format.number(overview.data.activeSnapshot.pagesByLocale.es), en: format.number(overview.data.activeSnapshot.pagesByLocale.en) })}
					</p>
					<p
						if:when="!overview.data.activeSnapshot"
						class="dash-muted"
					>
						{t('overview.noSnapshot')}
						<a bind:href="localePath('/snapshots')">{t('overview.publishFirst')}</a>
					</p>
				</div>
				<div class="dash-strip-item">
					<h2>{t('overview.lastJob')}</h2>
					<p if:when="overview.data.jobs.content">
						{t(`labels.job.${overview.data.jobs.content.kind}`)}:
						<span>{t(`labels.jobStatus.${overview.data.jobs.content.status}`).toLocaleLowerCase()}</span>
						<span class="dash-muted">· {format.date(overview.data.jobs.content.startedAt)}</span>
					</p>
					<p
						if:when="!overview.data.jobs.content"
						class="dash-muted"
					>
						{t('overview.noJob')}
					</p>
				</div>
				<div class="dash-strip-item">
					<h2>{t('overview.savedSnapshots')}</h2>
					<p>{format.number(overview.data.snapshots)}</p>
				</div>
			</section>

			<section aria-labelledby="translations-heading">
				<div class="dash-panel-head">
					<h2
						id="translations-heading"
						class="dash-section-title"
					>
						{t('overview.translations')}
					</h2>
					<a bind:href="localePath('/translations')">{t('overview.seeTranslations')}</a>
				</div>
				<p class="dash-section-lead">{t('overview.translationsLead')}</p>
				<div class="dash-translation-meter">
					<div
						class="dash-translation-bar"
						role="img"
						bind:aria-label="t('overview.translationsShare', { share: format.percent(translated.value), translated: format.number(overview.data.translations.translated), total: format.number(overview.data.translations.total) })"
					>
						<span
							each:of="translationStates"
							each:as="status"
							each:key="status"
							bind:data-status="status"
							bind:style="'flex-grow: ' + overview.data.translations[status]"
						/>
					</div>
					<ul class="dash-translation-legend">
						<li
							each:of="translationStates"
							each:as="status"
							each:key="status"
							bind:data-status="status"
						>
							<a
								bind:href="localePath('/translations?status=' + status)"
								bind:title="t(`labels.translationHelp.${status}`)"
							>
								<span
									class="dash-dot"
									aria-hidden="true"
								/>
								<strong>{format.number(overview.data.translations[status])}</strong>
								{t(`labels.translation.${status}`)}
							</a>
						</li>
					</ul>
				</div>
			</section>

			<section aria-labelledby="sources-heading">
				<h2
					id="sources-heading"
					class="dash-section-title"
				>
					{t('overview.sourcesBySite')}
				</h2>
				<div class="dash-table-scroll">
					<table class="dash-table">
						<caption class="dash-visually-hidden">{t('overview.sourcesCaption')}</caption>
						<thead>
							<tr>
								<th scope="col">{t('overview.site')}</th>
								<th
									scope="col"
									class="dash-num"
								>
									{t('overview.guides')}
								</th>
								<th
									scope="col"
									class="dash-num"
								>
									{t('labels.kind.reference')}
								</th>
								<th
									scope="col"
									class="dash-num"
								>
									{t('overview.meekoPages')}
								</th>
								<th
									scope="col"
									class="dash-num"
								>
									{t('overview.total')}
								</th>
								<th
									scope="col"
									class="dash-num"
								>
									{t('overview.removed')}
								</th>
								<th scope="col">{t('overview.lastImport')}</th>
							</tr>
						</thead>
						<tbody>
							<tr
								each:of="overview.data.sites"
								each:as="summary"
								each:key="summary.site"
							>
								<th scope="row">
									<a bind:href="localePath('/sources?site=' + summary.site)">{siteLabels[summary.site]}</a>
								</th>
								<td class="dash-num">{format.number(summary.kinds.guide)}</td>
								<td class="dash-num">{format.number(summary.kinds.reference)}</td>
								<td class="dash-num">{format.number(summary.kinds.page)}</td>
								<td class="dash-num dash-strong">{format.number(summary.total)}</td>
								<td class="dash-num">{summary.removed ? format.number(summary.removed) : '—'}</td>
								<td>{format.date(summary.lastImportedAt)}</td>
							</tr>
						</tbody>
					</table>
				</div>
				<p
					if:when="overview.data.sites.every((summary) => summary.total === 0)"
					class="dash-empty"
				>
					{t('overview.noSources')}
					<a bind:href="localePath('/snapshots')">{t('nav.snapshots')}</a>
				</p>
			</section>

			<section aria-labelledby="divergence-heading">
				<h2
					id="divergence-heading"
					class="dash-section-title"
				>
					{t('overview.divergence')}
				</h2>
				<p class="dash-section-lead">{t('overview.divergenceLead')}</p>
				<div class="dash-table-scroll">
					<table class="dash-table">
						<caption class="dash-visually-hidden">{t('overview.divergenceCaption')}</caption>
						<thead>
							<tr>
								<th scope="col">{t('overview.site')}</th>
								<th
									each:of="states"
									each:as="state"
									each:key="state"
									scope="col"
									class="dash-num"
									bind:title="t(`labels.stateHelp.${state}`)"
								>
									{t(`labels.state.${state}`)}
								</th>
								<th
									scope="col"
									class="dash-num"
									bind:title="t('badge.importStaleHelp')"
								>
									{t('badge.importStale')}
								</th>
								<th scope="col">{t('overview.attention')}</th>
							</tr>
						</thead>
						<tbody>
							<tr
								each:of="overview.data.sites"
								each:as="summary"
								each:key="summary.site"
							>
								<th scope="row">{siteLabels[summary.site]}</th>
								<td
									each:of="states"
									each:as="state"
									each:key="state"
									class="dash-num"
									bind:data-state="summary.states[state] ? state : undefined"
								>
									<a
										if:when="markdown(summary) && summary.states[state]"
										bind:href="stateHref(summary, state)"
										bind:aria-label="t('overview.stateLink', { count: format.number(summary.states[state]), site: siteLabels[summary.site], state: t(`labels.state.${state}`) })"
									>
										{format.number(summary.states[state])}
									</a>
									<span
										if:when="markdown(summary) && !summary.states[state]"
										class="dash-zero"
									>
										0
									</span>
									<span
										if:when="!markdown(summary)"
										class="dash-zero"
										bind:aria-label="t('overview.notApplicable')"
									>
										—
									</span>
								</td>
								<td class="dash-num">
									<a
										if:when="summary.importStale"
										bind:href="staleHref(summary)"
									>
										{format.number(summary.importStale)}
									</a>
									<span
										if:when="!summary.importStale"
										class="dash-zero"
									>
										{markdown(summary) ? '0' : '—'}
									</span>
								</td>
								<td>
									<UIBadge
										if:when="attention(summary)"
										tone="accent"
									>
										{t('overview.toReview', { count: format.number(attention(summary)) })}
									</UIBadge>
									<span
										if:when="!attention(summary)"
										class="dash-muted"
									>
										{t('overview.upToDate')}
									</span>
								</td>
							</tr>
						</tbody>
					</table>
				</div>
			</section>
		</div>
	</DashPage>
</template>
