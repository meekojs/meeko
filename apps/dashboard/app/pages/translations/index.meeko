<script
	server
	lang="ts"
>
	import { attempt } from '../../utils/errors'

	const { search } = usePage()
	const first = (value: string | string[] | undefined) => (Array.isArray(value) ? value[0] : value) ?? ''

	// Every guide and written reference page of the site with its English translation; the screen
	// filters it, so the counters are always those of the whole list.
	export const translations = await attempt(() => rpc.translations.list({}))
	export const initial = { status: first(search.status), kind: first(search.kind), q: first(search.q) }
</script>

<script lang="ts">
	import type { TableColumn, UINavigationTabsItem } from '@meekojs/ui/runtime'

	import type { TranslationEntryRow, TranslationStatus } from '../../../shared/schemas/dashboard'

	import { translationTones } from '../../utils/labels'

	const i18n = useI18n()
	const { t, localePath } = i18n
	const format = useFormat()

	type All = 'all'
	type Kind = 'guide' | 'reference'
	const statuses: readonly TranslationStatus[] = ['translated', 'outdated', 'missing']
	const kinds: readonly Kind[] = ['guide', 'reference']
	const pick = <T extends string>(value: string, allowed: readonly T[]): T | All => (allowed.includes(value as T) ? (value as T) : 'all')

	/** A row of the table: an entry with the date of its translation and the id its actions open. */
	type Row = TranslationEntryRow & { readonly imported: string | null; readonly actions: number }
	const entries: readonly Row[] = (translations.ok ? translations.data.entries : []).map((entry) => ({ ...entry, imported: entry.translation?.importedAt ?? null, actions: entry.original.id }))
	const counts = translations.ok ? translations.data.counts : { translated: 0, outdated: 0, missing: 0, total: 0 }

	const status = signal<TranslationStatus | All>(pick(initial.status, statuses))
	const kind = signal<Kind | All | null>(pick(initial.kind, kinds))
	const query = signal(initial.q)

	const normalize = (text: string) =>
		text
			.normalize('NFD')
			.replace(/\p{Diacritic}/gu, '')
			.toLocaleLowerCase(i18n.locale)

	const rows = computed(() => {
		const text = normalize(query.value.trim())
		return entries.filter((entry) => (status.value === 'all' || entry.status === status.value) && (!kind.value || kind.value === 'all' || entry.original.kind === kind.value) && (!text || normalize(`${entry.original.title} ${entry.translation?.title ?? ''} ${entry.original.path} ${entry.file ?? ''}`).includes(text)))
	})

	// The status filter is a row of real links with the counters, so it also works without JavaScript.
	const statusLink = (value: TranslationStatus | All) => {
		const params = new URLSearchParams()
		if (value !== 'all') params.set('status', value)
		if (kind.value && kind.value !== 'all') params.set('kind', kind.value)
		if (query.value.trim()) params.set('q', query.value.trim())
		return localePath(`/translations${params.size ? `?${params}` : ''}`)
	}
	const filterValues: readonly (TranslationStatus | All)[] = ['all', ...statuses]
	const filterLabel = (value: TranslationStatus | All) => (value === 'all' ? t('translations.all') : t(`labels.translation.${value}`))
	const filters = computed<readonly UINavigationTabsItem[]>(() =>
		filterValues.map((value) => ({
			label: filterLabel(value),
			href: statusLink(value),
			current: status.value === value,
			badge: format.number(value === 'all' ? counts.total : counts[value]),
			...(value === 'all' ? {} : { badgeDot: true, badgeTone: translationTones[value] }),
		})),
	)
	function choose(event: MouseEvent, item: UINavigationTabsItem) {
		if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return
		const value = filterValues.find((candidate) => filterLabel(candidate) === item.label)
		if (!value) return
		event.preventDefault()
		status.value = value
	}

	// The address keeps the filters, so a reload or a shared link opens the same list.
	effect(() => {
		const params = new URLSearchParams()
		if (status.value !== 'all') params.set('status', status.value)
		if (kind.value && kind.value !== 'all') params.set('kind', kind.value)
		if (query.value.trim()) params.set('q', query.value.trim())
		if (typeof window === 'undefined') return
		const next = `${location.pathname}${params.size ? `?${params}` : ''}`
		if (next !== `${location.pathname}${location.search}`) history.replaceState(history.state, '', next)
	})

	const kindOptions: readonly (Kind | All)[] = ['all', ...kinds]
	const columns = [
		{ key: 'original', label: t('translations.columns.page') },
		{ key: 'status', label: t('translations.columns.status') },
		{ key: 'file', label: t('translations.columns.file') },
		{ key: 'imported', label: t('translations.columns.imported') },
		{ key: 'actions', label: t('translations.columns.actions'), numeric: true },
	] satisfies TableColumn<Row>[]
</script>

<template>
	<DashPage
		bind:title="t('translations.title')"
		bind:description="t('translations.description')"
	>
		<DashFailure
			if:when="!translations.ok"
			bind:failure="translations.failure"
		/>
		<div
			if:when="translations.ok"
			class="dash-stack"
		>
			<UINavigationTabs
				bind:items="filters.value"
				bind:label="t('translations.byStatus')"
				on:select="choose"
			/>

			<form
				class="dash-filters"
				role="search"
				bind:aria-label="t('translations.filter')"
				on:submit="(event) => event.preventDefault()"
			>
				<UIField
					id="translations-query"
					class="dash-grow"
					bind:label="t('actions.search')"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UIInput
							type="search"
							model="query"
							bind:id="id"
							bind:describedBy="describedBy"
							bind:placeholder="t('translations.placeholder')"
						/>
					</snippet>
				</UIField>
				<UIField
					id="translations-kind"
					bind:label="t('translations.columns.kind')"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UISelect
							model="kind"
							bind:id="id"
							bind:describedBy="describedBy"
							bind:placeholder="t('filters.allMasculine')"
							bind:options="kindOptions"
							bind:labelBy="(value) => (value === 'all' ? t('filters.allMasculine') : t(`labels.kind.${value}`))"
						/>
					</snippet>
				</UIField>
			</form>

			<div class="dash-tight">
				<p
					class="dash-meta"
					role="status"
					aria-live="polite"
				>
					{t('translations.count', { shown: format.number(rows.value.length), total: format.number(counts.total) })}
				</p>
				<UICard>
					<UITable
						rowKey="actions"
						bind:hideCaption="true"
						bind:caption="t('translations.caption')"
						bind:columns="columns"
						bind:rows="rows.value"
						bind:emptyText="counts.total ? t('translations.emptyFiltered') : t('translations.empty')"
					>
						<snippet
							name="cell"
							params="row, column"
						>
							<span
								if:when="column.key === 'original'"
								class="dash-cell"
							>
								<a bind:href="localePath('/translations/' + row.original.id)">{row.translation?.title ?? row.original.title}</a>
								<code>{row.original.path}</code>
							</span>
							<span
								if:when="column.key === 'status'"
								bind:title="t(`labels.translationHelp.${row.status}`)"
							>
								<UIBadge
									bind:dot="true"
									bind:tone="translationTones[row.status]"
								>
									{t(`labels.translation.${row.status}`)}
								</UIBadge>
							</span>
							<code if:when="column.key === 'file'">{row.file ?? '—'}</code>
							<span
								if:when="column.key === 'imported'"
								class="dash-nowrap"
							>
								{format.date(row.imported)}
							</span>
							<span
								if:when="column.key === 'actions'"
								class="dash-row-actions"
							>
								<UILink
									size="sm"
									variant="outline"
									bind:href="localePath('/translations/' + row.original.id)"
								>
									{t('translations.compare')}
									<span class="meeko-ui-sr-only">{row.original.path}</span>
								</UILink>
								<UILink
									if:when="row.translation && row.translation.removedAt === null"
									size="sm"
									variant="ghost"
									bind:href="localePath('/sources/' + row.translation?.id + '/edit')"
								>
									{t('translations.editShort')}
									<span class="meeko-ui-sr-only">{t('translations.editOf', { path: row.original.path })}</span>
								</UILink>
							</span>
						</snippet>
					</UITable>
				</UICard>
			</div>
		</div>
	</DashPage>
</template>
