			<p
				if:when="props.failure.detail"
				class="dash-failure-detail"
			>
				{issueText(i18n, props.failure.detail)}
			</p>
			<p class="dash-failure-code">
				{i18n.t('errors.code')}
				<code>{props.failure.code}</code>
			</p>
		</div>
