<script lang="ts">
	import type { Failure } from '../../utils/errors'

	import { failureMessage, issueText } from '../../utils/i18n'

	const props = defineProps<{ failure: Failure; title?: string }>()

	const i18n = useI18n()
</script>

<template>
	<div
		class="dash-failure"
		role="alert"
	>
		<svg
			viewBox="0 0 16 16"
