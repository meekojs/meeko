<script lang="ts">
	const props = defineProps<{ diff: string; label: string; empty?: string }>({ empty: 'Sin diferencias.' })

	type DiffKind = 'add' | 'context' | 'file' | 'hunk' | 'remove'

	/** The lines of a unified diff, each with its kind for the colors and the screen reader. */
	const diffKind = (text: string): DiffKind => (text.startsWith('@@') ? 'hunk' : text.startsWith('+++') || text.startsWith('---') ? 'file' : text.startsWith('+') ? 'add' : text.startsWith('-') ? 'remove' : 'context')

	const lines = computed(() =>
		props.diff
			.replace(/\n$/, '')
			.split('\n')
			.map((text, index) => ({ index, text, kind: diffKind(text) })),
	)

	const lineLabels: Record<DiffKind, string> = { add: 'Añadida: ', remove: 'Eliminada: ', hunk: '', file: '', context: '' }
</script>

<template>
	<p
		if:when="!props.diff"
		class="dash-empty"
	>
		{props.empty}
	</p>
	<pre
		if:when="props.diff"
		class="dash-diff"
		tabindex="0"
		bind:aria-label="props.label"
	><span each:of="lines.value" each:as="line" each:key="line.index" class="dash-diff-line" bind:data-kind="line.kind"><span class="dash-visually-hidden">{lineLabels[line.kind]}</span>{line.text}
</span></pre>
</template>
