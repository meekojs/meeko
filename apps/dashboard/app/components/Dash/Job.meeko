<script lang="ts">
	import type { Job } from '../../../shared/schemas/dashboard'

	import { jobSummary } from '../../utils/i18n'

	const props = defineProps<{ job: Job | null; empty: string }>()

	const i18n = useI18n()
	const { t } = i18n
	const format = useFormat()
	const id = useId()

	const duration = (job: Job) => {
		if (!job.finishedAt) return ''
		const seconds = (new Date(job.finishedAt).getTime() - new Date(job.startedAt).getTime()) / 1000
		return seconds < 60 ? t('job.seconds', { value: i18n.number(seconds, { minimumFractionDigits: 1, maximumFractionDigits: 1 }) }) : t('job.minutes', { minutes: Math.floor(seconds / 60), seconds: Math.round(seconds % 60) })
	}
	const summary = computed(() => (props.job ? jobSummary(i18n, props.job) : null))
</script>

<template>
	<section
		class="dash-job"
		bind:aria-labelledby="id + '-title'"
		bind:aria-busy="props.job?.status === 'running' ? 'true' : undefined"
	>
		<p
			if:when="!props.job"
			class="dash-empty"
		>
			{props.empty}
		</p>
		<div
			if:when="props.job"
			class="dash-job-body"
		>
			<header class="dash-job-header">
				<h3 bind:id="id + '-title'">{props.job ? t(`labels.job.${props.job.kind}`) : ''}</h3>
				<span
					class="dash-job-status"
					role="status"
					bind:data-status="props.job?.status"
				>
					<span
						class="dash-dot"
						aria-hidden="true"
					/>
					{props.job ? t(`labels.jobStatus.${props.job.status}`) : ''}
				</span>
			</header>
			<p class="dash-job-meta">
				{t('job.started', { date: format.date(props.job?.startedAt) })}
				<span if:when="props.job?.finishedAt">· {props.job ? duration(props.job) : ''}</span>
				<span if:when="props.job?.exitCode !== null && props.job?.exitCode !== undefined && props.job?.exitCode !== 0">· {t('job.exitCode', { code: String(props.job?.exitCode) })}</span>
			</p>
			<p
				if:when="summary.value"
				class="dash-job-summary"
			>
				{summary.value}
			</p>
			<pre
				class="dash-log"
				role="log"
				tabindex="0"
				bind:aria-label="props.job ? t('job.output', { job: t(`labels.job.${props.job.kind}`).toLocaleLowerCase(i18n.locale) }) : t('job.outputFallback')"
			><span if:when="props.job && props.job.dropped > 0" class="dash-log-dropped">{t('job.dropped', { count: props.job?.dropped ?? 0 })}
</span><span if:when="props.job?.output.length" lang="en">{props.job?.output.join('\n')}</span>{props.job?.output.length ? '' : t('job.noOutput')}</pre>
		</div>
	</section>
</template>
