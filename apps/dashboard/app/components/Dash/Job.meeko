<script lang="ts">
	import type { Job } from '../../../shared/schemas/dashboard'

	import { formatDate } from '../../utils/format'
	import { jobLabels } from '../../utils/labels'

	const props = defineProps<{ job: Job | null; empty: string }>()

	const statusLabels = { running: 'En curso', succeeded: 'Terminado', failed: 'Falló' } as const
	const id = useId()

	const duration = (job: Job) => {
		if (!job.finishedAt) return ''
		const seconds = (new Date(job.finishedAt).getTime() - new Date(job.startedAt).getTime()) / 1000
		return seconds < 60 ? `${seconds.toFixed(1)} s` : `${Math.floor(seconds / 60)} min ${Math.round(seconds % 60)} s`
	}
</script>

<template>
	<section
		class="dash-job"
		bind:aria-labelledby="id + '-title'"
		bind:aria-busy="props.job?.status === 'running' ? 'true' : undefined"
	>
		<p
			if:when="!props.job"
			class="dash-empty"
		>
			{props.empty}
		</p>
		<div
			if:when="props.job"
			class="dash-job-body"
		>
			<header class="dash-job-header">
				<h3 bind:id="id + '-title'">{props.job ? jobLabels[props.job.kind] : ''}</h3>
				<span
					class="dash-job-status"
					role="status"
					bind:data-status="props.job?.status"
				>
					<span
						class="dash-dot"
						aria-hidden="true"
					/>
					{props.job ? statusLabels[props.job.status] : ''}
				</span>
			</header>
			<p class="dash-job-meta">
				Iniciado {formatDate(props.job?.startedAt)}
				<span if:when="props.job?.finishedAt">· {props.job ? duration(props.job) : ''}</span>
				<span if:when="props.job?.exitCode !== null && props.job?.exitCode !== undefined && props.job?.exitCode !== 0">· código de salida {String(props.job?.exitCode)}</span>
			</p>
			<p
				if:when="props.job?.summary"
				class="dash-job-summary"
			>
				{props.job?.summary}
			</p>
			<pre
				class="dash-log"
				role="log"
				tabindex="0"
				bind:aria-label="'Salida de ' + (props.job ? jobLabels[props.job.kind].toLowerCase() : 'el trabajo')"
			><span if:when="props.job && props.job.dropped > 0" class="dash-log-dropped">… {String(props.job?.dropped)} líneas anteriores omitidas
</span>{props.job?.output.join('\n') || 'Sin salida todavía.'}</pre>
		</div>
	</section>
</template>
