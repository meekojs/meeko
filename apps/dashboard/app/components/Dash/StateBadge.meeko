<script lang="ts">
	import type { DivergenceState } from '../../../shared/schemas/dashboard'

	import { stateDescriptions, stateLabels, stateTones } from '../../utils/labels'

	const props = defineProps<{ state: DivergenceState | null; importStale?: boolean; removed?: boolean }>({ importStale: false, removed: false })
</script>

<template>
	<span class="dash-badges">
		<UIBadge
			if:when="props.removed"
			tone="danger"
		>
			Retirada
		</UIBadge>
		<span
			if:when="props.state"
			bind:title="props.state ? stateDescriptions[props.state] : undefined"
		>
			<UIBadge bind:tone="props.state ? stateTones[props.state] : 'neutral'">{props.state ? stateLabels[props.state] : ''}</UIBadge>
		</span>
		<span
			if:when="!props.state && !props.removed"
			class="dash-muted"
			title="Las páginas .meeko no guardan su texto en la base: se editan en el repositorio."
		>
			Sin Markdown
		</span>
		<span
			if:when="props.importStale"
			title="Git cambió desde la última importación: importa las fuentes de nuevo."
		>
			<UIBadge tone="accent">Importación desactualizada</UIBadge>
		</span>
	</span>
</template>
