<script lang="ts">
	import { stripLocale } from '@meekojs/i18n'

	import { emptyInput } from '../shared/schemas/dashboard'

	const route = useRoute()
	const i18n = useI18n()
	const { t } = i18n

	// 16 px icons drawn with the 1.4 px round stroke of the reference's group icons.
	const sections = [
		{ href: '/', key: 'overview', icon: 'M2.75 2.75h4v4h-4zM9.25 2.75h4v4h-4zM2.75 9.25h4v4h-4zM9.25 9.25h4v4h-4z' },
		{ href: '/sources', key: 'sources', icon: 'M4 1.75h5L12.25 5v9.25H4zM8.75 1.75V5.25h3.5M6.25 8.25h3.75M6.25 10.75h3.75' },
		{ href: '/translations', key: 'translations', icon: 'M1.75 3.25h6.5M5 1.75v1.5M3 3.25c.5 2.5 2 4.25 4.25 5.25M7 3.25c-.5 2.5-2 4.25-4.25 5.25M8.25 14.25l2.75-6.5 2.75 6.5M9.15 12.25h3.7' },
		{ href: '/moderation', key: 'moderation', icon: 'M3.25 14.25V2.25M3.25 2.75h8.5l-1.75 3 1.75 3h-8.5' },
		{ href: '/metrics', key: 'metrics', icon: 'M2.25 13.75h11.5M4 11.25V8.5M7 11.25V4.75M10 11.25V7M13 11.25V2.75' },
		{ href: '/health', key: 'health', icon: 'M1.75 8.25h2.75L6.25 4l3.5 8 1.75-3.75h2.75' },
		{ href: '/snapshots', key: 'snapshots', icon: 'M8 1.75 14.25 5 8 8.25 1.75 5zM1.75 8 8 11.25 14.25 8M1.75 11 8 14.25 14.25 11' },
	] as const

	// Under /en the route is /en/sources: the active section compares the path without the prefix.
	const path = computed(() => stripLocale(route.path.value, i18n.locales))
	const current = (href: string) => (href === '/' ? path.value === '/' : path.value === href || path.value.startsWith(href + '/'))

	// F5: who is logged in, for the header; `null` on the login page. Logging in and out loads a new
	// document, so it is read once per document.
	const session = await useRpcQuery('auth.session')
	const user = computed(() => session.data.value.user)
	// The logout is a native POST with the session's CSRF token, so it also works without JavaScript.
	const logout = useForm({ schema: emptyInput, initial: {}, action: '/api/auth/logout', submit: () => api.auth.logout.post() })

	// The language of the browser is only a suggestion: the address decides the language and nothing
	// redirects. It is read after hydration, so the server HTML and the first paint match.
	const suggestion = signal<string | undefined>(undefined)
	onMounted(() => {
		suggestion.value = i18n.suggestedLocale()
	})
	function stay() {
		i18n.rememberLocale(i18n.locale)
		suggestion.value = undefined
	}
</script>

<template>
	<UIApp>
		<a
			class="skip-link"
			href="#contenido"
		>
			{t('a11y.skip')}
		</a>
		<header class="dash-header">
			<a
				class="dash-brand"
				bind:href="i18n.localePath('/')"
				bind:aria-label="t('a11y.brand')"
			>
				<img
					src="/brand/meeko-logo.png"
					width="26"
					height="26"
					alt=""
				/>
				<span>
					Meeko
					<strong>Dashboard</strong>
				</span>
			</a>
			<nav
				if:when="user.value"
				class="dash-nav"
				bind:aria-label="t('a11y.sections')"
			>
				<a
					each:of="sections"
					each:as="section"
					each:key="section.href"
					bind:href="i18n.localePath(section.href)"
					bind:aria-current="current(section.href) ? 'page' : undefined"
				>
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path bind:d="section.icon" />
					</svg>
					<span>{t(`nav.${section.key}`)}</span>
				</a>
			</nav>
			<div
				if:when="!user.value"
				class="dash-header-spacer"
				aria-hidden="true"
			/>
			<div class="dash-header-end">
				<form
					if:when="user.value"
					class="dash-account"
					method="post"
					action="/api/auth/logout"
				>
					<input
						type="hidden"
						name="_csrf"
						bind:value="logout.csrfToken"
					/>
					<span
						class="dash-user"
						bind:title="t('a11y.session')"
					>
						{user.value}
					</span>
					<button
						type="submit"
						class="dash-logout"
						bind:title="t('account.logoutTitle', { user: user.value ?? '' })"
					>
						{t('account.logout')}
					</button>
				</form>
				<nav
					class="dash-locale"
					bind:aria-label="t('locale.label')"
				>
					<a
						each:of="i18n.pageLocales()"
						each:as="code"
						each:key="code"
						bind:href="i18n.switchLocalePath(code)"
						bind:hreflang="code"
						bind:lang="code"
						bind:aria-current="code === i18n.locale ? 'true' : undefined"
					>
						<span aria-hidden="true">{code.toUpperCase()}</span>
						<span class="dash-visually-hidden">{i18n.localeName(code)}</span>
					</a>
				</nav>
				<UIThemeToggle />
			</div>
		</header>
		<main
			id="contenido"
			class="dash-main"
			tabindex="-1"
		>
			<MeekoOutlet />
		</main>
		<aside
			if:when="suggestion.value"
			class="dash-locale-suggestion"
			role="status"
			bind:aria-label="t('locale.label')"
		>
			<svg
				viewBox="0 0 16 16"
				aria-hidden="true"
			>
				<path d="M8 14.25A6.25 6.25 0 1 0 8 1.75a6.25 6.25 0 0 0 0 12.5ZM1.75 8h12.5M8 1.75c1.6 1.7 2.4 3.8 2.4 6.25S9.6 12.55 8 14.25M8 1.75C6.4 3.45 5.6 5.55 5.6 8s.8 4.55 2.4 6.25" />
			</svg>
			<p>{t('locale.suggestion')}</p>
			<div class="dash-locale-suggestion-actions">
				<a
					class="dash-locale-switch"
					bind:href="i18n.switchLocalePath(suggestion.value ?? i18n.locale)"
					bind:hreflang="suggestion.value"
					bind:lang="suggestion.value"
				>
					{i18n.localeName(suggestion.value ?? i18n.locale)}
				</a>
				<button
					type="button"
					class="dash-locale-stay"
					bind:title="t('locale.dismiss')"
					on:click="stay"
				>
					{t('locale.stay')}
				</button>
			</div>
		</aside>
	</UIApp>
</template>
