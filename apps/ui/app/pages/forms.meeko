<script lang="ts">
	import { examples } from '../utils/examples'
	const name = signal('')
	const error = signal<string | undefined>(undefined)
	const saved = signal(false)
	function save(event: SubmitEvent) {
		event.preventDefault()
		error.value = name.value.trim() ? undefined : 'Escribe un nombre.'
		saved.value = !error.value
	}
	function reset() {
		name.value = ''
		error.value = undefined
		saved.value = false
	}
</script>

<template>
	<DocsPage
		title="Field e Input"
		description="Conecta señales de texto con etiquetas, descripciones y errores accesibles."
	>
		<h2 id="usage">Un campo completo</h2>
		<p>El ejemplo valida un nombre localmente. No envía información ni guarda datos en un servidor.</p>
		<DocsPreview>
			<form
				class="docs-stack"
				novalidate
				on:submit="save"
			>
				<UIField
					id="name"
					label="Nombre"
					description="Como aparecerá en tu proyecto."
					required
					bind:error="error.value"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UIInput
							required
							placeholder="Proyecto Aurora"
							model="name"
							bind:id="id"
							bind:describedBy="describedBy"
							bind:invalid="Boolean(error.value)"
						/>
					</snippet>
				</UIField>
				<div class="docs-actions">
					<UIButton type="submit">Guardar nombre</UIButton>
					<UIButton
						variant="outline"
						on:click="reset"
					>
						Restablecer
					</UIButton>
				</div>
				<p
					class="docs-status"
					role="status"
				>
					{saved.value ? 'Nombre validado en este ejemplo.' : 'Completa el nombre para continuar.'}
				</p>
			</form>
		</DocsPreview>
		<DocsCode bind:code="examples.form" />
		<UIAlert tone="info">
			UIField entrega
			<code>id</code>
			y
			<code>describedBy</code>
			a su snippet. Debes pasarlos al control, junto con
			<code>invalid</code>
			y
			<code>required</code>
			cuando corresponda. No se propagan automáticamente.
		</UIAlert>
		<DocsApi
			caption="Propiedades de UIField"
			bind:rows="[
				{ name: 'id / label', type: 'string', description: 'Obligatorias. Identidad del control y etiqueta visible.' },
				{ name: 'description / error', type: 'string', description: 'El error tiene prioridad y se anuncia con role=alert.' },
				{ name: 'hint / counter', type: 'string / string | number', description: 'Ayuda breve y contador, junto a la etiqueta. Sus id van en el describedBy que recibe el snippet.' },
				{ name: 'required', type: 'boolean', default: 'false', description: 'Muestra el indicador de campo obligatorio.' },
				{ name: 'class', type: 'string', description: 'Clases adicionales.' },
			]"
		/>
		<DocsApi
			caption="Propiedades de UIInput"
			bind:rows="[
				{ name: 'model', type: 'Signal<string>', default: 'Cadena vacía', description: 'Modelo de texto de doble vía; se actualiza con input.' },
				{ name: 'type', type: 'text | email | password | search | url | tel | date | datetime-local', default: 'text', description: 'Tipo nativo del control. La fecha es la del navegador.' },
				{ name: 'autocomplete / min / max / step', type: 'atributos HTML', description: 'Llegan tal cual al input, como autocapitalize y spellcheck.' },
				{ name: 'id / name / placeholder', type: 'string', description: 'Atributos del input.' },
				{ name: 'describedBy', type: 'string', description: 'IDs de descripción y error para aria-describedby.' },
				{ name: 'required / disabled / invalid', type: 'boolean', default: 'false', description: 'Estado del control. invalid activa aria-invalid.' },
				{ name: 'class', type: 'string', description: 'Clases adicionales.' },
			]"
		/>
		<h2 id="other-controls">Otros controles</h2>
		<p>
			Área de texto, casillas, radios, interruptor y deslizador están en
			<a href="/controls">Controles de formulario</a>. Para elegir entre opciones, usa
			<a href="/select">UISelect</a>, un
			<code>select</code>
			nativo, o
			<code>UICombobox</code>
			si necesitas búsqueda o selección múltiple. Sustituyen a la etiqueta obsoleta
			<code>MeekoSelect</code>
			del núcleo.
		</p>
	</DocsPage>
</template>
