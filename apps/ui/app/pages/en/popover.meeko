<script lang="ts">
	import { englishExamples as examples } from '../../utils/examples.en'

	const action = signal('No action yet.')
	const filtersOpen = signal(false)
	const published = signal(true)
	const drafts = signal(false)
	const filters = signal('Showing published projects.')
	function applyFilters() {
		const shown = [published.value ? 'published' : '', drafts.value ? 'draft' : ''].filter(Boolean)
		filters.value = shown.length ? 'Showing ' + shown.join(' and ') + ' projects.' : 'No filters: no project is shown.'
		filtersOpen.value = false
	}
</script>

<template>
	<DocsPage
		locale="en"
		title="Popover"
		description="Menus, lightweight dialogs and tooltips anchored to their trigger, with keyboard support and the native top layer."
	>
		<p>
			<code>UIPopover</code>
			places its content in the browser's top layer with the
			<code>popover</code>
			attribute and anchors it to the trigger with CSS anchor positioning, without JavaScript. When it does not fit, it moves to the other side with
			<code>position-try-fallbacks</code>. A browser without anchoring opens it unanchored: it still works.
		</p>
		<h2 id="menu">Action menu</h2>
		<p>
			With
			<code>role="menu"</code>, the children with
			<code>role="menuitem"</code>
			are navigated with the arrow keys,
			<code>Home</code>,
			<code>End</code>
			and the first letter of each action.
			<code>Esc</code>
			closes the menu and returns focus to the trigger.
		</p>
		<DocsPreview>
			<UIPopover
				role="menu"
				placement="bottom-start"
				bind:offset="6"
			>
				<snippet name="trigger">Project actions</snippet>
				<UIButton
					variant="ghost"
					role="menuitem"
					on:click="() => (action.value = 'Project renamed.')"
				>
					Rename
				</UIButton>
				<UIButton
					variant="ghost"
					role="menuitem"
					on:click="() => (action.value = 'Project duplicated.')"
				>
					Duplicate
				</UIButton>
				<UIButton
					variant="ghost"
					role="menuitem"
					on:click="() => (action.value = 'Project archived.')"
				>
					Archive
				</UIButton>
			</UIPopover>
			<p
				id="menu-status"
				class="docs-status"
				role="status"
			>
				{action.value}
			</p>
		</DocsPreview>
		<DocsCode bind:code="examples.popoverMenu" />
		<h2 id="dialog">Lightweight dialog</h2>
		<p>
			With
			<code>role="dialog"</code>
			focus moves into the content when it opens. Use it for brief controls that do not need to block the page; for a task that demands attention, use
			<MeekoLink to="/modals">Modal</MeekoLink>. The model controls the opening from code.
		</p>
		<DocsPreview>
			<UIPopover
				role="dialog"
				label="Filter projects"
				model="filtersOpen"
				bind:offset="6"
			>
				<snippet name="trigger">Filter</snippet>
				<div class="docs-stack">
					<div
						class="docs-stack"
						data-dense
						role="group"
						aria-label="Status"
					>
						<UICheckbox
							label="Published"
							model="published"
						/>
						<UICheckbox
							label="Drafts"
							model="drafts"
						/>
					</div>
					<UIButton
						size="sm"
						on:click="applyFilters"
					>
						Apply filters
					</UIButton>
				</div>
			</UIPopover>
			<p
				id="filters-status"
				class="docs-status"
				role="status"
			>
				{filters.value}
			</p>
		</DocsPreview>
		<DocsCode bind:code="examples.popoverDialog" />
		<h2 id="tooltip">Tooltip</h2>
		<p>
			With
			<code>mode="hint"</code>
			the content is a tooltip: it opens when the pointer hovers, after
			<code>delay</code>, or when the trigger is focused, and it never receives focus. The trigger references it with
			<code>aria-describedby</code>. Write supplementary information in it, never the only explanation of an action.
		</p>
		<DocsPreview>
			<UITooltip bind:offset="6">
				<snippet name="trigger">Status: draft</snippet>
				Only your team can see it until you publish it.
			</UITooltip>
		</DocsPreview>
		<DocsCode bind:code="examples.popoverTooltip" />
		<h2 id="anchor">Your own trigger</h2>
		<p>
			The
			<code>anchor</code>
			snippet replaces the button that UI renders. It receives the attributes of the trigger to apply them with
			<code>bind="trigger"</code>; UIPopover finds it by its
			<code>id</code>
			and adds the keyboard handling and the anchoring.
		</p>
		<DocsCode bind:code="examples.popoverAnchor" />
		<h2 id="api">API</h2>
		<DocsApi
			caption="UIPopover props"
			bind:rows="[
				{ name: 'model', type: 'Signal<boolean>', default: 'false', description: 'Two-way opening of the content.' },
				{ name: 'mode', type: 'auto | manual | hint', default: 'auto', description: 'auto closes on an outside click and with Esc; manual only from the trigger, Esc or the model; hint is a tooltip.' },
				{ name: 'role', type: 'menu | dialog | tooltip', description: 'ARIA pattern of the content. With mode=hint, tooltip by default.' },
				{ name: 'placement', type: 'top | bottom | left | right, with -start or -end', default: 'bottom-start', description: 'Side and alignment relative to the trigger.' },
				{ name: 'offset', type: 'number', default: '0', description: 'Distance in pixels from the trigger.' },
				{ name: 'label', type: 'string', description: 'Accessible name of the content. Without it, a menu or a dialog is named after the trigger.' },
				{ name: 'matchWidth', type: 'boolean', default: 'false', description: 'The content is at least as wide as the trigger.' },
				{ name: 'delay / closeDelay', type: 'number', default: '300 / 150', description: 'With mode=hint, milliseconds before opening and closing.' },
				{ name: 'class / triggerClass', type: 'string', description: 'Classes of the content and of the trigger button.' },
				{ name: 'triggerId', type: 'string', description: 'id of the trigger. By default, one that is stable between SSR and hydration.' },
			]"
		/>
		<p>
			It accepts the
			<code>default</code>,
			<code>trigger</code>
			and
			<code>anchor</code>
			snippets. The
			<code>toggle</code>
			event receives an object with
			<code>open</code>
			every time the content opens or closes. With a
			<code>ref:</code>, the component exposes
			<code>show()</code>,
			<code>hide()</code>
			and
			<code>toggle()</code>. The
			<code>UIPopoverProps</code>,
			<code>PopoverPlacement</code>
			and
			<code>PopoverTrigger</code>
			types are exported from
			<code>@meekojs/ui/runtime</code>.
		</p>
	</DocsPage>
</template>
