<script lang="ts">
	import { examples } from '../../utils/examples'

	interface Member {
		id: number
		name: string
		team: string
		role: string
		disabled?: boolean
	}

	const plans = ['Personal', 'Team', 'Business', 'Education']
	const topics = ['Accessibility', 'Design', 'Documentation', 'Performance', 'Testing', 'Security']
	const members: Member[] = [
		{ id: 1, name: 'Lucía Martín', team: 'Design', role: 'Art director' },
		{ id: 2, name: 'Andrés Pérez', team: 'Design', role: 'Product designer' },
		{ id: 3, name: 'Sofía Ramos', team: 'Engineering', role: 'Developer' },
		{ id: 4, name: 'Mateo Gil', team: 'Engineering', role: 'On vacation', disabled: true },
		{ id: 5, name: 'Valeria Ortiz', team: 'Engineering', role: 'Quality lead' },
	]

	const plan = signal<string | null>(null)
	const chosen = signal<string[]>([])
	const owner = signal<Member | null>(null)
	const planError = signal<string | undefined>(undefined)
	const sent = signal('Choose a plan and up to two topics.')

	function validate() {
		planError.value = plan.value === null ? 'Choose a plan to continue.' : undefined
	}
	function send(event: SubmitEvent) {
		event.preventDefault()
		const data = new FormData(event.currentTarget as HTMLFormElement)
		const entries = [...data.entries()].map(([name, value]) => name + '=' + String(value))
		sent.value = 'Sent in this example: ' + entries.join(' · ')
	}
</script>

<template>
	<DocsPage
		locale="en"
		title="Select"
		description="Choose one option with the native select or, to search or choose several, with UICombobox."
	>
		<p>
			<code>UISelect</code>
			is a native
			<code>select</code>
			with
			<code>appearance: base-select</code>: the browser brings the list, the keyboard and the form value, and UI paints it with its tokens.
			<code>UICombobox</code>
			covers what the native one cannot: searching, filtering on a server and choosing several options. The type of the model is inferred from
			<code>options</code>.
		</p>
		<h2 id="usage">One option in a form</h2>
		<p>
			With
			<code>name</code>, a native form sends the value without extra code. Open the list with
			<code>Enter</code>,
			<code>Space</code>
			or a click and type a letter to jump to the option that starts with it: it is the keyboard of the browser.
		</p>
		<DocsPreview>
			<form
				id="select-form"
				class="docs-stack"
				on:submit="send"
			>
				<UIField
					id="plan"
					label="Plan"
					required
					bind:error="planError.value"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UISelect
							name="plan"
							placeholder="Choose a plan"
							required
							model="plan"
							bind:options="plans"
							bind:id="id"
							bind:describedBy="describedBy"
							bind:invalid="Boolean(planError.value)"
							on:change="validate"
						/>
					</snippet>
				</UIField>
				<UIField
					id="topics"
					label="Topics"
					description="Up to two topics. The search ignores accents and case."
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UICombobox
							name="topics"
							multiple
							searchable
							placeholder="Search for a topic"
							model="chosen"
							bind:options="topics"
							bind:max="2"
							bind:id="id"
							bind:describedBy="describedBy"
						/>
					</snippet>
				</UIField>
				<div class="docs-actions">
					<UIButton
						type="submit"
						on:click="validate"
					>
						Send selection
					</UIButton>
				</div>
				<p
					id="select-sent"
					class="docs-status"
					role="status"
				>
					{sent.value}
				</p>
			</form>
		</DocsPreview>
		<DocsCode bind:code="examples.select" />
		<UIAlert tone="info">
			With
			<code>required</code>, a form without a value is not sent: the
			<code>select</code>
			receives the focus and
			<code>aria-invalid</code>, without the browser message. Write a visible message too with
			<code>UIField</code>, as in the example. With
			<code>useForm</code>, pass
			<code>bind:field="form.field('plan')"</code>
			and the field brings the id, the name, the value and the error state.
		</UIAlert>
		<h2 id="browsers">Browsers</h2>
		<p>
			Chrome, Edge and Safari 27 paint the list with the tokens of UI, with an animated entrance. Firefox and older browsers show their own list: they work the same, and there
			<code>value</code>,
			<code>group</code>
			and the rich content of
			<code>option</code>
			stay as their text. A hidden option at the start stands for the
			<code>placeholder</code>, or for a value that is no longer in
			<code>options</code>: the model keeps it and the form keeps sending it.
		</p>
		<h2 id="objects">Objects, groups and custom options</h2>
		<p>
			Options can be objects.
			<code>by</code>
			decides how they are compared,
			<code>labelBy</code>
			which text is shown and searched,
			<code>groupBy</code>
			adds a heading per group and an option with
			<code>disabled: true</code>
			cannot be chosen. The
			<code>option</code>
			and
			<code>value</code>
			snippets receive the option with its type.
		</p>
		<DocsPreview>
			<div class="docs-stack">
				<UIField
					id="owner"
					label="Owner"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UISelect
							by="id"
							labelBy="name"
							groupBy="team"
							placeholder="Assign a person"
							clearable
							model="owner"
							bind:options="members"
							bind:id="id"
							bind:describedBy="describedBy"
						>
							<snippet
								name="option"
								params="member"
							>
								{member.name}
								<UIBadge>{member.role}</UIBadge>
							</snippet>
						</UISelect>
					</snippet>
				</UIField>
				<p
					id="owner-status"
					class="docs-status"
					role="status"
				>
					{owner.value ? owner.value.name + ' owns ' + owner.value.team.toLowerCase() + '.' : 'No owner assigned.'}
				</p>
			</div>
		</DocsPreview>
		<DocsCode bind:code="examples.selectObjects" />
		<h2 id="api">UISelect API</h2>
		<DocsApi
			caption="UISelect props"
			bind:rows="[
				{ name: 'options', type: 'readonly T[]', description: 'Required. Primitives or objects.' },
				{ name: 'model', type: 'Signal<T | null>', default: 'null', description: 'Chosen value.' },
				{ name: 'by / labelBy / disabledBy / groupBy', type: 'key or function', description: 'Comparison, label, disabled state and group of each option.' },
				{ name: 'clearable / clearLabel', type: 'boolean / string', default: 'false / Clear selection', description: 'Accessible button that clears the selection and returns focus to the select. The default label follows the language of the document (see Theming).' },
				{ name: 'name / required / disabled', type: 'string / boolean', description: 'Form submission and validation.' },
				{ name: 'field', type: 'SelectField', description: 'A useForm field: id, name, value, aria-invalid and aria-describedby.' },
				{ name: 'id / label / describedBy / invalid', type: 'string / boolean', description: 'Identity and accessible state of the select.' },
				{ name: 'placeholder', type: 'string', description: 'Text without a value.' },
				{ name: 'placement / offset', type: 'PopoverPlacement / number', default: 'bottom-start', description: 'Position of the list, where the browser paints it with the tokens.' },
				{ name: 'class / listClass', type: 'string', description: 'Classes of the root and of the select; style the list with .my-class::picker(select).' },
			]"
		/>
		<p>
			It accepts the
			<code>option</code>,
			<code>value</code>
			and
			<code>group</code>
			snippets, and the
			<code>change</code>
			event.
			<code>multiple</code>,
			<code>searchable</code>,
			<code>filter</code>
			and
			<code>max</code>
			are a type error that points to
			<code>UICombobox</code>.
		</p>
		<h2 id="combobox">UICombobox</h2>
		<p>
			A list of its own on top of
			<MeekoLink to="/popover">UIPopover</MeekoLink>, with more JavaScript: use it only if you need
			<code>searchable</code>,
			<code>filter</code>,
			<code>multiple</code>
			or
			<code>max</code>. The focus stays on the trigger while
			<code>aria-activedescendant</code>
			walks the list. The Topics field of the first example is a
			<code>UICombobox</code>. With
			<code>multiple</code>, each option toggles, the list stays open and the model is an array;
			<code>max</code>
			disables the rest at the limit.
		</p>
		<DocsCode bind:code="examples.combobox" />
		<p>
			To search on a server, pass a
			<code>filter</code>
			function that returns a promise and uses its
			<code>AbortSignal</code>. Without results it shows
			<code>empty</code>: by default,
			<code>No results</code>.
		</p>
		<DocsApi
			caption="UICombobox own props"
			bind:rows="[
				{ name: 'model', type: 'Signal<T | null> or Signal<T[]>', default: 'null', description: 'Chosen value; an array with multiple.' },
				{ name: 'multiple', type: 'boolean', default: 'false', description: 'Allows choosing several options.' },
				{ name: 'searchable / filter', type: 'boolean / ComboboxFilter<T>', description: 'Search in the list, synchronous or asynchronous.' },
				{ name: 'max', type: 'number', description: 'With multiple, maximum number of chosen options.' },
			]"
		/>
		<p>
			The other props are those of
			<code>UISelect</code>. It also accepts the
			<code>empty</code>
			and
			<code>loading</code>
			snippets. The types
			<code>UISelectProps</code>,
			<code>UIComboboxProps</code>,
			<code>SelectModel</code>
			and
			<code>ComboboxFilter</code>
			are exported from
			<code>@meekojs/ui/runtime</code>.
		</p>
	</DocsPage>
</template>
