<script lang="ts">
	import { englishExamples as examples } from '../../utils/examples.en'

	const count = signal(0)
	const variants = ['outline', 'soft', 'solid', 'elevated'] as const
	const variant = signal<(typeof variants)[number] | null>('outline')
</script>

<template>
	<DocsPage
		locale="en"
		title="Card"
		description="Group content with variants, a header and optional actions."
	>
		<div class="docs-actions">
			<UIField
				id="card-variant"
				label="Variant"
			>
				<snippet
					name="default"
					params="id, describedBy"
				>
					<UISelect
						model="variant"
						bind:options="variants"
						bind:id="id"
						bind:describedBy="describedBy"
					/>
				</snippet>
			</UIField>
		</div>
		<UICard
			title="Your workspace"
			description="A card controlled by props, with reactive content."
			bind:variant="variant.value ?? 'outline'"
		>
			<p role="status">Saved changes: {count.value}</p>
			<snippet name="footer">
				<UIButton
					variant="secondary"
					on:click="() => count.value++"
				>
					Save change
				</UIButton>
			</snippet>
		</UICard>
		<div class="docs-grid">
			<UICard
				title="Outline"
				description="A defined border to separate content."
				variant="outline"
			>
				<p>Project details and related content.</p>
			</UICard>
			<UICard
				title="Soft"
				description="A subtle background, without a visible border."
				variant="soft"
			>
				<p>Supporting information within a view.</p>
			</UICard>
			<UICard
				title="Solid"
				description="The accent color to highlight content."
				variant="solid"
			>
				<p>A relevant message for the team.</p>
			</UICard>
			<UICard
				title="Elevated"
				description="A surface raised with a shadow."
				variant="elevated"
			>
				<p>Content that needs to stand out from the background.</p>
			</UICard>
		</div>
		<div class="docs-grid">
			<UICard class="card-demo-custom">
				<snippet name="header"><h2>Custom header</h2></snippet>
				<p>Snippets keep the content and actions of your application.</p>
			</UICard>
			<UICard class="card-demo-minimal"><p>You can also use only the body, without a header or footer.</p></UICard>
		</div>
		<h2 id="usage">Usage and snippets</h2>
		<DocsCode bind:code="examples.card" />
		<p>
			The header can come from
			<code>title</code>
			and
			<code>description</code>
			or from the
			<code>header</code>
			snippet, which takes priority.
			<code>default</code>
			holds the body and
			<code>footer</code>
			the actions.
		</p>
		<DocsApi
			bind:rows="[
				{ name: 'title / description', type: 'string', description: 'Optional header text.' },
				{ name: 'variant', type: 'outline | soft | solid | elevated', default: 'outline', description: 'Visual variant; supports ui.defaults.card.' },
				{ name: 'class', type: 'string', description: 'Additional classes.' },
			]"
		/>
		<p>
			The
			<code>default</code>
			snippet is required.
			<code>header</code>
			and
			<code>footer</code>
			are optional. The component uses a section with an accessible name when a title is given.
		</p>
	</DocsPage>
</template>
