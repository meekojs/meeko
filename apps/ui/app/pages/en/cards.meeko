<script lang="ts">
	import { englishExamples as examples } from '../../utils/examples.en'

	const count = signal(0)
	const variants = ['surface', 'outline', 'soft', 'subtle', 'solid', 'glass', 'plain'] as const
	const colors = ['neutral', 'primary', 'secondary', 'success', 'info', 'warning', 'danger'] as const
	const variant = signal<(typeof variants)[number] | null>('surface')
	const color = signal<(typeof colors)[number] | null>('neutral')
</script>

<template>
	<DocsPage
		locale="en"
		title="Card"
		description="Group content with variants, a header and optional actions."
	>
		<div class="docs-actions">
			<UIField
				id="card-variant"
				label="Variant"
			>
				<snippet
					name="default"
					params="id, describedBy"
				>
					<UISelect
						model="variant"
						bind:options="variants"
						bind:id="id"
						bind:describedBy="describedBy"
					/>
				</snippet>
			</UIField>
			<UIField
				id="card-color"
				label="Color"
			>
				<snippet
					name="default"
					params="id, describedBy"
				>
					<UISelect
						model="color"
						bind:options="colors"
						bind:id="id"
						bind:describedBy="describedBy"
					/>
				</snippet>
			</UIField>
		</div>
		<UICard
			title="Your workspace"
			description="A card controlled by props, with reactive content."
			bind:variant="variant.value ?? 'surface'"
			bind:color="color.value ?? 'neutral'"
		>
			<p role="status">Saved changes: {count.value}</p>
			<snippet name="footer">
				<UIButton
					variant="surface"
					color="neutral"
					on:click="() => count.value++"
				>
					Save change
				</UIButton>
			</snippet>
		</UICard>
		<div class="docs-grid">
			<UICard
				title="Surface"
				description="The default surface, with a border."
			>
				<p>Project details and related content.</p>
			</UICard>
			<UICard
				title="Soft"
				description="A subtle background, without a visible border."
				variant="soft"
			>
				<p>Supporting information within a view.</p>
			</UICard>
			<UICard
				title="Solid"
				description="The accent color to highlight content."
				variant="solid"
				color="primary"
			>
				<p>A relevant message for the team.</p>
			</UICard>
			<UICard
				title="Elevation"
				description="A surface raised with a shadow."
				elevation="md"
			>
				<p>Content that needs to stand out from the background.</p>
			</UICard>
		</div>
		<div class="docs-grid">
			<UICard class="card-demo-custom">
				<snippet name="header"><h2>Custom header</h2></snippet>
				<p>Snippets keep the content and actions of your application.</p>
			</UICard>
			<UICard class="card-demo-minimal"><p>You can also use only the body, without a header or footer.</p></UICard>
		</div>
		<h2 id="usage">Usage and snippets</h2>
		<DocsCode bind:code="examples.card" />
		<p>
			The header can come from
			<code>title</code>
			and
			<code>description</code>
			or from the
			<code>header</code>
			snippet, which takes priority.
			<code>default</code>
			holds the body and
			<code>footer</code>
			the actions.
		</p>
		<h2 id="appearance">Appearance</h2>
		<p>
			The look combines a treatment,
			<code>variant</code>
			(<code>surface</code>,
			<code>outline</code>, <code>soft</code>, <code>subtle</code>, <code>solid</code>,
			<code>glass</code>
			or
			<code>plain</code>), with a semantic color,
			<code>color</code>
			(<code>primary</code>,
			<code>secondary</code>, <code>neutral</code>, <code>success</code>, <code>info</code>,
			<code>warning</code>
			or
			<code>danger</code>). Without them it is
			<code>surface</code>
			and
			<code>neutral</code>.
			<code>radius</code>
			goes from
			<code>none</code>
			to
			<code>full</code>
			(<code>lg</code>
			by default) and
			<code>elevation</code>
			adds a shadow. It is the
			<code>cardTheme</code>
			recipe of
			<code>@meekojs/ui/theme</code>: your
			<code>class</code>
			is merged with Tailwind Merge and wins over the utility of the recipe that sets the same property.
		</p>
		<DocsPreview>
			<UICard
				title="Weekly summary"
				color="primary"
				radius="xl"
				elevation="md"
			>
				3 projects updated
			</UICard>
			<UICard
				title="outline"
				variant="outline"
				color="primary"
			>
				3 projects updated
			</UICard>
			<UICard
				title="glass"
				variant="glass"
				color="primary"
			>
				3 projects updated
			</UICard>
			<UICard
				title="plain"
				variant="plain"
				color="primary"
			>
				3 projects updated
			</UICard>
		</DocsPreview>
		<DocsCode bind:code="examples.cardTheme" />
		<DocsApi
			bind:rows="[
				{ name: 'title / description', type: 'string', description: 'Optional header text.' },
				{ name: 'variant', type: 'surface | outline | soft | subtle | solid | glass | plain', default: 'surface', description: 'Visual treatment; plain paints no background, border or color. Supports ui.defaults.card.' },
				{ name: 'color', type: 'primary | secondary | neutral | success | info | warning | danger', default: 'neutral', description: 'Semantic color; supports ui.defaults.card.' },
				{ name: 'radius / elevation', type: 'none … full / none … 2xl', default: 'lg / —', description: 'Corner radius and shadow; support ui.defaults.card.' },
				{ name: 'padding / density', type: 'none | sm | md | lg / compact | normal | comfortable', default: 'md / normal', description: 'Space between the content and the edge; padding wins over density.' },
				{ name: 'actionsWrap', type: 'inline | below | auto', default: 'inline', description: 'Where the actions go; auto moves them down in a narrow card and supports ui.defaults.card.' },
				{ name: 'class', type: 'string', description: 'Additional classes, merged with Tailwind Merge after those of the recipe.' },
			]"
		/>
		<p>
			The
			<code>default</code>
			snippet is required.
			<code>header</code>
			and
			<code>footer</code>
			are optional. The component uses a section with an accessible name when a title is given.
		</p>
		<h2 id="actions">Header actions</h2>
		<p>
			The
			<code>actions</code>
			snippet goes next to the title. With
			<code>actionsWrap="auto"</code>
			the actions move under the title when the card is narrow, even on a wide window;
			<code>below</code>
			always puts them underneath and
			<code>inline</code>, the default, always beside it. It is pure CSS and the DOM order does not change.
		</p>
		<UICard
			title="Orders"
			description="The last 30 days."
			actionsWrap="auto"
			class="card-demo-actions"
		>
			<snippet name="actions">
				<UIButton
					variant="surface"
					color="neutral"
					size="sm"
				>
					Export
				</UIButton>
				<UIButton size="sm">New order</UIButton>
			</snippet>
			<p>With room, the actions stay next to the title.</p>
		</UICard>
		<div class="docs-grid">
			<UICard
				title="Invoices"
				description="Awaiting payment."
				actionsWrap="auto"
			>
				<snippet name="actions">
					<UIButton
						variant="surface"
						color="neutral"
						size="sm"
					>
						Export
					</UIButton>
					<UIButton size="sm">New order</UIButton>
				</snippet>
				<p>With auto, they move under the title if the card gets narrow.</p>
			</UICard>
			<UICard
				title="Customers"
				description="New this week."
				actionsWrap="below"
			>
				<snippet name="actions">
					<UIButton
						variant="surface"
						color="neutral"
						size="sm"
					>
						Export
					</UIButton>
					<UIButton size="sm">New order</UIButton>
				</snippet>
				<p>With below, always under the title.</p>
			</UICard>
		</div>
	</DocsPage>
</template>
