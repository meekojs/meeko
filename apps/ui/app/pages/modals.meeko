<script lang="ts">
	import { examples } from '../utils/examples'

	const modal = useModal()
	const result = signal('Sin respuesta todavía.')
	const opened = signal(false)
	const locked = signal(false)
	async function ask() {
		try {
			const accepted = await modal.open<boolean>('ModalConfirm', { message: 'Puedes confirmar, cancelar o abrir otra instancia.' })
			result.value = accepted ? 'Acción confirmada.' : 'Acción cancelada.'
		} catch {
			result.value = 'No se pudo cargar el modal. Vuelve a intentarlo.'
		}
	}
</script>

<template>
	<DocsPage
		title="Modal"
		description="Diálogos declarativos o programáticos con resultados y soporte de anidación."
	>
		<div class="docs-actions">
			<UIButton on:click="ask">Abrir confirmación</UIButton>
			<UIButton
				variant="secondary"
				on:click="() => (opened.value = true)"
			>
				Modal declarativo
			</UIButton>
			<UIButton
				variant="secondary"
				on:click="() => (locked.value = true)"
			>
				Cierre protegido
			</UIButton>
		</div>
		<p role="status">{result.value}</p>
		<UIModal
			title="Un modal declarativo"
			description="Controlado con una señal y model."
			model="opened"
		>
			<UIField
				id="modal-name"
				label="Nombre"
			>
				<snippet
					name="default"
					params="id, describedBy"
				>
					<UIInput
						placeholder="Escribe tu nombre"
						bind:id="id"
						bind:describedBy="describedBy"
					/>
				</snippet>
			</UIField>
			<snippet name="footer"><UIButton on:click="() => (opened.value = false)">Listo</UIButton></snippet>
		</UIModal>
		<UIModal
			title="Cierre protegido"
			description="Escape y el fondo están desactivados."
			model="locked"
			bind:closeOnEscape="false"
			bind:closeOnBackdrop="false"
			bind:closeButton="false"
		>
			<p>Usa la acción explícita para cerrar este diálogo.</p>
			<snippet name="footer"><UIButton on:click="() => (locked.value = false)">Terminar</UIButton></snippet>
		</UIModal>
		<h2 id="declarative">Modal declarativo</h2>
		<p>
			Controla la visibilidad mediante una señal booleana y
			<code>model</code>. El ejemplo de arriba también permite probar un diálogo cuyo cierre exige una acción explícita.
		</p>
		<DocsCode bind:code="examples.modal" />
		<h2 id="programmatic">Abrir y esperar un resultado</h2>
		<p>
			Necesitas
			<a href="/app">UIApp</a>
			en la raíz. Los componentes del registro cuyo nombre empieza por
			<code>Modal</code>
			se pueden abrir con props tipadas. Un error de carga rechaza la promesa; descartar el diálogo resuelve
			<code>undefined</code>.
		</p>
		<DocsCode
			label="Dentro de un componente"
			bind:code="examples.modalOpen"
		/>
		<DocsCode
			label="app/components/Modal/Confirm.meeko"
			bind:code="examples.modalInstance"
		/>
		<h2 id="stack">Modales anidados</h2>
		<p>
			Abre la confirmación y luego otro modal para probar tamaños
			<code>lg</code>,
			<code>md</code>
			y
			<code>sm</code>. Sólo el superior controla el fondo y el foco. Los anteriores conservan su estado, quedan bloqueados y recuperan foco y tamaño al volver. El movimiento se reduce cuando el usuario lo solicita.
		</p>
		<DocsApi
			bind:rows="[
				{ name: 'title', type: 'string', description: 'Obligatoria. Nombre accesible del diálogo.' },
				{ name: 'description', type: 'string', description: 'Descripción asociada mediante aria-describedby.' },
				{ name: 'model', type: 'Signal<boolean>', default: 'false', description: 'Control de apertura declarativa.' },
				{ name: 'size', type: 'sm | md | lg', default: 'md', description: 'Ancho máximo del diálogo.' },
				{ name: 'closeOnEscape / closeOnBackdrop', type: 'boolean', default: 'true', description: 'Permite descartar con Escape o el fondo.' },
				{ name: 'closeButton', type: 'boolean', default: 'true', description: 'Muestra el botón de cierre.' },
				{ name: 'closeLabel', type: 'string', default: 'Cerrar modal', description: 'Nombre accesible del botón. El valor por defecto sigue el idioma del documento (véase Temas).' },
				{ name: 'class', type: 'string', description: 'Clases adicionales.' },
			]"
		/>
		<p>
			Requiere el snippet
			<code>default</code>
			y admite
			<code>footer</code>. El evento
			<code>dismiss</code>
			recibe
			<code>escape</code>,
			<code>backdrop</code>,
			<code>button</code>
			o
			<code>native</code>. No uses un modal para tareas que puedan resolverse dentro de la página.
		</p>
	</DocsPage>
</template>
