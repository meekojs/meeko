<script lang="ts">
	import { examples } from '../utils/examples'

	interface Member {
		id: number
		name: string
		team: string
		role: string
		disabled?: boolean
	}

	const plans = ['Personal', 'Equipo', 'Empresa', 'Educación']
	const topics = ['Accesibilidad', 'Diseño', 'Documentación', 'Rendimiento', 'Pruebas', 'Seguridad']
	const members: Member[] = [
		{ id: 1, name: 'Lucía Martín', team: 'Diseño', role: 'Directora de arte' },
		{ id: 2, name: 'Andrés Pérez', team: 'Diseño', role: 'Diseñador de producto' },
		{ id: 3, name: 'Sofía Ramos', team: 'Ingeniería', role: 'Desarrolladora' },
		{ id: 4, name: 'Mateo Gil', team: 'Ingeniería', role: 'De vacaciones', disabled: true },
		{ id: 5, name: 'Valeria Ortiz', team: 'Ingeniería', role: 'Responsable de calidad' },
	]

	const plan = signal<string | null>(null)
	const chosen = signal<string[]>([])
	const owner = signal<Member | null>(null)
	const planError = signal<string | undefined>(undefined)
	const sent = signal('Elige un plan y hasta dos temas.')

	function validate() {
		planError.value = plan.value === null ? 'Elige un plan para continuar.' : undefined
	}
	function send(event: SubmitEvent) {
		event.preventDefault()
		const data = new FormData(event.currentTarget as HTMLFormElement)
		const entries = [...data.entries()].map(([name, value]) => name + '=' + String(value))
		sent.value = 'Enviado en este ejemplo: ' + entries.join(' · ')
	}
</script>

<template>
	<DocsPage
		title="Select"
		description="Elige una opción con el select nativo o, para buscar o elegir varias, con UICombobox."
	>
		<p>
			<code>UISelect</code>
			es un
			<code>select</code>
			nativo con
			<code>appearance: base-select</code>
			: el navegador trae la lista, el teclado y el valor de formulario, y UI la pinta con sus tokens.
			<code>UICombobox</code>
			cubre lo que el nativo no puede: buscar, filtrar en un servidor y elegir varias opciones. El tipo del modelo se infiere de
			<code>options</code>
			.
		</p>
		<h2 id="usage">Una opción en un formulario</h2>
		<p>
			Con
			<code>name</code>
			, el valor se envía con un formulario nativo sin código adicional. Abre la lista con
			<code>Intro</code>
			,
			<code>Espacio</code>
			o un clic y escribe una letra para saltar a la opción que empieza por ella: es el teclado del navegador.
		</p>
		<DocsPreview>
			<form
				id="select-form"
				class="docs-stack"
				on:submit="send"
			>
				<UIField
					id="plan"
					label="Plan"
					required
					bind:error="planError.value"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UISelect
							name="plan"
							placeholder="Elige un plan"
							required
							model="plan"
							bind:options="plans"
							bind:id="id"
							bind:describedBy="describedBy"
							bind:invalid="Boolean(planError.value)"
							on:change="validate"
						/>
					</snippet>
				</UIField>
				<UIField
					id="topics"
					label="Temas"
					description="Hasta dos temas. La búsqueda ignora acentos y mayúsculas."
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UICombobox
							name="topics"
							multiple
							searchable
							placeholder="Busca un tema"
							model="chosen"
							bind:options="topics"
							bind:max="2"
							bind:id="id"
							bind:describedBy="describedBy"
						/>
					</snippet>
				</UIField>
				<div class="docs-actions">
					<UIButton
						type="submit"
						on:click="validate"
					>
						Enviar selección
					</UIButton>
				</div>
				<p
					id="select-sent"
					class="docs-status"
					role="status"
				>
					{sent.value}
				</p>
			</form>
		</DocsPreview>
		<DocsCode bind:code="examples.select" />
		<UIAlert tone="info">
			Con
			<code>required</code>
			, un formulario sin valor no se envía: el
			<code>select</code>
			recibe el foco y
			<code>aria-invalid</code>
			, sin el aviso del navegador. Escribe además un mensaje visible con
			<code>UIField</code>
			, como en el ejemplo. Con
			<code>useForm</code>
			, pasa
			<code>bind:field="form.field('plan')"</code>
			y el campo aporta el id, el nombre, el valor y el estado de error.
		</UIAlert>
		<h2 id="browsers">Navegadores</h2>
		<p>
			Chrome, Edge y Safari 27 pintan la lista con los tokens de UI, con entrada animada. Firefox y los navegadores antiguos muestran su lista propia: funcionan igual, y en ellos
			<code>value</code>
			,
			<code>group</code>
			y el contenido rico de
			<code>option</code>
			quedan en su texto. Una opción oculta al principio representa el
			<code>placeholder</code>
			, o un valor que ya no está en
			<code>options</code>
			: el modelo lo conserva y el formulario lo sigue enviando.
		</p>
		<h2 id="objects">Objetos, grupos y opciones propias</h2>
		<p>
			Las opciones pueden ser objetos.
			<code>by</code>
			decide cómo se comparan,
			<code>labelBy</code>
			qué texto se muestra y se busca,
			<code>groupBy</code>
			añade un encabezado por grupo y una opción con
			<code>disabled: true</code>
			no se puede elegir. Los snippets
			<code>option</code>
			y
			<code>value</code>
			reciben la opción con su tipo.
		</p>
		<DocsPreview>
			<div class="docs-stack">
				<UIField
					id="owner"
					label="Responsable"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UISelect
							by="id"
							labelBy="name"
							groupBy="team"
							placeholder="Asigna una persona"
							clearable
							model="owner"
							bind:options="members"
							bind:id="id"
							bind:describedBy="describedBy"
						>
							<snippet
								name="option"
								params="member"
							>
								{member.name}
								<UIBadge>{member.role}</UIBadge>
							</snippet>
						</UISelect>
					</snippet>
				</UIField>
				<p
					id="owner-status"
					class="docs-status"
					role="status"
				>
					{owner.value ? owner.value.name + ' es responsable de ' + owner.value.team.toLowerCase() + '.' : 'Sin responsable asignado.'}
				</p>
			</div>
		</DocsPreview>
		<DocsCode bind:code="examples.selectObjects" />
		<h2 id="api">API de UISelect</h2>
		<DocsApi
			caption="Propiedades de UISelect"
			bind:rows="[
				{ name: 'options', type: 'readonly T[]', description: 'Obligatoria. Primitivos u objetos.' },
				{ name: 'model', type: 'Signal<T | null>', default: 'null', description: 'Valor elegido.' },
				{ name: 'by / labelBy / disabledBy / groupBy', type: 'clave o función', description: 'Comparación, etiqueta, deshabilitado y grupo de cada opción.' },
				{ name: 'clearable / clearLabel', type: 'boolean / string', default: 'false / Quitar selección', description: 'Botón accesible que quita la selección y devuelve el foco al select. La etiqueta por defecto sigue el idioma del documento (véase Temas).' },
				{ name: 'name / required / disabled', type: 'string / boolean', description: 'Envío y validación del formulario.' },
				{ name: 'field', type: 'SelectField', description: 'Un campo de useForm: id, name, valor, aria-invalid y aria-describedby.' },
				{ name: 'id / label / describedBy / invalid', type: 'string / boolean', description: 'Identidad y estado accesible del select.' },
				{ name: 'placeholder', type: 'string', description: 'Texto sin valor.' },
				{ name: 'placement / offset', type: 'PopoverPlacement / number', default: 'bottom-start', description: 'Posición de la lista, donde el navegador la pinta con los tokens.' },
				{ name: 'class / listClass', type: 'string', description: 'Clases de la raíz y del select; dale estilo a la lista con .mi-clase::picker(select).' },
			]"
		/>
		<p>
			Admite los snippets
			<code>option</code>
			,
			<code>value</code>
			y
			<code>group</code>
			, y el evento
			<code>change</code>
			.
			<code>multiple</code>
			,
			<code>searchable</code>
			,
			<code>filter</code>
			y
			<code>max</code>
			son un error de tipos que indica
			<code>UICombobox</code>
			.
		</p>
		<h2 id="combobox">UICombobox</h2>
		<p>
			Una lista propia sobre
			<a href="/popover">UIPopover</a>
			, con más JavaScript: úsala sólo si necesitas
			<code>searchable</code>
			,
			<code>filter</code>
			,
			<code>multiple</code>
			o
			<code>max</code>
			. El foco permanece en el disparador mientras
			<code>aria-activedescendant</code>
			recorre la lista. El campo Temas del primer ejemplo es un
			<code>UICombobox</code>
			. Con
			<code>multiple</code>
			, cada opción se alterna, la lista sigue abierta y el modelo es un array;
			<code>max</code>
			deshabilita el resto al llegar al límite.
		</p>
		<DocsCode bind:code="examples.combobox" />
		<p>
			Para buscar en un servidor, pasa una función
			<code>filter</code>
			que devuelva una promesa y use su
			<code>AbortSignal</code>
			. Sin resultados, muestra
			<code>empty</code>
			: por defecto,
			<code>Sin resultados</code>
			.
		</p>
		<DocsApi
			caption="Propiedades propias de UICombobox"
			bind:rows="[
				{ name: 'model', type: 'Signal<T | null> o Signal<T[]>', default: 'null', description: 'Valor elegido; un array con multiple.' },
				{ name: 'multiple', type: 'boolean', default: 'false', description: 'Permite elegir varias opciones.' },
				{ name: 'searchable / filter', type: 'boolean / ComboboxFilter<T>', description: 'Búsqueda en la lista, síncrona o asíncrona.' },
				{ name: 'max', type: 'number', description: 'Con multiple, número máximo de opciones elegidas.' },
			]"
		/>
		<p>
			El resto de propiedades son las de
			<code>UISelect</code>
			. Admite además los snippets
			<code>empty</code>
			y
			<code>loading</code>
			. Los tipos
			<code>UISelectProps</code>
			,
			<code>UIComboboxProps</code>
			,
			<code>SelectModel</code>
			y
			<code>ComboboxFilter</code>
			se exportan desde
			<code>@meekojs/ui/runtime</code>
			.
		</p>
	</DocsPage>
</template>
