<script lang="ts">
	import { examples } from '../utils/examples'

	interface Member {
		id: number
		name: string
		team: string
		role: string
		disabled?: boolean
	}

	const plans = ['Personal', 'Equipo', 'Empresa', 'Educación']
	const topics = ['Accesibilidad', 'Diseño', 'Documentación', 'Rendimiento', 'Pruebas', 'Seguridad']
	const members: Member[] = [
		{ id: 1, name: 'Lucía Martín', team: 'Diseño', role: 'Directora de arte' },
		{ id: 2, name: 'Andrés Pérez', team: 'Diseño', role: 'Diseñador de producto' },
		{ id: 3, name: 'Sofía Ramos', team: 'Ingeniería', role: 'Desarrolladora' },
		{ id: 4, name: 'Mateo Gil', team: 'Ingeniería', role: 'De vacaciones', disabled: true },
		{ id: 5, name: 'Valeria Ortiz', team: 'Ingeniería', role: 'Responsable de calidad' },
	]

	const plan = signal<string | null>(null)
	const chosen = signal<string[]>([])
	const owner = signal<Member | null>(null)
	const planError = signal<string | undefined>(undefined)
	const sent = signal('Elige un plan y hasta dos temas.')

	function validate() {
		planError.value = plan.value === null ? 'Elige un plan para continuar.' : undefined
	}
	function send(event: SubmitEvent) {
		event.preventDefault()
		const data = new FormData(event.currentTarget as HTMLFormElement)
		const entries = [...data.entries()].map(([name, value]) => name + '=' + String(value))
		sent.value = 'Enviado en este ejemplo: ' + entries.join(' · ')
	}
</script>

<template>
	<DocsPage
		title="Select"
		description="Elige una opción de una lista con UISelect o, para buscar o elegir varias, con UICombobox."
	>
		<p>
			<code>UISelect</code>
			es un botón que abre una lista propia, con el patrón de combobox de sólo selección: se ve y se maneja igual en todos los navegadores, con los tokens de UI, y un campo oculto envía su valor con el formulario.
			<code>UICombobox</code>
			añade a esa misma lista lo que una selección simple no necesita: buscar, filtrar en un servidor y elegir varias opciones. El tipo del modelo se infiere de
			<code>options</code>.
		</p>
		<h2 id="usage">Una opción en un formulario</h2>
		<p>
			Con
			<code>name</code>, el valor se envía con un formulario nativo sin código adicional. Abre la lista con <code>Intro</code>, <code>Espacio</code>, las flechas o un clic; muévete con las flechas, <code>Inicio</code> y <code>Fin</code>, o escribe para saltar a la opción que empieza por ese texto, y elige con <code>Intro</code> o <code>Espacio</code>. <code>Esc</code> y <code>Tab</code> cierran sin elegir. El foco no sale del disparador:
			<code>aria-activedescendant</code>
			recorre la lista.
		</p>
		<DocsPreview>
			<form
				id="select-form"
				class="docs-stack"
				on:submit="send"
			>
				<UIField
					id="plan"
					label="Plan"
					required
					bind:error="planError.value"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UISelect
							name="plan"
							placeholder="Elige un plan"
							required
							model="plan"
							bind:options="plans"
							bind:id="id"
							bind:describedBy="describedBy"
							bind:invalid="Boolean(planError.value)"
							on:change="validate"
						/>
					</snippet>
				</UIField>
				<UIField
					id="topics"
					label="Temas"
					description="Hasta dos temas. La búsqueda ignora acentos y mayúsculas."
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UICombobox
							name="topics"
							multiple
							searchable
							placeholder="Busca un tema"
							model="chosen"
							bind:options="topics"
							bind:max="2"
							bind:id="id"
							bind:describedBy="describedBy"
						/>
					</snippet>
				</UIField>
				<div class="docs-actions">
					<UIButton
						type="submit"
						on:click="validate"
					>
						Enviar selección
					</UIButton>
				</div>
				<p
					id="select-sent"
					class="docs-status"
					role="status"
				>
					{sent.value}
				</p>
			</form>
		</DocsPreview>
		<DocsCode bind:code="examples.select" />
		<UIAlert color="info">
			Con
			<code>required</code>, un formulario sin valor no se envía: el disparador recibe el foco y <code>aria-invalid</code>, sin el aviso del navegador. Escribe además un mensaje visible con <code>UIField</code>, como en el ejemplo. Con <code>useForm</code>, pasa
			<code>bind:field="form.field('plan')"</code>
			y el campo aporta el id, el nombre, el valor y el estado de error.
		</UIAlert>
		<h2 id="behavior">Lista, formulario y carga</h2>
		<p>
			La lista es un
			<code>role="listbox"</code>
			dentro de un
			<a href="/popover">UIPopover</a>, con entrada animada que respeta <code>prefers-reduced-motion</code>. Sus opciones se crean la primera vez que se abre y se conservan después: una lista cerrada no envía opciones en el HTML del servidor. El disparador abre su popover con
			<code>popovertarget</code>
			antes de que llegue el JavaScript, y las opciones aparecen al hidratar; sin JavaScript no se puede elegir, pero el formulario envía el valor con el que se sirvió la página.
		</p>
		<p>
			Un valor que ya no está en
			<code>options</code>
			sigue en el modelo, en el disparador y en el formulario. Sin valor, el formulario envía el nombre con un texto vacío. Un
			<code>reset</code>
			del formulario devuelve el select al valor con el que se montó y emite <code>change</code>.
		</p>
		<h2 id="objects">Objetos, grupos y opciones propias</h2>
		<p>
			Las opciones pueden ser objetos.
			<code>by</code>
			decide cómo se comparan,
			<code>labelBy</code>
			qué texto se muestra y se busca,
			<code>groupBy</code>
			añade un encabezado por grupo y una opción con
			<code>disabled: true</code>
			no se puede elegir: el teclado la salta. Los snippets
			<code>option</code>
			y
			<code>value</code>
			reciben la opción con su tipo, y
			<code>group</code>, el nombre del grupo; los tres pintan lo mismo en todos los navegadores. La opción elegida lleva una marca al final.
		</p>
		<DocsPreview>
			<div class="docs-stack">
				<UIField
					id="owner"
					label="Responsable"
				>
					<snippet
						name="default"
						params="id, describedBy"
					>
						<UISelect
							by="id"
							labelBy="name"
							groupBy="team"
							placeholder="Asigna una persona"
							clearable
							model="owner"
							bind:options="members"
							bind:id="id"
							bind:describedBy="describedBy"
						>
							<snippet
								name="option"
								params="member"
							>
								{member.name}
								<UIBadge>{member.role}</UIBadge>
							</snippet>
							<snippet
								name="value"
								params="member"
							>
								{member.name} · {member.team}
							</snippet>
						</UISelect>
					</snippet>
				</UIField>
				<p
					id="owner-status"
					class="docs-status"
					role="status"
				>
					{owner.value ? owner.value.name + ' es responsable de ' + owner.value.team.toLowerCase() + '.' : 'Sin responsable asignado.'}
				</p>
			</div>
		</DocsPreview>
		<DocsCode bind:code="examples.selectObjects" />
		<h2 id="api">API de UISelect</h2>
		<DocsApi
			caption="Propiedades de UISelect"
			bind:rows="[
				{ name: 'options', type: 'readonly T[]', description: 'Obligatoria. Primitivos u objetos.' },
				{ name: 'model', type: 'Signal<T | null>', default: 'null', description: 'Valor elegido.' },
				{ name: 'by / labelBy / disabledBy / groupBy', type: 'clave o función', description: 'Comparación, etiqueta, deshabilitado y grupo de cada opción.' },
				{ name: 'clearable / clearLabel', type: 'boolean / string', default: 'false / Quitar selección', description: 'Botón accesible que quita la selección y devuelve el foco al disparador. La etiqueta por defecto sigue el idioma del documento (véase Temas).' },
				{ name: 'name / required / disabled', type: 'string / boolean', description: 'Envío y validación del formulario.' },
				{ name: 'field', type: 'SelectField', description: 'Un campo de useForm: id, name, valor, aria-invalid y aria-describedby.' },
				{ name: 'id / label / describedBy / invalid', type: 'string / boolean', description: 'Identidad y estado accesible del disparador.' },
				{ name: 'placeholder', type: 'string', description: 'Texto sin valor.' },
				{ name: 'placement / offset', type: 'PopoverPlacement / number', default: 'bottom-start / 4', description: 'Posición de la lista respecto al disparador y separación en píxeles.' },
				{ name: 'class / listClass', type: 'string', description: 'Clases de la raíz y de la caja flotante de la lista.' },
				{ name: 'ui', type: 'objeto de clases', description: 'Clases por parte: base, trigger, value, placeholder, chevron, list, group, groupLabel, option, indicator y clear.' },
			]"
		/>
		<p>
			Admite los snippets
			<code>option</code>,
			<code>value</code>
			y
			<code>group</code>, y el evento <code>change</code>. <code>multiple</code>, <code>searchable</code>,
			<code>filter</code>
			y
			<code>max</code>
			son un error de tipos que indica
			<code>UICombobox</code>.
		</p>
		<h2 id="combobox">UICombobox</h2>
		<p>
			La misma lista sobre
			<a href="/popover">UIPopover</a>, con un campo de búsqueda como disparador: úsala si necesitas <code>searchable</code>, <code>filter</code>,
			<code>multiple</code>
			o
			<code>max</code>. El campo Temas del primer ejemplo es un <code>UICombobox</code>. Con <code>multiple</code>, cada opción se alterna, la lista sigue abierta y el modelo es un array;
			<code>max</code>
			deshabilita el resto al llegar al límite.
		</p>
		<DocsCode bind:code="examples.combobox" />
		<p>
			Para buscar en un servidor, pasa una función
			<code>filter</code>
			que devuelva una promesa y use su
			<code>AbortSignal</code>. Sin resultados, muestra <code>empty</code>: por defecto, <code>Sin resultados</code>.
		</p>
		<DocsApi
			caption="Propiedades propias de UICombobox"
			bind:rows="[
				{ name: 'model', type: 'Signal<T | null> o Signal<T[]>', default: 'null', description: 'Valor elegido; un array con multiple.' },
				{ name: 'multiple', type: 'boolean', default: 'false', description: 'Permite elegir varias opciones.' },
				{ name: 'searchable / filter', type: 'boolean / ComboboxFilter<T>', description: 'Búsqueda en la lista, síncrona o asíncrona.' },
				{ name: 'max', type: 'number', description: 'Con multiple, número máximo de opciones elegidas.' },
			]"
		/>
		<p>
			El resto de propiedades son las de
			<code>UISelect</code>. Admite además los snippets
			<code>empty</code>
			y
			<code>loading</code>. Los tipos <code>UISelectProps</code>, <code>UIComboboxProps</code>,
			<code>SelectModel</code>
			y
			<code>ComboboxFilter</code>
			se exportan desde
			<code>@meekojs/ui/runtime</code>.
		</p>
	</DocsPage>
</template>
