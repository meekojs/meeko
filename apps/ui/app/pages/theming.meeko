			caption="Tokens principales"
			bind:rows="[
				{ name: '--ui-color-bg / -bg-subtle', type: 'color', description: 'Fondo de la página y bandas discretas.' },
				{ name: '--ui-color-surface / -surface-raised', type: 'color', description: 'Card, panel y tabla; popover y modal.' },
				{ name: '--ui-color-control / -hover / -active', type: 'color', description: 'Fondo de un control y sus estados.' },
				{ name: '--ui-color-text / -text-soft', type: 'color', description: 'Texto y texto secundario.' },
				{ name: '--ui-color-border / -border-strong / -control-border', type: 'color', description: 'Separadores, bordes discretos y borde de un campo con 3:1 o más.' },
