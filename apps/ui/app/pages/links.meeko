				description="Conecta tus colores, radios y tipografía con los tokens de UI."
			/>
		</div>
		<DocsApi
			caption="Propiedades de UILinkCard"
			bind:rows="[
				{ name: 'href', type: 'string', description: 'Obligatoria. Destino de toda la superficie.' },
				{ name: 'title', type: 'string', description: 'Obligatoria. Texto principal del enlace.' },
