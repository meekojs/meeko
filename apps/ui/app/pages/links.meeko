		</div>
		<DocsCode bind:code="examples.link" />
		<DocsApi
			caption="Propiedades de UILink"
			bind:rows="[
				{ name: 'to', type: 'RouteId', description: 'Ruta de la aplicación, con navegación del cliente. Excluye href, target y rel.' },
				{ name: 'params / search', type: 'parámetros de la ruta / objeto', description: 'Con to: los parámetros de una ruta dinámica (obligatorios en ella) y la query string.' },
				{ name: 'href', type: 'string', description: 'Cualquier URL. Excluye to; hace falta uno de los dos.' },
				{ name: 'variant / size / shape', type: 'UIActionVariant / UIActionSize / UIActionShape', default: 'primary / md / rounded', description: 'Misma API visual que UIButton.' },
				{ name: 'target / rel', type: 'string', description: 'Atributos nativos del enlace. Para _blank se añade noopener noreferrer cuando rel no está definido.' },
