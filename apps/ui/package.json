{
	"name": "meeko-ui-site",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -F meeko-docs run build && node ../../packages/docs/scripts/assets.mjs && meeko build .",
		"check": "pnpm -F meeko-docs run build && meeko check .",
		"dev": "pnpm -F meeko-docs run build && node ../../packages/docs/scripts/assets.mjs && meeko dev .",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"preview": "meeko preview .",
		"start": "meeko start .",
		"test:e2e": "node --test tests/*.e2e.mjs"
	},
	"dependencies": {
		"@meekojs/i18n": "workspace:*",
		"@meekojs/icon": "workspace:*",
		"@meekojs/meeko": "workspace:*",
		"@meekojs/ui": "workspace:*",
		"meeko-docs": "workspace:*",
		"meeko-docs-content": "workspace:*",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@iconify-json/lucide": "1.2.149",
		"@meekojs/eslint-plugin": "workspace:*",
		"@types/node": "^24.0.0",
		"eslint": "10.13.0",
		"jiti": "2.7.0",
		"playwright-core": "1.64.1",
		"typescript": "7.0.2",
		"vite": "8.3.5"
	}
}
