<script lang="ts">
const name = signal("");
const choice = signal<string | null>(null);
const saved = signal(false);
</script>

<template>
  <main>
    <header><div><h1>Una base para tu interfaz.</h1><p>Controles tipados, temas y estilos que puedes personalizar.</p></div><MeekoThemeToggle /></header>
    <section aria-labelledby="form-title">
    <h2 id="form-title">Datos del proyecto</h2>
    <form on:submit="(event) => { event.preventDefault(); saved.value = true; }">
      <UiField id="name" label="Nombre" description="El nombre que verá tu equipo." required>
        <snippet name="default" params="id, describedBy"><UiInput bind:id="id" bind:describedBy="describedBy" model="name" required /></snippet>
      </UiField>
      <UiField id="category" label="Tipo de proyecto">
        <snippet name="default" params="id, describedBy"><MeekoSelect bind:id="id" bind:describedBy="describedBy" bind:options="['Sitio web', 'Aplicación', 'Documentación']" model="choice" placeholder="Selecciona un tipo" /></snippet>
      </UiField>
      <div class="actions"><UiButton type="submit">Guardar proyecto</UiButton><UiButton variant="secondary" on:click="() => { name.value = ''; choice.value = null; saved.value = false; }">Restablecer</UiButton></div>
      <p class="status" role="status">{saved.value ? 'Proyecto guardado para esta demostración.' : 'Completa los datos para probar los controles.'}</p>
    </form>
    </section>
  </main>
</template>

