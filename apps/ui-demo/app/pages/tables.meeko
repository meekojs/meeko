<script lang="ts">
	import type { TableColumn } from '@meekojs/ui/runtime'

	interface Project {
		id: number
		name: string
		category: string
		status: string
	}
	const columns = [
		{ key: 'name', label: 'Proyecto', footer: 'Total de proyectos' },
		{ key: 'category', label: 'Tipo', footer: (rows) => rows.length },
		{ key: 'status', label: 'Estado', footer: 'Equipo Meeko', format: (value) => value.toUpperCase() },
	] satisfies TableColumn<Project>[]
	const environmentColumns = [
		{ key: 'name', label: 'Entorno' },
		{ key: 'value', label: 'Valor' },
	] satisfies TableColumn<{ name: string; value: string }>[]
	const environment = [{ name: 'Entorno', value: 'Desarrollo' }]
	const layout = signal<'native' | 'grid'>('native')
	const projects = signal<Project[]>([
		{ id: 1, name: 'Sitio principal', category: 'Sitio web', status: 'Publicado' },
		{ id: 2, name: 'Panel de clientes', category: 'Aplicación', status: 'En desarrollo' },
		{ id: 3, name: 'Guía de componentes', category: 'Documentación', status: 'Publicado' },
	])
	function addProject() {
		const id = Math.max(0, ...projects.value.map((project) => project.id)) + 1
		projects.value = [...projects.value, { id, name: 'Proyecto ' + id, category: 'Aplicación', status: 'Borrador' }]
	}
</script>

<template>
	<main class="table-demo">
		<MeekoLink to="/">Volver a los controles</MeekoLink>
		<h1>Una tabla, dos formas de distribuirla.</h1>
		<p>El modo nativo ajusta las columnas al contenido. Grid permite definir sus proporciones.</p>
		<div class="table-demo-controls">
			<label for="table-layout">Distribución</label>
			<select
				id="table-layout"
				bind:value="layout.value"
				on:change="(event) => (layout.value = event.currentTarget.value === 'grid' ? 'grid' : 'native')"
			>
				<option value="native">Nativa</option>
				<option value="grid">Grid</option>
			</select>
			<UIButton on:click="addProject">Añadir proyecto</UIButton>
			<MeekoThemeToggle />
		</div>
		<UITable
			caption="Proyectos del equipo"
			bind:columns="columns"
			bind:rows="projects.value"
			rowKey="id"
			bind:layout="layout.value"
			gridColumns="minmax(180px, 2fr) minmax(180px, 3fr) 160px"
		/>
		<UITable
			caption="Tabla sin cabecera ni pie"
			class="table-demo-secondary"
			bind:columns="environmentColumns"
			bind:rows="environment"
			rowKey="name"
			hideHeader
		>
			<snippet
				name="cell"
				params="row, column, value"
			>
				<strong if:when="column.key === 'name'">{row.name}</strong>
				<span if:when="column.key !== 'name'">{String(value)}</span>
			</snippet>
		</UITable>
		<UITable
			caption="Tabla vacía"
			class="table-demo-secondary"
			bind:columns="environmentColumns"
			bind:rows="[]"
			rowKey="name"
			layout="grid"
		/>
	</main>
</template>

<style>
	.table-demo {
		margin: auto;
		padding: clamp(1.5rem, 5vw, 4rem);
		max-width: 68rem;
	}
	.table-demo h1 {
		margin: 2rem 0 1rem;
		max-width: 45rem;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.1;
	}
	.table-demo > p {
		max-width: 45rem;
		color: var(--meeko-ui-muted);
		line-height: 1.6;
	}
	.table-demo-controls {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem;
		margin: 2rem 0;
	}
	.table-demo-controls select {
		border: 1px solid var(--meeko-ui-border);
		border-radius: var(--meeko-ui-radius);
		background: var(--meeko-ui-surface);
		padding: 0.5rem 0.75rem;
		min-height: 2.5rem;
		color: var(--meeko-ui-text);
		font: inherit;
	}
	.table-demo-secondary {
		margin-top: 2rem;
	}
</style>
