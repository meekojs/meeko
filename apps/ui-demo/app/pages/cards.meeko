<script lang="ts">
	const count = signal(0)
	const variant = signal<'outline' | 'soft' | 'solid' | 'elevated'>('outline')
</script>

<template>
	<main class="card-demo">
		<MeekoLink to="/">Volver a los controles</MeekoLink>
		<div class="card-demo-heading">
			<div>
				<h1>Cards para componer tu interfaz.</h1>
				<p>Cuatro variantes con cabecera, contenido y acciones opcionales.</p>
			</div>
			<MeekoThemeToggle />
