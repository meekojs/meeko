<script lang="ts">
	const modal = useModal()
	const result = signal('Sin respuesta todavía.')
	const opened = signal(false)
	const locked = signal(false)
	async function ask() {
		try {
			const accepted = await modal.open<boolean>('ModalConfirm', { message: 'Puedes confirmar, cancelar o abrir otra instancia.' })
			result.value = accepted ? 'Acción confirmada.' : 'Acción cancelada.'
		} catch {
			result.value = 'No se pudo cargar el modal. Vuelve a intentarlo.'
		}
	}
</script>

<template>
	<main class="modal-demo">
		<MeekoLink to="/">Volver a los controles</MeekoLink>
		<h1>Modales con una respuesta.</h1>
		<p>Prueba una pila con tamaños grande, mediano y pequeño. Los diálogos de atrás conservan su estado y recuperan el foco al volver.</p>
		<div class="modal-demo-actions">
			<UIButton on:click="ask">Abrir confirmación</UIButton>
			<UIButton
				variant="secondary"
				on:click="() => (opened.value = true)"
			>
				Modal declarativo
			</UIButton>
			<UIButton
				variant="secondary"
				on:click="() => (locked.value = true)"
			>
				Cierre protegido
			</UIButton>
		</div>
		<p role="status">{result.value}</p>
	</main>
	<UIModal
		title="Un modal declarativo"
		description="Controlado con una señal y model."
		model="opened"
	>
		<label for="modal-name">Nombre</label>
		<UIInput
			id="modal-name"
			placeholder="Escribe tu nombre"
		/>
		<snippet name="footer"><UIButton on:click="() => (opened.value = false)">Listo</UIButton></snippet>
	</UIModal>
	<UIModal
		title="Cierre protegido"
		description="Escape y el fondo están desactivados."
		model="locked"
		bind:closeOnEscape="false"
		bind:closeOnBackdrop="false"
		bind:closeButton="false"
	>
		<p>Usa la acción explícita para cerrar este diálogo.</p>
		<snippet name="footer"><UIButton on:click="() => (locked.value = false)">Terminar</UIButton></snippet>
	</UIModal>
</template>

<style>
	.modal-demo {
		margin: auto;
		padding: clamp(1.5rem, 5vw, 4rem);
		max-width: 60rem;
	}
	.modal-demo h1 {
		margin: 2rem 0 1rem;
		max-width: 32rem;
		font-size: clamp(2rem, 5vw, 3.5rem);
		line-height: 1.1;
	}
	.modal-demo > p {
		max-width: 36rem;
		color: var(--meeko-ui-muted);
		line-height: 1.6;
	}
	.modal-demo-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin: 2rem 0;
	}
</style>
