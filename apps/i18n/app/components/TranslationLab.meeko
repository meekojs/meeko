<script lang="ts">
	const i18n = useI18n()
	const name = signal('Meeko')
	const total = signal(2)
	const role = signal('owner')
	const currency = signal('USD')
	const date = Date.UTC(2026, 0, 15, 12)
</script>

<template>
	<div
		class="locale-actions"
		role="group"
		aria-label="Idioma del ejemplo"
	>
		<UIButton
			variant="outline"
			bind:disabled="i18n.locale === 'es'"
			on:click="() => i18n.switchLocale('es')"
		>
			Español
		</UIButton>
		<UIButton
			variant="outline"
			bind:disabled="i18n.locale === 'en'"
			on:click="() => i18n.switchLocale('en')"
		>
			English
		</UIButton>
		<UIButton
			variant="outline"
			bind:disabled="i18n.locale === 'ar'"
			on:click="() => i18n.switchLocale('ar')"
		>
			العربية
		</UIButton>
	</div>
	<div class="translation-controls">
		<UIField
			id="translation-name"
			label="Nombre para traducir"
		>
			<snippet
				name="default"
				params="id, describedBy"
			>
				<UIInput
					model="name"
					bind:id="id"
					bind:describedBy="describedBy"
				/>
			</snippet>
		</UIField>
		<label for="translation-total">Cantidad de elementos: {total.value}</label>
		<input
			id="translation-total"
			type="range"
			min="0"
			max="12"
			step="1"
			bind:value="total.value"
			on:input="(event) => (total.value = Number(event.currentTarget.value))"
		/>
		<label for="translation-role">Permiso del usuario</label>
		<select
			id="translation-role"
			bind:value="role.value"
			on:change="(event) => (role.value = event.currentTarget.value)"
		>
			<option value="owner">Administrar</option>
			<option value="viewer">Consultar</option>
		</select>
		<label for="translation-currency">Moneda</label>
		<select
			id="translation-currency"
			bind:value="currency.value"
			on:change="(event) => (currency.value = event.currentTarget.value)"
		>
			<option value="USD">USD</option>
			<option value="EUR">EUR</option>
		</select>
	</div>
	<section
		class="translation-result"
		aria-label="Resultado traducido"
		aria-live="polite"
		aria-atomic="true"
		bind:lang="i18n.locale"
		bind:dir="i18n.locale === 'ar' ? 'rtl' : 'ltr'"
	>
		<p data-output="greeting">{i18n.t('greeting', { name: name.value })}</p>
		<p data-output="plural">{i18n.t('cart.items', { total: total.value })}</p>
		<p data-output="select">{i18n.t('invitation', { role: role.value, name: name.value })}</p>
		<dl>
			<div>
				<dt
					lang="es"
					dir="ltr"
				>
					Moneda
				</dt>
				<dd data-output="number">{i18n.number(12345.67, { style: 'currency', currency: currency.value })}</dd>
			</div>
			<div>
				<dt
					lang="es"
					dir="ltr"
				>
					Fecha · UTC
				</dt>
				<dd data-output="date">{i18n.date(date, { dateStyle: 'long', timeZone: 'UTC' })}</dd>
			</div>
		</dl>
	</section>
	<p>
		Idioma activo:
		<code>{i18n.locale}</code>
		. Datos de ejemplo locales. Cambiar idioma navega a otro documento; editar los controles no guarda información.
	</p>
</template>
