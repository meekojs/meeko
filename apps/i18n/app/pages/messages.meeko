	<DocsPage
		product="Meeko i18n"
		title="Mensajes y parámetros"
		description="Deja que TypeScript compruebe las claves y los valores que necesita cada mensaje."
	>
		<h2 id="interpolation">Interpolación</h2>
		<p>
			Escribe parámetros con la forma
