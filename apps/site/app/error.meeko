    <img src="/brand/meeko-logo.webp" width="132" height="132" alt="Meeko, la gatita del logo" />
    <p class="code">{props.status}</p>
    <h1 if:when="props.status === 404">Esta página no existe</h1>
    <h1 if:when="props.status !== 404">Algo salió mal</h1>
    <p if:when="props.status === 404">Meeko buscó por todas partes y no la encontró. Puede que el enlace sea antiguo o que la página haya cambiado de nombre.</p>
    <p if:when="props.status !== 404">No se pudo mostrar la página ({props.message}).</p>
    <p class="actions">
      <a class="primary" bind:href="home">Volver al inicio</a>
      <a bind:href="guide">Leer la guía</a>
    </p>
  </section>
</template>

