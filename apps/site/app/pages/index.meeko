<script server lang="ts">
	import { trustHtml } from '@meekojs/meeko'
	import { definePage } from '@meekojs/meeko/framework'
	import type { DemoMark, DemoSource } from '../../shared/types/demo.js'
	import { createHighlight, createTokenizer } from '../../server/content/highlight.js'
	import { codeBlockHtml, escapeHtml } from '../../server/content/markdown.js'
	import { githubUrl, readRepositoryFile } from '../../server/content/repository.js'

	export const route = definePage({ render: 'prerender' })

	// The live demo runs the counter example of the package; its source is tokenized here, line by
	// line, so the page can light the lines that declare and read the signal.
	const tokenize = await createTokenizer()
	const exampleFile = 'examples/counter/Counter.meeko'
	const exampleText = readRepositoryFile(exampleFile).trim()
	const exampleLines = exampleText.split('\n')
	const markOf = (text: string): DemoMark | undefined => (/\bsignal\(/.test(text) ? 'count' : /\bcomputed\(/.test(text) ? 'doubled' : /\{count\.value\}/.test(text) ? 'render' : undefined)
	export const demo: DemoSource = {
		file: exampleFile,
		url: githubUrl(exampleFile),
		lines: tokenize(exampleText, 'meeko').map((tokens, index) => {
			const html = trustHtml(tokens.map((token) => `<span style="${escapeHtml(token.style)}">${escapeHtml(token.content)}</span>`).join(''))
			// The page state is JSON: a line without a mark leaves the key out instead of `undefined`.
			const mark = markOf(exampleLines[index] ?? '')
			return mark ? { html, mark } : { html }
		}),
		countLine: exampleLines.findIndex((line) => markOf(line) === 'count') + 1,
		doubledLine: exampleLines.findIndex((line) => markOf(line) === 'doubled') + 1,
	}
	// The editor frame shows the declarations and the template of the same file, lines 10 to 17.
	export const editorLines = demo.lines.slice(9, 17).map((line, index) => ({ html: line.html, number: index + 10, count: line.mark === 'count' }))
	export const command = 'pnpm exec meeko init-framework mi-app'
	// The quick start of the README (packages/meeko/README.md, «Crear una aplicación full-stack»).
	const highlight = await createHighlight()
	export const quickStart = codeBlockHtml('terminal', highlight([command, 'cd mi-app', 'npm install', 'npm run dev'].join('\n'), 'shellscript'))
	export const version = (JSON.parse(readRepositoryFile('package.json')) as { version: string }).version
	export const head = {
		title: 'Meeko · Componentes .meeko tipados, SSR e hidratación para TypeScript',
		description: 'Meeko es un motor de componentes para TypeScript y un framework full-stack: archivos .meeko tipados, signals, SSR con hidratación, API y RPC tipados y despliegue en Node, Bun, Deno y Cloudflare.',
	}
</script>

<script lang="ts">
	import { signal } from '@meekojs/meeko'

	export interface Props {
		params: Record<string, string>
		search: Record<string, string | string[]>
	}

	const api = href('/docs/[slug]', { params: { slug: 'api' } })
	const framework = href('/docs/[slug]', { params: { slug: 'framework' } })
	const editors = href('/docs/[slug]', { params: { slug: 'editors' } })
	const devtools = href('/docs/[slug]', { params: { slug: 'devtools' } })
	const stability = href('/docs/[slug]', { params: { slug: 'stability' } })
	const quickStartPage = href('/docs/[slug]', { params: { slug: 'inicio-rapido' } })
	const copied = signal<'idle' | 'done' | 'error'>('idle')
	let reset: ReturnType<typeof setTimeout> | undefined

	function copyCommand(): void {
		copyText(command).then(
			() => (copied.value = 'done'),
			() => (copied.value = 'error'),
		)
		if (reset !== undefined) clearTimeout(reset)
		reset = setTimeout(() => (copied.value = 'idle'), 1800)
	}
</script>

<template>
	<section
