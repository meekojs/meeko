					data-copy
				>
					Copiar
				</button>
			</div>
			<div html="example.html"></div>
		</div>
	</section>

	<DocsLayout
		bind:nav="nav"
		bind:current="'/'"
		bind:toc="readme.toc"
		bind:pager="pages"
		bind:editUrl="readme.editUrl"
		bind:source="readme.source"
	>
		<h2
			class="quick-start"
			id="inicio-rápido"
		>
			Inicio rápido
		</h2>
		<article
			class="prose"
			data-pagefind-body
			html="readme.html"
			on:click="copyCodeBlock"
		></article>
	</DocsLayout>
</template>

