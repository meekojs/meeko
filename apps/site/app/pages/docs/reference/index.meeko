		font-weight: 560;
		font-size: 0.95rem;
	}
	.tally {
		color: var(--muted);
		font: 500 0.75rem var(--font-mono);
		font-variant-numeric: tabular-nums;
	}
	.card-text {
		color: var(--muted);
		font-size: 0.86rem;
		line-height: 1.5;
	}
	.card-text :global(code) {
		font-size: 0.86em;
	}
	.group h2 {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}
	.group h2 svg {
		width: 20px;
		height: 20px;
		color: var(--ink-soft);
	}
	.group-description {
		max-width: 46rem;
		color: var(--ink-soft);
	}
	.entries {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2rem;
		margin: 0;
		border-top: 1px solid var(--line);
		padding: 0;
		list-style: none;
	}
	.entries li {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		margin: 0;
		border-bottom: 1px solid var(--line);
		padding: 0.6rem 0;
	}
	.name {
		text-decoration: none;
		overflow-wrap: anywhere;
	}
	.name code {
		border: 0;
		background: none;
		padding: 0;
		color: var(--accent-ink);
		font-weight: 500;
		font-size: 0.88rem;
	}
	.name:hover code {
		text-decoration: underline;
		text-underline-offset: 0.18em;
	}
	.summary {
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.5;
	}
	.summary :global(code) {
		font-size: 0.84em;
	}
	.modules {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin: 0;
		padding: 0;
