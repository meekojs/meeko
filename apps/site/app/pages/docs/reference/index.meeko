<script server lang="ts">
	import { definePage } from '@meekojs/meeko/framework'
	import { apiGroups, exportsHref, groupHref, referenceHref } from '../../../../server/content/api-groups.js'
	import { referenceIndex, referenceNavigation } from '../../../../server/content/reference.js'
	import { groupIcons, taxonomyPath } from '../../../../server/content/reference-taxonomy.js'
	import { githubUrl } from '../../../../server/content/repository.js'

	// The index of the reference: the groups of docs/reference/taxonomy.json, each with its symbols
	// (server/content/reference.ts). Every export by module is at /docs/reference/exports.
	export const route = definePage({ render: 'prerender' })

	export const groups = await referenceIndex()
	export const total = groups.reduce((sum, group) => sum + group.entries.length, 0)
	// The anchors of the earlier index (`/docs/reference#framework`) stay, on the modules at the end.
	export const modules = apiGroups().map((group) => ({ id: group.id, label: group.specifier ?? group.title, href: groupHref(group), code: group.specifier !== null }))
	export const exportsIcon = groupIcons.exports!
	export const exportsLink = exportsHref
	export const nav = await referenceNavigation()
	export const current = referenceHref
	export const toc = [...groups.map((group) => ({ id: group.anchor, text: group.title, level: 2 })), { id: 'todos-los-exports', text: 'Todos los exports', level: 2 }]
	const first = groups[0]?.entries[0]
	export const pages = {
		previous: { href: '/docs/api', label: 'Componentes y API' },
		next: first ? { href: first.href, label: first.name } : null,
	}
	export const source = taxonomyPath
	export const editUrl = githubUrl(source, 'edit')
	export const head = {
		title: 'Referencia de la API · Meeko',
		description: 'Cada componente, macro, composable, función de reactividad, utilidad, directiva, API de servidor, adaptador, comando y opción de configuración de Meeko, con su tipo exacto, ejemplos y errores comunes.',
	}
</script>

<script lang="ts">
	export interface Props {
		params: Record<string, string>
		search: Record<string, string | string[]>
	}
</script>

<template>
	<DocsLayout
		bind:nav="nav"
		bind:current="current"
		bind:toc="toc"
		bind:pager="pages"
		bind:editUrl="editUrl"
		bind:source="source"
	>
		<article class="prose reference-index">
			<h1>Referencia de la API</h1>
			<p class="lead">
				{total} símbolos de Meeko agrupados por lo que son. Cada página explica uno con su tipo exacto, generado desde el código fuente, sus parámetros, ejemplos reales y los errores que da usarlo mal.
			</p>
			<ul
				class="cards"
				aria-label="Grupos de la referencia"
			>
				<li
					each:of="groups"
					each:as="group"
					each:key="group.anchor"
				>
					<a
						class="card"
						bind:href="'#' + group.anchor"
					>
						<span class="card-head">
							<svg
								viewBox="0 0 16 16"
								aria-hidden="true"
							>
								<path bind:d="group.icon" />
							</svg>
							<span class="card-title">{group.title}</span>
							<span class="tally">{group.entries.length}</span>
						</span>
						<span
							class="card-text"
							html="group.description"
						></span>
					</a>
				</li>
				<li>
					<a
						class="card"
						bind:href="exportsLink"
					>
						<span class="card-head">
							<svg
								viewBox="0 0 16 16"
								aria-hidden="true"
							>
								<path bind:d="exportsIcon" />
							</svg>
							<span class="card-title">Todos los exports</span>
						</span>
						<span class="card-text">Cada export de cada módulo del paquete, con su página generada desde el JSDoc.</span>
					</a>
				</li>
			</ul>

			<section
				class="group"
				each:of="groups"
				each:as="group"
				each:key="group.anchor"
			>
				<h2 bind:id="group.anchor">
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path bind:d="group.icon" />
					</svg>
					{group.title}
					<a
						class="heading-anchor"
						bind:href="'#' + group.anchor"
						aria-label="Enlace a esta sección"
						data-pagefind-ignore
					>
						#
					</a>
				</h2>
				<p
					class="group-description"
					html="group.description"
				></p>
				<ul class="entries">
					<li
						each:of="group.entries"
						each:as="entry"
						each:key="entry.name"
					>
						<a
							class="name"
							bind:href="entry.href"
						>
							<code>{entry.name}</code>
						</a>
						<span
							class="summary"
							html="entry.description"
						></span>
					</li>
				</ul>
			</section>

			<section class="group">
				<h2 id="todos-los-exports">
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path bind:d="exportsIcon" />
					</svg>
					Todos los exports
					<a
						class="heading-anchor"
						href="#todos-los-exports"
						aria-label="Enlace a esta sección"
						data-pagefind-ignore
					>
						#
					</a>
				</h2>
				<p class="group-description">
					Los tipos, las interfaces y las piezas de bajo nivel que no tienen su propia entrada arriba siguen documentados, uno por página, en el
					<a bind:href="exportsLink">índice por módulo</a>
					.
				</p>
				<ul class="modules">
					<li
						each:of="modules"
						each:as="module"
						each:key="module.id"
						bind:id="module.id"
					>
						<a bind:href="module.href">
							<code if:when="module.code">{module.label}</code>
							<span if:when="!module.code">{module.label}</span>
						</a>
					</li>
				</ul>
			</section>
		</article>
	</DocsLayout>
</template>

<style scoped>
