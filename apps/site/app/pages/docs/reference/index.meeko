		max-width: 60rem;
	}
	.lead {
		max-width: 46rem;
		color: var(--ink-soft);
		font-size: 1.05rem;
	}
	svg {
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
		width: 16px;
		height: 16px;
	}
	.cards {
		display: grid;
		max-width: none;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.6rem;
