		color: var(--ink-soft);
		font-size: 0.9em;
	}
	section + section {
		margin-top: 2.75rem;
	}
	h2 {
		margin: 0 0 1rem;
		border-bottom: 1px solid var(--line);
		padding-bottom: 0.75rem;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
	}
	ul {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(16.5rem, 1fr));
		gap: 0.75rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: flex;
		flex-direction: column;
		gap: 0.45rem;
		transition:
			border-color 0.15s,
			background-color 0.15s;
		border: 1px solid var(--line);
