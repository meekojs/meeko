<script server lang="ts">
	import { definePage } from '@meekojs/meeko/framework'
	import type { NavSection, Pager, RenderedDoc } from '../../../shared/types/docs'
	import { readPage } from '../../../server/content/db'

	export const route = definePage({ render: 'ssr' })

	const { params } = usePage()
	type GuidePage = {
		readonly doc: RenderedDoc
		readonly nav: readonly NavSection[]
		readonly pages: Pager
		readonly current: string
		readonly head: { readonly title: string; readonly description: string }
	}
	const snapshot = await readPage<GuidePage>(`/docs/${params.slug}`)
	if (!snapshot) notFound()
	export const { doc, nav, pages, current, head } = snapshot
</script>

<script lang="ts">
	export interface Props {
		params: { slug: string }
		search: Record<string, string | string[]>
	}
</script>

<template>
	<DocsLayout
		bind:nav="nav"
		bind:current="current"
		bind:toc="doc.toc"
		bind:pager="pages"
		bind:editUrl="doc.editUrl"
		bind:source="doc.source"
	>
		<article
			class="prose"
			data-pagefind-body
			html="doc.html"
			on:click="copyCodeBlock"
		></article>
	</DocsLayout>
</template>
