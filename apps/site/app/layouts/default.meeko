	const start = href('/docs/[slug]', { params: { slug: 'inicio-rapido' } })

	/** Folds the small-screen menu once a link in it is chosen. */
	function closeMenu(event: MouseEvent): void {
		if (event.target instanceof Element && event.target.closest('a')) (event.currentTarget as HTMLElement).closest('details')?.removeAttribute('open')
	}
</script>

