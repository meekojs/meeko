<script lang="ts">
	import { computed, signal } from '@meekojs/meeko'
	import type { DemoSource } from '../../shared/types/demo.js'

	interface Props {
		/** The counter example of the package, highlighted on the server line by line. */
		source: DemoSource
	}

	/** A write to `count`, as the DevTools timeline lists it. */
	interface SignalEvent {
		readonly id: number
		readonly from: number
		readonly to: number
	}

	const props = defineProps<Props>()

	// The same state as examples/counter/Counter.meeko, rendered on the server and hydrated here.
	const count = signal(0)
	const doubled = computed(() => count.value * 2)
	const events = signal<readonly SignalEvent[]>([])
	const fileName = computed(() => props.source.file.split('/').pop() ?? props.source.file)
	/** Alternates on every change so the CSS flash restarts; absent until the first change. */
	const pulse = computed(() => {
		const latest = events.value[0]
		return latest === undefined ? undefined : latest.id % 2 ? 'a' : 'b'
	})
	const announcement = computed(() => (events.value.length ? `count vale ${count.value}; doubled vale ${doubled.value}.` : ''))

	function increment(): void {
		const from = count.value
		count.value++
		const id = (events.value[0]?.id ?? 0) + 1
		events.value = [{ id, from, to: count.value }, ...events.value].slice(0, 4)
	}

	function reset(): void {
		count.value = 0
		events.value = []
	}
</script>

<template>
	<figure
		class="demo"
		aria-labelledby="demo-caption"
	>
		<div class="window">
			<div class="titlebar">
				<p class="path">
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path d="M4 1.5h5.5L13 5v9.5H4z M9.5 1.5V5H13" />
					</svg>
					<span class="dir">examples / counter /</span>
					<b>{fileName.value}</b>
				</p>
				<button
					type="button"
					class="reset"
					on:click="reset"
					bind:disabled="events.value.length === 0"
				>
					Reiniciar
				</button>
			</div>
			<div class="panes">
				<section
					class="pane code"
					aria-label="Código de Counter.meeko"
				>
					<header class="pane-head">
						<span>Editor</span>
						<a
							bind:href="props.source.url"
							rel="noopener"
						>
							Ver en GitHub
						</a>
					</header>
					<pre
						class="shiki source"
						tabindex="0"
						aria-label="Counter.meeko"
						bind:data-pulse="pulse.value"
					><code><span
							class="line"
							each:of="props.source.lines"
							each:as="line"
							each:index="index"
							bind:data-mark="line.mark"
						><span
								class="ln"
								aria-hidden="true"
							>{index + 1}</span><span
								class="text"
								html="line.html"
							></span></span></code></pre>
				</section>
				<section
					class="pane result"
					aria-label="Resultado en el navegador"
				>
					<header class="pane-head">
						<span>Resultado</span>
						<span class="note">SSR e hidratado en esta página</span>
					</header>
					<div class="stage">
						<button
							type="button"
							class="counter"
							on:click="increment"
						>
							{count.value} · doble: {doubled.value}
						</button>
						<p class="hint">Pulsa el botón: cambia la señal y sólo se actualiza su texto.</p>
					</div>
				</section>
				<section
					class="pane devtools"
					aria-label="Representación de DevTools"
				>
					<header class="pane-head">
						<span>DevTools</span>
						<span class="tag">representación</span>
					</header>
					<div class="tree">
						<span class="node">&lt;Counter&gt;</span>
						<span class="instance">#1</span>
					</div>
					<p class="group-title">Props</p>
					<dl class="rows">
						<div class="row">
							<dt>initial</dt>
							<dd class="value muted">undefined</dd>
							<dd class="site"></dd>
						</div>
					</dl>
					<p class="group-title">Señales</p>
					<dl class="rows">
						<div
							class="row signal"
							bind:data-flash="pulse.value"
						>
							<dt>count</dt>
							<dd class="value">{count.value}</dd>
							<dd class="site">{fileName.value}:{props.source.countLine}</dd>
						</div>
						<div
							class="row derived"
							bind:data-flash="pulse.value"
						>
							<dt>
								doubled
								<span class="kind">computed</span>
							</dt>
							<dd class="value">{doubled.value}</dd>
							<dd class="site">{fileName.value}:{props.source.doubledLine}</dd>
						</div>
					</dl>
					<p class="group-title">Línea de tiempo</p>
					<ol class="timeline">
						<li
							each:of="events.value"
							each:as="event"
							each:key="event.id"
						>
							<span class="seq">{event.id}</span>
							<span class="name">count</span>
							<span class="change">{event.from} → {event.to}</span>
						</li>
					</ol>
					<p
						class="empty"
						if:when="events.value.length === 0"
					>
						Sin cambios todavía.
					</p>
					<p class="disclaimer">El panel real existe sólo en desarrollo, dentro de la página o en Chrome DevTools.</p>
				</section>
			</div>
		</div>
		<figcaption
			id="demo-caption"
			class="fig-label"
		>
			<b>FIG. 01</b>
			<span>Counter.meeko del repositorio, su resultado y una representación de DevTools</span>
		</figcaption>
		<p
			class="sr-only"
			aria-live="polite"
		>
			{announcement.value}
		</p>
	</figure>
</template>

<style scoped>
	.demo {
		position: relative;
		margin: 0;
	}
	.window {
		position: relative;
		mask-image: linear-gradient(to bottom, #000 calc(100% - 3rem), transparent);
		box-shadow: var(--shadow-window);
		border: 1px solid var(--line-strong);
		border-bottom: 0;
		/* The window melts into the ground instead of ending on a hard edge (mask-image above). */
		border-radius: var(--radius-l) var(--radius-l) 0 0;
		background: var(--bg-raised);
		overflow: hidden;
	}
	.titlebar {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		border-bottom: 1px solid var(--line);
		background: var(--surface);
		padding: 0 0.6rem 0 1rem;
		height: 2.6rem;
	}
