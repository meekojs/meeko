		color: var(--muted);
		font: 400 0.7rem/1.6 var(--font-mono);
	}

	/* Editor */
	/* Long lines wrap under their own text (hanging indent), never past the pane; the line
	   number stays in its column. */
	.source {
		padding: 0.75rem 0;
		overflow: visible;
		font-size: 0.76rem;
		line-height: 1.75;
	}
	.source:focus-visible {
		outline-offset: -2px;
	}
	.line {
		display: grid;
		grid-template-columns: 3.4rem minmax(0, 1fr);
		transition: background-color 0.4s var(--ease-out);
		padding-right: 1rem;
		min-height: 1.75em;
	}
