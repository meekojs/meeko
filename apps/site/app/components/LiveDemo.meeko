	.source[data-pulse] .line[data-mark] .ln {
		color: var(--accent-ink);
		opacity: 1;
	}
	.source[data-pulse='a'] .line[data-mark='count'] {
		animation: line-a 0.9s var(--ease-out);
	}
	.source[data-pulse='b'] .line[data-mark='count'] {
		animation: line-b 0.9s var(--ease-out);
	}
	@keyframes line-a {
		from {
			background-color: color-mix(in oklab, var(--accent) 34%, transparent);
		}
	}
	@keyframes line-b {
		from {
			background-color: color-mix(in oklab, var(--accent) 34%, transparent);
		}
	}

	/* Result */
	.stage {
		display: grid;
		place-content: center;
		justify-items: center;
		gap: 1rem;
		padding: 3rem 1.25rem 1rem;
		min-height: 15rem;
		background:
			radial-gradient(circle at center, var(--line) 1px, transparent 1.5px) 0 0 / 18px 18px,
			transparent;
	}
