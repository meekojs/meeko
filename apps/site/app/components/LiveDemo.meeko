		min-width: 0;
		padding-bottom: 3rem;
	}
	.pane + .pane {
		border-left: 1px solid var(--line);
	}
	.pane-head {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 0.75rem;
		border-bottom: 1px solid var(--line-soft);
		padding: 0 1rem;
		height: 2.4rem;
		color: var(--ink-soft);
		font-weight: 500;
		font-size: 0.8rem;
	}
	.pane-head a {
		color: var(--muted);
		font-weight: 400;
		text-decoration: none;
	}
	.pane-head a:hover {
		color: var(--accent-ink);
	}
	.note {
		color: var(--muted);
		font-weight: 400;
	}
	.tag {
		border: 1px solid var(--line-strong);
