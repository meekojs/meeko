		animation: nose-a 1.1s var(--ease-out);
	}
	.signal[data-flash='b'] .value {
		animation: nose-b 1.1s var(--ease-out);
	}
	.derived[data-flash] .value {
		color: var(--accent-ink);
	}
	@keyframes flash-a {
