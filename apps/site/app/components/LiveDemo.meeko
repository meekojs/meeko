		transition:
			border-color 0.15s,
			background-color 0.15s,
			transform 0.12s var(--ease-out);
		cursor: pointer;
		box-shadow: var(--shadow-lg);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius);
		background: var(--surface-2);
