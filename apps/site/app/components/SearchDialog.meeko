<script lang="ts">
	import { computed, signal } from '@meekojs/meeko'
	import type { SearchResult } from '../utils/search.js'

	const dialog = useElementRef('dialog')
	const input = useElementRef('input')
	const query = signal('')
	const results = signal<readonly SearchResult[]>([])
	const status = signal<'idle' | 'loading' | 'ready' | 'empty' | 'unavailable'>('idle')
	/** Index of the highlighted link among every result and section link. */
	const active = signal(0)
	/** URLs of every link of the results in order: each page, then its sections. */
	const order = computed(() => results.value.flatMap((result) => [result.url, ...result.sections.map((section) => section.url)]))
	const activeUrl = computed(() => order.value[active.value])
	/** The modifier of the shortcut: Ctrl until the browser says it runs on an Apple platform. */
	const modifier = signal('Ctrl')
	let request = 0
	let timer: ReturnType<typeof setTimeout> | undefined

	function open(): void {
		const element = dialog.value
		if (!element || element.open) return
		preloadSearch()
		element.showModal()
		input.value?.select()
	}

	function close(): void {
		dialog.value?.close()
	}

	/** The link of the results at `index`, in the order of `order`. */
	function link(index: number): HTMLAnchorElement | undefined {
		return dialog.value?.querySelectorAll<HTMLAnchorElement>('a[data-result]')[index]
	}

	function move(step: number): void {
		const count = order.value.length
		if (!count) return
		active.value = (active.value + step + count) % count
		link(active.value)?.scrollIntoView({ block: 'nearest' })
	}

	function onKeydown(event: KeyboardEvent): void {
		if (event.key === 'ArrowDown') {
			event.preventDefault()
			move(1)
		} else if (event.key === 'ArrowUp') {
			event.preventDefault()
			move(-1)
		} else if (event.key === 'Enter') {
			const target = link(active.value)
			if (target) {
				event.preventDefault()
				target.click()
			}
		}
	}

	/** A click on the backdrop, outside the panel, closes the dialog. */
	function onDialogClick(event: MouseEvent): void {
		if (event.target === dialog.value) close()
	}

	async function run(text: string, id: number): Promise<void> {
		try {
			const found = await searchDocs(text)
			if (id !== request) return
			results.value = found
			active.value = 0
			status.value = found.length ? 'ready' : 'empty'
		} catch {
			if (id === request) status.value = 'unavailable'
		}
	}

	effect(() => {
		const text = query.value.trim()
		const id = ++request
		if (timer !== undefined) clearTimeout(timer)
		if (!text) {
			results.value = []
			status.value = 'idle'
			return
		}
		status.value = 'loading'
		timer = setTimeout(() => {
			void run(text, id)
		}, 120)
	})

	onMounted(() => {
		if (/Mac|iPhone|iPad/.test(navigator.userAgent)) modifier.value = '⌘'
		const onShortcut = (event: KeyboardEvent): void => {
			const target = event.target as HTMLElement | null
			const typing = target?.isContentEditable || /^(?:input|textarea|select)$/i.test(target?.tagName ?? '')
			if ((event.key === 'k' || event.key === 'K') && (event.ctrlKey || event.metaKey)) {
				event.preventDefault()
				open()
			} else if (event.key === '/' && !typing && !event.ctrlKey && !event.metaKey && !event.altKey) {
				event.preventDefault()
				open()
			}
		}
		document.addEventListener('keydown', onShortcut)
		return () => {
			document.removeEventListener('keydown', onShortcut)
			if (timer !== undefined) clearTimeout(timer)
		}
	})
</script>

<template>
	<button
		type="button"
		class="search-trigger"
		on:click="open"
		aria-label="Buscar en la documentación"
	>
		<svg
			viewBox="0 0 24 24"
			aria-hidden="true"
		>
			<circle
				cx="11"
				cy="11"
				r="7"
			/>
			<path d="m20 20-3.5-3.5" />
		</svg>
		<span class="label">Buscar…</span>
		<span
			class="keys"
			aria-hidden="true"
		>
			<kbd>{modifier.value}</kbd>
			<kbd>K</kbd>
		</span>
	</button>
	<dialog
		ref:dialog
		class="search"
		aria-label="Buscar en la documentación"
		on:click="onDialogClick"
		on:keydown="onKeydown"
	>
		<div class="panel">
			<div class="field">
				<svg
					viewBox="0 0 24 24"
					aria-hidden="true"
				>
					<circle
						cx="11"
						cy="11"
						r="7"
					/>
					<path d="m20 20-3.5-3.5" />
				</svg>
				<input
					ref:input
					id="meeko-search"
					name="q"
					type="search"
					model="query"
					placeholder="Buscar: signals, defineModel, prerender…"
					autocomplete="off"
					spellcheck="false"
					aria-label="Texto de búsqueda"
				/>
				<button
					type="button"
					class="close"
					on:click="close"
				>
					Esc
				</button>
			</div>
			<p
				class="hint"
				if:when="status.value === 'idle'"
			>
				Escribe para buscar en las guías y en la referencia de la API. Ábrela desde cualquier página con
				<kbd>/</kbd>
				o
				<kbd>{modifier.value}</kbd>
				<kbd>K</kbd>
				; muévete con las flechas y entra con
				<kbd>Intro</kbd>
				.
			</p>
			<p
				class="hint"
				if:when="status.value === 'loading'"
			>
				Buscando…
			</p>
			<p
				class="hint"
				if:when="status.value === 'empty'"
			>
				Sin resultados para «{query.value.trim()}».
			</p>
			<p
				class="hint"
				if:when="status.value === 'unavailable'"
			>
				El índice de búsqueda se genera con
				<code>pnpm run build</code>
				; no existe en
				<code>meeko dev</code>
				.
			</p>
			<ol
				class="results"
				if:when="status.value === 'ready'"
			>
				<li
					each:of="results.value"
					each:as="result"
					each:key="result.url"
				>
					<a
						data-result
						bind:href="result.url"
						on:click="close"
						bind:class="activeUrl.value === result.url ? 'page active' : 'page'"
					>
						<strong>{result.title}</strong>
						<span
							class="excerpt"
							html="result.excerpt"
						></span>
					</a>
					<ul
						class="sections"
						if:when="result.sections.length > 0"
					>
						<li
							each:of="result.sections"
							each:as="section"
							each:key="section.url"
						>
							<a
								data-result
								bind:href="section.url"
								on:click="close"
								bind:class="activeUrl.value === section.url ? 'active' : undefined"
							>
								<strong>{section.title}</strong>
								<span
									class="excerpt"
									html="section.excerpt"
								></span>
							</a>
						</li>
					</ul>
				</li>
			</ol>
		</div>
	</dialog>
</template>

<style scoped>
	.search-trigger {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition:
			border-color 0.15s,
			background-color 0.15s,
			color 0.15s;
		cursor: pointer;
		margin-right: 0.25rem;
		border: 1px solid var(--line);
		border-radius: 8px;
		background: var(--surface);
		padding: 0 0.35rem 0 0.65rem;
		min-width: 12.5rem;
		height: 32px;
		color: var(--muted);
		font-size: 0.84rem;
	}
	.search-trigger:hover {
		border-color: var(--line-strong);
		background: var(--surface-2);
		color: var(--ink-soft);
	}
	.search-trigger .label {
		flex: 1;
		text-align: left;
	}
	.keys {
		display: inline-flex;
		gap: 0.2rem;
	}
	.keys kbd {
		font-size: 0.7rem;
	}
	svg {
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-width: 1.6;
		width: 15px;
		height: 15px;
	}
	.search {
		margin: 12vh auto auto;
		box-shadow: var(--shadow-lg);
		border: 1px solid var(--line-strong);
		border-radius: var(--radius-l);
		background: var(--surface-2);
		padding: 0;
		width: min(40rem, calc(100vw - 2rem));
		max-height: min(34rem, calc(100dvh - 4rem));
		overflow: hidden;
		color: var(--ink);
	}
	.search[open] {
		animation: open 0.22s var(--ease-out);
	}
	@keyframes open {
		from {
			transform: translateY(-6px) scale(0.985);
			opacity: 0;
		}
	}
	.search::backdrop {
		background: var(--scrim);
	}
	.panel {
		display: flex;
		flex-direction: column;
		max-height: inherit;
	}
	.field {
		display: flex;
		align-items: center;
		gap: 0.7rem;
		border-bottom: 1px solid var(--line);
		padding: 0.95rem 1rem;
		color: var(--muted);
	}
	.field svg {
		width: 17px;
		height: 17px;
	}
	.field input {
		flex: 1;
		outline: 0;
		border: 0;
		background: transparent;
		min-width: 0;
		color: var(--ink);
		font-size: 1.02rem;
		caret-color: var(--accent);
	}
	.field input::-webkit-search-cancel-button {
		display: none;
	}
	.close {
		cursor: pointer;
		border: 1px solid var(--line-strong);
		border-radius: 5px;
		background: var(--surface-3);
		padding: 0.1rem 0.45rem;
		color: var(--muted);
		font: 500 0.72rem/1.5 var(--font-mono);
	}
	.close:hover {
		color: var(--ink);
	}
	.hint {
		margin: 0;
		padding: 1.1rem 1.1rem 1.25rem;
		color: var(--muted);
		font-size: 0.88rem;
		line-height: 1.7;
	}
	.hint code {
		color: var(--ink-soft);
		font-size: 0.85em;
	}
	.results {
		margin: 0;
		padding: 0.4rem;
		overflow-y: auto;
		list-style: none;
	}
	.results li {
		margin: 0;
	}
	.sections {
		margin: 0 0 0.3rem 0.9rem;
		border-left: 1px solid var(--line-strong);
		padding: 0 0 0 0.45rem;
		list-style: none;
	}
	a {
		display: block;
		border-radius: var(--radius-s);
		padding: 0.5rem 0.7rem;
		color: var(--ink);
		text-decoration: none;
	}
	a strong {
		display: block;
		font-weight: 520;
		font-size: 0.9rem;
	}
	a:hover,
	a.active {
		background: var(--surface-3);
	}
	a.active {
		box-shadow: inset 0 0 0 1px var(--accent-line);
	}
	.excerpt {
		display: block;
		margin-top: 0.1rem;
		color: var(--muted);
		font-size: 0.82rem;
		line-height: 1.5;
	}
	.excerpt :global(mark) {
		border-radius: 3px;
		background: var(--mark);
		padding: 0 1px;
		color: var(--ink);
	}
	@media (prefers-reduced-motion: reduce) {
		.search[open] {
			animation: none;
		}
	}
	@media (max-width: 1080px) {
		.search-trigger {
			min-width: 9.5rem;
		}
	}
	@media (max-width: 640px) {
		.search-trigger {
			justify-content: center;
			margin-right: 0;
			border-color: transparent;
			background: transparent;
			padding: 0;
			width: 32px;
			min-width: 0;
		}
		.search-trigger .label,
		.search-trigger .keys {
			display: none;
		}
		.search {
			margin-top: 0.75rem;
		}
	}
</style>
