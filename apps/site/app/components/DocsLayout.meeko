<script lang="ts">
	import { computed, signal } from '@meekojs/meeko'
	import type { NavSection, Pager, TocEntry } from '../../shared/types/docs.js'

	interface Props {
		nav: readonly NavSection[]
		/** URL of the page, to mark it in the sidebar. */
		current: string
		toc: readonly TocEntry[]
		pager: Pager
		/** "Edit on GitHub" link and repository path of the source. */
		editUrl: string
		source: string
	}

	const props = defineProps<Props>()
	// The page writes the article; `aside` adds a block under the table of contents.
	const snippets = defineSnippets<{ default: []; aside?: [] }>()
	const menuOpen = signal(false)
	const activeHeading = signal('')
	const toggle = useElementRef('toggle')
	const sidebar = useElementRef('sidebar')
	/** Label of the current page in the sidebar, for the small-screen bar. */
	const currentLabel = computed(() => props.nav.flatMap((section) => section.links).find((link) => link.href === props.current)?.label ?? 'Documentación')

	function toggleMenu(): void {
		menuOpen.value = !menuOpen.value
	}

	function closeMenu(): void {
		menuOpen.value = false
	}

	/** A chosen page closes the small-screen drawer. */
	function onNavClick(event: MouseEvent): void {
		if (event.target instanceof Element && event.target.closest('a')) closeMenu()
	}

	/** Folds the narrow-screen table of contents once a heading is chosen. */
	function closeMobileToc(event: MouseEvent): void {
		if (event.target instanceof Element && event.target.closest('a')) (event.currentTarget as HTMLElement).closest('details')?.removeAttribute('open')
	}

	// Marks in the table of contents the last heading that scrolled past the top of the viewport.
	onMounted(() => {
		const onKeydown = (event: KeyboardEvent): void => {
			if (event.key !== 'Escape' || !menuOpen.value) return
			closeMenu()
			toggle.value?.focus()
		}
		document.addEventListener('keydown', onKeydown)
		// The sidebar of the reference is long: the current page is brought into its view.
		effect(() => {
			void props.current
			requestAnimationFrame(() => {
				const nav = sidebar.value
				const link = nav?.querySelector<HTMLElement>('a[aria-current="page"]')
				if (!nav || !link) return
				if (link.offsetTop < nav.scrollTop || link.offsetTop + link.offsetHeight > nav.scrollTop + nav.clientHeight) nav.scrollTop = link.offsetTop - nav.clientHeight / 3
			})
		})
		let headings: HTMLElement[] = []
		let frame = 0
		const update = (): void => {
			frame = 0
			if (!headings.length) return
			let current = headings[0]!.id
			for (const heading of headings) {
				if (heading.getBoundingClientRect().top <= 140) current = heading.id
				else break
			}
			activeHeading.value = current
		}
		const schedule = (): void => {
			if (!frame) frame = requestAnimationFrame(update)
		}
		window.addEventListener('scroll', schedule, { passive: true })
		// The layout stays mounted while the table of contents changes with the page; the headings
		// of the new page render after it, so they are read on the next frame.
		effect(() => {
			const ids = props.toc.map((entry) => entry.id)
			requestAnimationFrame(() => {
				headings = ids.map((id) => document.getElementById(id)).filter((element): element is HTMLElement => element !== null)
				update()
			})
		})
		return () => {
			document.removeEventListener('keydown', onKeydown)
			window.removeEventListener('scroll', schedule)
			if (frame) cancelAnimationFrame(frame)
		}
	})
</script>

<template>
	<div
		class="docs"
		bind:data-menu="menuOpen.value ? 'open' : 'closed'"
	>
		<div
			class="docs-bar"
			data-pagefind-ignore
		>
			<button
				ref:toggle
				type="button"
				class="menu-toggle"
				on:click="toggleMenu"
				bind:aria-expanded="String(menuOpen.value)"
				aria-controls="docs-nav"
			>
				<svg
					viewBox="0 0 16 16"
					aria-hidden="true"
				>
					<path d="M2.5 4.5h11M2.5 8h11M2.5 11.5h7" />
				</svg>
				Índice
			</button>
			<span class="docs-bar-current">{currentLabel.value}</span>
		</div>
		<div
			class="scrim"
			aria-hidden="true"
			on:click="closeMenu"
		></div>
		<nav
			ref:sidebar
			id="docs-nav"
			class="sidebar"
			aria-label="Documentación"
			data-pagefind-ignore
			on:click="onNavClick"
		>
			<details
				bind:class="section.icon ? 'group has-icon' : 'group'"
				open
				each:of="props.nav"
				each:as="section"
				each:key="section.title"
			>
				<summary>
					<span class="group-title">
						<svg
							class="group-icon"
							if:when="section.icon"
							viewBox="0 0 16 16"
							aria-hidden="true"
						>
							<path bind:d="section.icon" />
						</svg>
						{section.title}
					</span>
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path d="m5.5 6.5 2.5 2.5 2.5-2.5" />
					</svg>
				</summary>
				<ul>
					<li
						each:of="section.links"
						each:as="link"
						each:key="link.label + link.href"
					>
						<a
							bind:href="link.href"
							bind:class="link.code ? 'symbol' : undefined"
							bind:aria-current="link.href === props.current ? 'page' : undefined"
						>
							{link.label}
						</a>
					</li>
				</ul>
			</details>
		</nav>
		<div class="content">
			<details
				class="toc-mobile"
				if:when="props.toc.length > 0"
				data-pagefind-ignore
			>
				<summary>
					En esta página
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path d="m5.5 6.5 2.5 2.5 2.5-2.5" />
					</svg>
				</summary>
				<ul on:click="closeMobileToc">
					<li
						each:of="props.toc"
						each:as="entry"
						each:key="entry.id"
						bind:class="entry.level === 3 ? 'nested' : undefined"
					>
						<a bind:href="'#' + entry.id">{entry.text}</a>
					</li>
				</ul>
			</details>
			<render snippet="snippets.default" />
			<footer
				class="page-footer"
				data-pagefind-ignore
			>
				<nav
					class="pager"
					aria-label="Páginas anterior y siguiente"
				>
					<a
						if:when="props.pager.previous"
						class="previous"
						bind:href="props.pager.previous?.href"
					>
						<small>Anterior</small>
						<span>{props.pager.previous?.label}</span>
					</a>
					<a
						if:when="props.pager.next"
						class="next"
						bind:href="props.pager.next?.href"
					>
						<small>Siguiente</small>
						<span>{props.pager.next?.label}</span>
					</a>
				</nav>
				<a
					class="edit"
					bind:href="props.editUrl"
					rel="noopener"
				>
					<svg
						viewBox="0 0 16 16"
						aria-hidden="true"
					>
						<path d="M3 13h2.6l7.2-7.2-2.6-2.6L3 10.4V13ZM9.2 4.2l2.6 2.6" />
					</svg>
					Editar en GitHub
					<span class="path">{props.source}</span>
				</a>
			</footer>
		</div>
		<aside
			class="toc"
			aria-label="En esta página"
			data-pagefind-ignore
		>
			<div class="toc-inner">
				<p
					class="toc-title"
					if:when="props.toc.length > 0"
				>
					En esta página
				</p>
				<ul>
					<li
						each:of="props.toc"
						each:as="entry"
						each:key="entry.id"
						bind:class="entry.level === 3 ? 'nested' : undefined"
					>
						<a
							bind:href="'#' + entry.id"
							bind:aria-current="activeHeading.value === entry.id ? 'location' : undefined"
						>
							{entry.text}
						</a>
					</li>
				</ul>
				<render snippet="snippets.aside" />
			</div>
		</aside>
	</div>
</template>

<style scoped>
	.docs {
		display: grid;
		grid-template-columns: 15rem minmax(0, 1fr) 13.5rem;
		gap: 3rem;
		margin: 0 auto;
		padding: 0 var(--gutter);
		max-width: var(--container);
	}
	.docs-bar,
	.scrim {
		display: none;
	}
	.sidebar,
	.toc-inner {
		position: sticky;
		top: var(--header-height);
		padding: 2rem 0 2.5rem;
		max-height: calc(100dvh - var(--header-height));
		overflow-y: auto;
	}
	/*
	 * The scrollbar shows only while the reader is in the panel. Chromium does not repaint
	 * ::-webkit-scrollbar-thumb on a parent :hover, so the panel hides its overflow instead;
	 * the stable gutter keeps the links from moving and scrollIntoView still works.
	 */
	@supports selector(::-webkit-scrollbar) {
		@media (hover: hover) {
			.sidebar,
			.toc-inner {
				scrollbar-gutter: stable;
				overflow-y: hidden;
			}
			.sidebar:hover,
			.sidebar:focus-within,
			.toc-inner:hover,
			.toc-inner:focus-within {
				overflow-y: auto;
			}
		}
	}
	@supports not selector(::-webkit-scrollbar) {
		.sidebar,
		.toc-inner {
			scrollbar-color: transparent transparent;
			scrollbar-width: thin;
		}
		.sidebar:hover,
		.sidebar:focus-within,
		.toc-inner:hover {
			scrollbar-color: var(--surface-3) transparent;
		}
	}
	.sidebar {
		margin-right: -0.5rem;
		padding-right: 0.5rem;
	}
	.group + .group {
		margin-top: 1.1rem;
	}
	.group summary {
		display: flex;
		justify-content: space-between;
		align-items: center;
		cursor: pointer;
		border-radius: var(--radius-s);
		padding: 0.3rem 0.6rem;
		color: var(--ink);
		font-weight: 500;
		font-size: 0.8rem;
		list-style: none;
	}
	.group summary::-webkit-details-marker {
		display: none;
	}
	.group summary:hover {
		background: var(--surface);
	}
	.group-title {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		min-width: 0;
	}
	.group summary .group-icon {
		transform: none;
		color: var(--ink-soft);
	}
	.group.has-icon ul {
		margin-left: 1.05rem;
		border-left: 1px solid var(--line);
		padding-left: 0.35rem;
	}
	.sidebar a.symbol {
		overflow: hidden;
		font: 400 0.8rem/1.55 var(--font-mono);
		letter-spacing: 0;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.sidebar a.symbol[aria-current='page'] {
		font-weight: 500;
	}
	.group summary > svg {
		transform: rotate(-90deg);
		transition: transform 0.2s var(--ease-out);
		color: var(--muted);
	}
	.group[open] summary > svg {
		transform: none;
	}
	.sidebar ul,
	.toc ul {
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.sidebar ul {
		margin-top: 0.15rem;
	}
	.sidebar a {
		display: block;
		transition:
			color 0.15s,
			background-color 0.15s;
		border-radius: var(--radius-s);
		padding: 0.3rem 0.6rem;
		color: var(--muted);
		font-size: 0.875rem;
		line-height: 1.45;
		text-decoration: none;
	}
	.sidebar a:hover {
		color: var(--ink);
	}
	.sidebar a[aria-current='page'] {
		background: var(--surface-2);
		color: var(--ink);
		font-weight: 500;
	}
	.content {
		padding: 2.5rem 0 5rem;
		min-width: 0;
	}
	.toc {
		font-size: 0.8rem;
	}
	.toc-title {
		margin: 0 0 0.7rem;
		color: var(--ink);
		font-weight: 500;
	}
	.toc li.nested a {
		padding-left: 1.6rem;
	}
	.toc a {
		display: block;
		transition: color 0.15s;
		border-left: 1px solid var(--line);
		padding: 0.25rem 0 0.25rem 0.85rem;
		color: var(--muted);
		line-height: 1.45;
		text-decoration: none;
	}
	.toc a:hover {
		color: var(--ink);
	}
	.toc a[aria-current='location'] {
		border-left-color: var(--accent);
		color: var(--ink);
	}
	.toc-mobile {
		display: none;
	}
	.page-footer {
		margin-top: 4rem;
		max-width: 70ch;
	}
	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 0.75rem;
	}
	.pager a {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		transition:
			border-color 0.15s,
			background-color 0.15s;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		padding: 0.85rem 1.05rem;
		color: var(--ink);
		text-decoration: none;
	}
	.pager a:hover {
		border-color: var(--line-strong);
		background: var(--surface);
	}
	.pager small {
		color: var(--muted);
		font-size: 0.75rem;
	}
	.pager span {
		font-weight: 500;
		font-size: 0.92rem;
	}
	.pager .next {
		grid-column: 2;
		text-align: right;
	}
	.edit {
		display: inline-flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.45rem;
		margin-top: 1.75rem;
		color: var(--muted);
		font-size: 0.82rem;
		text-decoration: none;
	}
	.edit:hover {
		color: var(--ink);
	}
	.edit .path {
		font: 0.75rem var(--font-mono);
		opacity: 0.8;
	}
	svg {
		flex: none;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.4;
		width: 15px;
		height: 15px;
	}
	@media (max-width: 1200px) {
		.docs {
			grid-template-columns: 14rem minmax(0, 1fr);
			gap: 2.5rem;
		}
		.toc {
			display: none;
		}
		.toc-mobile {
			display: block;
			margin: 0 0 2rem;
			border: 1px solid var(--line);
			border-radius: var(--radius);
			max-width: 70ch;
			font-size: 0.875rem;
		}
		.toc-mobile summary {
			display: flex;
			justify-content: space-between;
			align-items: center;
			cursor: pointer;
			padding: 0.6rem 0.9rem;
			color: var(--ink);
			font-weight: 500;
			list-style: none;
		}
		.toc-mobile summary::-webkit-details-marker {
			display: none;
		}
		.toc-mobile summary svg {
			transform: rotate(-90deg);
			transition: transform 0.2s var(--ease-out);
			color: var(--muted);
		}
		.toc-mobile[open] summary svg {
			transform: none;
		}
		.toc-mobile ul {
			margin: 0;
			border-top: 1px solid var(--line);
			padding: 0.5rem 0.9rem 0.7rem;
			max-height: 50vh;
			overflow-y: auto;
			list-style: none;
		}
		.toc-mobile li.nested {
			padding-left: 0.9rem;
		}
		.toc-mobile a {
			display: block;
			padding: 0.25rem 0;
			color: var(--muted);
			text-decoration: none;
		}
		.toc-mobile a:hover {
			color: var(--ink);
		}
	}
	@media (max-width: 860px) {
		.docs {
			display: block;
		}
		.docs-bar {
			display: flex;
			position: sticky;
			top: var(--header-height);
			align-items: center;
			gap: 0.75rem;
			z-index: 10;
			backdrop-filter: saturate(1.6) blur(14px);
			margin: 0 -1rem;
			border-bottom: 1px solid var(--line);
			background: color-mix(in oklab, var(--bg) 78%, transparent);
			padding: 0 var(--gutter);
			height: 2.75rem;
		}
		.menu-toggle {
			display: inline-flex;
			flex: none;
			align-items: center;
			gap: 0.45rem;
			cursor: pointer;
			border: 1px solid var(--line);
			border-radius: var(--radius-s);
			background: var(--surface);
			padding: 0 0.65rem;
			height: 1.9rem;
			color: var(--ink);
			font-weight: 500;
			font-size: 0.82rem;
		}
		.docs-bar-current {
			overflow: hidden;
			color: var(--muted);
			font-size: 0.82rem;
			text-overflow: ellipsis;
			white-space: nowrap;
		}
		.scrim {
			display: block;
			position: fixed;
			visibility: hidden;
			opacity: 0;
			z-index: 30;
			transition:
				opacity 0.25s var(--ease-out),
				visibility 0.25s;
			background: var(--scrim);
			inset: 0;
		}
		.docs[data-menu='open'] .scrim {
			visibility: visible;
			opacity: 1;
		}
		.sidebar {
			position: fixed;
			top: 0;
			bottom: 0;
			left: 0;
			transform: translateX(-102%);
			visibility: hidden;
			z-index: 40;
			transition:
				transform 0.32s var(--ease-out),
				visibility 0.32s;
			box-shadow: var(--shadow-lg);
			margin: 0;
			border-right: 1px solid var(--line-strong);
			background: var(--bg);
			padding: 1.25rem 0.75rem 2rem;
			width: min(19rem, 86vw);
			max-height: none;
			overflow-y: auto;
		}
		.docs[data-menu='open'] .sidebar {
			transform: none;
			visibility: visible;
		}
		.content {
			padding-top: 1.75rem;
		}
		.pager {
			grid-template-columns: 1fr;
		}
		.pager .next {
			grid-column: 1;
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.sidebar,
		.scrim,
		.group summary > svg,
		.toc-mobile summary svg {
			transition: none;
		}
	}
</style>
