<script lang="ts">
	import { computed } from '@meekojs/meeko'

	// Meeko keeps the theme (theme in meeko.config.ts): <html>, the cookie, localStorage and the system.
	const { theme } = useTheme()

	/** The cycle: the default dark world first, then light, then the system's. */
	const following = { dark: 'light', light: 'system', system: 'dark' } as const
	const names = { dark: 'oscuro', light: 'claro', system: 'del sistema' } as const
	const next = computed(() => following[theme.value])
	const label = computed(() => `Tema ${names[theme.value]}. Cambiar a ${names[next.value]}`)

	function cycle(): void {
		theme.value = next.value
	}
</script>

<template>
	<button
		type="button"
		class="theme-toggle"
		bind:aria-label="label.value"
		bind:title="label.value"
		on:click="cycle"
	>
		<svg
			class="icon dark"
			viewBox="0 0 16 16"
			aria-hidden="true"
		>
			<path d="M13.5 9.7A5.6 5.6 0 0 1 6.3 2.5a5.6 5.6 0 1 0 7.2 7.2Z" />
		</svg>
		<svg
			class="icon light"
			viewBox="0 0 16 16"
			aria-hidden="true"
		>
			<circle
				cx="8"
				cy="8"
				r="2.8"
			/>
			<path d="M8 1.5v1.6M8 12.9v1.6M1.5 8h1.6M12.9 8h1.6M3.4 3.4l1.1 1.1M11.5 11.5l1.1 1.1M3.4 12.6l1.1-1.1M11.5 4.5l1.1-1.1" />
		</svg>
		<svg
			class="icon system"
			viewBox="0 0 16 16"
			aria-hidden="true"
		>
			<rect
				x="1.8"
				y="2.8"
				width="12.4"
				height="8.4"
				rx="1.4"
			/>
			<path d="M5.5 13.8h5M8 11.2v2.6" />
		</svg>
	</button>
</template>

<style scoped>
	.theme-toggle {
		display: grid;
		place-items: center;
		transition:
			color 0.15s,
			background-color 0.15s;
		cursor: pointer;
		border: 0;
		border-radius: var(--radius-s);
		background: transparent;
		padding: 0;
		width: 32px;
		height: 32px;
		color: var(--muted);
	}
	.theme-toggle:hover {
		background: var(--surface-2);
		color: var(--ink);
	}
	/* The icon follows data-theme-choice, which Meeko's script in <head> writes before the first
	   paint: right from the first frame, with nothing for hydration to change. */
	.icon {
		display: none;
		fill: none;
		stroke: currentColor;
		stroke-linecap: round;
		stroke-linejoin: round;
		stroke-width: 1.3;
		width: 16px;
		height: 16px;
	}
	:global(:root:not([data-theme-choice])) .dark,
	:global(:root[data-theme-choice='dark']) .dark,
	:global(:root[data-theme-choice='light']) .light,
	:global(:root[data-theme-choice='system']) .system {
		display: block;
	}
</style>
