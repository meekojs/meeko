{
	"name": "meeko-language",
	"displayName": "Meeko Language",
	"version": "1.7.6",
	"private": true,
	"description": "%description%",
	"categories": [
		"Programming Languages"
	],
	"keywords": [
		"meeko",
		"typescript",
		"components",
		"syntax",
		"diagnostics",
		"lsp"
	],
	"homepage": "https://meekojs.com/docs/editors",
	"bugs": {
		"url": "https://github.com/meekojs/meeko/issues"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/meekojs/meeko"
	},
	"license": "MIT",
	"publisher": "meekojs",
	"type": "module",
	"main": "./dist/extension.js",
	"scripts": {
		"build": "node build.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"install:local": "node install-local.mjs",
		"lint": "eslint .",
		"package:vsix": "node package-vsix.mjs",
		"test": "tsx --test tests/*.test.ts",
		"test:host": "node tests/run-host.mjs",
		"test:host:css": "node --test --test-timeout=60000 tests/run-host-css.mjs",
		"test:host:isolated": "pwsh -NoProfile -File tests/prepare-host.ps1",
		"test:host:snippets": "node tests/run-host-snippets.mjs",
		"test:host:untrusted": "node tests/run-host-untrusted.mjs",
		"test:host:virtual": "node tests/run-host-virtual.mjs"
	},
	"l10n": "./l10n",
	"contributes": {
		"colors": [
			{
				"id": "meeko.executionZone.serverBackground",
				"description": "%color.executionZone.serverBackground.description%",
				"defaults": {
					"dark": "#A371F710",
					"light": "#8250DF0C",
					"highContrast": "#00000000",
					"highContrastLight": "#00000000"
				}
			},
			{
				"id": "meeko.executionZone.sharedBackground",
				"description": "%color.executionZone.sharedBackground.description%",
				"defaults": {
					"dark": "#00000000",
					"light": "#00000000",
					"highContrast": "#00000000",
					"highContrastLight": "#00000000"
				}
			},
			{
				"id": "meeko.executionZone.browserBackground",
				"description": "%color.executionZone.browserBackground.description%",
				"defaults": {
					"dark": "#39C5CF10",
					"light": "#1B7C830C",
					"highContrast": "#00000000",
					"highContrastLight": "#00000000"
				}
			}
		],
		"commands": [
			{
				"command": "meeko.live.editSignal",
				"title": "%command.live.editSignal.title%",
				"category": "Meeko"
			},
			{
				"command": "meeko.live.reconnect",
				"title": "%command.live.reconnect.title%",
				"category": "Meeko"
			},
			{
				"command": "meeko.newComponent",
				"title": "%command.newComponent.title%",
				"category": "Meeko"
			},
			{
				"command": "meeko.newPage",
				"title": "%command.newPage.title%",
				"category": "Meeko"
			},
			{
				"command": "meeko.newEndpoint",
				"title": "%command.newEndpoint.title%",
				"category": "Meeko"
			},
			{
				"command": "meeko.restartLanguageServer",
				"title": "%command.restartLanguageServer.title%",
				"category": "Meeko"
			},
			{
				"command": "meeko.showOutput",
				"title": "%command.showOutput.title%",
				"category": "Meeko"
			}
		],
		"configuration": {
			"title": "Meeko",
			"properties": {
				"meeko.classes.completion": {
					"type": "string",
					"enum": [
						"auto",
						"on",
						"off"
					],
					"default": "auto",
					"scope": "resource",
					"description": "%config.classes.completion.description%"
				},
				"meeko.classes.hover": {
					"type": "string",
					"enum": [
						"auto",
						"on",
						"off"
					],
					"default": "auto",
					"scope": "resource",
					"description": "%config.classes.hover.description%"
				},
				"meeko.classes.definition": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.classes.definition.description%"
				},
				"meeko.cssVariables.completion": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.cssVariables.completion.description%"
				},
				"meeko.cssVariables.hover": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.cssVariables.hover.description%"
				},
				"meeko.cssVariables.definition": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.cssVariables.definition.description%"
				},
				"meeko.cssVariables.references": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.cssVariables.references.description%"
				},
				"meeko.cssVariables.rename": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.cssVariables.rename.description%"
				},
				"meeko.languageServer.preferWorkspace": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.languageServer.preferWorkspace.description%"
				},
				"meeko.languageServer.warmup": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.languageServer.warmup.description%"
				},
				"meeko.format.indentSections": {
					"type": "boolean",
					"default": false,
					"scope": "resource",
					"description": "%config.format.indentSections.description%"
				},
				"meeko.editor.executionZones": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.editor.executionZones.description%"
				},
				"meeko.autoClosingTags": {
					"type": "boolean",
					"default": true,
					"scope": "resource",
					"description": "%config.autoClosingTags.description%"
				},
				"meeko.live.enabled": {
					"type": "boolean",
					"default": true,
					"description": "%config.live.enabled.description%"
				},
				"meeko.live.inlineValues": {
					"type": "boolean",
					"default": true,
					"description": "%config.live.inlineValues.description%"
				},
				"meeko.trace.server": {
					"type": "string",
					"enum": [
						"off",
						"messages",
						"verbose"
					],
					"default": "off",
					"description": "%config.trace.server.description%"
				}
			}
		},
		"configurationDefaults": {
			"tailwindCSS.includeLanguages": {
				"meeko": "html"
			},
			"[meeko]": {
				"editor.semanticHighlighting.enabled": true,
				"editor.quickSuggestions": {
					"other": "on",
					"comments": "off",
					"strings": "on"
				},
				"editor.linkedEditing": true,
				"editor.bracketPairColorization.enabled": false
			}
		},
		"grammars": [
			{
				"language": "meeko",
				"scopeName": "source.meeko",
				"path": "./syntaxes/meeko.tmLanguage.json",
				"embeddedLanguages": {
					"meta.embedded.block.typescript": "typescript",
					"meta.embedded.inline.typescript": "typescript",
					"meta.embedded.block.html": "html",
					"meta.embedded.block.css": "css"
				}
			}
		],
		"languages": [
			{
				"id": "meeko",
				"aliases": [
					"Meeko"
				],
				"extensions": [
					".meeko"
				],
				"icon": {
					"light": "./icons/meeko-logo.png",
					"dark": "./icons/meeko-logo.png"
				},
				"configuration": "./language-configuration.json"
			}
		],
		"menus": {
			"commandPalette": [
				{
					"command": "meeko.live.editSignal",
					"when": "editorLangId == meeko"
				}
			],
			"explorer/context": [
				{
					"submenu": "meeko.explorer",
					"when": "explorerResourceIsFolder && resourceScheme == file && meeko.scaffold",
					"group": "1_meeko"
				}
			],
			"meeko.explorer": [
				{
					"command": "meeko.newComponent",
					"group": "1_new@1"
				},
				{
					"command": "meeko.newPage",
					"group": "1_new@2"
				},
				{
					"command": "meeko.newEndpoint",
					"group": "1_new@3"
				}
			]
		},
		"semanticTokenModifiers": [
			{
				"id": "signal",
				"description": "%semanticTokenModifier.signal.description%"
			},
			{
				"id": "computed",
				"description": "%semanticTokenModifier.computed.description%"
			},
			{
				"id": "resource",
				"description": "%semanticTokenModifier.resource.description%"
			},
			{
				"id": "reactive",
				"description": "%semanticTokenModifier.reactive.description%"
			}
		],
		"semanticTokenScopes": [
			{
				"language": "meeko",
				"scopes": {
					"variable.signal": [
						"support.class.component.signal.meeko"
					],
					"variable.readonly.signal": [
						"support.class.component.signal.meeko"
					],
					"variable.signal.reactive": [
						"support.class.component.signal.meeko"
					],
					"variable.readonly.signal.reactive": [
						"support.class.component.signal.meeko"
					],
					"variable.computed": [
						"entity.name.function.computed.meeko"
					],
					"variable.readonly.computed": [
						"entity.name.function.computed.meeko"
					],
					"variable.computed.reactive": [
						"entity.name.function.computed.meeko"
					],
					"variable.readonly.computed.reactive": [
						"entity.name.function.computed.meeko"
					],
					"variable.resource": [
						"entity.name.type.resource.meeko"
					],
					"variable.readonly.resource": [
						"entity.name.type.resource.meeko"
					],
					"variable.resource.reactive": [
						"entity.name.type.resource.meeko"
					],
					"variable.readonly.resource.reactive": [
						"entity.name.type.resource.meeko"
					],
					"property.modification": [
						"keyword.control.write.meeko"
					],
					"property.modification.reactive": [
						"keyword.control.write.meeko"
					],
					"method.modification": [
						"keyword.control.write.meeko"
					],
					"method.modification.reactive": [
						"keyword.control.write.meeko"
					]
				}
			}
		],
		"snippets": [
			{
				"language": "meeko",
				"path": "./snippets/meeko.json"
			},
			{
				"language": "typescript",
				"path": "./snippets/typescript.json"
			}
		],
		"submenus": [
			{
				"id": "meeko.explorer",
				"label": "Meeko"
			}
		]
	},
	"activationEvents": [
		"onLanguage:meeko",
		"workspaceContains:**/meeko.config.{ts,js,mts,mjs,cts,cjs}"
	],
	"dependencies": {
		"@typescript/typescript6": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/vscode": "catalog:",
		"@vscode/test-electron": "catalog:",
		"esbuild": "catalog:",
		"tsx": "catalog:",
		"vscode-languageclient": "catalog:",
		"vscode-oniguruma": "catalog:",
		"vscode-textmate": "catalog:"
	},
	"engines": {
		"vscode": "^1.144.0"
	},
	"icon": "./icons/meeko-logo.png",
	"capabilities": {
		"virtualWorkspaces": {
			"supported": "limited",
			"description": "%capabilities.virtualWorkspaces.description%"
		},
		"untrustedWorkspaces": {
			"supported": "limited",
			"description": "%capabilities.untrustedWorkspaces.description%",
			"restrictedConfigurations": [
				"meeko.languageServer.preferWorkspace"
			]
		}
	}
}
