{
	"Props tipadas del componente": {
		"prefix": "mprops",
		"body": [
			"interface Props {",
			"\t${1:label}: ${2:string}",
			"}",
			"",
			"const props = defineProps<Props>()",
			"$0"
		],
		"description": "Props tipadas del componente"
	},
	"Props reactivas desestructuradas con defaults (Meeko 1.8)": {
		"prefix": "mpropsd",
		"body": [
			"interface Props {",
			"\t${1:label}?: ${2:string}",
			"}",
			"",
			"const { ${1} = ${3:''} } = defineProps<Props>()",
			"$0"
		],
		"description": "Props reactivas desestructuradas con defaults (Meeko 1.8)"
	},
	"Eventos tipados del componente": {
		"prefix": "memits",
		"body": [
			"const emit = defineEmits<{ ${1:save}: [${2:value}: ${3:string}] }>()",
			"$0"
		],
		"description": "Eventos tipados del componente"
	},
	"Modelo reactivo con valor por defecto": {
		"prefix": "mmodel",
		"body": [
			"const ${1:value} = defineModel<${2:string}>({ default: ${3:''} })",
			"$0"
		],
		"description": "Modelo reactivo con valor por defecto"
	},
	"Contrato de snippets del componente": {
		"prefix": "msnippets",
		"body": [
			"const snippets = defineSnippets<{ ${1:default}: [${2:label}: ${3:string}] }>()",
			"$0"
		],
		"description": "Contrato de snippets del componente"
	},
	"Publicar valores del componente": {
		"prefix": "mexpose",
		"body": [
			"defineExpose({ ${1:value} })",
			"$0"
		],
		"description": "Publicar valores del componente"
	},
	"Señal reactiva": {
		"prefix": "msignal",
		"body": [
			"import { signal } from '@meekojs/meeko'",
			"",
			"const ${1:count} = signal(${2:0})",
			"$0"
		],
		"description": "Señal reactiva"
	},
	"Valor calculado reactivo": {
		"prefix": "mcomputed",
		"body": [
			"import { computed } from '@meekojs/meeko'",
			"",
			"const ${1:doubled} = computed(() => ${2:count.value * 2})",
			"$0"
		],
		"description": "Valor calculado reactivo"
	},
	"Efecto reactivo": {
		"prefix": "meffect",
		"body": [
			"import { effect } from '@meekojs/meeko'",
			"",
			"effect(() => {",
			"\t${1:console.log(count.value)}",
			"})",
			"$0"
		],
		"description": "Efecto reactivo"
	},
	"Montaje en el navegador con limpieza dentro del callback": {
		"prefix": "mmounted",
		"body": [
			"import { onCleanup, onMounted } from '@meekojs/meeko'",
			"",
			"onMounted(() => {",
			"\tconst timer = setInterval(() => {",
			"\t\t${1:console.log('tick')}",
			"\t}, ${2:1000})",
			"\tonCleanup(() => clearInterval(timer))",
			"})",
			"$0"
		],
		"description": "Montaje en el navegador con limpieza dentro del callback"
	},
	"Ref de elemento y guía para su plantilla": {
		"prefix": "mref",
		"body": [
			"// En <template>: <input ref:${1:input} />",
			"const ${1} = useElementRef('${1}')",
			"$0"
		],
		"description": "Ref de elemento y guía para su plantilla"
	}
}
