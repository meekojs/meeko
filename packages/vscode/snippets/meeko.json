			"\tname=\"${1:default}\"",
			"\tparams=\"${2:label}\"",
			">",
			"\t{${2}}$0",
			"</snippet>"
		],
		"description": "Contenido de un snippet dentro de un componente"
	},
	"Elemento o componente dinámico": {
