			"$0"
		],
		"description": "Contrato de snippets del componente"
	},
	"Publicar valores del componente": {
		"prefix": "mexpose",
		"body": [
			"defineExpose({ ${1:value} })",
			"$0"
		],
		"description": "Publicar valores del componente"
	},
	"Señal reactiva": {
		"prefix": "msignal",
		"body": [
			"import { signal } from '@meekojs/meeko'",
			"",
			"const ${1:count} = signal(${2:0})",
			"$0"
		],
		"description": "Señal reactiva"
	},
	"Valor calculado reactivo": {
		"prefix": "mcomputed",
		"body": [
			"import { computed } from '@meekojs/meeko'",
			"",
			"const ${1:doubled} = computed(() => ${2:count.value * 2})",
			"$0"
		],
		"description": "Valor calculado reactivo"
	},
	"Efecto reactivo": {
		"prefix": "meffect",
		"body": [
			"import { effect } from '@meekojs/meeko'",
			"",
			"effect(() => {",
			"\t${1:console.log(count.value)}",
			"})",
			"$0"
		],
		"description": "Efecto reactivo"
	},
	"Montaje en el navegador con limpieza dentro del callback": {
		"prefix": "mmounted",
		"body": [
			"import { onCleanup, onMounted } from '@meekojs/meeko'",
			"",
			"onMounted(() => {",
			"\tconst timer = setInterval(() => {",
			"\t\t${1:console.log('tick')}",
			"\t}, ${2:1000})",
			"\tonCleanup(() => clearInterval(timer))",
			"})",
			"$0"
		],
		"description": "Montaje en el navegador con limpieza dentro del callback"
	},
	"Ref de elemento y guía para su plantilla": {
		"prefix": "mref",
		"body": [
			"// En <template>: <input ref:${1:input} />",
			"const ${1} = useElementRef('${1}')",
			"$0"
		],
		"description": "Ref de elemento y guía para su plantilla"
	},
	"Elemento condicional": {
		"prefix": "mif",
		"body": [
			"<${1:div} if:when=\"${2:visible.value}\">",
			"\t$0",
			"</${1}>"
		],
		"description": "Elemento condicional"
	},
	"Lista con identidad estable": {
		"prefix": "meach",
		"body": [
			"<${1:div}",
			"\teach:of=\"${2:items.value}\"",
			"\teach:as=\"${3:item}\"",
			"\teach:key=\"${3}.id\"",
			">",
			"\t{${3}.${4:label}}$0",
			"</${1}>"
		],
		"description": "Lista con identidad estable"
	},
	"Renderizar un snippet con argumentos": {
		"prefix": "mrender",
		"body": [
			"<render",
			"\tsnippet=\"snippets.${1:default}\"",
			"\targs=\"${2:label}\"",
