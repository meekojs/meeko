{
	"Componente Meeko con TypeScript": {
		"prefix": [
			"meeko",
			"mcomp"
		],
		"body": [
			"<!-- ${TM_FILENAME_BASE} -->",
			"<script lang=\"ts\">",
			"$0",
			"</script>",
			"",
			"<template>",
			"\t<h1>${1:$TM_FILENAME_BASE}</h1>",
			"</template>"
		],
		"description": "Componente Meeko con TypeScript"
	},
	"Página con opciones de ruta en el servidor": {
		"prefix": "mpage",
		"body": [
			"<script",
			"\tserver",
			"\tlang=\"ts\"",
			">",
			"import { definePage } from '@meekojs/meeko/framework'",
			"",
			"export const route = definePage({ render: '${1:ssr}' })",
			"</script>",
			"",
			"<script lang=\"ts\">",
			"$0",
			"</script>",
			"",
			"<template>",
			"\t<h1>${2:$TM_FILENAME_BASE}</h1>",
			"</template>"
		],
		"description": "Página con opciones de ruta en el servidor"
	},
	"Layout con la salida de la página": {
		"prefix": "mlayout",
		"body": [
			"<script lang=\"ts\">",
			"$0",
			"</script>",
			"",
			"<template>",
			"\t<${1:main}>",
			"\t\t<MeekoOutlet />",
			"\t</${1}>",
			"</template>"
		],
		"description": "Layout con la salida de la página"
	},
	"Props tipadas del componente": {
		"prefix": "mprops",
		"body": [
			"interface Props {",
			"\t${1:label}: ${2:string}",
			"}",
			"",
			"const props = defineProps<Props>()",
			"$0"
		],
		"description": "Props tipadas del componente"
	},
	"Props reactivas desestructuradas con defaults (Meeko 1.8)": {
		"prefix": "mpropsd",
		"body": [
			"interface Props {",
			"\t${1:label}?: ${2:string}",
			"}",
			"",
			"const { ${1} = ${3:''} } = defineProps<Props>()",
			"$0"
		],
		"description": "Props reactivas desestructuradas con defaults (Meeko 1.8)"
	},
	"Eventos tipados del componente": {
		"prefix": "memits",
		"body": [
			"const emit = defineEmits<{ ${1:save}: [${2:value}: ${3:string}] }>()",
			"$0"
		],
		"description": "Eventos tipados del componente"
	},
	"Modelo reactivo con valor por defecto": {
		"prefix": "mmodel",
		"body": [
			"const ${1:value} = defineModel<${2:string}>({ default: ${3:''} })",
			"$0"
		],
		"description": "Modelo reactivo con valor por defecto"
	},
	"Contrato de snippets del componente": {
		"prefix": "msnippets",
