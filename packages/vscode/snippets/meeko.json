	"Componente con formulario reactivo": {
		"prefix": "mform",
		"body": [
			"<script lang=\"ts\">",
			"const form = useForm({",
			"\tinitial: { ${1:name}: '' },",
			"\tsubmit: async (values) => {",
			"\t\t${2:console.log(values)}",
			"\t},",
			"})",
			"</script>",
			"",
			"<template>",
			"\t<form",
			"\t\ton:submit=\"form.submit\"",
			"\t\tnovalidate",
			"\t>",
			"\t\t<label>",
			"\t\t\t${3:Nombre}",
			"\t\t\t<input model=\"form.fields.${1}\" />",
			"\t\t</label>",
			"\t\t<button bind:disabled=\"form.pending.value\">${4:Guardar}</button>",
			"\t\t$0",
			"\t</form>",
			"</template>"
		],
		"description": "Componente con formulario reactivo"
	}
}
