{
	"name": "meeko-docs-content",
	"private": true,
	"type": "module",
	"exports": {
		"./snapshots": "./src/db/snapshots.ts",
		"./db": "./src/db/index.ts",
		"./render": "./src/snapshot.ts",
		"./diff": "./src/diff.ts",
		"./locale": "./src/locale.ts",
		"./health": "./src/health.ts",
		"./liveness": "./src/liveness.ts",
		"./status": "./src/db/status.ts",
		"./preview": "./src/preview.ts",
		"./moderation": "./src/moderation/index.ts",
		"./moderation/shared": "./src/moderation/shared.ts",
		"./metrics": "./src/metrics/index.ts",
		"./metrics/shared": "./src/metrics/shared.ts",
		"./types": "./src/types/index.ts",
		"./content/*": "./src/content/*.ts"
	},
	"scripts": {
		"check": "tsc -p tsconfig.json --noEmit",
		"inventory": "tsx scripts/inventory.ts",
		"test": "tsx --test --test-concurrency=1 tests/*.test.ts",
		"translations": "tsx scripts/translations.ts"
	},
	"dependencies": {
		"@meekojs/meeko": "workspace:*",
		"@typescript/typescript6": "catalog:",
		"github-slugger": "catalog:",
		"markdown-it": "catalog:",
		"pg": "catalog:",
		"prettier": "catalog:",
		"shiki": "catalog:",
		"valibot": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@types/pg": "catalog:",
		"tsx": "catalog:",
		"typescript": "catalog:"
	}
}
