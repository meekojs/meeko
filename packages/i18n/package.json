{
  "name": "@meekojs/i18n",
  "version": "0.1.0",
  "description": "Typed localization and catalogs for Meeko.",
  "keywords": [
    "meeko",
    "meeko-module"
  ],
  "homepage": "https://i18n.meekojs.com",
  "bugs": { "url": "https://github.com/meekojs/meeko/issues" },
  "repository": { "type": "git", "url": "git+https://github.com/meekojs/meeko.git", "directory": "packages/i18n" },
  "sideEffects": true,
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "default": "./dist/module.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-package.mjs && node scripts/copy-components.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@meekojs/meeko": ">=1.7 <2"
  },
  "devDependencies": {
    "@meekojs/meeko": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "engines": { "node": ">=24" },
  "publishConfig": { "access": "public", "provenance": true }
}
