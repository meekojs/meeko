<script lang="ts">
	const props = defineProps<{ groups: readonly { title: string; items: readonly { href: string; label: string; aliases?: readonly string[]; featured?: boolean }[] }[]; product?: string }>({ product: 'UI' })

	const route = useRoute()
</script>

<template>
	<nav bind:aria-label="'Documentación de ' + props.product">
		<section
			each:of="props.groups"
			each:as="group"
			each:key="group.title"
			class="nav-group"
		>
			<h2>{group.title}</h2>
			<a
				each:of="group.items"
				each:as="item"
				each:key="item.href"
				bind:href="item.href"
				bind:aria-current="route.path.value === item.href || item.aliases?.includes(route.path.value) ? 'page' : undefined"
			>
				{item.label}
				<UIBadge
					if:when="item.featured"
					tone="accent"
					class="nav-featured"
				>
					Destacado
				</UIBadge>
			</a>
		</section>
		<p
			if:when="!props.groups.length"
			class="nav-empty"
			role="status"
		>
			No hay coincidencias. Prueba con otro nombre.
		</p>
	</nav>
</template>
