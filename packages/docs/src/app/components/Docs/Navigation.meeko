<script lang="ts">
	import { useI18n } from '@meekojs/i18n'

	const props = defineProps<{ groups: readonly { title: string; items: readonly { href: string; label: string; aliases?: readonly string[]; featured?: boolean }[] }[]; product?: string }>({ product: 'UI' })

	const route = useRoute()
	const { t } = useI18n()
</script>

<template>
	<nav bind:aria-label="t('shell.nav.docsOf', { product: props.product })">
		<section
			each:of="props.groups"
			each:as="group"
			each:key="group.title"
			class="nav-group"
		>
			<h2>{group.title}</h2>
			<a
				each:of="group.items"
				each:as="item"
				each:key="item.href"
				bind:href="item.href"
				bind:aria-current="route.path.value === item.href || item.aliases?.includes(route.path.value) ? 'page' : undefined"
			>
				{item.label}
				<UIBadge
					if:when="item.featured"
					tone="accent"
					class="nav-featured"
				>
					{t('shell.nav.featured')}
				</UIBadge>
			</a>
		</section>
		<p
			if:when="!props.groups.length"
			class="nav-empty"
			role="status"
		>
			{t('shell.nav.empty')}
		</p>
	</nav>
</template>
