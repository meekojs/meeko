<script lang="ts">
	import { metricsActive, normalizeQuery, sendMetric, storedQuery } from '../../../metrics/state'
	import { moderateNavigation, useDocsModeration } from '../../../runtime/state'
	import * as DocsAnnouncements from './Announcements.meeko'
	import * as DocsNavigation from './Navigation.meeko'
	interface Item {
		href: string
		label: string
		description: string
		aliases?: readonly string[]
	}
	const props = defineProps<{ name: string; packageName: string; repository: string; navigation: readonly { title: string; items: readonly Item[] }[] }>()

	const snippets = defineSnippets<{ default: [] }>()

	// Páginas ocultas y destacadas desde el dashboard (vacío sin base de datos).
	const moderation = useDocsModeration()
	const query = signal('')
	const groups = computed(() =>
		moderateNavigation(props.navigation, moderation.value)
			.map((group) => ({ ...group, items: group.items.filter((item) => (item.label + ' ' + item.description).toLocaleLowerCase('es').includes(query.value.trim().toLocaleLowerCase('es'))) }))
			.filter((group) => group.items.length),
	)

	// The filter is a search of the guide: once the reader stops typing for 1.5 s (never per key), its
	// normalized query and the pages it matched are counted, once per query. A query that looks like
	// personal data or a secret is never sent (the server drops it too).
	let searchTimer: ReturnType<typeof setTimeout> | undefined
	let recorded = ''
	function recordSearch() {
		if (searchTimer !== undefined) clearTimeout(searchTimer)
		searchTimer = undefined
		const text = storedQuery(query.value)
		if (text.length < 2 || text === recorded || !metricsActive()) return
		recorded = text
		sendMetric('/api/docs/search', { q: text, results: groups.value.reduce((count, group) => count + group.items.length, 0) })
	}
	onMounted(() => {
		effect(() => {
			const text = query.value
			if (searchTimer !== undefined) clearTimeout(searchTimer)
			searchTimer = normalizeQuery(text).length >= 2 ? setTimeout(recordSearch, 1500) : undefined
		})
		return () => {
			if (searchTimer !== undefined) clearTimeout(searchTimer)
		}
	})

	function closeMenu(event: MouseEvent) {
		if (event.target instanceof Element && event.target.closest('a')) event.currentTarget instanceof Element && event.currentTarget.closest('details')?.removeAttribute('open')
	}
</script>

<template>
	<div
		lang="es"
		dir="ltr"
	>
		<UIApp>
			<a
				class="skip-link"
				href="#contenido"
			>
				Saltar al contenido
			</a>
			<header class="site-header">
				<a
					class="brand"
					href="/"
					bind:aria-label="'Meeko ' + props.name + ', inicio'"
				>
					<img
						src="/brand/meeko-logo.png"
						width="28"
						height="28"
						alt=""
					/>
					<span>
						Meeko
						<strong>{props.name}</strong>
					</span>
				</a>
				<nav
					class="top-nav"
					aria-label="Ecosistema"
				>
					<a href="/installation">Documentación</a>
					<a href="https://meekojs.com">Framework</a>
					<a bind:href="props.repository">GitHub</a>
				</nav>
				<div class="header-actions">
					<UIThemeToggle />
					<details class="mobile-menu">
						<summary>Menú</summary>
						<div
							class="mobile-panel"
							on:click="closeMenu"
						>
							<label
								class="search-label"
								for="mobile-docs-search"
							>
								Buscar en la guía
							</label>
							<UIInput
								id="mobile-docs-search"
								type="search"
								placeholder="Filtrar documentación…"
								model="query"
							/>
							<DocsNavigation
								bind:groups="groups.value"
								bind:product="props.name"
							/>
						</div>
					</details>
				</div>
			</header>
			<DocsAnnouncements />
			<UIContainer
				size="3xl"
				gutter="none"
				class="site-layout"
			>
				<aside
					id="docs-navigation"
					class="sidebar"
				>
					<label
						class="search-label"
						for="docs-search"
					>
						Buscar en la guía
					</label>
					<UIInput
						id="docs-search"
						type="search"
						placeholder="Filtrar documentación…"
						model="query"
					/>
					<DocsNavigation
						bind:groups="groups.value"
						bind:product="props.name"
					/>
					<a
						class="sidebar-package"
						bind:href="'https://www.npmjs.com/package/' + props.packageName"
					>
						<code>{props.packageName}</code>
						<span>Paquete de Meeko</span>
					</a>
				</aside>
				<div class="page-content">
					<render snippet="snippets.default" />
					<footer class="site-footer">
						<span>Meeko {props.name} · Documentación del ecosistema Meeko.</span>
						<a href="https://github.com/meekojs/meeko/blob/main/LICENSE">Licencia MIT</a>
					</footer>
				</div>
			</UIContainer>
		</UIApp>
	</div>
</template>
