<script lang="ts">
	import { useI18n } from '@meekojs/i18n'

	const props = defineProps<{ rows: readonly { name: string; type: string; description: string; default?: string }[]; caption?: string }>()

	const { t } = useI18n()
</script>

<template>
	<div
		class="api-scroll"
		tabindex="0"
		role="region"
		bind:aria-label="props.caption ?? t('shell.api.caption')"
	>
		<table class="api-table">
			<caption bind:lang="props.caption === undefined ? t('shell.meta.lang') : undefined">{props.caption ?? t('shell.api.caption')}</caption>
			<thead bind:lang="t('shell.meta.lang')">
				<tr>
					<th scope="col">{t('shell.api.name')}</th>
					<th scope="col">{t('shell.api.type')}</th>
					<th scope="col">{t('shell.api.description')}</th>
				</tr>
			</thead>
			<tbody>
				<tr
					each:of="props.rows"
					each:as="row"
					each:key="row.name"
				>
					<th scope="row">
						<code>{row.name}</code>
					</th>
					<td>
						<code>{row.type}</code>
						<span
							if:when="row.default"
							class="api-default"
						>
							{row.default}
						</span>
					</td>
					<td>{row.description}</td>
				</tr>
			</tbody>
		</table>
	</div>
</template>
