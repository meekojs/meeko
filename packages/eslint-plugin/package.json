{
  "name": "@meekojs/eslint-plugin",
  "version": "0.1.0",
  "description": "ESLint parser and template rules for Meeko components.",
  "homepage": "https://meekojs.com/docs/tooling",
  "type": "module",
  "license": "MIT",
  "files": ["dist/", "README.md"],
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./parser": { "types": "./dist/parser.d.ts", "default": "./dist/parser.js" }
  },
  "scripts": {
    "build": "pnpm run types:generate && node ../../scripts/build-package.mjs",
    "check": "pnpm run types:generate && tsc6 -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "types:generate": "node scripts/generate-rule-types.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@eslint/js": "10.0.1",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/utils": "8.72.1",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "peerDependencies": {
    "@meekojs/meeko": ">=1.7 <2",
    "eslint": "^10.0.0"
  },
  "devDependencies": {
    "@meekojs/meeko": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "10.13.0"
  }
}
