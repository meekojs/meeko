{
  "name": "meeko-devtools-extension",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "check": "node --test tests/*.test.js && tsc -p tsconfig.json --noEmit",
    "types": "node scripts/protocol-types.mjs --write",
    "test:installed": "node --test tests/installed.e2e.js",
    "package:zip": "pwsh -NoProfile -File package-zip.ps1"
  },
  "devDependencies": {
    "@typescript/typescript6": "6.0.2",
    "playwright-core": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
