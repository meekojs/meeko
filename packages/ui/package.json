{
	"name": "@meekojs/ui",
	"version": "0.1.0",
	"description": "Typed UI components and themes for Meeko.",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist/"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json && node scripts/copy-components.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"prepack": "pnpm run build"
	},
	"devDependencies": {
		"@meekojs/eslint-plugin": "workspace:*",
		"@meekojs/meeko": "workspace:*",
		"@meekojs/prettier-plugin": "workspace:*",
		"@types/node": "^24.0.0",
		"eslint": "10.13.0",
		"jiti": "2.7.0",
		"prettier": "^3.9.10",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-packagejson": "^3.0.3",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@meekojs/meeko": ">=1.7 <2"
	}
}
