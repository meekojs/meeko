{
	"name": "@meekojs/ui",
	"version": "0.1.0",
	"description": "Typed UI components and themes for Meeko.",
	"keywords": [
		"meeko",
		"meeko-module"
	],
	"homepage": "https://ui.meekojs.com",
	"license": "MIT",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		}
	},
	"files": [
		"dist/",
		"src/app/styles/",
		"DESIGN.md"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.mjs && node scripts/copy-components.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"prepack": "pnpm run build",
		"test": "pnpm run build && node --test tests/*.test.mjs",
		"test:e2e": "pnpm run build && pnpm -F meeko-ui-site build && node --test --test-concurrency=1 tests/*.e2e.mjs"
	},
	"devDependencies": {
		"@meekojs/eslint-plugin": "workspace:*",
		"@meekojs/meeko": "workspace:*",
		"@meekojs/prettier-plugin": "workspace:*",
		"@types/node": "^24.0.0",
		"eslint": "10.13.0",
		"jiti": "2.7.0",
		"playwright-core": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-packagejson": "^3.0.3",
		"typescript": "7.0.2"
	},
	"peerDependencies": {
		"@meekojs/meeko": ">=1.7 <2"
	}
}
