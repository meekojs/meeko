{
	"name": "@meekojs/ui",
	"version": "0.1.0",
	"description": "Typed UI components and themes for Meeko.",
	"keywords": [
		"meeko",
		"meeko-module"
	],
	"homepage": "https://ui.meekojs.com",
	"bugs": {
		"url": "https://github.com/meekojs/meeko/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meekojs/meeko.git",
		"directory": "packages/ui"
	},
	"license": "MIT",
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./runtime": {
			"types": "./dist/runtime.d.ts",
			"default": "./dist/runtime.js"
		},
		"./editor": {
			"types": "./dist/editor/index.d.ts",
			"default": "./dist/editor/index.js"
		},
		"./editor/module": {
			"types": "./dist/editor/module.d.ts",
			"default": "./dist/editor/module.js"
		},
		"./styles/code.css": "./src/app/styles/code.css",
		"./styles/fonts.css": "./src/app/styles/fonts.css",
		"./styles/prose.css": "./src/app/styles/prose.css"
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist/",
		"src/app/styles/",
		"DESIGN.md",
		"README.md",
		"LICENSE",
		"CHANGELOG.md",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"build": "node ../../scripts/build-package.mjs && node scripts/copy-components.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"prepack": "pnpm run build",
		"test": "pnpm run build && node --test tests/*.test.mjs",
		"test:e2e": "pnpm run build && pnpm -F meeko-ui-site build && pnpm -F meeko-i18n-site build && node --test --test-concurrency=1 tests/*.e2e.mjs"
	},
	"devDependencies": {
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@meekojs/eslint-plugin": "workspace:*",
		"@meekojs/meeko": "workspace:*",
		"@meekojs/prettier-plugin": "workspace:*",
		"@milkdown/crepe": "7.23.0",
		"@milkdown/kit": "7.23.0",
		"@types/node": "^24.0.0",
		"eslint": "10.13.0",
		"jiti": "2.7.0",
		"playwright-core": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-css-order": "^2.2.0",
		"prettier-plugin-packagejson": "^3.0.3",
		"remark-gfm": "^4.0.1",
		"remark-parse": "^11.0.0",
		"remark-stringify": "^11.0.0",
		"typescript": "7.0.2",
		"unified": "^11.0.5"
	},
	"peerDependencies": {
		"@codemirror/lang-css": "^6.3.1",
		"@codemirror/lang-html": "^6.4.12",
		"@codemirror/lang-javascript": "^6.2.5",
		"@codemirror/lang-json": "^6.0.2",
		"@codemirror/language": "^6.13.1",
		"@codemirror/view": "^6.43.15",
		"@lezer/highlight": "^1.2.5",
		"@meekojs/meeko": ">=1.7 <2",
		"@milkdown/crepe": "^7.23.0",
		"@milkdown/kit": "^7.23.0"
	},
	"peerDependenciesMeta": {
		"@codemirror/lang-css": {
			"optional": true
		},
		"@codemirror/lang-html": {
			"optional": true
		},
		"@codemirror/lang-javascript": {
			"optional": true
		},
		"@codemirror/lang-json": {
			"optional": true
		},
		"@codemirror/language": {
			"optional": true
		},
		"@codemirror/view": {
			"optional": true
		},
		"@lezer/highlight": {
			"optional": true
		},
		"@milkdown/crepe": {
			"optional": true
		},
		"@milkdown/kit": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
