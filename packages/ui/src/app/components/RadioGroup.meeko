<script lang="ts">
	import { useId } from '@meekojs/meeko'

	import type { UIRadioGroupProps } from '../types/forms'

	import { radioGroupTheme } from '../theme/components/radio-group'
	import { uiTheme } from '../utils/defaults'

	const { legend, options, name, required, variant = 'default', class: ownClass, ui: ownUi, ...rest } = defineProps<UIRadioGroupProps>()

	const theme = uiTheme('radioGroup', () => ({ class: ownClass, ui: ownUi }))

	const value = defineModel<string>({ default: '' })

	const id = useId()

	const classes = radioGroupTheme({ variant })
</script>

<template>
	<fieldset
		bind:class="classes.base({ class: [theme.ui.base, theme.class] })"
		bind="rest"
	>
		<legend bind:class="classes.legend({ class: theme.ui.legend })">{legend}</legend>
		<div bind:class="classes.options({ class: theme.ui.options })">
			<label
				each:of="options"
				each:as="option"
				each:key="option.value"
				bind:class="classes.option({ class: theme.ui.option })"
			>
				<input
					type="radio"
					model="value"
					bind:name="name ?? id"
					bind:form="rest.form"
					bind:value="option.value"
					bind:disabled="option.disabled"
					bind:required="required"
					bind:class="classes.input({ class: theme.ui.input })"
				/>
				<span>{option.label}</span>
			</label>
		</div>
	</fieldset>
</template>
