<script lang="ts">
	import { useId } from '@meekojs/meeko'

	import type { UIRadioGroupProps } from '../types/forms'

	import { radioGroup } from '../variants/choice'

	const { legend, options, name, required, variant = 'default', class: className, ui, ...rest } = defineProps<UIRadioGroupProps>()

	const value = defineModel<string>({ default: '' })

	const id = useId()

	const classes = radioGroup({ variant })
</script>

<template>
	<fieldset
		bind:class="classes.base({ class: [ui?.base, className] })"
		bind="rest"
	>
		<legend bind:class="classes.legend({ class: ui?.legend })">{legend}</legend>
		<div bind:class="classes.options({ class: ui?.options })">
			<label
				each:of="options"
				each:as="option"
				each:key="option.value"
				bind:class="classes.option({ class: ui?.option })"
			>
				<input
					type="radio"
					model="value"
					bind:name="name ?? id"
					bind:form="rest.form"
					bind:value="option.value"
					bind:disabled="option.disabled"
					bind:required="required"
					bind:class="classes.input({ class: ui?.input })"
				/>
				<span>{option.label}</span>
			</label>
		</div>
	</fieldset>
</template>
