<script lang="ts">
	import type { UILinkTarget, UINavigationLink, UIPageNavigationProps } from '../types/navigation'

	import { icons } from '../utils/icons'
	import { uiMessages } from '../utils/messages'
	import { linkTarget } from '../utils/navigation'
	import { pageNavigation, pageNavigationNext } from '../variants/navigation'
	import * as Icon from './internal/Icon.meeko'
	import * as ItemLink from './internal/ItemLink.meeko'

	const props = defineProps<UIPageNavigationProps>()

	const text = uiMessages().pageNavigation

	const withRel = (link: UINavigationLink, rel: string): UILinkTarget => ({ ...linkTarget(link), rel: link.rel ?? rel })

	const classes = pageNavigation()
</script>

<template>
	<nav
		if:when="props.previous || props.next"
		data-pagefind-ignore
		bind:class="classes.base({ class: [props.ui?.base, props.class] })"
		bind:aria-label="props.label ?? text.label"
	>
		<ItemLink
			if:when="props.previous"
			bind:class="classes.link({ class: props.ui?.link })"
			bind:link="withRel(props.previous!, 'prev')"
		>
			<small bind:class="classes.hint({ class: props.ui?.hint })">
				<Icon
					bind:class="classes.icon({ class: props.ui?.icon })"
					bind:path="icons.arrowStart"
				/>
				{props.previousLabel ?? text.previous}
			</small>
			<span bind:class="classes.label({ class: props.ui?.label })">{props.previous?.label}</span>
		</ItemLink>
		<ItemLink
			if:when="props.next"
			bind:class="classes.link({ class: [pageNavigationNext.link, props.ui?.link] })"
			bind:link="withRel(props.next!, 'next')"
		>
			<small bind:class="classes.hint({ class: [pageNavigationNext.hint, props.ui?.hint] })">
				{props.nextLabel ?? text.next}
				<Icon
					bind:class="classes.icon({ class: props.ui?.icon })"
					bind:path="icons.arrowEnd"
				/>
			</small>
			<span bind:class="classes.label({ class: props.ui?.label })">{props.next?.label}</span>
		</ItemLink>
	</nav>
</template>
