<script lang="ts">
	import type { UILinkTarget, UINavigationLink, UIPageNavigationProps } from '../types/navigation'

	import { icons } from '../utils/icons'
	import { uiMessages } from '../utils/messages'
	import { linkTarget } from '../utils/navigation'
	import * as Icon from './internal/Icon.meeko'
	import * as ItemLink from './internal/ItemLink.meeko'

	const props = defineProps<UIPageNavigationProps>()

	const text = uiMessages().pageNavigation

	const withRel = (link: UINavigationLink, rel: string): UILinkTarget => ({ ...linkTarget(link), rel: link.rel ?? rel })
</script>

<template>
	<nav
		if:when="props.previous || props.next"
		data-pagefind-ignore
		bind:class="['meeko-ui-page-nav', props.class].filter(Boolean).join(' ')"
		bind:aria-label="props.label ?? text.label"
	>
		<ItemLink
			if:when="props.previous"
			class="meeko-ui-page-nav-link"
			data-direction="previous"
			bind:link="withRel(props.previous!, 'prev')"
		>
			<small>
				<Icon bind:path="icons.arrowStart" />
				{props.previousLabel ?? text.previous}
			</small>
			<span>{props.previous?.label}</span>
		</ItemLink>
		<ItemLink
			if:when="props.next"
			class="meeko-ui-page-nav-link"
			data-direction="next"
			bind:link="withRel(props.next!, 'next')"
		>
			<small>
				{props.nextLabel ?? text.next}
				<Icon bind:path="icons.arrowEnd" />
			</small>
			<span>{props.next?.label}</span>
		</ItemLink>
	</nav>
</template>
