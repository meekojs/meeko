<script lang="ts">
	// <UITooltip>: a <UIPopover mode="hint"> with the look of a tooltip. The browser opens and closes it where
	// it has Interest Invokers (`interestfor`: Chromium since 142, neither Firefox nor Safari yet), and the script
	// of <UIPopover> everywhere else. Its look is the `tooltip` role of ../variants/popover.ts. Its template has
	// no whitespace between the tags: it would be text in the tooltip.
	import { computed } from '@meekojs/meeko'

	import type { TooltipSnippets, UITooltipProps } from '../types/tooltip'

	import { tooltipTrigger } from '../variants/popover'
	import * as Popover from './Popover.meeko'

	const props = defineProps<UITooltipProps>()

	const open = defineModel<boolean>({ default: false })

	const snippets = defineSnippets<TooltipSnippets>()

	const triggerClass = computed(() => tooltipTrigger({ class: props.triggerClass }))
</script>

<!-- No whitespace between the tags of this template: it would be text inside the tooltip and the trigger. Prettier keeps it that way (htmlWhitespaceSensitivity "strict" in prettier.config.ts); tests/templates-without-whitespace.test.mjs guards it. -->
<template><Popover
		mode="hint"
		model="open"
		bind:placement="props.placement ?? 'top'"
		bind:offset="props.offset ?? 6"
		bind:delay="props.delay"
		bind:closeDelay="props.closeDelay"
		bind:triggerId="props.triggerId"
		bind:class="props.class"
		><snippet
			name="anchor"
			params="trigger"
		>
			<render
				if:when="snippets.anchor"
				snippet="snippets.anchor"
				args="trigger"
			/><button
				if:when="!snippets.anchor"
				type="button"
				bind:id="trigger.id"
				bind:aria-describedby="trigger['aria-describedby']"
				bind:interestfor="trigger.interestfor"
				bind:class="triggerClass.value"
				><render snippet="snippets.trigger"
			/></button></snippet
		><template if:when="props.text !== undefined">{props.text}</template
		><render
			if:when="snippets.default"
			snippet="snippets.default"
	/></Popover></template>
