<script lang="ts" generic="T, Multiple extends boolean = false">
	// <UISelect>, built on <UIPopover>: the successor of the deprecated <MeekoSelect> of the core, with
	// the same contract and markup. The behavior lives in ../utils/select.ts. Its template stays on one
	// line, outside Prettier (.prettierignore): whitespace between the tags would be text in the options.
	import { onMounted, useId } from '@meekojs/meeko'

	import type { SelectModel, SelectSettings, SelectSnippets, UISelectProps } from '../types/select'

	import { uiMessages } from '../utils/messages'
	import { createSelect } from '../utils/select'
	import * as Popover from './Popover.meeko'

	const props = defineProps<UISelectProps<T, Multiple>>()

	const emit = defineEmits<{ change: [value: SelectModel<T, Multiple>] }>()

	const model = defineModel<SelectModel<T, Multiple>>({ default: null as unknown as SelectModel<T, Multiple> })

	const snippets = defineSnippets<SelectSnippets<T>>()

	const root = useElementRef('root')

	const text = uiMessages().select

	// The IDs of the trigger, the list and each option come from useId: the same in SSR and hydration.
	const select = createSelect<T>(props as SelectSettings<T>, model, useId(), (value) => emit('change', value as SelectModel<T, Multiple>))
	onMounted(() => select.mount(root.value))
</script>

<!-- Keep this template on one line, without whitespace between the tags: it would be text inside the trigger and the options. Do not format this file (it is in .prettierignore; tests/one-line-templates.test.mjs guards it). -->
<template><div ref:root data-meeko-select bind:class="props.class" bind:data-open="select.open.value ? '' : undefined" bind:data-disabled="props.disabled ? '' : undefined" bind:data-multiple="select.multiple.value ? '' : undefined" bind:data-loading="select.loading.value ? '' : undefined" bind:data-clearable="props.clearable ? '' : undefined"><Popover mode="manual" matchWidth bind:placement="props.placement ?? 'bottom-start'" bind:offset="props.offset ?? 0" bind:triggerId="select.triggerId.value" bind:class="props.listClass" model="select.open"><snippet name="anchor" params="trigger"><button if:when="!props.searchable" type="button" role="combobox" data-meeko-select-trigger bind:id="trigger.id" aria-haspopup="listbox" bind:aria-controls="select.listboxId" bind:aria-expanded="select.open.value ? 'true' : 'false'" bind:aria-activedescendant="select.activeId.value" bind:aria-label="props.label" bind:aria-describedby="select.describedBy.value" bind:aria-invalid="select.invalid.value" bind:aria-required="props.required ? 'true' : undefined" bind:disabled="props.disabled" on:click="select.triggerClick" on:keydown="select.keydown" on:keyup="select.keyup"><span if:when="snippets.value && select.selected.value.length" data-meeko-select-values><span each:of="select.selectedEntries.value" each:as="entry" each:key="entry.key" data-meeko-select-value><render snippet="snippets.value" args="entry.option" /></span></span><span if:when="!snippets.value && select.selected.value.length" data-meeko-select-value>{select.valueText.value}</span><span if:when="!select.selected.value.length" data-meeko-select-placeholder>{props.placeholder ?? ''}</span></button><span if:when="props.searchable && select.multiple.value && select.selected.value.length" data-meeko-select-values><span each:of="select.selectedEntries.value" each:as="entry" each:key="entry.key" data-meeko-select-value><render if:when="snippets.value" snippet="snippets.value" args="entry.option" /><template if:when="!snippets.value">{entry.label}</template></span></span><input if:when="props.searchable" type="text" role="combobox" autocomplete="off" aria-autocomplete="list" aria-haspopup="listbox" data-meeko-select-trigger bind:id="trigger.id" bind:aria-controls="select.listboxId" bind:aria-expanded="select.open.value ? 'true' : 'false'" bind:aria-activedescendant="select.activeId.value" bind:aria-label="props.label" bind:aria-describedby="select.describedBy.value" bind:aria-invalid="select.invalid.value" bind:aria-required="props.required ? 'true' : undefined" bind:disabled="props.disabled" bind:placeholder="props.placeholder" bind:value="select.inputText.value" on:input="select.input" on:click="select.inputClick" on:keydown="select.keydown" /></snippet><div role="listbox" data-meeko-select-list bind:id="select.listboxId" bind:aria-multiselectable="select.multiple.value ? 'true' : undefined" bind:aria-label="props.label" bind:aria-labelledby="props.label === undefined ? select.triggerId.value : undefined" bind:aria-busy="select.loading.value ? 'true' : undefined" on:mousedown="select.keepFocus" on:click="select.optionClick" on:pointermove="select.optionHover"><div each:of="select.groups.value" each:as="group" each:key="group.key" bind:role="group.name === undefined ? 'presentation' : 'group'" bind:aria-labelledby="group.id" data-meeko-select-group><div if:when="group.name !== undefined" role="presentation" bind:id="group.id" data-meeko-select-group-label><render if:when="snippets.group" snippet="snippets.group" args="group.name ?? ''" /><template if:when="!snippets.group">{group.name}</template></div><div each:of="group.entries" each:as="entry" each:key="entry.key" role="option" bind:id="entry.id" bind:data-index="entry.index" bind:aria-selected="select.isSelected(entry) ? 'true' : 'false'" bind:aria-disabled="select.isBlocked(entry) ? 'true' : undefined" bind:data-active="select.active.value === entry.index ? '' : undefined" bind:data-selected="select.isSelected(entry) ? '' : undefined" bind:data-disabled="select.isBlocked(entry) ? '' : undefined"><render if:when="snippets.option" snippet="snippets.option" args="entry.option, select.stateOf(entry)" /><template if:when="!snippets.option">{entry.label}</template></div></div><div if:when="select.loading.value" role="presentation" data-meeko-select-loading><render snippet="snippets.loading" /></div><div if:when="!select.loading.value && !select.entries.value.length" role="presentation" data-meeko-select-empty><render if:when="snippets.empty" snippet="snippets.empty" /><template if:when="!snippets.empty">{text.empty}</template></div></div></Popover><button if:when="select.showClear.value" type="button" data-meeko-select-clear bind:aria-label="props.clearLabel ?? text.clear" on:click="select.clear">×</button><input each:of="select.hiddenValues.value" each:as="value" type="hidden" bind:name="select.name.value" bind:value="value" bind:disabled="props.disabled" /><input if:when="props.required" type="text" hidden required tabindex="-1" aria-hidden="true" data-meeko-select-validity bind:value="select.selected.value.length ? 'selected' : ''" bind:disabled="props.disabled" on:invalid="select.reportInvalid" /></div></template>
