<script lang="ts">
	import type { UIFieldProps } from '../types/forms'

	import { field } from '../variants/field'

	const props = defineProps<UIFieldProps>()

	const snippets = defineSnippets<{ default: [id: string, describedBy: string | undefined] }>()

	const classes = field()
</script>

<template>
	<div bind:class="classes.base({ class: [props.ui?.base, props.class] })">
		<label
			bind:for="props.id"
			bind:class="classes.label({ class: props.ui?.label })"
		>
			{props.label}
			<span
				if:when="props.required"
				aria-hidden="true"
			>
				*
			</span>
		</label>
		<render
			snippet="snippets.default"
			args="props.id, [props.error ? props.id + '-error' : props.description ? props.id + '-description' : undefined, props.hint ? props.id + '-hint' : undefined, props.counter !== undefined ? props.id + '-counter' : undefined].filter(Boolean).join(' ') || undefined"
		/>
		<p
			if:when="props.description && !props.error"
			bind:id="props.id + '-description'"
			bind:class="classes.description({ class: props.ui?.description })"
		>
			{props.description}
		</p>
		<p
			if:when="props.error"
			role="alert"
			bind:id="props.id + '-error'"
			bind:class="classes.error({ class: props.ui?.error })"
		>
			{props.error}
		</p>
		<div
			if:when="props.hint || props.counter !== undefined"
			bind:class="classes.meta({ class: props.ui?.meta })"
		>
			<p
				if:when="props.hint"
				bind:id="props.id + '-hint'"
				bind:class="classes.hint({ class: props.ui?.hint })"
			>
				{props.hint}
			</p>
			<p
				if:when="props.counter !== undefined"
				bind:id="props.id + '-counter'"
				bind:class="classes.counter({ class: props.ui?.counter })"
			>
				{props.counter}
			</p>
		</div>
	</div>
</template>
