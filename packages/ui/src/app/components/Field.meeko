<script lang="ts">
	import type { UIFieldProps } from '../types/forms'

	const props = defineProps<UIFieldProps>()

	const snippets = defineSnippets<{ default: [id: string, describedBy: string | undefined] }>()
</script>

<template>
	<div bind:class="['meeko-ui-field', props.class].filter(Boolean).join(' ')">
		<label
			class="meeko-ui-field-label"
			bind:for="props.id"
		>
			{props.label}
			<span
				if:when="props.required"
				aria-hidden="true"
			>
				*
			</span>
		</label>
		<render
			snippet="snippets.default"
			args="props.id, [props.error ? props.id + '-error' : props.description ? props.id + '-description' : undefined, props.hint ? props.id + '-hint' : undefined, props.counter !== undefined ? props.id + '-counter' : undefined].filter(Boolean).join(' ') || undefined"
		/>
		<p
			if:when="props.description && !props.error"
			class="meeko-ui-field-description"
			bind:id="props.id + '-description'"
		>
			{props.description}
		</p>
		<p
			if:when="props.error"
			class="meeko-ui-field-error"
			role="alert"
			bind:id="props.id + '-error'"
		>
			{props.error}
		</p>
		<div
			if:when="props.hint || props.counter !== undefined"
			class="meeko-ui-field-meta"
		>
			<p
				if:when="props.hint"
				class="meeko-ui-field-description"
				bind:id="props.id + '-hint'"
			>
				{props.hint}
			</p>
			<p
				if:when="props.counter !== undefined"
				class="meeko-ui-field-description meeko-ui-field-counter"
				bind:id="props.id + '-counter'"
			>
				{props.counter}
			</p>
		</div>
	</div>
</template>
