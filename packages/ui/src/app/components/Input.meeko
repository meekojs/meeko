<script lang="ts">
	import type { UIInputProps } from '../types/forms'

	import { uiTheme } from '../utils/defaults'
	import { input } from '../variants/input'

	const { invalid, describedBy, spellcheck, class: ownClass, type = 'text', ...rest } = defineProps<UIInputProps>()

	const theme = uiTheme('input', () => ({ class: ownClass }))

	const value = defineModel<string>({ default: '' })
</script>

<template>
	<input
		model="value"
		bind:spellcheck="spellcheck === undefined ? undefined : String(spellcheck)"
		bind:type="type"
		bind:aria-invalid="invalid ? 'true' : undefined"
		bind:aria-describedby="describedBy ?? rest['aria-describedby']"
		bind:class="input({ class: theme.class })"
		bind="rest"
	/>
</template>
