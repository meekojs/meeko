<script lang="ts">
	import type { UIEmptyProps } from '../types/feedback'

	import { uiMessages } from '../utils/messages'

	const props = defineProps<UIEmptyProps>()

	const snippets = defineSnippets<{ default?: []; title?: []; actions?: [] }>()

	const text = uiMessages().feedback
</script>

<template>
	<div
		bind:class="['meeko-ui-empty', props.class].filter(Boolean).join(' ')"
		bind:data-variant="props.variant ?? 'inline'"
	>
		<p class="meeko-ui-empty-title">
			<render
				if:when="snippets.title"
				snippet="snippets.title"
			/>
			<template if:when="!snippets.title">{props.title ?? text.empty}</template>
		</p>
		<p
			if:when="props.description"
			class="meeko-ui-empty-description"
		>
			{props.description}
		</p>
		<render
			if:when="snippets.default"
			snippet="snippets.default"
		/>
		<div
			if:when="snippets.actions"
			class="meeko-ui-feedback-actions"
		>
			<render snippet="snippets.actions" />
		</div>
	</div>
</template>
