<script lang="ts">
	import type { UIFooterProps } from '../types/navigation'

	import { uiTheme } from '../utils/defaults'
	import { uiMessages } from '../utils/messages'
	import { linkTarget } from '../utils/navigation'
	import { container } from '../variants/container'
	import { footer } from '../variants/header'
	import * as Brand from './internal/Brand.meeko'
	import * as ItemLink from './internal/ItemLink.meeko'

	const props = defineProps<UIFooterProps>({ size: '2xl' })

	const theme = uiTheme('footer', () => props)

	const snippets = defineSnippets<{ brand?: []; about?: []; actions?: []; legal?: [] }>()

	const text = uiMessages().footer

	const classes = footer()
</script>

<template>
	<footer
		data-pagefind-ignore
		bind:class="classes.base({ class: [theme.ui.base, theme.class] })"
	>
		<div bind:class="classes.inner({ class: [container({ size: props.size, gutter: 'md' }), theme.ui.inner] })">
			<div
				if:when="snippets.brand || props.brand || snippets.about || props.description || snippets.actions"
				bind:class="classes.about({ class: theme.ui.about })"
			>
				<render
					if:when="snippets.brand"
					snippet="snippets.brand"
				/>
				<Brand
					if:when="!snippets.brand && props.brand"
					bind:brand="props.brand!"
				/>
				<render
					if:when="snippets.about"
					snippet="snippets.about"
				/>
				<p if:when="!snippets.about && props.description">{props.description}</p>
				<div
					if:when="snippets.actions"
					bind:class="classes.actions({ class: theme.ui.actions })"
				>
					<render snippet="snippets.actions" />
				</div>
			</div>
			<nav
				if:when="props.groups?.length"
				bind:aria-label="props.label ?? text.label"
				bind:class="classes.groups({ class: theme.ui.groups })"
			>
				<div
					each:of="props.groups ?? []"
					each:as="group"
					each:key="group.title"
				>
					<p bind:class="classes.title({ class: theme.ui.title })">{group.title}</p>
					<ul bind:class="classes.list({ class: theme.ui.list })">
						<li
							each:of="group.items"
							each:as="item"
							each:key="item.label"
						>
							<ItemLink
								bind:link="linkTarget(item)"
								bind:class="classes.link({ class: theme.ui.link })"
							>
								{item.label}
							</ItemLink>
						</li>
					</ul>
				</div>
			</nav>
			<div
				if:when="snippets.legal || props.items?.length"
				bind:class="classes.legal({ class: theme.ui.legal })"
			>
				<div if:when="snippets.legal"><render snippet="snippets.legal" /></div>
				<nav
					if:when="props.items?.length"
					bind:aria-label="props.label ?? text.label"
					bind:class="classes.legalNav({ class: theme.ui.legalNav })"
				>
					<ItemLink
						each:of="props.items ?? []"
						each:as="item"
						each:key="item.label"
						bind:link="linkTarget(item)"
						bind:class="classes.link({ class: theme.ui.link })"
					>
						{item.label}
					</ItemLink>
				</nav>
			</div>
		</div>
	</footer>
</template>
