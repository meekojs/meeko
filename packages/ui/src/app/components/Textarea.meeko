<script lang="ts">
	import type { UITextareaProps } from '../types/forms'

	import { uiTheme } from '../utils/defaults'
	import { textarea } from '../variants/input'

	const { invalid, describedBy, spellcheck, class: ownClass, ...rest } = defineProps<UITextareaProps>()

	const theme = uiTheme('textarea', () => ({ class: ownClass }))

	const value = defineModel<string>({ default: '' })
</script>

<template>
	<textarea
		model="value"
		bind:spellcheck="spellcheck === undefined ? undefined : String(spellcheck)"
		bind:aria-invalid="invalid ? 'true' : undefined"
		bind:aria-describedby="describedBy ?? rest['aria-describedby']"
		bind:class="textarea({ class: theme.class })"
		bind="rest"
	/>
</template>
