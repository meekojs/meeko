<script lang="ts">
	// <UIDisclosure>: a native <details>, so it opens with the keyboard and without JavaScript.
	import type { UIDisclosureProps } from '../types/feedback'

	import { disclosureTheme } from '../theme/components/disclosure'
	import { chevron } from '../theme/components/navigation'
	import { uiTheme } from '../utils/defaults'
	import { icons } from '../utils/icons'
	import * as Icon from './internal/Icon.meeko'

	const props = defineProps<UIDisclosureProps>()

	const theme = uiTheme('disclosure', () => props)

	const snippets = defineSnippets<{ default: [] }>()

	const classes = disclosureTheme()
</script>

<template>
	<details
		bind:class="classes.base({ class: [theme.ui.base, theme.class] })"
		bind:open="props.open"
	>
		<summary bind:class="classes.summary({ class: theme.ui.summary })">
			{props.summary}
			<Icon
				bind:class="chevron"
				bind:path="icons.chevron"
			/>
		</summary>
		<div bind:class="classes.body({ class: theme.ui.body })"><render snippet="snippets.default" /></div>
	</details>
</template>
