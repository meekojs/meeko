<script lang="ts">
	// <UIDisclosure>: a native <details>, so it opens with the keyboard and without JavaScript.
	import type { UIDisclosureProps } from '../types/feedback'

	import { icons } from '../utils/icons'
	import { disclosure } from '../variants/feedback'
	import { chevron } from '../variants/navigation'
	import * as Icon from './internal/Icon.meeko'

	const props = defineProps<UIDisclosureProps>()

	const snippets = defineSnippets<{ default: [] }>()

	const classes = disclosure()
</script>

<template>
	<details
		bind:class="classes.base({ class: [props.ui?.base, props.class] })"
		bind:open="props.open"
	>
		<summary bind:class="classes.summary({ class: props.ui?.summary })">
			{props.summary}
			<Icon
				bind:class="chevron"
				bind:path="icons.chevron"
			/>
		</summary>
		<div bind:class="classes.body({ class: props.ui?.body })"><render snippet="snippets.default" /></div>
	</details>
</template>
