<script lang="ts" generic="Value extends string">
	// <UITabs>: panels of one page, with the ARIA tabs pattern. The panels only change `hidden`, so the
	// chosen one is already visible before hydration. Its template stays on one line, outside Prettier
	// (.prettierignore): whitespace between the tags would be text inside the tabs.
	import type { Snippet } from '@meekojs/meeko'

	import { onMounted, useId } from '@meekojs/meeko'

	import type { TabsSnippets, UITabsProps } from '../types/tabs'

	import { createTabs } from '../utils/tabs'

	const props = defineProps<UITabsProps<Value>>()

	const emit = defineEmits<{ change: [value: Value] }>()

	const model = defineModel<Value | undefined>({ default: undefined })

	const snippets = defineSnippets<TabsSnippets<Value>>()

	const root = useElementRef('root')

	// The template reads the panels by name, a string that their template-literal key cannot index.
	const panels = snippets as unknown as Readonly<Record<string, Snippet | undefined>>

	const tabs = createTabs<Value>(props, model, useId(), (value) => emit('change', value))
	onMounted(() => tabs.mount(root.value))
</script>

<!-- Keep this template on one line, without whitespace between the tags: it would be text inside the tabs. Do not format this file (it is in .prettierignore; tests/one-line-templates.test.mjs guards it). -->
<template><div ref:root bind:id="props.id" bind:class="['meeko-ui-tabs', props.class].filter(Boolean).join(' ')"><div role="tablist" class="meeko-ui-tabs-list" bind:aria-label="props.label" bind:aria-labelledby="props.labelledBy" on:keydown="tabs.keydown"><button each:of="props.items" each:as="item" each:key="item.value" type="button" role="tab" class="meeko-ui-tabs-tab" bind:id="tabs.tabId(item)" bind:aria-controls="tabs.panelId(item)" bind:aria-selected="tabs.selected.value === item.value ? 'true' : 'false'" bind:tabindex="tabs.selected.value === item.value ? '0' : '-1'" bind:disabled="item.disabled" on:click="() => tabs.choose(item)"><render if:when="snippets.tab" snippet="snippets.tab" args="item" /><template if:when="!snippets.tab">{item.label}</template><span class="meeko-ui-tabs-indicator" /></button></div><div each:of="props.items" each:as="item" each:key="item.value" role="tabpanel" class="meeko-ui-tabs-panel" tabindex="0" bind:id="tabs.panelId(item)" bind:aria-labelledby="tabs.tabId(item)" bind:hidden="tabs.selected.value !== item.value"><render if:when="panels['panel-' + item.value]" snippet="panels['panel-' + item.value]" /><render if:when="!panels['panel-' + item.value] && snippets.panel" snippet="snippets.panel" args="item" /></div></div></template>
