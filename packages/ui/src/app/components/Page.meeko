<script lang="ts">
	// <UIPage>: the structure every site shares, one <main> and its skip link; what goes inside is the app's.
	import type { UIPageProps } from '../types/navigation'

	import { uiTheme } from '../utils/defaults'
	import { uiMessages } from '../utils/messages'
	import { page, pageColumns } from '../variants/page'

	const { layout = 'docs', mainId = 'contenido', mainLang, skipLabel, ui: ownUi, class: ownClass, ...rest } = defineProps<UIPageProps>()

	const theme = uiTheme('page', () => ({ class: ownClass, ui: ownUi }))

	const snippets = defineSnippets<{ default: []; header?: []; notices?: []; bar?: []; sidebar?: []; aside?: []; footer?: [] }>()

	const text = uiMessages().page
	const classes = page()
</script>

<template>
	<div
		bind:class="classes.base({ class: [theme.ui.base, theme.class] })"
		bind="rest"
	>
		<a
			bind:class="classes.skip({ class: theme.ui.skip })"
			bind:href="'#' + mainId"
		>
			{skipLabel ?? text.skip}
		</a>
		<render
			if:when="snippets.header"
			snippet="snippets.header"
		/>
		<div
			if:when="snippets.notices"
			bind:class="classes.notices({ class: theme.ui.notices })"
		>
			<render snippet="snippets.notices" />
		</div>
		<div
			if:when="snippets.bar"
			data-pagefind-ignore
			bind:class="classes.bar({ class: theme.ui.bar })"
		>
			<render snippet="snippets.bar" />
		</div>
		<div bind:class="classes.body({ layout, class: [pageColumns({ sidebar: Boolean(snippets.sidebar), aside: Boolean(snippets.aside) }), theme.ui.body] })">
			<div
				if:when="snippets.sidebar"
				data-pagefind-ignore
				bind:class="classes.sidebar({ class: theme.ui.sidebar })"
			>
				<render snippet="snippets.sidebar" />
			</div>
			<main
				tabindex="-1"
				bind:class="classes.main({ layout, class: theme.ui.main })"
				bind:id="mainId"
				bind:lang="mainLang"
			>
				<render snippet="snippets.default" />
			</main>
			<aside
				if:when="snippets.aside"
				data-pagefind-ignore
				bind:class="classes.aside({ class: theme.ui.aside })"
			>
				<render snippet="snippets.aside" />
			</aside>
		</div>
		<render
			if:when="snippets.footer"
			snippet="snippets.footer"
		/>
	</div>
</template>
