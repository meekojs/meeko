<script lang="ts" generic="T">
	// <UICommandPalette>: a search dialog that knows nothing about where the results come from. The parent
	// reads `query` and passes `results` and `status`. The dialog is the one of <UIModal>, with its entrance,
	// exit and backdrop. Its template stays on one line, outside Prettier (.prettierignore): whitespace
	// between the tags would be text inside the trigger and the rows.
	import { onMounted, useId } from '@meekojs/meeko'

	import type { CommandPaletteSnippets, UICommandPaletteProps } from '../types/command-palette'

	import { createCommandPalette } from '../utils/command-palette'
	import { commandPaletteStatusText, uiMessages } from '../utils/messages'

	const props = defineProps<UICommandPaletteProps<T>>()

	const emit = defineEmits<{ open: []; close: []; choose: [item: T] }>()

	const open = defineModel<boolean>({ default: false })

	const query = defineModel<string>('query', { default: '' })

	const active = defineModel<number>('active', { default: 0 })

	const snippets = defineSnippets<CommandPaletteSnippets<T>>()

	const dialog = useElementRef('dialog')

	const input = useElementRef('input')

	const text = uiMessages().commandPalette
	const palette = createCommandPalette<T>(props, { open, query, active }, useId(), { open: () => emit('open'), close: () => emit('close'), choose: (item) => emit('choose', item) })
	onMounted(() => palette.mount(dialog.value, input.value))
</script>

<!-- Keep this template on one line, without whitespace between the tags: it would be text inside the trigger and the rows. Do not format this file (it is in .prettierignore; tests/one-line-templates.test.mjs guards it). -->
<template><button if:when="props.trigger !== false" type="button" bind:class="['meeko-ui-command-trigger', props.triggerClass].filter(Boolean).join(' ')" bind:aria-label="props.label ?? text.label" on:click="palette.show"><render if:when="snippets.trigger" snippet="snippets.trigger" args="palette.modifier.value" /><template if:when="!snippets.trigger"><svg class="meeko-ui-command-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg><span class="meeko-ui-command-trigger-label">{props.label ?? text.label}</span><span class="meeko-ui-command-keys" aria-hidden="true"><kbd>{palette.modifier.value}</kbd><kbd>K</kbd></span></template></button><dialog ref:dialog closedby="any" bind:class="['meeko-ui-modal', 'meeko-ui-command', props.class].filter(Boolean).join(' ')" bind:aria-label="props.label ?? text.label" on:keydown="palette.keydown"><div class="meeko-ui-command-field"><svg class="meeko-ui-command-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg><input ref:input type="search" role="combobox" autocomplete="off" spellcheck="false" aria-autocomplete="list" model="query" bind:id="props.inputId" bind:name="props.inputName" bind:placeholder="props.placeholder ?? text.placeholder" bind:aria-label="props.inputLabel ?? text.input" bind:aria-expanded="palette.showing.value ? 'true' : 'false'" bind:aria-controls="palette.listId" bind:aria-activedescendant="palette.activeId.value" /><button type="button" class="meeko-ui-command-close" bind:aria-label="props.closeLabel ?? text.close" on:click="palette.hide"><kbd aria-hidden="true">Esc</kbd></button></div><div role="status" class="meeko-ui-command-status"><render if:when="snippets.status && palette.status.value !== 'ready'" snippet="snippets.status" args="palette.status.value, query.value.trim()" /><template if:when="!snippets.status && palette.status.value !== 'ready'">{commandPaletteStatusText(text, palette.status.value, query.value.trim())}</template></div><ul role="listbox" class="meeko-ui-command-list" bind:id="palette.listId" bind:aria-label="props.label ?? text.label" bind:hidden="!palette.showing.value"><li each:of="palette.rows.value" each:as="row" each:key="row.index" role="presentation"><component is="row.href === undefined ? 'button' : 'a'" role="option" class="meeko-ui-command-row" bind:id="palette.rowId(row.index)" bind:href="row.href" bind:type="row.href === undefined ? 'button' : undefined" bind:data-depth="row.depth" bind:data-active="active.value === row.index ? '' : undefined" bind:aria-selected="active.value === row.index ? 'true' : 'false'" on:click="() => palette.pick(row)"><render if:when="snippets.item" snippet="snippets.item" args="row.item, { active: active.value === row.index, depth: row.depth, index: row.index }" /><template if:when="!snippets.item">{row.label}</template></component></li></ul></dialog></template>
