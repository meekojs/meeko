<script lang="ts">
	import { useId } from '@meekojs/meeko'

	import type { UISwitchProps } from '../types/forms'

	import { toggle } from '../variants/choice'

	const { label, description, invalid, describedBy, class: className, ui, ...rest } = defineProps<UISwitchProps>()

	const checked = defineModel<boolean>({ default: false })

	const id = useId()

	const classes = toggle()
</script>

<template>
	<label bind:class="classes.base({ class: [ui?.base, className] })">
		<input
			type="checkbox"
			role="switch"
			model="checked"
			bind:aria-invalid="invalid ? 'true' : undefined"
			bind:aria-describedby="[describedBy ?? rest['aria-describedby'], description ? id + '-description' : undefined].filter(Boolean).join(' ') || undefined"
			bind:class="classes.input({ class: ui?.input })"
			bind="rest"
		/>
		<span bind:class="classes.content({ class: ui?.content })">
			<span>{label}</span>
			<span
				if:when="description"
				bind:id="id + '-description'"
				bind:class="classes.description({ class: ui?.description })"
			>
				{description}
			</span>
		</span>
	</label>
</template>
