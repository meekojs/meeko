<script lang="ts">
	// <UIButton>: a route with <MeekoLink> when it gets `to`, an <a> with `href`, otherwise a
	// <button>. The three share the classes of theme/components/button, so they look the same. The types
	// (UIButtonProps) forbid the props of the other branches.
	import { computed } from '@meekojs/meeko'

	import type { UIButtonProps } from '../types/button'

	import { buttonTheme } from '../theme/components/button'
	import { uiTheme } from '../utils/defaults'

	const { to, params, search, resolve, href, target, rel, download, type = 'button', disabled = false, loading, iconOnly, ariaLabel, variant, color, size, radius, width, elevation, class: ownClass, ...rest } = defineProps<UIButtonProps>()

	const theme = uiTheme('button', () => ({ class: ownClass }))

	const emit = defineEmits<{ click: [event: MouseEvent] }>()

	const snippets = defineSnippets<{ default: [] }>()

	// A disabled button drops the focus: while busy it stays focusable, and the click handler stops it.
	const nativeDisabled = computed(() => (to === undefined && href === undefined ? disabled : undefined))
	const classes = computed(() =>
		buttonTheme({
			variant: variant ?? theme.defaults?.variant,
			color: color ?? theme.defaults?.color,
			size: size ?? theme.defaults?.size,
			radius: radius ?? theme.defaults?.radius,
			width,
			elevation,
			iconOnly: Boolean(iconOnly),
			class: theme.class,
		}),
	)
	const linkRel = computed(() => rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined))
</script>

<template>
	<component
		is="to !== undefined ? 'MeekoLink' : href !== undefined ? 'a' : 'button'"
		bind:to="to"
		bind:params="params"
		bind:search="search"
		bind:resolve="resolve"
		bind:href="href"
		bind:target="target"
		bind:rel="linkRel.value"
		bind:download="download"
		bind:type="type"
		bind:disabled="nativeDisabled.value"
		bind:aria-busy="loading ? 'true' : undefined"
		bind:aria-disabled="loading ? 'true' : undefined"
		bind:aria-label="ariaLabel ?? rest['aria-label']"
		bind:class="classes.value"
		bind="rest"
		on:click="
			(event) => {
				if (loading) {
					event.preventDefault()
					return
				}
				emit('click', event)
			}
		"
	>
		<render snippet="snippets.default" />
	</component>
</template>
