<script lang="ts">
	// <UILink>: an <a> with `href`, or a route with <MeekoLink> with `to`; both look the same.
	import { computed } from '@meekojs/meeko'

	import type { UILinkProps } from '../types/button'

	import { uiTheme } from '../utils/defaults'
	import { button } from '../variants/button'

	const { to, params, search, resolve, href, target, rel, ariaLabel, variant, size, shape, class: ownClass, ...rest } = defineProps<UILinkProps>()

	const theme = uiTheme('link', () => ({ class: ownClass }))

	const emit = defineEmits<{ click: [event: MouseEvent] }>()

	const snippets = defineSnippets<{ default: [] }>()

	const classes = computed(() => button({ variant: variant ?? theme.defaults?.variant, size: size ?? theme.defaults?.size, shape: shape ?? theme.defaults?.shape, class: theme.class }))
	const linkRel = computed(() => rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined))
	// `ariaLabel` predates the forwarded `aria-label`; when both are given, `ariaLabel` wins.
	const label = computed(() => ariaLabel ?? rest['aria-label'])
</script>

<template>
	<component
		is="to !== undefined ? 'MeekoLink' : 'a'"
		bind:to="to"
		bind:params="params"
		bind:search="search"
		bind:resolve="resolve"
		bind:href="href"
		bind:target="target"
		bind:rel="linkRel.value"
		bind:aria-label="label.value"
		bind:class="classes.value"
		bind="rest"
		on:click="(event) => emit('click', event)"
	>
		<render snippet="snippets.default" />
	</component>
</template>
