<script lang="ts" generic="T extends object">
	import type { Snippet } from '@meekojs/meeko'
	import type { TableCellValue, TableColumn, UITableProps } from '@meekojs/ui/runtime'

	import { uiMessages } from '../utils/messages'
	import { table } from '../variants/table'

	const props = defineProps<UITableProps<T>>({ layout: 'native', hideHeader: false })

	// `cell-<clave>` y `header-<clave>` salen de las claves de T: `value` tiene el tipo de esa columna.
	const snippets = defineSnippets<
		{ [K in Extract<keyof T, string> as `cell-${K}`]?: [row: T, value: T[K]] } & {
			[K in Extract<keyof T, string> as `header-${K}`]?: [column: TableColumn<T>]
		} & {
			header?: [column: TableColumn<T>]
			cell?: [row: T, column: TableColumn<T>, value: T[keyof T], index: number]
			footer?: [column: TableColumn<T>, rows: readonly T[]]
			empty?: []
			caption?: []
		}
	>()

	// Sobre T, TypeScript no lee un nombre calculado; los snippets de cada columna se leen de esta vista.
	const byName = snippets as { readonly [name: string]: Snippet<never> | undefined }

	function columnCell(column: TableColumn<T>): Snippet<[row: T, value: T[keyof T]]> | undefined {
		return byName[`cell-${column.key}`] as Snippet<[row: T, value: T[keyof T]]> | undefined
	}

	function columnHeader(column: TableColumn<T>): Snippet<[column: TableColumn<T>]> | undefined {
		return byName[`header-${column.key}`] as Snippet<[column: TableColumn<T>]> | undefined
	}

	const id = useId()
	const text = uiMessages().table
	const classes = table()

	/** The variants that the whole table shares. */
	const variants = () => ({ layout: props.layout, density: props.density ?? 'normal', hideCaption: Boolean(props.hideCaption) })

	function keyOf(row: T): string | number {
		return typeof props.rowKey === 'function' ? props.rowKey(row) : (row[props.rowKey] as string | number)
	}

	function cellText(row: T, column: TableColumn<T>): string {
		// La unión pública correlaciona key y format; la llamada conserva esa relación.
		const format = column.format as ((value: T[keyof T], row: T) => TableCellValue) | undefined
		const value = format ? format(row[column.key], row) : row[column.key]
		return value == null ? '' : String(value)
	}

	function footerText(column: TableColumn<T>): string {
		const value = typeof column.footer === 'function' ? column.footer(props.rows) : column.footer
		return value == null ? '' : String(value)
	}
</script>

<template>
	<div
		tabindex="0"
		bind:class="classes.base({ class: props.ui?.base })"
		bind:role="props.caption || snippets.caption ? 'region' : undefined"
		bind:aria-labelledby="props.caption || snippets.caption ? id + '-caption' : undefined"
	>
		<table
			role="table"
			bind:class="classes.table({ ...variants(), class: [props.ui?.table, props.class] })"
			bind:style="'--table-columns: ' + (props.gridColumns ?? 'repeat(' + Math.max(1, props.columns.length) + ', minmax(var(--ui-table-column-min), 1fr))')"
		>
			<caption
				if:when="props.caption || snippets.caption"
				bind:id="id + '-caption'"
				bind:class="classes.caption({ ...variants(), class: props.ui?.caption })"
			>
				<render
					if:when="snippets.caption"
					snippet="snippets.caption"
				/>
				{snippets.caption ? '' : props.caption}
			</caption>
			<thead
				if:when="!props.hideHeader"
				role="rowgroup"
				bind:class="classes.section({ ...variants(), class: props.ui?.section }) || undefined"
			>
				<tr
					role="row"
					bind:class="classes.row({ ...variants(), class: props.ui?.row }) || undefined"
				>
					<th
						each:of="props.columns"
						each:as="column"
						each:key="column.key"
						role="columnheader"
						scope="col"
						bind:class="classes.headerCell({ ...variants(), numeric: Boolean(column.numeric), class: props.ui?.headerCell })"
					>
						<render
							if:when="columnHeader(column)"
							snippet="columnHeader(column)"
							args="column"
						/>
						<render
							if:when="!columnHeader(column) && snippets.header"
							snippet="snippets.header"
							args="column"
						/>
						<span if:when="!columnHeader(column) && !snippets.header">{column.label}</span>
					</th>
				</tr>
			</thead>
			<tbody
				role="rowgroup"
				bind:class="classes.section({ ...variants(), class: props.ui?.section }) || undefined"
			>
				<tr
					each:of="props.rows"
					each:as="row"
					each:index="_index"
					each:key="keyOf(row)"
					role="row"
					bind:class="classes.bodyRow({ ...variants(), class: props.ui?.bodyRow })"
				>
					<component
						each:of="props.columns"
						each:as="column"
						each:key="column.key"
						is="column.rowHeader ? 'th' : 'td'"
						bind:role="column.rowHeader ? 'rowheader' : 'cell'"
						bind:scope="column.rowHeader ? 'row' : undefined"
						bind:class="classes.cell({ ...variants(), numeric: Boolean(column.numeric), rowHeader: Boolean(column.rowHeader), class: props.ui?.cell })"
					>
						<render
							if:when="columnCell(column)"
							snippet="columnCell(column)"
							args="row, row[column.key]"
						/>
						<render
							if:when="!columnCell(column) && snippets.cell"
							snippet="snippets.cell"
							args="row, column, row[column.key], _index"
						/>
						<span if:when="!columnCell(column) && !snippets.cell">{cellText(row, column)}</span>
					</component>
				</tr>
				<tr
					if:when="props.rows.length === 0"
					role="row"
					bind:class="classes.bodyRow({ ...variants(), class: props.ui?.bodyRow })"
				>
					<td
						role="cell"
						bind:class="classes.cell({ ...variants(), class: [classes.empty({ ...variants() }), props.ui?.cell, props.ui?.empty] })"
						bind:colspan="Math.max(1, props.columns.length)"
					>
						<render
							if:when="snippets.empty"
							snippet="snippets.empty"
						/>
						<span if:when="!snippets.empty">{props.emptyText ?? text.empty}</span>
					</td>
				</tr>
			</tbody>
			<tfoot
				if:when="snippets.footer || props.columns.some((column) => column.footer !== undefined)"
				role="rowgroup"
				bind:class="classes.section({ ...variants(), class: props.ui?.section }) || undefined"
			>
				<tr
					role="row"
					bind:class="classes.row({ ...variants(), class: props.ui?.row }) || undefined"
				>
					<td
						each:of="props.columns"
						each:as="column"
						each:key="column.key"
						role="cell"
						bind:class="classes.footerCell({ ...variants(), class: props.ui?.footerCell })"
					>
						<render
							if:when="snippets.footer"
							snippet="snippets.footer"
							args="column, props.rows"
						/>
						<span if:when="!snippets.footer">{footerText(column)}</span>
					</td>
				</tr>
			</tfoot>
		</table>
	</div>
</template>
