<script lang="ts">
	// <UIBadge>: a label of state. Its look is the recipe of theme/components/badge.
	import { computed } from '@meekojs/meeko'

	import type { UIBadgeProps } from '../types/forms'

	import { badgeTheme } from '../theme/components/badge'
	import { uiTheme } from '../utils/defaults'

	const props = defineProps<UIBadgeProps>()

	const theme = uiTheme('badge', () => props)

	const snippets = defineSnippets<{ default: [] }>()

	const classes = computed(() =>
		badgeTheme({
			variant: props.variant ?? theme.defaults?.variant,
			color: props.color ?? theme.defaults?.color,
			radius: props.radius ?? theme.defaults?.radius,
		}),
	)
</script>

<template>
	<span bind:class="classes.value.base({ class: [theme.ui.base, theme.class] })">
		<span
			if:when="props.dot"
			aria-hidden="true"
			bind:class="classes.value.dot({ class: theme.ui.dot })"
		/>
		<render snippet="snippets.default" />
	</span>
</template>
