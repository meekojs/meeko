<script lang="ts">
	import type { UIBadgeProps } from '../types/forms'

	const props = defineProps<UIBadgeProps>({ tone: 'neutral' })

	const snippets = defineSnippets<{ default: [] }>()
</script>

<template>
	<span
		bind:class="['meeko-ui-badge', props.class].filter(Boolean).join(' ')"
		bind:data-tone="props.tone"
	>
		<span
			if:when="props.dot"
			class="meeko-ui-badge-dot"
			aria-hidden="true"
		/>
		<render snippet="snippets.default" />
	</span>
</template>
