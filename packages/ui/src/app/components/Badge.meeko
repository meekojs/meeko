<script lang="ts">
	import { computed } from '@meekojs/meeko'

	import type { UIBadgeProps } from '../types/forms'

	import { badge } from '../variants/badge'

	const props = defineProps<UIBadgeProps>({ tone: 'neutral' })

	const snippets = defineSnippets<{ default: [] }>()

	const classes = computed(() => badge({ tone: props.tone }))
</script>

<template>
	<span bind:class="classes.value.base({ class: [props.ui?.base, props.class] })">
		<span
			if:when="props.dot"
			aria-hidden="true"
			bind:class="classes.value.dot({ class: props.ui?.dot })"
		/>
		<render snippet="snippets.default" />
	</span>
</template>
