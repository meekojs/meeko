<script lang="ts">
	// <UITableOfContents>: plain links. The observer below keeps aria-current on the active one, which paints it
	// in every browser (see tableOfContentsLink); `scroll-target-group` still lets the browser follow the target.
	import { effect, signal } from '@meekojs/meeko'

	import type { UITableOfContentsProps } from '../types/navigation'

	import { uiTheme } from '../utils/defaults'
	import { icons } from '../utils/icons'
	import { uiMessages } from '../utils/messages'
	import { followsLink } from '../utils/navigation'
	import { tableOfContents, tableOfContentsLink, tableOfContentsTracking } from '../variants/navigation'
	import * as Icon from './internal/Icon.meeko'

	const props = defineProps<UITableOfContentsProps>({ variant: 'aside' })

	const theme = uiTheme('tableOfContents', () => props)

	const text = uiMessages().tableOfContents
	const spied = signal<string | undefined>(undefined)
	const viewportHeight = signal(0)
	const panel = useElementRef('panel')

	const activeId = (): string | undefined => props.active ?? spied.value
	const classes = tableOfContents()
	const tracking = (): 'auto' | 'manual' => (props.active === undefined ? 'auto' : 'manual')
	/** Levels 3 and 4 are indented; deeper ones are not, as before. */
	const nested = (level: number): 0 | 1 | 2 => (level === 3 ? 1 : level === 4 ? 2 : 0)
	const linkClass = (level: number): string => classes.link({ class: [tableOfContentsLink({ nested: nested(level), tracking: tracking() }), theme.ui.link] })
	// The <nav> is the root of the aside; in the collapsible view, the panel of its <details>.
	const navClass = (): string =>
		classes.base({
			class: [tracking() === 'auto' ? tableOfContentsTracking : undefined, theme.ui.base, props.variant === 'aside' ? theme.class : classes.panel({ class: theme.ui.panel })],
		})

	function closeOnChoice(event: MouseEvent): void {
		if (followsLink(event)) panel.value?.removeAttribute('open')
	}

	onMounted(() => {
		let stop: (() => void) | undefined
		const measure = (): void => {
			viewportHeight.value = window.innerHeight
		}
		measure()
		window.addEventListener('resize', measure, { passive: true })
		const stopEffect = effect(() => {
			stop?.()
			stop = undefined
			if (props.active !== undefined) return
			const ids = props.entries.map((entry) => entry.id)
			const passed = new Set<string>()
			// A band from far above the page to the line where an anchor leaves a heading, as the platform
			// does: a heading enters it when it reaches that line, however fast the reader scrolls.
			const line = (Number.parseFloat(getComputedStyle(document.documentElement).scrollPaddingBlockStart) || 0) + 1
			const observer = new IntersectionObserver(
				(changes) => {
					for (const change of changes) {
						if (change.isIntersecting) passed.add(change.target.id)
						else passed.delete(change.target.id)
					}
					spied.value = [...ids].reverse().find((id) => passed.has(id)) ?? ids[0]
				},
				{ rootMargin: `100000% 0% ${line - viewportHeight.value}px 0%` },
			)
			// The headings of a new page render after the entries change.
			const frame = requestAnimationFrame(() => {
				for (const id of ids) {
					const heading = document.getElementById(id)
					if (heading) observer.observe(heading)
				}
			})
			stop = () => {
				cancelAnimationFrame(frame)
				observer.disconnect()
			}
		})
		return () => {
			window.removeEventListener('resize', measure)
			stop?.()
			stopEffect()
		}
	})
</script>

<template>
	<nav
		if:when="props.variant === 'aside' && props.entries.length"
		data-pagefind-ignore
		bind:class="navClass()"
		bind:aria-label="props.label ?? text.label"
	>
		<p bind:class="classes.title({ class: theme.ui.title })">{props.label ?? text.label}</p>
		<ul bind:class="classes.list({ class: theme.ui.list })">
			<li
				each:of="props.entries"
				each:as="entry"
				each:key="entry.id"
			>
				<a
					bind:href="'#' + entry.id"
					bind:aria-current="activeId() === entry.id ? 'location' : undefined"
					bind:class="linkClass(entry.level)"
				>
					{entry.text}
				</a>
			</li>
		</ul>
	</nav>
	<details
		ref:panel
		if:when="props.variant === 'collapsible' && props.entries.length"
		data-pagefind-ignore
		bind:class="classes.collapsible({ class: [theme.ui.collapsible, theme.class] })"
	>
		<summary bind:class="classes.summary({ class: theme.ui.summary })">
			{props.label ?? text.label}
			<Icon
				bind:class="classes.chevron({ class: theme.ui.chevron })"
				bind:path="icons.chevron"
			/>
		</summary>
		<nav
			bind:aria-label="props.label ?? text.label"
			bind:class="navClass()"
			on:click="closeOnChoice"
		>
			<ul bind:class="classes.list({ class: theme.ui.list })">
				<li
					each:of="props.entries"
					each:as="entry"
					each:key="entry.id"
				>
					<a
						bind:href="'#' + entry.id"
						bind:aria-current="activeId() === entry.id ? 'location' : undefined"
						bind:class="linkClass(entry.level)"
					>
						{entry.text}
					</a>
				</li>
			</ul>
		</nav>
	</details>
</template>
