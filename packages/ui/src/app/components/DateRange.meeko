<script lang="ts">
	// <UIDateRange>: two native date fields in a <fieldset>, with shortcuts and the validation of the range.
	// The models follow what the user types; `change` only carries a complete and valid range. While
	// rendering it never reads the clock: without `today`, the shortcuts wait disabled until mounted, so the
	// server and the hydration paint the same thing. The logic lives in ../utils/date-range.ts.
	import { computed, onMounted, useId } from '@meekojs/meeko'

	import type { UIDateRangeProps, UIDateRangeValue } from '../types/date-range'

	import { createDateRange } from '../utils/date-range'
	import { uiTheme } from '../utils/defaults'
	import { uiMessages } from '../utils/messages'
	import { dateRange } from '../variants/date-range'
	import { input, inputNumeric } from '../variants/input'

	const props = defineProps<UIDateRangeProps>()

	const theme = uiTheme('dateRange', () => props)

	const emit = defineEmits<{ change: [range: UIDateRangeValue] }>()

	const from = defineModel<string>('from', { default: '' })

	const to = defineModel<string>('to', { default: '' })

	const messages = uiMessages()
	const text = messages.dateRange

	const own = useId()
	const errorId = own + '-error'

	const range = createDateRange(props, { from, to }, messages, (value) => emit('change', value))

	// The local date waits behind the prop `today`, which wins whenever the parent passes it.
	onMounted(range.mount)

	// The name of the group: its legend, `ariaLabel`, or the label of <UIField> (`<id>-label`) with the default
	// text as a fallback, which a screen reader uses when that label does not exist.
	const labelledBy = computed(() => (props.label === undefined && props.ariaLabel === undefined && props.id !== undefined ? props.id + '-label' : undefined))
	const ariaLabel = computed(() => (props.label === undefined ? (props.ariaLabel ?? text.label) : undefined))
	const describedBy = (invalid: boolean): string | undefined => [props.describedBy, invalid && range.problem.value ? errorId : undefined].filter(Boolean).join(' ') || undefined

	const classes = dateRange()
	const inputClass = computed(() => input({ class: [inputNumeric, classes.input({ class: theme.ui.input })] }))
</script>

<template>
	<fieldset
		bind:id="props.id"
		bind:disabled="props.disabled"
		bind:aria-labelledby="labelledBy.value"
		bind:aria-label="ariaLabel.value"
		bind:class="classes.base({ class: [theme.ui.base, theme.class] })"
		on:input="range.edited"
	>
		<legend
			if:when="props.label !== undefined"
			bind:class="classes.legend({ class: theme.ui.legend })"
			>{props.label}</legend
		>
		<div
			if:when="range.presets.value.length"
			role="group"
			bind:aria-label="text.presets"
			bind:class="classes.presets({ class: theme.ui.presets })"
		>
			<button
				each:of="range.presets.value"
				each:as="preset"
				each:key="preset.key"
				type="button"
				bind:aria-pressed="preset.pressed ? 'true' : 'false'"
				bind:disabled="range.today.value === undefined"
				bind:class="classes.preset({ class: theme.ui.preset })"
				on:click="preset.apply"
				>{preset.label}</button
			>
		</div>
		<div bind:class="classes.fields({ class: theme.ui.fields })">
			<label bind:class="classes.field({ class: theme.ui.field })">
				<span bind:class="classes.fieldLabel({ class: theme.ui.fieldLabel })">{props.fromLabel ?? text.from}</span>
				<input
					type="date"
					model="from"
					bind:name="props.fromName"
					bind:form="props.form"
					bind:required="props.required"
					bind:min="props.min"
					bind:max="props.max"
					bind:aria-invalid="range.fromInvalid.value ? 'true' : undefined"
					bind:aria-describedby="describedBy(range.fromInvalid.value)"
					bind:class="inputClass.value"
				/>
			</label>
			<label bind:class="classes.field({ class: theme.ui.field })">
				<span bind:class="classes.fieldLabel({ class: theme.ui.fieldLabel })">{props.toLabel ?? text.to}</span>
				<input
					type="date"
					model="to"
					bind:name="props.toName"
					bind:form="props.form"
					bind:required="props.required"
					bind:min="props.min"
					bind:max="props.max"
					bind:aria-invalid="range.toInvalid.value ? 'true' : undefined"
					bind:aria-describedby="describedBy(range.toInvalid.value)"
					bind:class="inputClass.value"
				/>
			</label>
		</div>
		<p
			if:when="range.problem.value"
			role="alert"
			bind:id="errorId"
			bind:class="classes.error({ class: theme.ui.error })"
		>
			{range.message.value}
		</p>
	</fieldset>
</template>
