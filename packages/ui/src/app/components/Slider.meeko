<script lang="ts">
	import { computed } from '@meekojs/meeko'

	import type { UISliderProps } from '../types/forms'

	import { uiTheme } from '../utils/defaults'
	import { slider } from '../variants/slider'

	const { label, class: ownClass, style, ui: ownUi, ...rest } = defineProps<UISliderProps>()

	const theme = uiTheme('slider', () => ({ class: ownClass, ui: ownUi }))

	const value = defineModel<number>({ default: 50 })

	// The filled part of the track, which WebKit and Blink cannot draw without the position.
	const fill = computed(() => {
		const min = Number(rest.min ?? 0)
		const max = Number(rest.max ?? 100)
		return max > min ? Math.min(100, Math.max(0, ((value.value - min) / (max - min)) * 100)) : 0
	})

	const classes = slider()
</script>

<template>
	<label bind:class="classes.base({ class: [theme.ui.base, theme.class] })">
		<span>{label}</span>
		<input
			type="range"
			model="value"
			bind:class="classes.input({ class: theme.ui.input })"
			bind:style="[style, '--slider-fill: ' + fill.value + '%'].filter(Boolean).join('; ')"
			bind="rest"
		/>
	</label>
</template>
