<script lang="ts">
	import type { UIContainerGutter, UIContainerSize, UIContainerTag } from '../types/container'

	interface Props {
		as?: UIContainerTag
		size?: UIContainerSize
		gutter?: UIContainerGutter
		id?: string
		ariaLabel?: string
		class?: string
	}

	const props = defineProps<Props>({ as: 'div', size: 'xl', gutter: 'md' })

	const snippets = defineSnippets<{ default: [] }>()
</script>

<template>
	<component
		is="props.as"
		bind:id="props.id"
		bind:aria-label="props.ariaLabel"
		bind:class="['meeko-ui-container', props.class].filter(Boolean).join(' ')"
		bind:data-size="props.size"
		bind:data-gutter="props.gutter"
	>
		<render snippet="snippets.default" />
	</component>
</template>
