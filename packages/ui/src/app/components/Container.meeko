<script lang="ts">
	import type { UIContainerProps } from '../types/container'

	import { containerTheme } from '../theme/components/container'
	import { uiTheme } from '../utils/defaults'

	const props = defineProps<UIContainerProps>({ as: 'div', size: 'xl', gutter: 'md' })

	const theme = uiTheme('container', () => props)

	const snippets = defineSnippets<{ default: [] }>()
</script>

<template>
	<component
		is="props.as"
		bind:id="props.id"
		bind:aria-label="props.ariaLabel"
		bind:class="containerTheme({ size: props.size, gutter: props.gutter, class: theme.class })"
	>
		<render snippet="snippets.default" />
	</component>
</template>
