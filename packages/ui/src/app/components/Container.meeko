<script lang="ts">
	import type { UIContainerProps } from '../types/container'

	import { container } from '../variants/container'

	const props = defineProps<UIContainerProps>({ as: 'div', size: 'xl', gutter: 'md' })

	const snippets = defineSnippets<{ default: [] }>()
</script>

<template>
	<component
		is="props.as"
		bind:id="props.id"
		bind:aria-label="props.ariaLabel"
		bind:class="container({ size: props.size, gutter: props.gutter, class: props.class })"
	>
		<render snippet="snippets.default" />
	</component>
</template>
