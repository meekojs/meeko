<script lang="ts">
	import type { UISkeletonProps } from '../types/feedback'

	import { uiTheme } from '../utils/defaults'
	import { uiMessages } from '../utils/messages'
	import { skeleton, skeletonWidths } from '../variants/feedback'

	const props = defineProps<UISkeletonProps>()

	const theme = uiTheme('skeleton', () => props)

	const text = uiMessages().feedback
	const classes = skeleton()
</script>

<template>
	<div
		role="status"
		bind:aria-label="props.label ?? text.loading"
		bind:class="classes.base({ class: [theme.ui.base, theme.class] })"
	>
		<span
			each:of="Array.from({ length: Math.max(0, Math.min(100, Math.floor(props.lines ?? 3))) }, (_, index) => index)"
			each:as="line"
			each:key="line"
			aria-hidden="true"
			bind:class="classes.line({ class: [skeletonWidths[props.widths?.[line] ?? 'full'], theme.ui.line] })"
		/>
	</div>
</template>
