<script lang="ts">
	import type { UISkeletonProps } from '../types/feedback'

	import { uiMessages } from '../utils/messages'

	const props = defineProps<UISkeletonProps>()

	const text = uiMessages().feedback
</script>

<template>
	<div
		role="status"
		bind:aria-label="props.label ?? text.loading"
		bind:class="['meeko-ui-skeleton', props.class].filter(Boolean).join(' ')"
	>
		<span
			each:of="Array.from({ length: Math.max(0, Math.min(100, Math.floor(props.lines ?? 3))) }, (_, index) => index)"
			each:as="line"
			each:key="line"
			aria-hidden="true"
			bind:data-width="props.widths?.[line] ?? 'full'"
		/>
	</div>
</template>
