<script lang="ts">
	// <UILinkCard>: a linked surface, an <a> with `href` or a route with <MeekoLink> with `to`, as <UILink>.
	import { computed } from '@meekojs/meeko'

	import type { UILinkCardProps } from '../types/button'

	import { linkCard } from '../variants/card'

	const { to, params, search, resolve, href, target, rel, title, description, ui, class: className, ...rest } = defineProps<UILinkCardProps>()

	const emit = defineEmits<{ click: [event: MouseEvent] }>()

	const snippets = defineSnippets<{ default?: [] }>()

	const classes = linkCard()
	const linkRel = computed(() => rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined))
</script>

<template>
	<component
		is="to !== undefined ? 'MeekoLink' : 'a'"
		bind:to="to"
		bind:params="params"
		bind:search="search"
		bind:resolve="resolve"
		bind:href="href"
		bind:target="target"
		bind:rel="linkRel.value"
		bind:class="classes.base({ class: [ui?.base, className] })"
		bind="rest"
		on:click="(event) => emit('click', event)"
	>
		<strong bind:class="classes.title({ class: ui?.title })">{title}</strong>
		<span
			if:when="description"
			bind:class="classes.description({ class: ui?.description })"
		>
			{description}
		</span>
		<render snippet="snippets.default" />
	</component>
</template>
