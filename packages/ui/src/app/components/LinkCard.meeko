<script lang="ts">
	// <UILinkCard>: a linked surface, an <a> with `href` or a route with <MeekoLink> with `to`, as <UILink>.
	import { computed } from '@meekojs/meeko'

	import type { UILinkCardProps } from '../types/button'

	import { linkCardTheme } from '../theme/components/card'
	import { uiTheme } from '../utils/defaults'

	const { to, params, search, resolve, href, target, rel, title, description, variant, color, radius, elevation, ui: ownUi, class: ownClass, ...rest } = defineProps<UILinkCardProps>()

	const theme = uiTheme('linkCard', () => ({ class: ownClass, ui: ownUi }))

	const emit = defineEmits<{ click: [event: MouseEvent] }>()

	const snippets = defineSnippets<{ default?: [] }>()

	const classes = linkCardTheme()
	const variants = () => ({
		variant: variant ?? theme.defaults?.variant,
		color: color ?? theme.defaults?.color,
		radius: radius ?? theme.defaults?.radius,
		elevation: elevation ?? theme.defaults?.elevation,
	})
	const linkRel = computed(() => rel ?? (target === '_blank' ? 'noopener noreferrer' : undefined))
</script>

<template>
	<component
		is="to !== undefined ? 'MeekoLink' : 'a'"
		bind:to="to"
		bind:params="params"
		bind:search="search"
		bind:resolve="resolve"
		bind:href="href"
		bind:target="target"
		bind:rel="linkRel.value"
		bind:class="classes.base({ ...variants(), class: [theme.ui.base, theme.class] })"
		bind="rest"
		on:click="(event) => emit('click', event)"
	>
		<strong bind:class="classes.title({ ...variants(), class: theme.ui.title })">{title}</strong>
		<span
			if:when="description"
			bind:class="classes.description({ ...variants(), class: theme.ui.description })"
		>
			{description}
		</span>
		<render snippet="snippets.default" />
	</component>
</template>
