<script lang="ts">
	import type { UIPageHeaderProps } from '../types/navigation'

	import { pageHeaderTheme } from '../theme/components/page'
	import { uiTheme } from '../utils/defaults'

	const props = defineProps<UIPageHeaderProps>({ layout: 'docs' })

	const theme = uiTheme('pageHeader', () => props)

	const snippets = defineSnippets<{ default?: []; title?: []; breadcrumb?: []; actions?: [] }>()

	const classes = pageHeaderTheme()
</script>

<template>
	<header bind:class="classes.base({ layout: props.layout, class: [theme.ui.base, theme.class] })">
		<render
			if:when="snippets.breadcrumb"
			snippet="snippets.breadcrumb"
		/>
		<div bind:class="classes.row({ class: theme.ui.row })">
			<div bind:class="classes.text({ class: theme.ui.text })">
				<h1
					bind:id="props.headingId"
					bind:class="classes.title({ layout: props.layout, class: theme.ui.title })"
				>
					<render
						if:when="snippets.title"
						snippet="snippets.title"
					/>
					<span if:when="!snippets.title">{props.title}</span>
				</h1>
				<p
					if:when="props.description"
					bind:class="classes.description({ layout: props.layout, class: theme.ui.description })"
					>{props.description}</p
				>
			</div>
			<div
				if:when="snippets.actions"
				bind:class="classes.actions({ class: theme.ui.actions })"
			>
				<render snippet="snippets.actions" />
			</div>
		</div>
		<render
			if:when="snippets.default"
			snippet="snippets.default"
		/>
	</header>
</template>
