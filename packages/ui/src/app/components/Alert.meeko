<script lang="ts">
	import { computed, signal } from '@meekojs/meeko'

	import type { UIAlertProps } from '../types/feedback'

	import { icons } from '../utils/icons'
	import { uiMessages } from '../utils/messages'
	import { alert } from '../variants/feedback'
	import * as Icon from './internal/Icon.meeko'

	const { tone = 'neutral', title, description, icon, dismiss, closeLabel, role, class: className, ui, ...rest } = defineProps<UIAlertProps>()

	const emit = defineEmits<{ dismiss: [] }>()

	const snippets = defineSnippets<{ default?: []; icon?: []; actions?: [] }>()

	const visible = signal(true)
	const text = uiMessages().feedback
	const classes = computed(() => alert({ tone }))
</script>

<template>
	<section
		if:when="visible.value"
		bind:class="classes.value.base({ class: [ui?.base, className] })"
		bind:role="role ?? (tone === 'danger' ? 'alert' : 'note')"
		bind="rest"
	>
		<span
			if:when="icon || snippets.icon"
			aria-hidden="true"
			bind:class="classes.value.icon({ class: ui?.icon })"
		>
			<render
				if:when="snippets.icon"
				snippet="snippets.icon"
			/>
			<render
				if:when="!snippets.icon && icon"
				snippet="icon"
			/>
		</span>
		<div bind:class="classes.value.content({ class: ui?.content })">
			<p
				if:when="title"
				bind:class="classes.value.title({ class: ui?.title })"
			>
				{title}
			</p>
			<p
				if:when="description"
				bind:class="classes.value.description({ class: ui?.description })"
			>
				{description}
			</p>
			<render
				if:when="snippets.default"
				snippet="snippets.default"
			/>
			<div
				if:when="snippets.actions"
				bind:class="classes.value.actions({ class: ui?.actions })"
			>
				<render snippet="snippets.actions" />
			</div>
		</div>
		<button
			if:when="dismiss"
			type="button"
			bind:class="classes.value.dismiss({ class: ui?.dismiss })"
			bind:aria-label="closeLabel ?? text.close"
			on:click="
				() => {
					visible.value = false
					emit('dismiss')
				}
			"
		>
			<Icon bind:path="icons.close" />
		</button>
	</section>
</template>
