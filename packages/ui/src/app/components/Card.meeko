<script lang="ts">
	// <UICard>: a <section> with header, body and footer. Its look is the recipe of theme/components/card.
	import type { UICardProps } from '../types/card'

	import { cardTheme } from '../theme/components/card'
	import { uiTheme } from '../utils/defaults'

	const { title, headingId, description, variant, color, radius, elevation, density, padding, actionsWrap, ui: ownUi, class: ownClass, ...rest } = defineProps<UICardProps>()

	const theme = uiTheme('card', () => ({ class: ownClass, ui: ownUi }))

	const snippets = defineSnippets<{ header?: []; actions?: []; default: []; footer?: [] }>()

	const id = useId()
	const titleId = headingId ?? id + '-title'

	/** `density` gives the padding when `padding` does not: compact, normal and comfortable are sm, md and lg. */
	const densityPadding = { compact: 'sm', normal: 'md', comfortable: 'lg' } as const
	/** The props of the card win over `ui.defaults`, and `padding` over `density` at each level. */
	const paddingOf = () => padding ?? (density ? densityPadding[density] : (theme.defaults?.padding ?? densityPadding[theme.defaults?.density ?? 'normal']))

	const classes = cardTheme()
	const variants = () => ({
		variant: variant ?? theme.defaults?.variant,
		color: color ?? theme.defaults?.color,
		radius: radius ?? theme.defaults?.radius,
		elevation: elevation ?? theme.defaults?.elevation,
		padding: paddingOf(),
		actions: Boolean(snippets.actions),
		actionsWrap: actionsWrap ?? theme.defaults?.actionsWrap,
	})
</script>

<template>
	<section
		bind:class="classes.base({ ...variants(), class: [theme.ui.base, theme.class] })"
		bind:aria-labelledby="title && !snippets.header ? titleId : rest['aria-labelledby']"
		bind="rest"
	>
		<header
			if:when="snippets.header || snippets.actions || title || description"
			bind:class="classes.header({ ...variants(), class: theme.ui.header })"
		>
			<render
				if:when="snippets.header"
				snippet="snippets.header"
			/>
			<h2
				if:when="!snippets.header && title"
				bind:id="titleId"
				bind:tabindex="headingId ? -1 : undefined"
				bind:class="classes.title({ ...variants(), class: theme.ui.title })"
			>
				{title}
			</h2>
			<p
				if:when="!snippets.header && description"
				bind:class="classes.description({ ...variants(), class: theme.ui.description })"
			>
				{description}
			</p>
			<div
				if:when="snippets.actions"
				bind:class="classes.actions({ ...variants(), class: theme.ui.actions })"
			>
				<render snippet="snippets.actions" />
			</div>
		</header>
		<div bind:class="classes.body({ ...variants(), class: theme.ui.body })"><render snippet="snippets.default" /></div>
		<footer
			if:when="snippets.footer"
			bind:class="classes.footer({ ...variants(), class: theme.ui.footer })"
		>
			<render snippet="snippets.footer" />
		</footer>
	</section>
</template>
