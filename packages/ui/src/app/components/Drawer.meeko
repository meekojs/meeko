<script lang="ts">
	// <UIDrawer>: a native modal <dialog>. `command` and `commandfor` open and close it without JavaScript
	// where the browser has them. Once hydrated it closes as <UIModal> does, with a View Transition, so its
	// handlers take over from the native close. The platform traps the focus and gives the focus back.
	import type { UIDrawerProps } from '../types/navigation'

	import { icons } from '../utils/icons'
	import { uiMessages } from '../utils/messages'
	import { mountModalDialog } from '../utils/modal-dialog'
	import { followsLink } from '../utils/navigation'
	import * as Icon from './internal/Icon.meeko'

	const props = defineProps<UIDrawerProps>({ side: 'start', closedBy: 'any', closeOnNavigate: true })

	const emit = defineEmits<{ close: [] }>()

	const open = defineModel<boolean>({ default: false })

	const snippets = defineSnippets<{ default: []; footer?: []; trigger?: [id: string] }>()

	const generated = useId()
	const text = uiMessages().drawer
	const dialog = useElementRef('dialog')

	const dialogId = (): string => props.id ?? generated

	/** Through the model, which plays the exit; a `snippets.trigger` may have opened it without the model. */
	function close(): void {
		if (open.value) open.value = false
		else dialog.value?.close()
	}

	function onCloseClick(event: MouseEvent): void {
		// The native `command="close"` would close it at once, without its exit.
		event.preventDefault()
		close()
	}

	let controller: ReturnType<typeof mountModalDialog> | undefined

	function onDialogClick(event: MouseEvent): void {
		if (!props.closeOnNavigate || !followsLink(event)) return
		// At once: the navigation is the transition, and the scroll lock of the page has to leave before it
		// starts, because changing the overflow of the root inside a View Transition crashes WebKit 27.2.
		controller?.closeNow()
		open.value = false
	}

	function onClose(): void {
		open.value = false
		emit('close')
	}

	onMounted(() => {
		if (!dialog.value) return
		// `closedby` closes it natively; the controller keeps its exit, and does it where the browser has no `closedby`.
		const options = {
			get closeOnEscape() {
				return props.closedBy !== 'none'
			},
			get closeOnBackdrop() {
				return props.closedBy === 'any'
			},
		}
		controller = mountModalDialog(dialog.value, open, options, () => (open.value = false))
		return controller.dispose
	})
</script>

<template>
	<render
		if:when="snippets.trigger"
		snippet="snippets.trigger"
		args="dialogId()"
	/>
	<button
		if:when="!snippets.trigger && props.triggerLabel"
		type="button"
		command="show-modal"
		class="meeko-ui-button meeko-ui-drawer-trigger"
		data-variant="outline"
		data-size="sm"
		aria-haspopup="dialog"
		bind:commandfor="dialogId()"
		on:click="() => (open.value = true)"
	>
		<Icon bind:path="icons.menu" />
		{props.triggerLabel}
	</button>
	<dialog
		ref:dialog
		bind:id="dialogId()"
		bind:class="['meeko-ui-drawer', props.class].filter(Boolean).join(' ')"
		bind:data-side="props.side"
		bind:closedby="props.closedBy"
		bind:aria-labelledby="dialogId() + '-title'"
		on:click="onDialogClick"
		on:close="onClose"
	>
		<div class="meeko-ui-drawer-panel">
			<div class="meeko-ui-drawer-heading">
				<h2 bind:id="dialogId() + '-title'">{props.title}</h2>
				<button
					type="button"
					command="close"
					class="meeko-ui-drawer-close"
					bind:commandfor="dialogId()"
					bind:aria-label="props.closeLabel ?? text.close"
					on:click="onCloseClick"
				>
					<Icon bind:path="icons.close" />
				</button>
			</div>
			<div class="meeko-ui-drawer-body"><render snippet="snippets.default" /></div>
			<footer
				if:when="snippets.footer"
				class="meeko-ui-drawer-footer"
			>
				<render snippet="snippets.footer" />
			</footer>
		</div>
	</dialog>
</template>
