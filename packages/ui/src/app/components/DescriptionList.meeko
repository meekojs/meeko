<script lang="ts">
	import type { UIDescriptionListProps } from '../types/data'

	import { descriptionListTheme } from '../theme/components/description-list'
	import { uiTheme } from '../utils/defaults'

	const props = defineProps<UIDescriptionListProps>()

	const theme = uiTheme('descriptionList', () => props)

	const classes = descriptionListTheme()
</script>

<template>
	<dl bind:class="classes.base({ columns: props.columns ?? 1, class: [theme.ui.base, theme.class] })">
		<div
			each:of="props.items"
			each:as="item"
			each:key="item.label"
			bind:class="classes.item({ class: theme.ui.item })"
		>
			<dt
				bind:lang="item.labelLang"
				bind:class="classes.label({ class: theme.ui.label })"
				>{item.label}</dt
			>
			<dd
				if:when="item.code"
				bind:class="classes.value({ class: theme.ui.value })"
			>
				<code
					bind:title="item.title"
					bind:class="classes.code({ class: theme.ui.code })"
					>{item.value}</code
				>
			</dd>
			<template if:when="!item.code">
				<dd bind:class="classes.value({ class: theme.ui.value })">{item.value}</dd>
			</template>
			<dd
				if:when="item.detail"
				bind:class="classes.detail({ class: theme.ui.detail })"
			>
				{item.detail}
			</dd>
		</div>
	</dl>
</template>
