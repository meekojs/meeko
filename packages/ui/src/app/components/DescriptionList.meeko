<script lang="ts">
	import type { UIDescriptionListProps } from '../types/data'

	import { descriptionList } from '../variants/data'

	const props = defineProps<UIDescriptionListProps>()

	const classes = descriptionList()
</script>

<template>
	<dl bind:class="classes.base({ columns: props.columns ?? 1, class: [props.ui?.base, props.class] })">
		<div
			each:of="props.items"
			each:as="item"
			each:key="item.label"
			bind:class="classes.item({ class: props.ui?.item })"
		>
			<dt
				bind:lang="item.labelLang"
				bind:class="classes.label({ class: props.ui?.label })"
				>{item.label}</dt
			>
			<dd
				if:when="item.code"
				bind:class="classes.value({ class: props.ui?.value })"
			>
				<code
					bind:title="item.title"
					bind:class="classes.code({ class: props.ui?.code })"
					>{item.value}</code
				>
			</dd>
			<template if:when="!item.code">
				<dd bind:class="classes.value({ class: props.ui?.value })">{item.value}</dd>
			</template>
			<dd
				if:when="item.detail"
				bind:class="classes.detail({ class: props.ui?.detail })"
			>
				{item.detail}
			</dd>
		</div>
	</dl>
</template>
