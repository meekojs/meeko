<script lang="ts">
	// <UILocaleSuggestion>: it floats, so its arrival moves nothing. It is written in the language it
	// offers; the button to stay, in the current one. What each choice stores belongs to the application.
	import { computed } from '@meekojs/meeko'

	import type { UILinkTarget, UILocaleSuggestionProps } from '../types/navigation'

	import { icons } from '../utils/icons'
	import { fillMessage, uiMessages, uiMessagesFor } from '../utils/messages'
	import { linkTarget } from '../utils/navigation'
	import * as Icon from './internal/Icon.meeko'
	import * as ItemLink from './internal/ItemLink.meeko'

	const props = defineProps<UILocaleSuggestionProps>()

	const emit = defineEmits<{ stay: [] }>()

	const messages = uiMessages()
	const textsOf = uiMessagesFor()

	const offered = computed(() => props.items.find((item) => !item.current && (props.suggested === undefined || item.code === props.suggested)))
	const current = computed(() => props.items.find((item) => item.current))
	const texts = computed(() => (offered.value ? textsOf(offered.value.code) : undefined))
	const language = computed(() => ({ language: offered.value?.label ?? '' }))
	// A locale without texts of its own shows a fallback, which is not in its language; the props are.
	const speaksOffered = computed(() => texts.value?.translated === true || (props.message !== undefined && props.goLabel !== undefined))
	const target = computed<UILinkTarget | undefined>(() => (offered.value ? { ...linkTarget(offered.value), hreflang: offered.value.hreflang ?? offered.value.code } : undefined))
</script>

<template>
	<aside
		if:when="offered.value"
		data-pagefind-ignore
		bind:class="['meeko-ui-locale-suggestion', props.class].filter(Boolean).join(' ')"
		bind:lang="speaksOffered.value ? offered.value?.code : undefined"
		bind:aria-label="props.label ?? texts.value?.messages.language.suggestion"
	>
		<Icon bind:path="icons.globe" />
		<p role="status">{props.message ?? fillMessage(texts.value?.messages.language.message ?? '', language.value)}</p>
		<div class="meeko-ui-locale-suggestion-actions">
			<ItemLink
				class="meeko-ui-button"
				data-variant="primary"
				data-size="sm"
				bind:link="target.value!"
			>
				{props.goLabel ?? fillMessage(texts.value?.messages.language.go ?? '', language.value)}
			</ItemLink>
			<button
				type="button"
				class="meeko-ui-button"
				data-variant="outline"
				data-size="sm"
				bind:lang="speaksOffered.value ? messages.locale : undefined"
				on:click="() => emit('stay')"
			>
				{props.stayLabel ?? fillMessage(messages.language.stay, { language: current.value?.label ?? '' })}
			</button>
		</div>
	</aside>
</template>
