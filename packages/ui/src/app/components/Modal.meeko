<script lang="ts">
	import { computed } from '@meekojs/meeko'

	import type { ModalDismissReason, UIModalProps } from '../types/modal'

	import { modalExitRegistration, optionalModalInstance } from '../composables/useModal'
	import { modalHeadingAlone, modalTheme } from '../theme/components/modal'
	import { uiTheme } from '../utils/defaults'
	import { uiMessages } from '../utils/messages'
	import { mountModalDialog } from '../utils/modal-dialog'

	const props = defineProps<UIModalProps>()

	const theme = uiTheme('modal', () => props)

	const emit = defineEmits<{ dismiss: [reason: ModalDismissReason] }>()

	const open = defineModel<boolean>({ default: false })

	const snippets = defineSnippets<{ default?: []; footer?: [] }>()

	const dialog = useElementRef('dialog')

	const id = useId()
	const text = uiMessages().modal
	const instance = optionalModalInstance()
	const registerExit = modalExitRegistration()
	const classes = computed(() => modalTheme({ size: props.size }))
	if (instance) open.value = true

	function dismiss(reason: ModalDismissReason) {
		open.value = false
		try {
			emit('dismiss', reason)
		} finally {
			instance?.dismiss()
		}
	}

	onMounted(() => {
		if (!dialog.value) return
		const controller = mountModalDialog(dialog.value, open, props, dismiss)
		const unregister = registerExit?.(controller.close)
		return () => {
			unregister?.()
			controller.dispose()
		}
	})
</script>

<template>
	<dialog
		ref:dialog
		bind:class="classes.value.base({ class: [theme.ui.base, theme.class] })"
		bind:closedby="props.closeOnEscape === false ? 'none' : props.closeOnBackdrop === false ? 'closerequest' : 'any'"
		bind:aria-labelledby="id + '-title'"
		bind:aria-describedby="props.description ? id + '-description' : undefined"
	>
		<div bind:class="classes.value.heading({ class: [snippets.default ? undefined : modalHeadingAlone, theme.ui.heading] })">
			<div>
				<h2
					bind:id="id + '-title'"
					bind:class="classes.value.title({ class: theme.ui.title })"
					>{props.title}</h2
				>
				<p
					if:when="props.description"
					bind:class="classes.value.description({ class: theme.ui.description })"
					bind:id="id + '-description'"
				>
					{props.description}
				</p>
			</div>
			<button
				if:when="props.closeButton !== false"
				type="button"
				bind:class="classes.value.close({ class: theme.ui.close })"
				bind:aria-label="props.closeLabel ?? text.close"
				on:click="() => dismiss('button')"
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.75"
					aria-hidden="true"
				>
					<path d="M6 6l12 12M6 18L18 6" />
				</svg>
			</button>
		</div>
		<div
			if:when="snippets.default"
			bind:class="classes.value.body({ class: theme.ui.body })"
		>
			<render snippet="snippets.default" />
		</div>
		<footer
			if:when="snippets.footer"
			bind:class="classes.value.footer({ class: theme.ui.footer })"
		>
			<render snippet="snippets.footer" />
		</footer>
	</dialog>
</template>
