<script lang="ts">
	import { onMounted } from '@meekojs/meeko'

	import { useModalHost } from '../composables/useModal'
	import { useToastHost } from '../composables/useToast'
	import * as ModalInstance from './internal/ModalInstance.meeko'
	import * as Toast from './Toast.meeko'

	const snippets = defineSnippets<{ default: [] }>()

	const modals = useModalHost()
	const toasts = useToastHost()
	const toastHost = useElementRef('toastHost')

	onMounted(() => toastHost.value?.showPopover?.())
</script>

<template>
	<render snippet="snippets.default" />

	<ModalInstance
		each:of="[...modals.instances.value.values()]"
		each:as="instance"
		each:key="instance.id"
		bind:instance="instance"
	/>
	<div
		ref:toastHost
		popover="manual"
		class="meeko-ui-toast-host"
	>
		<Toast
			each:of="toasts.entries.value"
			each:as="entry"
			each:key="entry.id"
			bind:hosted="true"
			bind:text="entry.text"
			bind:actions="entry.actions"
			bind:tone="entry.tone"
			bind:duration="entry.duration"
			bind:closeLabel="entry.closeLabel"
			on:dismiss="() => toasts.remove(entry.id)"
		/>
	</div>
</template>
