			{ "names": ["type"], "elements": ["feColorMatrix"], "values": ["matrix", "saturate", "hueRotate", "luminanceToAlpha"] },
			{ "names": ["operator"], "elements": ["feComposite"], "values": ["over", "in", "out", "atop", "xor", "lighter", "arithmetic"] },
			{ "names": ["operator"], "elements": ["feMorphology"], "values": ["erode", "dilate"] },
			{ "names": ["type"], "elements": ["feTurbulence"], "values": ["fractalNoise", "turbulence"] },
			{ "names": ["stitchTiles"], "values": ["stitch", "noStitch"] },
			{ "names": ["edgeMode"], "values": ["duplicate", "wrap", "mirror", "none"] },
			{ "names": ["preserveAlpha"], "values": ["true", "false"] },
			{ "names": ["type"], "elements": ["feFuncA", "feFuncB", "feFuncG", "feFuncR"], "values": ["identity", "table", "discrete", "linear", "gamma"] },
			{ "names": ["xChannelSelector", "yChannelSelector"], "values": ["R", "G", "B", "A"] },
			{ "names": ["in", "in2"], "values": ["SourceGraphic", "SourceAlpha", "BackgroundImage", "BackgroundAlpha", "FillPaint", "StrokePaint"], "freeform": true },
			{ "names": ["calcMode"], "values": ["discrete", "linear", "paced", "spline"] },
			{ "names": ["additive"], "values": ["replace", "sum"] },
			{ "names": ["accumulate"], "values": ["none", "sum"] },
			{ "names": ["restart"], "values": ["always", "whenNotActive", "never"] },
			{ "names": ["fill"], "elements": ["animate", "animateMotion", "animateTransform", "set"], "values": ["freeze", "remove"] },
			{ "names": ["type"], "elements": ["animateTransform"], "values": ["translate", "scale", "rotate", "skewX", "skewY"] },
			{ "names": ["crossorigin"], "values": ["anonymous", "use-credentials", ""] },
			{ "names": ["decoding"], "values": ["sync", "async", "auto"] },
			{ "names": ["fetchpriority"], "values": ["auto", "high", "low"] },
			{ "names": ["referrerpolicy"], "values": ["", "no-referrer", "no-referrer-when-downgrade", "same-origin", "origin", "strict-origin", "origin-when-cross-origin", "strict-origin-when-cross-origin", "unsafe-url"] },
			{ "names": ["target"], "values": ["_self", "_parent", "_top", "_blank"], "freeform": true },
			{ "names": ["xml:space"], "values": ["default", "preserve"] },
			{ "names": ["orient"], "values": ["auto", "auto-start-reverse"], "freeform": true },
			{ "names": ["preserveAspectRatio"], "values": ["none", "xMinYMin", "xMidYMin", "xMaxYMin", "xMinYMid", "xMidYMid", "xMaxYMid", "xMinYMax", "xMidYMax", "xMaxYMax", "xMidYMid meet", "xMidYMid slice"], "freeform": true },
			{ "names": ["fill-rule", "clip-rule"], "values": ["nonzero", "evenodd"], "presentation": true },
			{ "names": ["stroke-linecap"], "values": ["butt", "round", "square"], "presentation": true },
			{ "names": ["stroke-linejoin"], "values": ["miter", "miter-clip", "round", "bevel", "arcs"], "presentation": true },
			{ "names": ["text-anchor"], "values": ["start", "middle", "end"], "presentation": true },
			{ "names": ["shape-rendering"], "values": ["auto", "optimizeSpeed", "crispEdges", "geometricPrecision"], "presentation": true },
			{ "names": ["text-rendering"], "values": ["auto", "optimizeSpeed", "optimizeLegibility", "geometricPrecision"], "presentation": true },
			{ "names": ["image-rendering"], "values": ["auto", "optimizeQuality", "optimizeSpeed", "smooth", "high-quality", "crisp-edges", "pixelated"], "presentation": true },
			{ "names": ["pointer-events"], "values": ["auto", "bounding-box", "visiblePainted", "visibleFill", "visibleStroke", "visible", "painted", "fill", "stroke", "all", "none"], "presentation": true },
			{ "names": ["visibility"], "values": ["visible", "hidden", "collapse"], "presentation": true },
			{ "names": ["vector-effect"], "values": ["none", "non-scaling-stroke", "non-scaling-size", "non-rotation", "fixed-position"], "presentation": true },
			{ "names": ["dominant-baseline"], "values": ["auto", "text-bottom", "alphabetic", "ideographic", "middle", "central", "mathematical", "hanging", "text-top"], "presentation": true },
			{ "names": ["alignment-baseline"], "values": ["baseline", "text-bottom", "alphabetic", "ideographic", "middle", "central", "mathematical", "text-top"], "presentation": true },
			{ "names": ["color-interpolation", "color-interpolation-filters"], "values": ["auto", "sRGB", "linearRGB"], "presentation": true },
			{ "names": ["paint-order"], "values": ["normal", "fill", "stroke", "markers"], "presentation": true },
			{ "names": ["overflow"], "values": ["visible", "hidden", "clip", "scroll", "auto"], "presentation": true },
			{ "names": ["direction"], "values": ["ltr", "rtl"], "presentation": true },
			{ "names": ["writing-mode"], "values": ["horizontal-tb", "vertical-rl", "vertical-lr"], "presentation": true },
			{ "names": ["font-style"], "values": ["normal", "italic", "oblique"], "presentation": true },
			{ "names": ["font-weight"], "values": ["normal", "bold", "bolder", "lighter"], "presentation": true },
			{ "names": ["fill", "stroke"], "values": ["none", "currentColor", "context-fill", "context-stroke"], "presentation": true },
			{ "names": ["display"], "values": ["inline", "block", "none"], "presentation": true }
		]
	}
