{
	"source": "Written by hand from the specifications each entry links to: what the indices of the HTML standard and @mdn/browser-compat-data do not say about the value of an attribute.",
	"html": [
		{ "name": "interestfor", "elements": ["a", "area", "button"], "description": "Targets the element that is shown interest in while the user hovers, focuses or long-presses this one", "value": "ID*", "spec": "https://open-ui.org/components/interest-invokers.explainer/" },
		{ "name": "part", "elements": ["*"], "description": "Names of the element as a shadow part, for ::part()", "value": "Unordered set of unique space-separated tokens", "spec": "https://drafts.csswg.org/css-shadow-parts/#part-attr" },
		{ "name": "exportparts", "elements": ["*"], "description": "Shadow parts of the element's shadow tree that are exposed outside", "value": "Comma-separated list of part mappings", "spec": "https://drafts.csswg.org/css-shadow-parts/#exportparts-attr" },
		{ "name": "virtualkeyboardpolicy", "elements": ["*"], "description": "Whether the virtual keyboard shows by itself on an editable element", "value": "\"auto\"; \"manual\"; the empty string", "values": ["auto", "manual", ""], "spec": "https://w3c.github.io/virtual-keyboard/#dom-elementcontenteditable-virtualkeyboardpolicy" },
		{ "name": "elementtiming", "elements": ["*"], "description": "Identifier of the element for the Element Timing API", "value": "Text", "spec": "https://w3c.github.io/element-timing/#sec-elements-exposed" },
		{ "name": "capture", "elements": ["input"], "description": "Which camera or microphone captures a new file", "value": "\"user\"; \"environment\"", "values": ["user", "environment"], "spec": "https://w3c.github.io/html-media-capture/#the-capture-attribute" },
		{ "name": "webkitdirectory", "elements": ["input"], "description": "Whether the user selects directories instead of files", "value": "Boolean attribute", "boolean": true, "spec": "https://wicg.github.io/entries-api/#dom-htmlinputelement-webkitdirectory" },
		{ "name": "controlslist", "elements": ["audio", "video"], "description": "Controls that the user agent leaves out of its own", "value": "Unordered set of unique space-separated tokens", "values": ["nodownload", "nofullscreen", "noremoteplayback"], "tokens": true, "spec": "https://wicg.github.io/controls-list/explainer.html" },
		{ "name": "disablepictureinpicture", "elements": ["video"], "description": "Whether picture-in-picture is disabled", "value": "Boolean attribute", "boolean": true, "spec": "https://w3c.github.io/picture-in-picture/#disable-pip" },
		{ "name": "disableremoteplayback", "elements": ["audio", "video"], "description": "Whether remote playback is disabled", "value": "Boolean attribute", "boolean": true, "spec": "https://w3c.github.io/remote-playback/#the-disableremoteplayback-attribute" },
		{ "name": "credentialless", "elements": ["iframe"], "description": "Whether the document loads in a new, ephemeral context without credentials", "value": "Boolean attribute", "boolean": true, "spec": "https://wicg.github.io/anonymous-iframe/#dom-htmliframeelement-credentialless" },
		{ "name": "csp", "elements": ["iframe"], "description": "Content Security Policy that the embedded document must enforce", "value": "Serialized content security policy", "spec": "https://w3c.github.io/webappsec-cspee/#element-attrdef-iframe-csp" },
		{ "name": "rel", "elements": ["form"], "description": "Relationship between the document and the destination of the form", "value": "Unordered set of unique space-separated tokens*", "values": ["external", "help", "license", "next", "nofollow", "noopener", "noreferrer", "opener", "prev", "search"], "freeform": true, "tokens": true, "spec": "https://html.spec.whatwg.org/#attr-form-rel" }
	],
	"svg": {
		"sources": ["https://svgwg.org/svg2-draft/", "https://drafts.fxtf.org/filter-effects/", "https://svgwg.org/specs/animations/", "https://drafts.fxtf.org/css-masking/"],
		"globalAttributes": [
			{ "name": "role", "description": "ARIA role of the element, and fallback roles after it", "value": "Unordered set of unique space-separated tokens", "roles": true, "spec": "https://w3c.github.io/svg-aam/#mapping_role_table" },
			{ "name": "xmlns", "description": "XML namespace of the element", "value": "Text", "spec": "https://svgwg.org/svg2-draft/struct.html#Namespace" },
			{ "name": "xmlns:xlink", "description": "XML namespace of XLink", "value": "Text", "deprecated": true, "spec": "https://svgwg.org/svg2-draft/linking.html#XLinkRefAttrs" },
			{ "name": "nonce", "description": "Cryptographic nonce used in Content Security Policy checks", "value": "Text", "spec": "https://html.spec.whatwg.org/#attr-nonce" }
		],
		"values": [
			{ "names": ["interestfor"], "value": "ID*" },
			{ "names": ["href", "xlink:href"], "value": "URL" },
			{ "names": ["gradientUnits", "patternUnits", "patternContentUnits", "clipPathUnits", "maskUnits", "maskContentUnits", "filterUnits", "primitiveUnits"], "values": ["userSpaceOnUse", "objectBoundingBox"] },
			{ "names": ["markerUnits"], "values": ["strokeWidth", "userSpaceOnUse"] },
			{ "names": ["spreadMethod"], "values": ["pad", "reflect", "repeat"] },
			{ "names": ["lengthAdjust"], "values": ["spacing", "spacingAndGlyphs"] },
