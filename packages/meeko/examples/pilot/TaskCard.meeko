<script lang="ts">
import { signal } from "@meekojs/meeko";

import type { Task } from "./model.js";

/** Datos de una tarjeta, sin estado global compartido con otras instancias. */
const props = defineProps<{ task: Task }>();

const expanded = signal(false);
</script>

<template>
  <article class="task-card" bind:data-task-id="props.task.id">
    <button class="task-details" type="button" bind:aria-expanded="expanded.value" on:click="() => expanded.value = !expanded.value">
      <strong>{props.task.title}</strong>
      <span if:when="expanded.value">Ocultar detalle</span>
      <span if:when="!expanded.value">Ver detalle</span>
    </button>
    <p if:when="expanded.value" class="task-detail">{props.task.detail}</p>
  </article>
</template>
