<script lang="ts" generic="T, Multiple extends boolean = false">
// <MeekoSelect>, Meeko's own tag since 1.5, built on <MeekoPopover>. `pnpm run builtins` compiles this
// file into select.compiled.ts, which the package ships as @meekojs/meeko/builtins/select and which
// only the components that use the tag import; edit this file, not that one.
import { useId } from "../ids.js";
import { onMounted } from "../lifecycle.js";
import { createSelect } from "./select.js";
import type { MeekoSelectProps, SelectModel, SelectSettings, SelectSnippets } from "./select.js";

const props = defineProps<MeekoSelectProps<T, Multiple>>();
const snippets = defineSnippets<SelectSnippets<T>>();
const emit = defineEmits<{ change: [value: SelectModel<T, Multiple>] }>();
const model = defineModel<SelectModel<T, Multiple>>({ default: null as unknown as SelectModel<T, Multiple> });
const root = useElementRef("root");
// The IDs of the trigger, the list and each option come from useId: the same in SSR and hydration.
const select = createSelect<T>(props as SelectSettings<T>, model, useId(), (value) => emit("change", value as SelectModel<T, Multiple>));
onMounted(() => select.mount(root.value));
</script>

<!-- No whitespace between the tags: it would be text inside the trigger and the options. -->
<template><div ref:root data-meeko-select bind:class="props.class" bind:data-open="select.open.value ? '' : undefined" bind:data-disabled="props.disabled ? '' : undefined" bind:data-multiple="select.multiple.value ? '' : undefined" bind:data-loading="select.loading.value ? '' : undefined"><MeekoPopover mode="manual" matchWidth bind:placement="props.placement ?? 'bottom-start'" bind:offset="props.offset ?? 0" bind:triggerId="select.triggerId.value" bind:class="props.listClass" model="select.open"><snippet name="anchor" params="trigger"><button if:when="!props.searchable" type="button" role="combobox" data-meeko-select-trigger bind:id="trigger.id" aria-haspopup="listbox" bind:aria-controls="select.listboxId" bind:aria-expanded="select.open.value ? 'true' : 'false'" bind:aria-activedescendant="select.activeId.value" bind:aria-label="props.label" bind:aria-describedby="select.describedBy.value" bind:aria-invalid="select.invalid.value" bind:aria-required="props.required ? 'true' : undefined" bind:disabled="props.disabled" on:click="select.triggerClick" on:keydown="select.keydown" on:keyup="select.keyup"><span if:when="snippets.value && select.selected.value.length" data-meeko-select-values><span each:of="select.selectedEntries.value" each:as="entry" each:key="entry.key" data-meeko-select-value><render snippet="snippets.value" args="entry.option" /></span></span><span if:when="!snippets.value && select.selected.value.length" data-meeko-select-value>{select.valueText.value}</span><span if:when="!select.selected.value.length" data-meeko-select-placeholder>{props.placeholder ?? ""}</span></button><span if:when="props.searchable && select.multiple.value && select.selected.value.length" data-meeko-select-values><span each:of="select.selectedEntries.value" each:as="entry" each:key="entry.key" data-meeko-select-value><render if:when="snippets.value" snippet="snippets.value" args="entry.option" /><template if:when="!snippets.value">{entry.label}</template></span></span><input if:when="props.searchable" type="text" role="combobox" autocomplete="off" aria-autocomplete="list" aria-haspopup="listbox" data-meeko-select-trigger bind:id="trigger.id" bind:aria-controls="select.listboxId" bind:aria-expanded="select.open.value ? 'true' : 'false'" bind:aria-activedescendant="select.activeId.value" bind:aria-label="props.label" bind:aria-describedby="select.describedBy.value" bind:aria-invalid="select.invalid.value" bind:aria-required="props.required ? 'true' : undefined" bind:disabled="props.disabled" bind:placeholder="props.placeholder" bind:value="select.inputText.value" on:input="select.input" on:click="select.inputClick" on:keydown="select.keydown"></snippet><div role="listbox" data-meeko-select-list bind:id="select.listboxId" bind:aria-multiselectable="select.multiple.value ? 'true' : undefined" bind:aria-label="props.label" bind:aria-labelledby="props.label === undefined ? select.triggerId.value : undefined" bind:aria-busy="select.loading.value ? 'true' : undefined" on:mousedown="select.keepFocus" on:click="select.optionClick" on:pointermove="select.optionHover"><div each:of="select.groups.value" each:as="group" each:key="group.key" bind:role="group.name === undefined ? 'presentation' : 'group'" bind:aria-labelledby="group.id" data-meeko-select-group><div if:when="group.name !== undefined" role="presentation" bind:id="group.id" data-meeko-select-group-label><render if:when="snippets.group" snippet="snippets.group" args="group.name ?? ''" /><template if:when="!snippets.group">{group.name}</template></div><div each:of="group.entries" each:as="entry" each:key="entry.key" role="option" bind:id="entry.id" bind:data-index="entry.index" bind:aria-selected="select.isSelected(entry) ? 'true' : 'false'" bind:aria-disabled="select.isBlocked(entry) ? 'true' : undefined" bind:data-active="select.active.value === entry.index ? '' : undefined" bind:data-selected="select.isSelected(entry) ? '' : undefined" bind:data-disabled="select.isBlocked(entry) ? '' : undefined"><render if:when="snippets.option" snippet="snippets.option" args="entry.option, select.stateOf(entry)" /><template if:when="!snippets.option">{entry.label}</template></div></div><div if:when="select.loading.value" role="presentation" data-meeko-select-loading><render snippet="snippets.loading" /></div><div if:when="!select.loading.value && !select.entries.value.length" role="presentation" data-meeko-select-empty><render if:when="snippets.empty" snippet="snippets.empty" /><template if:when="!snippets.empty">{"Sin resultados"}</template></div></div></MeekoPopover><input each:of="select.hiddenValues.value" each:as="value" type="hidden" bind:name="select.name.value" bind:value="value" bind:disabled="props.disabled"><input if:when="props.required" type="text" hidden required tabindex="-1" aria-hidden="true" data-meeko-select-validity bind:value="select.selected.value.length ? 'selected' : ''" bind:disabled="props.disabled" on:invalid="select.reportInvalid"></div></template>
