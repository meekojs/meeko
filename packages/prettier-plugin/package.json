{
  "name": "@meekojs/prettier-plugin",
  "version": "0.1.0",
  "homepage": "https://meekojs.com/docs/tooling",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist/"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.mjs",
    "prepack": "pnpm run build"
  },
  "peerDependencies": {
    "@meekojs/meeko": ">=1.7 <2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "dependencies": {
    "@typescript/typescript6": "6.0.2",
    "postcss": "^8.5.31",
    "postcss-selector-parser": "^7.1.7"
  },
  "devDependencies": {
    "@meekojs/meeko": "workspace:*",
    "@types/node": "^24.0.0",
    "typescript": "7.0.2",
    "prettier": "3.9.10",
    "vite": "8.3.5"
  }
}
