{
	"name": "@meekojs/prettier-plugin",
	"version": "1.12.0",
	"description": "Prettier formatting for Meeko components.",
	"keywords": [
		"meeko",
		"typescript",
		"prettier-plugin"
	],
	"homepage": "https://meekojs.com/docs/tooling",
	"bugs": {
		"url": "https://github.com/meekojs/meeko/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/meekojs/meeko.git",
		"directory": "packages/prettier-plugin"
	},
	"license": "MIT",
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"types": "./dist/index.d.ts",
	"files": [
		"dist/",
		"README.md",
		"LICENSE",
		"CHANGELOG.md"
	],
	"scripts": {
		"build": "pnpm run formatter:generate && tsdown -c ../../tsdown.config.ts",
		"check": "pnpm run formatter:generate && tsc -p tsconfig.json --noEmit",
		"formatter:generate": "node scripts/generate-formatter.mjs",
		"lint": "eslint .",
		"prepack": "pnpm run build",
		"test": "node --test tests/*.test.mjs"
	},
	"dependencies": {
		"@typescript/typescript6": "catalog:",
		"postcss": "catalog:",
		"postcss-selector-parser": "catalog:"
	},
	"devDependencies": {
		"@meekojs/meeko": "workspace:*",
		"@types/node": "catalog:",
		"prettier": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"peerDependencies": {
		"@meekojs/meeko": ">=1.8 <2",
		"prettier": "^3.9.10"
	},
	"engines": {
		"node": ">=24"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	}
}
