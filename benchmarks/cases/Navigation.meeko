<script lang="ts">
import { signal } from "@meekojs/meeko";

const view = signal(0);
const rows = Array.from({ length: 40 }, (_, index) => index);

function navigate(): void {
  view.value = (view.value + 1) % 3;
  history.pushState({ view: view.value }, "", `/navigation/${view.value}`);
}
</script>

<template>
  <main>
    <button type="button" on:click="navigate">Next view</button>
    <section if:when="view.value === 0" bind:data-view="0"><h1>View 0</h1><p each:of="rows" each:as="row" each:key="row">Home {row}</p></section>
    <section if:when="view.value === 1" bind:data-view="1"><h1>View 1</h1><p each:of="rows" each:as="row" each:key="row">Catalog {row}</p></section>
    <section if:when="view.value === 2" bind:data-view="2"><h1>View 2</h1><p each:of="rows" each:as="row" each:key="row">Profile {row}</p></section>
  </main>
</template>
