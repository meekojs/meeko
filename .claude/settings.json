{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash|PowerShell",
				"hooks": [
					{
						"type": "command",
						"command": "node",
						"args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/git-guard.mjs"],
						"timeout": 10
					},
					{
						"type": "command",
						"command": "node",
						"args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/memory-guard.mjs"],
						"timeout": 10
					}
				]
			}
		]
	}
}
